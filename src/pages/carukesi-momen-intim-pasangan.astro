---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import {
  loadStoreCodDisabledProvinceCodes,
  resolveFormModeContext,
} from '../lib/form-mode';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';

export const prerender = false;

const SLUG = 'carukesi-momen-intim-pasangan';
const PRODUCT_SLUG = 'soothing-gristle-gel-cream-perawatan-cream-pijat-otot-sendi';

const product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);
if (!product) return Astro.rewrite('/404');

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const codDisabledProvinceCodes = await loadStoreCodDisabledProvinceCodes(database);
const formContext = await resolveFormModeContext(
  Astro.request,
  codDisabledProvinceCodes,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;
const comparePrice = cheapest?.comparePrice ?? product.comparePrice ?? 199000;
const discount = comparePrice > price ? Math.round((1 - price / comparePrice) * 100) : 50;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;

const indonesianBuyers = [
  { name: 'Pak Rendra & Istri', location: 'Jakarta Selatan', time: '2 menit lalu' },
  { name: 'Pak Bambang S.', location: 'Surabaya', time: '4 menit lalu' },
  { name: 'Ibu Diana & Suami', location: 'Bandung', time: '6 menit lalu' },
  { name: 'Pak Hendri K.', location: 'Semarang', time: '9 menit lalu' },
  { name: 'Pak Aris W.', location: 'Tangerang', time: '12 menit lalu' },
  { name: 'Pak Gunawan', location: 'Medan', time: '15 menit lalu' },
  { name: 'Ibu Ratna & Suami', location: 'Makassar', time: '18 menit lalu' },
  { name: 'Pak Farhan M.', location: 'Bekasi', time: '21 menit lalu' },
];

const testimonials = [
  {
    name: 'Pak Rendra (42 th) & Istri',
    city: 'Jakarta Selatan',
    occupation: 'Wiraswasta',
    rating: 5,
    highlight: 'otot pinggang super enteng',
    quote: 'Biasanya baru sebentar pinggang dan paha sudah kaku banget menahan posisi. Setelah rutin oles Carukesi sebelum momen berdua, sensasi hangatnya bikin otot pinggang super enteng. Istri juga senang karena saya gak gampang capek lagi.',
    image: '/images/landing/carukesi-momen-intim-pasangan/testimoni-pak-rendra.webp',
  },
  {
    name: 'Ibu Diana (38 th) & Suami',
    city: 'Bandung',
    occupation: 'Ibu Rumah Tangga',
    rating: 5,
    highlight: 'hangatnya meresap cepat dan gak lengket',
    quote: 'Seharian ngurus anak dan rumah bikin badan remuk pas malam hari. Dulu sering nolak suami karena pinggang dan pundak serasa mau patah. Sekarang dioles Carukesi sebentar, hangatnya meresap cepat dan gak lengket sama sekali di sprei kasur. Badan rileks dan fresh!',
    image: '/images/landing/carukesi-momen-intim-pasangan/testimoni-ibu-diana.webp',
  },
  {
    name: 'Pak Hendri (45 th) & Pasangan',
    city: 'Semarang',
    occupation: 'Karyawan Swasta',
    rating: 5,
    highlight: 'quality time bareng istri jadi jauh lebih nyaman',
    quote: 'Usia 40-an lutut dan pinggang gampang ngilu kalau tumpuan lama. Carukesi ini beda dari balsem atau minyak urut yang bikin kasur bau. Hangatnya pas merasuk ke dalam otot, gerak lebih luwes dan quality time bareng istri jadi jauh lebih nyaman.',
    image: '/images/landing/carukesi-momen-intim-pasangan/testimoni-pak-hendri.webp',
  },
];

const sectionTitle = 'text-[clamp(22px,6.8vw,26px)] font-black text-slate-950 tracking-tight leading-[1.2]';
const sectionLead = 'text-[14px] sm:text-[14.5px] text-slate-600 leading-relaxed mt-2 max-w-[420px] mx-auto';
---

<BaseLayout
  title="Carukési Soothing Gristle Gel — Relaksasi Pinggang, Paha & Lutut Momen Pasangan"
  description="Masih ingin menikmati momen intim tapi pinggang, paha, atau lutut cepat lelah? Oles Carukési Gel: hangat meresap, tubuh rileks, dan quality time bersama pasangan terasa lebih nyaman."
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-6 font-sans text-slate-900 shadow-2xl selection:bg-[#0B1E40] selection:text-white antialiased">
    
    <!-- ═══ 1. URGENCY ANNOUNCEMENT BAR (TOP) ═══ -->
    <header class="flex items-center justify-between border-b border-blue-950 bg-[#0B1E40] px-4 py-2.5 text-white shadow-md">
      <div class="flex items-center gap-1.5 text-[11.5px] sm:text-[12px] font-extrabold tracking-wide">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
        </span>
        <span class="text-amber-300 font-black uppercase">PROMO HARI INI:</span>
        <span class="text-slate-100">DISKON {discount}%</span>
      </div>
      <div class="flex items-center gap-1 text-[11.5px] font-bold text-white bg-blue-800/90 px-3 py-0.5 rounded-full border border-blue-600/60 shadow-xs">
        <Icon name="truck" class="h-3.5 w-3.5 text-amber-300 shrink-0" />
        <span>BISA COD</span>
      </div>
    </header>

    <!-- ═══ 2. HERO SECTION (HEADLINE, SUB-HEADLINE & IMMEDIATE FULLWIDTH HERO BANNER) ═══ -->
    <section id="landing-hero" class="bg-white text-center pb-8">
      <div class="px-5 pt-6">
        
        <!-- Star Rating Social Proof (Clean & Compact) -->
        <div class="mb-3.5 inline-flex items-center justify-center gap-1.5 text-[12px] sm:text-[12.5px] font-bold text-slate-800 bg-slate-50 px-3 py-1 rounded-full border border-slate-200/80">
          <div class="flex items-center gap-0.5 shrink-0" role="img" aria-label="Rating 5 dari 5 bintang">
            <svg class="h-3.5 w-3.5 fill-amber-400 text-amber-400 shrink-0" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-3.5 w-3.5 fill-amber-400 text-amber-400 shrink-0" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-3.5 w-3.5 fill-amber-400 text-amber-400 shrink-0" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-3.5 w-3.5 fill-amber-400 text-amber-400 shrink-0" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-3.5 w-3.5 fill-amber-400 text-amber-400 shrink-0" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          </div>
          <span class="text-slate-900 font-extrabold">4.9 / 5.0</span>
          <span class="text-slate-400">•</span>
          <span class="text-slate-600 font-medium">(2.800+ Pasangan)</span>
        </div>

        <!-- Main Impact Headline (Precise Inline Text Highlight) -->
        <h1 class="mx-auto max-w-[440px] text-[clamp(23px,7.2vw,27px)] font-black leading-snug tracking-tight text-slate-950">
          Masih Ingin Menikmati Momen Intim, Tapi <span class="box-decoration-clone rounded-[0.18em] bg-amber-300 px-1.5 py-0.5 text-red-700">Pinggang, Paha, Atau Lutut</span> Sering Menyerah Duluan?
        </h1>

        <!-- Subtitle -->
        <p class="mx-auto mt-3 max-w-[410px] text-[15px] font-semibold leading-relaxed text-slate-700">
          <strong class="text-red-700 font-bold">Sekali Oles Hangat Meresap:</strong> Sensasi hangat menenangkan otot &amp; sendi penopang, mengembalikan kenyamanan momen berdua bersama pasangan.
        </p>
      </div>

      <!-- ═══ FULL-WIDTH HERO IMAGE BANNER (RATIO 4:3) ═══ -->
      <div class="mt-5 relative w-full overflow-hidden bg-slate-900 aspect-[4/3] shadow-md">
        <img
          src="/images/landing/carukesi-momen-intim-pasangan/hero-banner.webp"
          alt="Momen Hangat Pasangan Bersama Carukési Soothing Gel"
          class="h-full w-full object-cover object-center"
          loading="eager"
          decoding="async"
          width="1200"
          height="900"
        />

        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/95 via-slate-950/75 to-transparent px-3 pt-8 pb-3 text-center">
          <div class="inline-flex items-center justify-center gap-1.5 text-[12px] sm:text-[13px] font-extrabold text-amber-300 leading-tight">
            <Icon name="sparkles" class="h-4 w-4 text-amber-400 shrink-0" />
            <span>Sensasi Hangat Menenangkan Otot &amp; Sendi Dalam Hitungan Menit</span>
          </div>
        </div>
      </div>

      <!-- Horizontal Trust Row -->
      <div class="mt-5 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 px-3 text-slate-700">
        <span class="inline-flex items-center gap-1.5 text-[12.5px] sm:text-[13px] font-bold text-slate-800 whitespace-nowrap">
          <Icon name="truck" class="h-4 w-4 text-[#0B1E40] shrink-0" />
          Bisa COD
        </span>
        <span class="inline-flex items-center gap-1.5 text-[12.5px] sm:text-[13px] font-bold text-slate-800 whitespace-nowrap">
          <Icon name="lock-keyhole" class="h-4 w-4 text-[#0B1E40] shrink-0" />
          Privasi 100%
        </span>
        <span class="inline-flex items-center gap-1.5 text-[12.5px] sm:text-[13px] font-bold text-slate-800 whitespace-nowrap">
          <Icon name="shield-check" class="h-4 w-4 text-[#0B1E40] shrink-0" />
          Resmi BPOM
        </span>
      </div>

      <!-- 4 Key Physical Pain Points (Fluid Minimalist List) -->
      <div class="mt-6 px-5 text-left space-y-3.5">
        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 mt-0.5">
            <Icon name="zap" class="h-3.5 w-3.5 shrink-0" />
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-950">Pinggang Cepat Lelah &amp; Pegal</h3>
            <p class="text-[13.5px] sm:text-[14px] text-slate-600 mt-0.5 leading-relaxed">Mulai terasa ngilu dan kaku saat menopang posisi dalam waktu lebih lama.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 mt-0.5">
            <Icon name="zap" class="h-3.5 w-3.5 shrink-0" />
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-950">Otot Paha Kaku &amp; Tertarik</h3>
            <p class="text-[13.5px] sm:text-[14px] text-slate-600 mt-0.5 leading-relaxed">Ketegangan otot paha menahan gerakan yang mengurangi kelenturan tubuh.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 mt-0.5">
            <Icon name="zap" class="h-3.5 w-3.5 shrink-0" />
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-950">Sendi Lutut Kurang Nyaman</h3>
            <p class="text-[13.5px] sm:text-[14px] text-slate-600 mt-0.5 leading-relaxed">Sensasi ngilu saat harus menahan tumpuan tubuh yang memaksa Anda berhenti.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 mt-0.5">
            <Icon name="zap" class="h-3.5 w-3.5 shrink-0" />
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-950">Kaki &amp; Betis Berat Setelah Aktivitas</h3>
            <p class="text-[13.5px] sm:text-[14px] text-slate-600 mt-0.5 leading-relaxed">Tubuh sudah diforsir bekerja seharian sehingga minta istirahat saat malam tiba.</p>
          </div>
        </div>
      </div>

      <!-- Narrative Pivot Callout -->
      <div class="mt-6 px-5 text-left">
        <div class="border-l-2 border-amber-500 pl-4 bg-amber-50/50 py-2.5 rounded-r-lg">
          <p class="text-[14px] font-medium text-amber-950 leading-relaxed italic">
            “Momen yang seharusnya menyenangkan justru membuat Anda sibuk memikirkan rasa pegal pada tubuh yang sudah ingin berhenti.”
          </p>
        </div>
      </div>
    </section>

    <!-- ═══ 3. SECTION: DULU VS SEKARANG (REALITA FISIK USIA PRODUKTIF) ═══ -->
    <section class="border-t border-slate-100 bg-slate-50/60 pt-10 pb-10 text-center">
      <div class="px-5">
        <span class="mb-2 block text-[11.5px] font-bold uppercase tracking-[0.2em] text-red-600">Realita Usia Produktif</span>
        <h2 class={`${sectionTitle} mt-1`}>
          Bukan Selalu Soal Gairah.
        </h2>
        <p class={`${sectionLead} text-center`}>
          Keinginan masih sama, tapi sinyal fisik tak bisa dibohongi:
        </p>
      </div>

      <!-- ═══ REAL IMAGE 2: KONTRAS REALITA USIA (RATIO 16:9) ═══ -->
      <div class="mt-6 relative w-full overflow-hidden aspect-[16/9] bg-slate-100 shadow-2xs">
        <img
          src="/images/landing/carukesi-momen-intim-pasangan/kontras-usia.webp"
          alt="Realita Fisik Usia Produktif Pinggang & Sendi Cepat Lelah"
          class="h-full w-full object-cover object-center"
          loading="lazy"
          decoding="async"
          width="1376"
          height="768"
        />
      </div>

      <!-- Integrated Comparison Rows (Clean & Compact UI/UX) -->
      <div class="mt-5 px-4 grid grid-cols-2 gap-2 text-left">
        <div class="p-2.5 rounded-lg bg-emerald-50/60 border border-emerald-200/60 shadow-2xs">
          <p class="font-extrabold text-emerald-800 uppercase tracking-wider text-[11px] sm:text-[11.5px] pb-1.5 border-b border-emerald-200/50 mb-2 flex items-center gap-1">
            <Icon name="check" class="h-3.5 w-3.5 text-emerald-600 shrink-0" />
            <span>Dulu (Usia Muda)</span>
          </p>
          <ul class="space-y-1.5 text-slate-700 font-medium text-[12.5px] sm:text-[13px]">
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-600 font-bold text-[12px] mt-px">✓</span>
              <span>Gerak bebas tanpa mikir</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-600 font-bold text-[12px] mt-px">✓</span>
              <span>Posisi apapun tahan lama</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-600 font-bold text-[12px] mt-px">✓</span>
              <span>Pinggang enteng &amp; lentur</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-600 font-bold text-[12px] mt-px">✓</span>
              <span>Selesai langsung bugar</span>
            </li>
          </ul>
        </div>

        <div class="p-2.5 rounded-lg bg-amber-50/70 border border-amber-200/60 shadow-2xs">
          <p class="font-extrabold text-amber-900 uppercase tracking-wider text-[11px] sm:text-[11.5px] pb-1.5 border-b border-amber-200/50 mb-2 flex items-center gap-1">
            <Icon name="zap" class="h-3.5 w-3.5 text-amber-600 shrink-0" />
            <span>Sekarang (30-40+)</span>
          </p>
          <ul class="space-y-1.5 text-slate-900 font-bold text-[12.5px] sm:text-[13px]">
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-amber-600 font-bold text-[12px] mt-px">✕</span>
              <span>Baru sebentar kaku</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-amber-600 font-bold text-[12px] mt-px">✕</span>
              <span>Otot paha tegang</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-amber-600 font-bold text-[12px] mt-px">✕</span>
              <span>Lutut ngilu beban</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-amber-600 font-bold text-[12px] mt-px">✕</span>
              <span>Lama pulih bertenaga</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ═══ 4. SECTION: DUAL PERSPEKTIF (SUAMI & ISTRI) ═══ -->
    <section class="border-t border-slate-100 bg-white pt-10 pb-10 text-center">
      <div class="px-5">
        <span class="mb-2 block text-[11.5px] font-bold uppercase tracking-[0.2em] text-[#0B1E40]">Dua Sisi Cerita</span>
        <h2 class={`${sectionTitle} mt-1`}>
          Beda Peran, Sama-Sama Butuh Dirawat
        </h2>
        <p class={`${sectionLead} text-center`}>
          Momen intim yang hangat butuh tubuh yang sama-sama rileks dan siap:
        </p>
      </div>

      <!-- PERSPEKTIF PRIA -->
      <div class="mt-8 px-5 text-left space-y-2.5">
        <div class="flex items-center gap-2">
          <span class="text-[12px] font-bold uppercase tracking-wider text-white bg-[#0B1E40] px-2.5 py-0.5 rounded-sm">
            Suami
          </span>
          <span class="text-[13.5px] sm:text-[14px] font-bold text-slate-900">Gairah Ada, Kuda-kuda Menyerah</span>
        </div>

        <p class="text-[13.5px] sm:text-[14px] text-slate-600 leading-relaxed">
          Area tumpuan yang bekerja paling keras saat menopang posisi:
        </p>

        <!-- 4 Bullet Checkpoints -->
        <div class="grid grid-cols-2 gap-2 text-[12.5px] sm:text-[13px] font-bold text-slate-800 pt-0.5">
          <div class="flex items-center gap-2 p-2 rounded-md bg-slate-50 border border-slate-200/70">
            <Icon name="circle-check" class="h-3.5 w-3.5 text-red-600 shrink-0" />
            <span>Pinggang (Lumbar)</span>
          </div>
          <div class="flex items-center gap-2 p-2 rounded-md bg-slate-50 border border-slate-200/70">
            <Icon name="circle-check" class="h-3.5 w-3.5 text-red-600 shrink-0" />
            <span>Otot Paha</span>
          </div>
          <div class="flex items-center gap-2 p-2 rounded-md bg-slate-50 border border-slate-200/70">
            <Icon name="circle-check" class="h-3.5 w-3.5 text-red-600 shrink-0" />
            <span>Sendi Lutut</span>
          </div>
          <div class="flex items-center gap-2 p-2 rounded-md bg-slate-50 border border-slate-200/70">
            <Icon name="circle-check" class="h-3.5 w-3.5 text-red-600 shrink-0" />
            <span>Kaki &amp; Betis</span>
          </div>
