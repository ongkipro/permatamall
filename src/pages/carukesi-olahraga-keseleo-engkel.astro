---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import {
  loadStoreCodDisabledProvinceCodes,
  resolveFormModeContext,
} from '../lib/form-mode';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';

export const prerender = false;

const SLUG = 'carukesi-olahraga-keseleo-engkel';
const PRODUCT_SLUG = 'soothing-gristle-gel-cream-perawatan-cream-pijat-otot-sendi';

const product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);
if (!product) return Astro.rewrite('/404');

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const codDisabledProvinceCodes = await loadStoreCodDisabledProvinceCodes(database);
const formContext = await resolveFormModeContext(
  Astro.request,
  codDisabledProvinceCodes,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;
const comparePrice = cheapest?.comparePrice ?? product.comparePrice ?? 199000;
const discount = comparePrice > price ? Math.round((1 - price / comparePrice) * 100) : 50;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;

const olahragaBuyers = [
  { name: 'Reza Aditya', location: 'Jakarta Selatan', time: '2 menit lalu' },
  { name: 'Bayu Pratama', location: 'Denpasar', time: '5 menit lalu' },
  { name: 'Fajar Hidayat', location: 'Bandung', time: '9 menit lalu' },
  { name: 'Rio Wibowo', location: 'Yogyakarta', time: '13 menit lalu' },
  { name: 'Aris Munandar', location: 'Surabaya', time: '17 menit lalu' },
];

const sectionTitle = 'text-[clamp(22px,6.8vw,26px)] font-black text-slate-950 tracking-tight leading-[1.2]';
const sectionLead = 'text-[13.5px] text-slate-600 leading-relaxed mt-2 max-w-[420px] mx-auto';
---

<BaseLayout
  title="Carukési Relaxing Gel — Solusi Cedera Olahraga, Keseleo & Kram Otot"
  description="Engkel terkilir saat futsal, hamstring ketarik atau pegal gowes/badminton? Oles Carukési Gel: hangat aktif percepat pemulihan tendon & otot dalam 10 detik."
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  image="/images/landing/carukesi-olahraga-keseleo-engkel/hero-olahraga.webp"
  preloadImages="/images/landing/carukesi-olahraga-keseleo-engkel/hero-olahraga.webp"
>
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-6 font-sans text-slate-900 shadow-2xl selection:bg-blue-600 selection:text-white antialiased">
    <!-- ═══ 1. URGENCY ANNOUNCEMENT BAR (TOP NON-STICKY) ═══ -->
    <header class="flex items-center justify-between border-b border-blue-950 bg-[#0B1E40] px-4 py-2.5 text-white shadow-md">
      <div class="flex items-center gap-1.5 text-[11px] font-extrabold tracking-wide">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
        </span>
        <span class="text-amber-300 font-black uppercase">PROMO HARI INI:</span>
        <span class="text-slate-100">DISKON {discount}%</span>
      </div>
      <div class="flex items-center gap-1 text-[10.5px] font-bold text-white bg-blue-800/90 px-2.5 py-0.5 rounded-full border border-blue-600/60 shadow-xs">
        <Icon name="truck" class="h-3 w-3 text-amber-300" />
        <span>BISA COD</span>
      </div>
    </header>

    <!-- ═══ 2. HERO SECTION (FULL WIDTH HERO IMAGE & FLUID ICONS) ═══ -->
    <section id="landing-hero" class="bg-white text-center pb-8">
      <div class="px-5 pt-6">
        <!-- Main Brutal Headline -->
        <h1 class="mx-auto max-w-[440px] text-[clamp(24px,7.2vw,28px)] font-black leading-[1.18] tracking-tight text-slate-950">
          Engkel Terkilir Keseleo, Hamstring Ketarik &amp; <span class="box-decoration-clone rounded-[0.18em] bg-[#0B1E40] px-2 py-0.5 text-white">Otot Kram Pasca Tanding?</span>
        </h1>

        <!-- Subtitle -->
        <p class="mx-auto mt-3 max-w-[410px] text-[15px] font-semibold leading-relaxed text-slate-700">
          <strong class="text-red-700 font-bold">Sekali Oles Hangat Aktif:</strong> Membuka sirkulasi darah, redakan pembengkakan tendon, lemaskan serat otot kram &amp; siap gaspol ke lapangan lagi!
        </p>

        <!-- Star Rating Social Proof -->
        <div class="mt-3.5 flex items-center justify-center gap-1.5 text-[12.5px] font-extrabold text-slate-800">
          <div class="flex items-center gap-0.5" aria-label="Rating 5 dari 5 bintang">
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          </div>
          <span class="text-slate-900 font-bold">4.9 / 5.0</span>
          <span class="text-slate-400">•</span>
          <span class="text-slate-600 font-medium">(2.190+ Atlet &amp; Penggemar Olahraga)</span>
        </div>
      </div>

      <!-- Hero Visual (100% FULL WIDTH EDGE-TO-EDGE) -->
      <div class="mt-5 relative w-full overflow-hidden bg-slate-900 aspect-[5/4]">
        <img
          src="/images/landing/carukesi-olahraga-keseleo-engkel/hero-olahraga.webp"
          alt="Carukési Relaxing Gel Solusi Cedera Olahraga & Keseleo"
          class="h-full w-full object-cover block"
          loading="eager"
          decoding="async"
          width="480"
          height="480"
        />
        <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2.5 text-center backdrop-blur-xs">
          <p class="text-[12.5px] font-bold text-amber-300 flex items-center justify-center gap-1.5">
            <Icon name="sparkles" class="h-4 w-4 text-amber-300 shrink-0" />
            <span>Pemulihan Cedera Otot &amp; Tendon Lebih Cepat Dalam 10 Detik</span>
          </p>
        </div>
      </div>

      <!-- Horizontal Trust Row -->
      <div class="mt-5 flex justify-center gap-4 px-4 text-slate-700">
        <span class="inline-flex items-center gap-1.5 text-[12px] font-bold text-slate-800">
          <Icon name="truck" class="h-4 w-4 text-[#0B1E40]" />
          Bisa COD
        </span>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-bold text-slate-800">
          <Icon name="lock-keyhole" class="h-4 w-4 text-[#0B1E40]" />
          Privasi 100%
        </span>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-bold text-slate-800">
          <Icon name="shield-check" class="h-4 w-4 text-[#0B1E40]" />
          Resmi BPOM
        </span>
      </div>

      <!-- 4 Key Value Checkmarks (Fluid Minimalist List) -->
      <div class="mt-6 px-5 text-left space-y-3.5">
        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 mt-0.5">
            <Icon name="check" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[14.5px] font-bold text-slate-950">Kempeskan Bengkak Engkel Terkilir</h3>
            <p class="text-[13px] text-slate-600 mt-0.5 leading-relaxed">Meredakan memar peradangan ligamen akibat salah tumpuan saat main futsal/basket.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 mt-0.5">
            <Icon name="check" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[14.5px] font-bold text-slate-950">Pemanasan Cepat (*Pre-Workout*) Anti Kram</h3>
            <p class="text-[13px] text-slate-600 mt-0.5 leading-relaxed">Oles sebelum tanding untuk memacu vasodilatasi pembuluh darah, cegah otot ketarik.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 mt-0.5">
            <Icon name="check" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[14.5px] font-bold text-slate-950">Hilangkan DOMS Pasca Gym / Gowes 100 KM</h3>
            <p class="text-[13px] text-slate-600 mt-0.5 leading-relaxed">Menguras timbunan asam laktat di paha dan betis sehingga besok pagi langsung enteng.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 mt-0.5">
            <Icon name="check" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[14.5px] font-bold text-slate-950">Cepat Kering &amp; Tidak Mengotori Jersey</h3>
            <p class="text-[13px] text-slate-600 mt-0.5 leading-relaxed">Gel bening tidak meninggalkan residu putih berdebu ataupun bercak noda di pakaian olahraga.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 3. PROBLEM AGITATION SECTION (FLUID LIST) ═══ -->
    <section class="border-t border-slate-100 bg-red-50/35 px-5 py-10">
      <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-red-600">Risiko Cedera Atlet</span>
      <h2 class={`${sectionTitle} mt-1`}>
        Apakah Performa Anda Terhambat <span class="box-decoration-clone rounded-[0.18em] bg-[#0B1E40] px-2 py-0.5 text-white">Cedera Menyiksa Ini?</span>
      </h2>
      <p class={`${sectionLead} text-left`}>
        Cedera ligamen dan otot yang dibiarkan tanpa penanganan cepat bisa berujung robekan meniskus permanen!
      </p>

      <div class="mt-7 space-y-4">
        <div class="flex gap-3.5 items-start">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 mt-0.5">
            <Icon name="x" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-900">Engkel Terkilir &amp; Bengkak Biru Menusuk</h3>
            <p class="text-[13.5px] text-slate-600 mt-0.5 leading-relaxed">Jalan pincang dan menahan rasa sakit luar biasa saat telapak kaki menapak lantai.</p>
          </div>
        </div>

        <div class="flex gap-3.5 items-start">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 mt-0.5">
            <Icon name="x" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-900">Hamstring Ketarik &amp; Paha Belakang Mengunci</h3>
            <p class="text-[13.5px] text-slate-600 mt-0.5 leading-relaxed">Seketika tidak sanggup berlari kencang atau melompat karena serat otot robek mikroskopis.</p>
          </div>
        </div>

        <div class="flex gap-3.5 items-start">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 mt-0.5">
            <Icon name="x" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-900">Nyeri Sendi Lutut (*Jumper's Knee*) Pasca Smash</h3>
            <p class="text-[13.5px] text-slate-600 mt-0.5 leading-relaxed">Tendon patella meradang parah akibat pendaratan keras berulang kali di lapangan keras.</p>
          </div>
        </div>

        <div class="flex gap-3.5 items-start">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 mt-0.5">
            <Icon name="x" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-900">Frustrasi Hanya Jadi Penonton di Bangku Cadangan</h3>
            <p class="text-[13.5px] text-slate-600 mt-0.5 leading-relaxed">Kehilangan momentum tanding bersama tim kebanggaan gara-gara masa pemulihan yang lambat.</p>
          </div>
        </div>
      </div>

      <!-- Warning Callout -->
      <div class="mt-6 border-l-2 border-red-600 pl-4 text-left">
        <h3 class="text-[14.5px] font-bold text-slate-950">Solusi Fast Recovery:</h3>
        <p class="text-[13px] leading-relaxed text-slate-600 mt-0.5">
          Gel terapi oles berkecepatan tinggi melancarkan mikrosirkulasi di sekitar tendon yang cedera, mempercepat regenerasi sel dalam hitungan hari!
        </p>
      </div>
    </section>

    <!-- ═══ 4. THE SOLUTION & MECHANISM ═══ -->
    <section class="border-t border-slate-100 bg-white px-5 py-10 text-center">
      <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-[#0B1E40]">Mekanisme Kerja</span>
      <h2 class={`${sectionTitle} mt-1`}>
        Bagaimana Carukési Memulihkan Otot Atlet Lebih Cepat?
      </h2>
      <p class={`${sectionLead} text-center`}>
        Formula gel mikro transparan menyerap (*Fast Absorbing*) langsung meredakan peradangan ligamen.
      </p>

      <div class="mt-8 space-y-6 text-left">
        <div class="flex items-start gap-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#0B1E40] text-white font-black text-[14px]">
            01
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-950">Vasodilatasi Pembuluh Darah 10 Detik</h3>
            <p class="text-[13.5px] text-slate-600 mt-1 leading-relaxed">
              Meningkatkan suplai oksigen dan nutrisi kolagen ke area tendon yang mengalami mikrolesi.
            </p>
          </div>
        </div>

        <div class="h-px bg-slate-100 w-full" />

        <div class="flex items-start gap-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#0B1E40] text-white font-black text-[14px]">
            02
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-950">Meredakan Pembengkakan &amp; Memar</h3>
            <p class="text-[13.5px] text-slate-600 mt-1 leading-relaxed">
              Zat anti-inflamasi herbal aktif menekan zat sitokin penyebab bengkak dan nyeri berdenyut pada sendi.
            </p>
          </div>
        </div>

        <div class="h-px bg-slate-100 w-full" />

        <div class="flex items-start gap-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#0B1E40] text-white font-black text-[14px]">
            03
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-950">Kembalikan Kelenturan &amp; Ledakan Otot</h3>
            <p class="text-[13.5px] text-slate-600 mt-1 leading-relaxed">
              Otot kembali lentur elastis, siap melakukan sprint, jumping, dan manuver tajam di lapangan.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 5. CARA PEMAKAIAN (FULL WIDTH BANNER) ═══ -->
    <section class="border-t border-slate-100 bg-slate-50/50 pt-10 pb-10 text-center">
      <div class="px-5">
        <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-emerald-800">Petunjuk Penggunaan</span>
        <h2 class={`${sectionTitle} mt-1`}>
          3 Langkah Pemulihan &amp; Pemanasan Atlet
        </h2>
      </div>

      <div class="mt-6 w-full overflow-hidden">
        <img
          src="/images/landing/carukesi-olahraga-keseleo-engkel/cara-pakai-olahraga.webp"
          alt="Cara Pemakaian Carukési Gel Pada Atlet Olahraga"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="mt-5 px-5">
        <div class="border-l-2 border-emerald-600 pl-4 text-left">
          <p class="text-[13px] font-semibold text-slate-800 leading-relaxed">
            💡 <strong>Anjuran Pakai:</strong> Oleskan tipis sebelum pemanasan untuk cegah kram, dan oleskan merata setelah bertanding untuk mempercepat pemulihan asam laktat.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══ 6. SEBELUM VS SESUDAH (PERBANDINGAN VISUAL MENYATU) ═══ -->
    <section class="border-t border-slate-100 bg-white pt-10 pb-10 text-center">
      <div class="px-5">
        <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-amber-800">Hasil Nyata</span>
        <h2 class={`${sectionTitle} mt-1`}>
          Perbedaan Nyata Pada Performa Anda
        </h2>
      </div>

      <div class="mt-6 w-full overflow-hidden mb-6">
        <img
          src="/images/landing/carukesi-olahraga-keseleo-engkel/before-after-olahraga.webp"
          alt="Sebelum vs Sesudah Menggunakan Carukési Gel Pada Cedera Olahraga"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Integrated Comparison Rows -->
      <div class="px-5 grid grid-cols-2 gap-3 text-left text-[12.5px]">
        <div class="p-3.5 rounded-lg bg-red-50/60 border-l-2 border-red-500">
          <p class="font-bold text-red-700 uppercase tracking-wider mb-2">❌ SEBELUM OLES</p>
          <ul class="space-y-1.5 text-slate-700 leading-relaxed font-medium">
            <li>• Engkel bengkak &amp; pincang</li>
            <li>• Hamstring ketarik mengunci</li>
            <li>• DOMS berhari-hari pasca gym</li>
            <li>• Terpaksa absen tanding</li>
          </ul>
        </div>
        <div class="p-3.5 rounded-lg bg-emerald-50/70 border-l-2 border-emerald-600">
          <p class="font-bold text-emerald-800 uppercase tracking-wider mb-2">✅ SETELAH OLES</p>
          <ul class="space-y-1.5 text-slate-900 font-bold leading-relaxed">
            <li>• Engkel kokoh &amp; jalan normal</li>
            <li>• Otot lentur bertenaga</li>
            <li>• Recovery cepat 10 detik</li>
            <li>• Siap gaspol &amp; cetak gol</li>
          </ul>
        </div>
      </div>
