---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import Icon from '../components/shared/Icon.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('bibit-jeruk-santang');
if (!product) throw new Error('Product bibit-jeruk-santang not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = 'https://pesantren.shop/bibit-jeruk-santang';
const seoTitle = 'Bibit Jeruk Santang Madu Super Genjah: Berbuah Lebat Cepat di Pot Teras';
const seoDescription =
  'Bibit Jeruk Santang Madu Okulasi Super Manis. Berbuah lebat berdompolan 6-12 bulan di pot/lahan, rasa manis segar tanpa biji. Promo COD Rp 99rb.';

const sectionTitle = 'text-[clamp(26px,6.8vw,30px)] font-extrabold leading-[1.14] tracking-tight text-slate-950';
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={product.heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Bibit Jeruk Santang', url: '/bibit-jeruk-santang' }
  ]}
  preloadImages={[
    {
      srcset: "/images/jeruk-santang/jeruk-hero-400.webp 400w, /images/jeruk-santang/jeruk-hero-600.webp 600w",
      sizes: "(max-width: 480px) 100vw, 480px"
    }
  ]}
>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <MetaLandingTracker slug="bibit-jeruk-santang" productId={product.productId} contentName={product.contentName} price={product.price} />

    <!-- 1. URGENCY TOP BAR -->
    <div class="bg-[#EC7211] px-4 py-2.5 text-center">
      <p class="flex items-center justify-center gap-1.5 text-[12px] font-extrabold uppercase tracking-wide text-white">
        <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-white" aria-hidden="true" />
        PROMO BIBIT JERUK SANTANG MADU SUPER GENJAH: DISKON 50% GARANSI HIDUP & COD 99RB!
      </p>
    </div>

    <!-- 2. HERO SECTION & FOTO HERO UTAMA -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-6">
        <div class="mx-auto mb-2.5 inline-flex items-center gap-1.5 rounded-full bg-[#FFF5E5] px-3.5 py-1 text-[11px] font-extrabold text-[#EC7211] border border-[#FFEACC]">
          <Icon name="lucide:sparkles" class="h-3.5 w-3.5 text-[#EC7211]" />
          VARIETAS JERUK SANTANG MADU OKULASI UNGGULAN
        </div>
        <h1 class="mx-auto max-w-[440px] text-[clamp(28px,7.8vw,33px)] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Berbuah Lebat Melimpah <span class="hl-brush">Super Manis Tanpa Biji!</span>
        </h1>
        <p class="mx-auto mt-3 max-w-[390px] text-[15px] font-semibold leading-relaxed text-slate-700">
          Bibit Jeruk Santang Madu. <strong class="font-bold text-slate-950">Rasa manis segar berair tanpa biji, buah oranye mencolok!</strong> <span class="font-bold text-slate-950 underline decoration-[#EC7211]/60 decoration-2 underline-offset-4">Pohon sangat genjah, cepat berbuah lebat berdompolan 6-12 bulan di pot teras rumah!</span>
        </p>
      </div>

      <!-- HERO IMAGE CONTAINER (PAS FLUID UNCROPPED) -->
      <div class="mt-5 w-full overflow-hidden border-y border-slate-200 bg-white">
        <img
          src="/images/jeruk-santang/jeruk-hero-600.webp"
          srcset="/images/jeruk-santang/jeruk-hero-400.webp 400w, /images/jeruk-santang/jeruk-hero-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Bibit Jeruk Santang Madu Super Genjah Berbuah Lebat"
          class="w-full h-auto block object-contain mx-auto"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="540"
          height="960"
        />

        <div class="bg-slate-950 px-4 py-2.5 text-center">
          <p class="flex items-center justify-center gap-1.5 text-[12.5px] font-bold text-[#FFD699]">
            <Icon name="lucide:sprout" class="h-4 w-4 text-[#EC7211] shrink-0" aria-hidden="true" />
            <span>Hasil Okulasi Vegetatif • Manis Segar Tanpa Biji • Genjah 6-12 Bulan!</span>
          </p>
        </div>
      </div>
    </section>

    <!-- 3. HIGHLIGHT SPECS BAR -->
    <section class="border-y border-orange-100 bg-[#FFF5E5]/60 px-5 py-4">
      <div class="grid grid-cols-2 gap-2.5 text-left">
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-2.5 shadow-xs">
          <Icon name="lucide:sparkles" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[10.5px] font-extrabold tracking-wide uppercase text-slate-400">RASA BUAH</p>
            <p class="text-[13px] font-extrabold text-slate-950">Super Manis Tanpa Biji</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-2.5 shadow-xs">
          <Icon name="lucide:calendar" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[10.5px] font-extrabold tracking-wide uppercase text-slate-400">MASA BERBUAH</p>
            <p class="text-[13px] font-extrabold text-slate-950">Genjah 6-12 Bulan</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-2.5 shadow-xs">
          <Icon name="lucide:flower-2" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[10.5px] font-extrabold tracking-wide uppercase text-slate-400">KEBUTUHAN POT</p>
            <p class="text-[13px] font-extrabold text-slate-950">Tabulampot Teras</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-2.5 shadow-xs">
          <Icon name="lucide:truck" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[10.5px] font-extrabold tracking-wide uppercase text-slate-400">LAYANAN</p>
            <p class="text-[13px] font-extrabold text-slate-950">Garansi & COD</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. SECTION FITUR 1: POHON BERBUAH LEBAT DI POT TERAS -->
    <section class="px-5 py-7 border-b border-slate-100">
      <div class="text-center">
        <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#EC7211]">TABULAMPOT CANTIK</span>
        <h2 class={sectionTitle + ' mt-1'}>Berbuah Lebat di Pot Teras</h2>
      </div>

      <div class="mt-4 w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
        <img
          src="/images/jeruk-santang/jeruk-lebat-600.webp"
          srcset="/images/jeruk-santang/jeruk-lebat-400.webp 400w, /images/jeruk-santang/jeruk-lebat-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Pohon Jeruk Santang Madu Berbuah Lebat di Pot Teras Rumah"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="960"
        />
      </div>
    </section>

    <!-- 5. SECTION FITUR 2: KEUNGGULAN DAGING BUAH MANIS SEGAR -->
    <section class="px-5 py-7 border-b border-slate-100 bg-slate-50/50">
      <div class="text-center">
        <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#EC7211]">RASA MANIS LEGIT</span>
        <h2 class={sectionTitle + ' mt-1'}>Jeruk Madu Segar Tanpa Biji</h2>
      </div>

      <div class="mt-4 w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
        <img
          src="/images/jeruk-santang/jeruk-keunggulan-600.webp"
          srcset="/images/jeruk-santang/jeruk-keunggulan-400.webp 400w, /images/jeruk-santang/jeruk-keunggulan-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Keunggulan Daging Buah Jeruk Santang Madu Manis Berair Tanpa Biji"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="960"
        />
      </div>
    </section>

    <!-- 6. SECTION FITUR 3: BIBIT OKULASI SIAP TANAM -->
    <section class="px-5 py-7 border-b border-slate-100">
      <div class="text-center">
        <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#EC7211]">GARANSI BIBIT UNGGUL</span>
        <h2 class={sectionTitle + ' mt-1'}>Bibit Okulasi Siap Tanam</h2>
      </div>

      <div class="mt-4 w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
        <img
          src="/images/jeruk-santang/jeruk-bibit-okulasi-600.webp"
          srcset="/images/jeruk-santang/jeruk-bibit-okulasi-400.webp 400w, /images/jeruk-santang/jeruk-bibit-okulasi-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Bibit Jeruk Santang Madu Okulasi Unggul Siap Tanam"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="960"
        />
      </div>
    </section>

    <!-- 7. SECTION FITUR 4: DOMPOLAN BUAH ORANYE MELIMPAH -->
    <section class="px-5 py-7 border-b border-slate-100 bg-slate-50/50">
      <div class="text-center">
        <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#EC7211]">HASIL PANEN MELIMPAH</span>
        <h2 class={sectionTitle + ' mt-1'}>Dompolan Buah Oranye Lebat</h2>
      </div>

      <div class="mt-4 w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
        <img
          src="/images/jeruk-santang/jeruk-dompolan-600.webp"
          srcset="/images/jeruk-santang/jeruk-dompolan-400.webp 400w, /images/jeruk-santang/jeruk-dompolan-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Dompolan Buah Jeruk Santang Madu Warna Oranye Lebat Melimpah"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>
    </section>

    <!-- 8. TABEL SPESIFIKASI PRODUK -->
    <section class="px-5 py-7 border-b border-slate-100">
      <div class="text-center">
        <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#EC7211]">SPESIFIKASI TEKNIS</span>
        <h2 class={sectionTitle + ' mt-1'}>Spesifikasi Tanaman Jeruk</h2>
      </div>

      <div class="mt-4 rounded-2xl border border-slate-200 bg-[#FFF5E5]/40 p-4.5 shadow-xs">
        <ul class="space-y-3 text-[14px] text-slate-800">
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2">
            <span class="text-slate-500 font-medium">Varietas Tanaman</span>
            <span class="font-bold text-slate-950">Jeruk Santang Madu Super Genjah</span>
          </li>
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2">
            <span class="text-slate-500 font-medium">Sistem Perbanyakan</span>
            <span class="font-bold text-slate-950">Okulasi Sambung Vegetatif Unggul</span>
          </li>
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2">
            <span class="text-slate-500 font-medium">Tinggi Bibit Dikirim</span>
            <span class="font-bold text-slate-950">50 - 70 cm (Siap Tanam)</span>
          </li>
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2">
            <span class="text-slate-500 font-medium">Estimasi Masa Berbuah</span>
            <span class="font-bold text-slate-950">6 - 12 Bulan Sejak Tanam</span>
          </li>
          <li class="flex items-center justify-between">
            <span class="text-slate-500 font-medium">Kebutuhan Lahan</span>
            <span class="font-bold text-slate-950">Tabulampot Pot Teras / Pekarangan</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- 9. TESTIMONIALS PELANGGAN REAL (FOTO BUKTI BUKAN TEKS) -->
    <section class="px-5 py-7 border-b border-slate-100 bg-slate-50/50">
      <div class="text-center">
        <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#EC7211]">KEUNGGULAN PRODUK</span>
        <h2 class={sectionTitle + ' mt-1'}>Keunggulan Produk</h2>
      </div>

      <div class="mt-4 space-y-4">
        <div class="w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
          <img
            src="/images/jeruk-santang/jeruk-testi1-600.webp"
            srcset="/images/jeruk-santang/jeruk-testi1-400.webp 400w, /images/jeruk-santang/jeruk-testi1-600.webp 600w"
            sizes="(max-width: 480px) 100vw, 480px"
            alt="Testimoni Real Pembeli Bibit Jeruk Santang Madu 1"
            class="w-full h-auto block object-contain mx-auto"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="540"
            height="540"
          />
        </div>
        <div class="w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
          <img
            src="/images/jeruk-santang/jeruk-testi2-600.webp"
            srcset="/images/jeruk-santang/jeruk-testi2-400.webp 400w, /images/jeruk-santang/jeruk-testi2-600.webp 600w"
            sizes="(max-width: 480px) 100vw, 480px"
            alt="Testimoni Real Pembeli Bibit Jeruk Santang Madu 2"
            class="w-full h-auto block object-contain mx-auto"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="540"
            height="540"
          />
        </div>
        <div class="w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
          <img
            src="/images/jeruk-santang/jeruk-testi3-600.webp"
            srcset="/images/jeruk-santang/jeruk-testi3-400.webp 400w, /images/jeruk-santang/jeruk-testi3-600.webp 600w"
            sizes="(max-width: 480px) 100vw, 480px"
            alt="Testimoni Real Pembeli Bibit Jeruk Santang Madu 3"
            class="w-full h-auto block object-contain mx-auto"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="540"
            height="540"
          />
        </div>
      </div>
    </section>

    <!-- 10. SOCIAL PROOF DYNAMIC -->
    <SocialProof productSlug="bibit-jeruk-santang" />

    <!-- 11. PRICING & HARGA SECTION (CHECKOUT FORM & BANNER GARANSI PROMO) -->
    <section id="checkout" class="border-t-8 border-slate-100 bg-white py-10">
      <div class="px-5 pb-6 text-center">
        <p class="mx-auto mb-2 inline-flex items-center gap-1.5 text-[11.5px] font-bold uppercase tracking-[0.14em] text-[#EC7211]">
          <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          Promo Bibit Jeruk Santang Madu COD
        </p>
        <h2 class="mx-auto max-w-[340px] text-[clamp(26px,6.8vw,30px)] font-extrabold leading-[1.12] tracking-tight text-slate-950">
          Isi Alamat Pengiriman, <span class="hl-brush">Bayar Saat Sampai</span>
        </h2>
      </div>

      <!-- FOTO BANNER GARANSI PROMO -->
      <div class="mx-auto mb-5 max-w-[440px] px-5">
        <div class="overflow-hidden rounded-2xl border border-slate-200 shadow-sm">
          <img
            src="/images/jeruk-santang/jeruk-garansi-600.webp"
            srcset="/images/jeruk-santang/jeruk-garansi-400.webp 400w, /images/jeruk-santang/jeruk-garansi-600.webp 600w"
            sizes="(max-width: 480px) 100vw, 480px"
            alt="Banner Garansi Promo Bibit Jeruk Santang Madu COD"
            class="w-full h-auto block object-contain mx-auto"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="540"
            height="540"
          />
        </div>
      </div>

      <div class="mx-auto mb-6 max-w-[380px] px-5 text-center">
        <div class="rounded-2xl border-2 border-[#EC7211] bg-[#FFF5E5]/40 p-3.5">
          <p class="text-[11.5px] font-bold text-[#EC7211] uppercase tracking-wider">HARGA PROMO SPESIAL</p>
          <div class="mt-0.5 flex items-baseline justify-center gap-2">
            <span class="text-[13.5px] text-slate-400 line-through">Rp 250.000</span>
            <span class="text-[26px] font-black text-slate-950">Rp 99.000</span>
          </div>
          <p class="mt-0.5 text-[11.5px] font-medium text-slate-600">Beli 1 Pohon Rp 99.000 • Promo PALING LARIS Beli 2 Pohon Rp 159.000</p>
        </div>
      </div>

      <GeoIpResolvedForm mode={formContext.mode} productSlug="bibit-jeruk-santang" embedded={true} />
    </section>

    <!-- 12. FOOTER -->
    <LpMiniFooter />

    <!-- 13. STICKY CTA MOBILE -->
    <StickyCTA productSlug="bibit-jeruk-santang" />
  </main>
</BaseLayout>

<style>
  .hl-brush {
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding-bottom: 0.14em;
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20320%2024'%20preserveAspectRatio='none'%3E%3Cpath%20d='M3%2013C55%206%20120%2016%20182%2011S292%208%20317%2012L315%2020C252%2015%20150%2023%2072%2019S13%2021%205%2020C2%2017%202%2016%203%2013Z'%20fill='%23EC7211'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: center 100%;
    background-size: 100% 0.32em;
  }
</style>
