---
import BaseLayout from '../layouts/BaseLayout.astro';
import RatingStars from '../components/shared/RatingStars.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import Icon from '../components/shared/Icon.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('bibit-sirsak-juara');
if (!product) throw new Error('Product bibit-sirsak-juara not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = 'https://pesantren.shop/bibit-sirsak-juara';
const seoTitle = 'Bibit Sirsak Juara Okulasi Premium: Pohon Pendek Berbuah Lebat Jumbo';
const seoDescription =
  'Bibit Sirsak Madu Juara okulasi premium. Daging tebal super manis 0% serat, cepat berbuah di pot teras rumah. Garansi COD & bibit segar sampai tujuan.';

const sectionTitle = 'text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950';
const body = 'text-[16px] leading-relaxed text-slate-600';

const testimonials = [
  {
    name: 'Pak Hidayat Subagio',
    location: 'Magelang, Jawa Tengah',
    avatar: '/images/petani/petani-07.webp',
    problem: 'Tanam sirsak lokal bertahun-tahun pohon tinggi tak berbuah',
    comment:
      'Dulu kapok <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">tanam sirsak lokal cuma rimbun daun</strong>. Pas coba bibit sirsak juara di pot teras rumah, <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">pohon masih 1 meter langsung keluar calon buah jumbo</strong>. Dagingnya tebal manis sekali!',
    highlight: 'Pohon pendek berbuah jumbo manis',
  },
  {
    name: 'Bu Ratna Dewi',
    location: 'Surakarta, Jawa Tengah',
    avatar: '/images/petani/petani-dewi.webp',
    problem: 'Sirsak biasa rasanya asam pekat dan bijinya banyak',
    comment:
      'Bosan beli sirsak di pasar yang <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">sering masam dan bijinya banyak</strong>. Pas panen sendiri dari pot teras, <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">dagingnya super tebal lumer 0% serat manis segar</strong>. Sangat puas!',
    highlight: 'Daging tebal manis lumer 0% serat',
  },
  {
    name: 'Pak Darmaji',
    location: 'Klaten, Jawa Tengah',
    avatar: '/images/petani/petani-01.webp',
    problem: 'Ragu beli bibit tanaman online takut patah di pengiriman',
    comment:
      'Awalnya ragu beli bibit via online. Pas datang <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">packingnya sangat rapi dan tanahnya lembab segar</strong>. Daun tetap hijau segar, langsung <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">tumbuh tunas baru cepat sekali</strong>.',
    highlight: 'Packing amanah, bibit cepat tumbuh',
  },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={product.heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Bibit Sirsak Juara', url: '/bibit-sirsak-juara' }
  ]}

  preloadImages={[
    "/images/produk/bibit-sirsak-juara-hero.webp",
    "/images/produk/bibit-sirsak-juara-product.webp"
  ]}>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <MetaLandingTracker slug="bibit-sirsak-juara" productId={product.productId} contentName={product.contentName} price={product.price} />

    <!-- 1. URGENCY TOP BAR -->
    <div class="bg-[#FF9900] px-4 py-2.5 text-center">
      <p class="flex items-center justify-center gap-1.5 text-[12px] font-extrabold uppercase tracking-wide text-white">
        <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-white" aria-hidden="true" />
        PROMO FLASH SALE SIRSAK MADU JUARA: DISKON 50% GARANSI SEGAR & COD 99RB!
      </p>
    </div>

    <!-- 2. HERO SECTION -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-7">
        <div class="mx-auto mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#FFF5E5] px-3.5 py-1 text-[11.5px] font-extrabold text-[#EC7211] border border-[#FFEACC]">
          <Icon name="lucide:sparkles" class="h-3.5 w-3.5 text-[#EC7211]" />
          VARIETAS SIRSAK RATU SUPER UNGGULAN
        </div>
        <h1 class="mx-auto max-w-[440px] text-[clamp(32px,8.8vw,36px)] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Panen Sirsak Madu Ratu Jumbo <span class="hl-brush">Langsung Di Pot Teras!</span>
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[16px] font-semibold leading-relaxed text-slate-700">
          Bibit Sirsak Juara Okulasi Premium. <strong class="font-bold text-slate-950">Pohon pendek berbuah lebat berbobot jumbo</strong> & <span class="font-bold text-slate-950 underline decoration-[#FF9900]/60 decoration-2 underline-offset-4">daging tebal 0% serat manis legit, garansi bibit tumbuh segar!</span>
        </p>
      </div>

      <!-- HERO IMAGE REAL (FOTO 1) -->
      <div class="mt-7 w-full border-b border-slate-100">
        <img
          src="/images/produk/bibit-sirsak-juara-hero.webp"
          alt="Promo Flash Sale Bibit Sirsak Madu Juara Okulasi Premium"
          class="w-full h-auto block"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="638"
          height="638"
        />
        <div class="bg-slate-950 px-4 py-3 text-center">
          <p class="flex items-center justify-center gap-1.5 text-[12.5px] font-bold text-[#FFD699]">
            <Icon name="lucide:award" class="h-4 w-4 text-[#FF9900] shrink-0" aria-hidden="true" />
            <span>Bibit Okulasi Premium • Mudah Tumbuh • Cepat Berbuah Berdompolan!</span>
          </p>
        </div>
      </div>

      <div class="mt-4 flex items-center justify-center gap-3 px-4">
        <div class="flex -space-x-2">
          {testimonials.map((t) => (
            <img src={t.avatar} alt={t.name} class="h-8 w-8 rounded-full border-2 border-white object-cover" width="32" height="32" loading="eager" decoding="async" />
          ))}
        </div>
        <div class="text-left">
          <div class="flex items-center gap-0.5">
            <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
            <span class="ml-1 text-[13px] font-bold text-slate-900">4.9/5</span>
          </div>
          <p class="text-[11px] font-medium text-slate-500">dari 1.800+ pekebun terpuaskan</p>
        </div>
      </div>

      <div class="mt-5 flex justify-center gap-4 px-4">
        <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
          <Icon name="lucide:sprout" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
          Okulasi Genjah
        </span>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
          <Icon name="lucide:shield-check" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
          Garansi Segar
        </span>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
          <Icon name="lucide:truck" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
          Bisa COD
        </span>
      </div>

      <div class="mt-6 border-l-2 border-[#FF9900] px-5 pl-4 text-left">
        <h2 class="text-[15px] font-bold text-slate-950">Bukan sirsak biasa yang butuh bertahun-tahun untuk berbuah.</h2>
        <p class="mt-1 text-[13.5px] leading-relaxed text-slate-600">Dengan menanam 1-2 pot bibit sirsak juara di teras, Anda bisa petik sendiri buah sirsak ratu manis segar sekeluarga.</p>
      </div>
    </section>

    <!-- 3. PAIN CHECKLIST (Sering Mengalami Ini?) -->
    <section class="border-t border-slate-100 bg-red-50/40 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-red-600">Kapok Beli Bibit Asal-Asalan?</span>
      <h2 class={sectionTitle}>Kecewa Tanam Sirsak Lokal <span class="hl-brush">Pohon Jangkung Tapi Mogok Berbuah?</span></h2>
      <p class={`${body} mt-3 mb-6`}>Banyak penggemar tanaman kecewa karena salah memilih bibit generik asal-asalan:</p>
      
      <div class="space-y-4">
        {[
          ['Pohon Raksasa Cuma Rimbun Daun', 'Sudah dirawat bertahun-tahun pohon makin jangkung merusak pekarangan, tapi tidak pernah memunculkan bakal buah.'],
          ['Rasa Buah Masam & Biji Banyak', 'Kalaupun berbuah, dagingnya tipis, rasanya masam kecut pekat, dan bijinya sangat dominan.'],
          ['Bibit Layu & Patah Saat Pengiriman', 'Beli online dari toko asal-asalan membuat media tanam kering dan bibit mati patah di perjalanan tanpa garansi.']
        ].map(([title, desc]) => (
          <div class="flex items-start gap-3.5">
            <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center text-red-600"><Icon name="lucide:x-circle" class="h-5 w-5" aria-hidden="true" /></span>
            <div>
              <h3 class="text-[16px] font-bold text-slate-900">{title}</h3>
              <p class="mt-0.5 text-[15px] leading-relaxed text-slate-600">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. KENAPA PILIH BIBIT SIRSAK MADU JUARA (FOTO 2) -->
    <section class="border-t border-slate-100 bg-slate-950 px-5 py-10 text-white">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#FFD699]">Keunggulan Bibit Okulasi</span>
      <h2 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-white">Kenapa Bibit Sirsak Juara <span class="text-[#FFD699]">Cepat Berbuah Di Pot Pendek?</span></h2>
      <p class="mt-3 text-[16px] leading-relaxed text-slate-400">Teknologi sambung pucuk (okulasi genjah) menyatukan tunas indukan Sirsak Ratu yang produktif ke batang bawah berakar kuat:</p>

      <div class="mt-7 w-full border border-slate-800 rounded-lg overflow-hidden">
        <img fetchpriority="low" src="/images/produk/bibit-sirsak-juara-product.webp"
          alt="Kenapa Pilih Bibit Sirsak Madu Juara Okulasi Premium"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
          width="800"
          height="800"
        />
      </div>

      <div class="relative ml-2 mt-8 space-y-8 border-l border-slate-800 pl-6">
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-white ring-4 ring-slate-950">1</span>
          <h3 class="text-[16px] font-semibold text-[#FFD699]">Genetik Indukan Sirsak Ratu Teruji</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-slate-400">Tunas diambil dari indukan sirsak pilihan yang sudah rutin berbuah manis lebat berukuran jumbo.</p>
        </div>
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-white ring-4 ring-slate-950">2</span>
          <h3 class="text-[16px] font-semibold text-[#FFD699]">Akar Batang Bawah Tahan Panas</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-slate-400">Batang bawah berakar tunggang kuat yang tahan penyakit tanah dan cepat beradaptasi di cuaca Indonesia.</p>
        </div>
      </div>

      <div class="mt-6 rounded-md bg-slate-900 p-4">
        <p class="text-[14px] leading-relaxed text-slate-300"><strong class="text-[#FFD699]">Hasilnya:</strong> Pohon berukuran pendek 1 meter di pot teras sudah mampu memproduksi buah sirsak manis berukuran jumbo!</p>
      </div>
    </section>

    <!-- 5. FOTO ASLI PRODUK, POUCH & DAGING BUAH (FOTO 3 & 4) -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Foto Asli & Kualitas Buah</span>
      <h2 class={sectionTitle}>Daging Super Tebal <span class="hl-brush">Manis Segar 0% Serat</span></h2>
      <p class={`${body} mt-3 mb-6`}>Bisa ditanam anggun di pot teras rumah (tabulampot) maupun pekarangan tanah:</p>

      <div class="w-full mb-5 border border-slate-200 rounded-lg overflow-hidden">
        <img fetchpriority="low" src="/images/produk/bibit-sirsak-juara-pouch.webp"
          alt="Pohon Bibit Sirsak Ratu Berbuah Lebat & Siap Tanam"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
          width="800"
          height="1000"
        />
      </div>
      <p class="text-[12.5px] text-slate-500 mb-6">Pohon pendek di pot teras rumah (tabulampot) yang rajin berbuah lebat berdompolan.</p>

      <div class="w-full mb-4 border border-slate-200 rounded-lg overflow-hidden">
        <img fetchpriority="low" src="/images/produk/bibit-sirsak-juara-harvest.webp"
          alt="Daging Sirsak Madu Juara Tebal Manis Segar 0% Serat"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
          width="500"
          height="500"
        />
      </div>
      <p class="text-[12.5px] text-slate-500">Irisan daging sirsak madu tebal lumer manis segar tanpa serat pekat mengganggu.</p>

      <div class="mt-8 border-t-2 border-[#FFEACC] pt-5">
        <h3 class="flex items-center gap-2 text-[15px] font-bold text-slate-950">
          <Icon name="lucide:shield-check" class="h-4.5 w-4.5 text-[#EC7211]" aria-hidden="true" />
          Spesifikasi Bibit Sirsak Juara
        </h3>
        <div class="mt-3 space-y-2.5 text-[14px] leading-relaxed">
          <p><strong class="font-semibold text-slate-900">Metode perbanyakan:</strong> <span class="text-slate-600">Okulasi / Sambung Pucuk Unggul</span></p>
          <p><strong class="font-semibold text-slate-900">Tinggi bibit dikirim:</strong> <span class="text-slate-600">50 - 60 cm (akar rimbun siap tanam)</span></p>
          <p><strong class="font-semibold text-slate-900">Estimasi berbuah:</strong> <span class="box-decoration-clone bg-[#FFF5E5] px-1.5 pb-0.5 font-semibold text-slate-900">6 - 10 bulan setelah tanam</span></p>
          <p><strong class="font-semibold text-slate-900">Kebutuhan sinar matahari:</strong> <span class="text-slate-600">Penuh sepanjang hari (full sun)</span></p>
        </div>
      </div>
    </section>

    <!-- 6. CARA TANAM (3 Langkah) -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Panduan Praktis</span>
      <h2 class={sectionTitle}>3 Langkah Menanam Sirsak Juara</h2>
      <p class={`${body} mt-3 mb-6`}>Sangat mudah dirawat, cocok untuk pemula dan pekarangan rumah sempit:</p>

      <figure class="overflow-hidden rounded-md ring-1 ring-slate-200">
        <figcaption class="flex items-center gap-2 bg-[#232F3E] px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.18em] text-white">
          <Icon name="lucide:workflow" class="h-4 w-4 shrink-0" aria-hidden="true" />
          3 Langkah Penanaman di Pot
        </figcaption>
        <div class="flex items-start justify-between gap-1 bg-gradient-to-b from-[#FFF5E5]/60 to-white px-3 py-6">
          {[
            ['lucide:package-open', 'Buka Polybag', 'Lepas plastik polybag pelan agar akar tidak rusak'],
            ['lucide:flower-2', 'Tanam Pot', 'Masukkan ke pot ukuran min 40cm dengan media subur'],
            ['lucide:droplets', 'Siram Rutin', 'Siram 1x sehari & tempatkan di lokasi terkena sinar matahari']
          ].map(([icon, title, sub], i, arr) => (
            <>
              <div class="flex-1 text-center">
                <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[#FF9900] text-white">
                  <Icon name={icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <h3 class="mt-2.5 text-[13px] font-bold text-slate-900">{title}</h3>
                <p class="mx-auto mt-0.5 max-w-[110px] text-[11px] leading-tight text-slate-500">{sub}</p>
              </div>
              {i < arr.length - 1 && (
                <Icon name="lucide:chevron-right" class="mt-4 h-5 w-5 shrink-0 text-[#FFD699]" aria-hidden="true" />
              )}
            </>
          ))}
        </div>
      </figure>
    </section>

    <!-- 7. BUKTI PEMBELI & SLIDE TESTIMONI REAL (FOTO 5, 6, 7) -->
    <section class="border-t border-slate-100 bg-[#FFF5E5]/40 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Bukti Panen Pelanggan</span>
      <h2 class={sectionTitle}>Ribuan Orang Sudah <span class="hl-brush">Membuktikan Panennya</span></h2>
      <p class={`${body} mt-3 mb-6`}>Kisah nyata pekebun yang sudah menikmati panen sirsak madu di teras rumah:</p>

      <div class="space-y-6 mb-8">
        <div class="w-full border border-amber-200 rounded-lg overflow-hidden">
          <img fetchpriority="low" src="/images/produk/bibit-sirsak-juara-testi1.webp"
            alt="Bukti Panen Sirsak Madu Juara 1"
            class="w-full h-auto block"
            loading="lazy"
            decoding="async"
            width="800"
            height="800"
          />
        </div>

        <div class="w-full border border-amber-200 rounded-lg overflow-hidden">
          <img fetchpriority="low" src="/images/produk/bibit-sirsak-juara-testi2.webp"
            alt="Bukti Panen Sirsak Madu Juara 2"
            class="w-full h-auto block"
            loading="lazy"
            decoding="async"
            width="800"
            height="800"
          />
        </div>

        <div class="w-full border border-amber-200 rounded-lg overflow-hidden">
          <img fetchpriority="low" src="/images/produk/bibit-sirsak-juara-testi3.webp"
            alt="Bukti Panen Sirsak Madu Juara 3"
            class="w-full h-auto block"
            loading="lazy"
            decoding="async"
            width="800"
            height="800"
          />
        </div>
      </div>

      <div class="space-y-9">
        {testimonials.map((t, index, arr) => (
          <div>
            <div class="flex items-center gap-3">
              <img
                src={t.avatar}
                alt={`Foto ${t.name}, pekebun sirsak`}
                class="h-11 w-11 shrink-0 rounded-full object-cover"
                width="44"
                height="44"
                loading="lazy"
                decoding="async"
              />
              <div class="min-w-0">
                <h3 class="flex items-center gap-1 text-[15px] font-bold text-slate-900">
                  {t.name}
                  <Icon name="lucide:badge-check" class="h-4 w-4 shrink-0 text-[#0073BB]" aria-hidden="true" />
                </h3>
                <p class="text-[11.5px] text-slate-500">{t.location}</p>
              </div>
              <div class="ml-auto flex gap-0.5">
                <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
              </div>
            </div>
            <p class="mt-1.5 text-[12px] font-semibold text-[#B45309]">Masalah: {t.problem}</p>
            <p class="mt-3 border-l-2 border-[#FF9900]/40 pl-3 text-[15px] italic leading-relaxed text-slate-700" set:html={`"${t.comment}"`} />
            <p class="mt-2.5 flex items-center gap-1.5 text-[13px] font-bold text-slate-900">
              <Icon name="lucide:check-circle-2" class="h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
              {t.highlight}
            </p>
            {index < arr.length - 1 && <div class="mt-8 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent" />}
          </div>
        ))}
      </div>
    </section>

    <!-- 8. JUJUR DARI AWAL -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Jujur Dari Awal</span>
      <h2 class={sectionTitle}>Syarat Supaya Pohon Berbuah Maksimal</h2>
      <p class={`${body} mt-3 mb-6`}>Agar tidak salah paham dalam perawatan bibit sirsak juara:</p>

      <div class="space-y-2.5 text-[15px] leading-relaxed">
        <p class="flex items-start gap-2.5">
          <Icon name="lucide:check-circle-2" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Wajib ditempatkan di area <strong class="font-semibold text-slate-900">terkena sinar matahari langsung minimal 6 jam sehari</strong> untuk merangsang pembungaan.</span>
        </p>
        <p class="flex items-start gap-2.5">
          <Icon name="lucide:check-circle-2" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Gunakan pot berdiameter <strong class="font-semibold text-slate-900">minimal 45-50 cm</strong> jika ingin dijadikan tabulampot pot teras.</span>
        </p>
        <p class="mt-4 flex items-start gap-2.5 border-l-2 border-[#FF9900] pl-3">
          <Icon name="lucide:info" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Jika daun sedikit terkulai saat perjalanan ekspedisi, <strong class="font-semibold text-slate-900">siram air & teduhkan 3-4 hari</strong>. Bibit okulasi kami bergaransi hidup dan cepat pulih segar.</span>
        </p>
