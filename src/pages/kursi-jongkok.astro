---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import { tenantConfig } from '../lib/tenant';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('kursi-jongkok-toilet');
if (!product) throw new Error('Product kursi-jongkok-toilet not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = `${tenantConfig.siteUrl}/kursi-jongkok`;
const seoTitle = `KURSI JONGKOK TOILET PORTABLE - ${tenantConfig.name}`;
const seoDescription =
  'Kursi Jongkok Toilet Portable Ergonomis. Sulap toilet jongkok jadi toilet duduk dalam 3 detik tanpa bongkar. Tahan beban 110kg anti selip. Promo Rp 149rb COD.';
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={product.heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Kursi Jongkok Toilet Portable', url: '/kursi-jongkok' },
  ]}
  preloadImages={[
    {
      srcset: '/images/kursi-jongkok/hero-image-400.webp 400w, /images/kursi-jongkok/hero-image-600.webp 600w',
      sizes: '(max-width: 480px) 100vw, 480px',
    },
  ]}
>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950 font-sans shadow-lg">
    <MetaLandingTracker
      slug="kursi-jongkok-toilet"
      productId={product.productId}
      contentName={product.contentName}
      price={product.price}
    />

    <!-- OVERCLAIM HEADLINE HERO SECTION -->
    <section class="px-5 pt-5 pb-4 bg-gradient-to-b from-sky-50 to-white text-center">
      <div
        class="inline-block bg-blue-600 text-white text-[11px] font-black uppercase tracking-widest px-3 py-0.5 rounded-full mb-2.5 shadow-xs"
      >
        ⚡ KURSI TOILET PORTABLE

        <h1 class="text-[clamp(21px,6.5vw,26px)] font-black leading-[1.26] text-slate-950 uppercase tracking-tight">
          SULAP TOILET JONGKOK JADI TOILET DUDUK MEWAH — <span class="text-blue-700 bg-sky-200 px-1.5 py-0.5 rounded"
            >BEBAS NYERI LUTUT!</span
          >
        </h1>

        <p
          class="mt-2.5 text-[14.5px] font-semibold leading-relaxed text-slate-700 bg-white p-3 rounded-xl border border-sky-300 shadow-xs"
        >
          Tanpa bongkar keramik! Super kokoh tahan beban 110 kg, aman &amp; anti selip untuk lansia &amp; ibu hamil.
          Promo 50% COD!
        </p>

        <!-- HERO IMAGE -->
        <div class="mt-4 rounded-2xl overflow-hidden shadow-md border border-slate-200">
          <img
            src="/images/kursi-jongkok/hero-image-600.webp"
            srcset="/images/kursi-jongkok/hero-image-400.webp 400w, /images/kursi-jongkok/hero-image-600.webp 600w"
            sizes="(max-width: 480px) 100vw, 480px"
            alt="Kursi Jongkok Toilet Portable Ergonomis"
            class="w-full h-auto block object-contain mx-auto"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="540"
            height="540"
          />
        </div>
      </div>

      <!-- SECTION 1: DETAIL PRODUK -->
      <section class="px-5 py-6 bg-slate-50 border-t border-slate-200 text-center">
        <h2 class="font-extrabold text-[20px] text-slate-900 mb-4 uppercase tracking-wide">Detail Produk</h2>

        <div class="space-y-4">
          <div class="rounded-xl overflow-hidden shadow-xs border border-slate-200">
            <img
              src="/images/kursi-jongkok/detail-1-600.webp"
              srcset="/images/kursi-jongkok/detail-1-400.webp 400w, /images/kursi-jongkok/detail-1-600.webp 600w"
              sizes="(max-width: 480px) 100vw, 480px"
              alt="Detail Ukuran Kursi Jongkok Toilet"
              class="w-full h-auto block object-contain mx-auto"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              width="540"
              height="540"
            />
          </div>
          <div class="rounded-xl overflow-hidden shadow-xs border border-slate-200">
            <img
              src="/images/kursi-jongkok/detail-2-600.webp"
              srcset="/images/kursi-jongkok/detail-2-400.webp 400w, /images/kursi-jongkok/detail-2-600.webp 600w"
              sizes="(max-width: 480px) 100vw, 480px"
              alt="Detail Sandaran & Dudukan Ergonomis"
              class="w-full h-auto block object-contain mx-auto"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              width="540"
              height="540"
            />
          </div>
          <div class="rounded-xl overflow-hidden shadow-xs border border-slate-200">
            <img
              src="/images/kursi-jongkok/detail-3-600.webp"
              srcset="/images/kursi-jongkok/detail-3-400.webp 400w, /images/kursi-jongkok/detail-3-600.webp 600w"
              sizes="(max-width: 480px) 100vw, 480px"
              alt="Struktur Material Kokoh Anti Selip"
              class="w-full h-auto block object-contain mx-auto"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              width="540"
              height="540"
            />
          </div>
          <div class="rounded-xl overflow-hidden shadow-xs border border-slate-200">
            <img
              src="/images/kursi-jongkok/detail-4-600.webp"
              srcset="/images/kursi-jongkok/detail-4-400.webp 400w, /images/kursi-jongkok/detail-4-600.webp 600w"
              sizes="(max-width: 480px) 100vw, 480px"
              alt="Kepraktisan Penggunaan Di Kloset Jongkok"
              class="w-full h-auto block object-contain mx-auto"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              width="540"
              height="540"
            />
          </div>
        </div>
      </section>

      <!-- SECTION 2: KENAPA PILIH KURSI JONGKOK TOILET? -->
      <section class="px-5 py-6 bg-white border-t border-slate-200">
        <h2 class="font-extrabold text-[21px] text-slate-950 text-center mb-6">Kenapa pilih Kursi Jongkok Toilet?</h2>

        <div class="space-y-6">
          <!-- FEATURE 1 -->
          <div class="bg-sky-50/70 p-4 rounded-2xl border border-sky-200 text-center">
            <div class="rounded-xl overflow-hidden shadow-xs mb-3 border border-sky-200">
              <img
                src="/images/kursi-jongkok/fitur-1-400.webp"
                alt="Struktur & Desain Compact Anti Slip"
                class="w-full h-auto block mx-auto object-contain"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                width="400"
                height="248"
              />
            </div>
            <h3 class="font-black text-[17px] text-slate-900 mb-1.5">Struktur &amp; Desain Compact</h3>
            <p class="text-[14px] leading-relaxed text-slate-700 font-medium">
              Dengan permukaan dudukan bertekstur, ukurannya pas, kokoh dan dilengkapi karet anti slip, biar nggak licin
              dan bebas dari tergelincir.
            </p>
          </div>

          <!-- FEATURE 2 -->
          <div class="bg-sky-50/70 p-4 rounded-2xl border border-sky-200 text-center">
            <div class="rounded-xl overflow-hidden shadow-xs mb-3 border border-sky-200">
              <img
                src="/images/kursi-jongkok/fitur-2-400.webp"
                alt="Kokoh Menahan Beban Hingga 110kg"
                class="w-full h-auto block mx-auto object-contain"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                width="400"
                height="248"
              />
            </div>
            <h3 class="font-black text-[17px] text-slate-900 mb-1.5">Kokoh Menahan Beban Hingga 110kg</h3>
            <p class="text-[14px] leading-relaxed text-slate-700 font-medium">
              Buat bapak-ibu yang lututnya udah lemas karena lanjut usia, buat ibu hamil, nggak bisa jongkok lama,
              sekarang buang air di rumah jadi bisa lebih nyaman dengan produk kami.
            </p>
          </div>

          <!-- FEATURE 3 -->
          <div class="bg-sky-50/70 p-4 rounded-2xl border border-sky-200 text-center">
            <div class="rounded-xl overflow-hidden shadow-xs mb-3 border border-sky-200">
              <img
                src="/images/kursi-jongkok/fitur-3-400.webp"
                alt="Praktis Solutif Tanpa Renovasi Rumah"
                class="w-full h-auto block mx-auto object-contain"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                width="400"
                height="248"
              />
            </div>
            <h3 class="font-black text-[17px] text-slate-900 mb-1.5">Praktis &amp; Solutif</h3>
            <p class="text-[14px] leading-relaxed text-slate-700 font-medium">
              Bisa dibongkar pasang, mudah dibawa bepergian, dan nggak perlu renovasi rumah buat punya toilet yang
              nyaman, cukup satu alat bisa mengatasi masalah.
            </p>
          </div>
        </div>
      </section>

      <!-- SECTION 3: CUSTOMER REVIEWS -->
      <section class="px-5 py-6 bg-slate-50 border-t border-slate-200 text-center">
        <h2 class="font-extrabold text-[20px] text-slate-950 mb-4">Review dari Para Customer</h2>

        <div class="rounded-2xl overflow-hidden shadow-md border border-slate-200">
          <img
            src="/images/kursi-jongkok/testimoni-review-600.webp"
            srcset="/images/kursi-jongkok/testimoni-review-400.webp 400w, /images/kursi-jongkok/testimoni-review-600.webp 600w"
            sizes="(max-width: 480px) 100vw, 480px"
            alt="Testimoni Pelanggan Kursi Jongkok Toilet"
            class="w-full h-auto block object-contain mx-auto"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="540"
            height="650"
          />
        </div>
      </section>

      <!-- SECTION 4: SPECIAL PRICING BOX -->
      <section class="px-5 py-8 bg-gradient-to-b from-amber-50 to-orange-50 text-center border-t border-amber-200">
        <h2 class="text-[20px] font-black text-slate-950">Promo yang bisa kamu dapatkan hari ini!</h2>

        <p class="mt-2 text-[14px] font-bold text-slate-400 line-through">HARGA SEBELUM DISKON Rp. 288.000</p>

        <div
          class="mt-3 inline-block bg-red-600 text-white font-black text-[13px] uppercase tracking-widest px-4 py-1 rounded-full shadow-xs"
        >
          Flash Sale Diskon 50%
        </div>

        <p class="mt-2 text-[13px] font-bold text-red-600">Besok harga kembali normal!!!</p>

        <div
          class="mt-4 p-4 bg-gradient-to-r from-amber-500 to-orange-600 text-white rounded-2xl shadow-xl max-w-[380px] mx-auto border border-amber-300"
        >
          <p class="text-[13px] font-extrabold uppercase tracking-wide text-amber-100">HARGA PROMO HANYA</p>
          <p class="text-[34px] font-black my-1 text-white">Rp. 149.000</p>
        </div>

        <!-- BONUS ITEM -->
        <div class="mt-6 p-4 bg-white rounded-2xl border border-amber-300 text-center shadow-xs">
          <h3 class="font-extrabold text-[15px] text-slate-900 leading-snug">
            Dapatkan bonus 1 item menarik dibawah ini, kami kirim acak di setiap pemesanan
          </h3>
          <div class="mt-3 rounded-xl overflow-hidden border border-slate-200">
            <img
              src="/images/kursi-jongkok/bonus-item-600.webp"
              srcset="/images/kursi-jongkok/bonus-item-400.webp 400w, /images/kursi-jongkok/bonus-item-600.webp 600w"
              sizes="(max-width: 480px) 100vw, 480px"
              alt="Bonus Spesial Setiap Pemesanan"
              class="w-full h-auto block object-contain mx-auto"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              width="540"
              height="166"
            />
          </div>
        </div>
      </section>

      <!-- ORDER FORM SECTION -->
      <section id="order-form" class="bg-white border-t border-slate-200">
        <!-- SCALEV ORDER FORM INTEGRATION -->
        <GeoIpResolvedForm mode={formContext.mode} productSlug="kursi-jongkok-toilet" embedded={true} />
      </section>

      <!-- SOCIAL PROOF NOTIFICATION -->
      <SocialProof productSlug="kursi-jongkok-toilet" />

      <!-- FOOTER & GUARANTEE IMAGES -->
      <section class="px-5 py-6 bg-slate-900 text-white text-center border-t border-slate-800">
        <div class="space-y-4 mb-6">
          <div class="overflow-hidden rounded-xl shadow-md border border-slate-800">
            <img
              src="/images/kursi-jongkok/garansi-banner-600.webp"
              srcset="/images/kursi-jongkok/garansi-banner-400.webp 400w, /images/kursi-jongkok/garansi-banner-600.webp 600w"
              sizes="(max-width: 480px) 100vw, 480px"
              alt="Garansi Kepuasan Pelanggan 100%"
              class="w-full h-auto block object-contain mx-auto"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              width="540"
              height="141"
            />
          </div>
        </div>

        <LpMiniFooter />
      </section>

      <!-- STICKY BOTTOM CTA -->
      <StickyCTA productSlug="kursi-jongkok-toilet" />
    </section>
  </main>
</BaseLayout>
