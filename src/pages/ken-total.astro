    <!-- ═══ 7. INFOGRAPHIC KANDUNGAN & BUKTI KEHARMONISAN ═══ -->
    <section class="border-t border-slate-100 bg-[#F8FAFC] px-4 py-8 space-y-4">
      <div class="text-center mb-2">
        <h2 class={sectionTitle}>Kandungan Alami &amp; Rasa Nikmat</h2>
