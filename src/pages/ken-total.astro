      <!-- Comparative Breakdown Cards -->
      <div class="mt-5 grid grid-cols-2 gap-3">
        <!-- SEBELUM -->
        <div class="rounded-xl border border-red-900/60 bg-red-950/40 p-3.5 text-left">
