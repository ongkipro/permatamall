  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950 pb-12 font-sans antialiased selection:bg-red-600 selection:text-white overflow-x-hidden">
    <MetaLandingTracker
      slug={SLUG}
      contentId={defaultCatalogContentId(product)}
      contentName={product.contentName}
      price={price}
