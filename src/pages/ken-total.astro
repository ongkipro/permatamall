const sectionTitle = 'text-[clamp(1.25rem,5.2vw,1.5rem)] font-black leading-tight tracking-tight text-slate-950 text-balance';
const sectionSubtitle = 'text-[clamp(0.85rem,3.6vw,0.925rem)] text-slate-600 mt-1 leading-relaxed';

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;

const maleBuyers = [
  { name: 'Pak Hendra Wijaya', location: 'Jakarta Selatan', time: 'Baru saja', avatar: '/assets/landing/ken-total/avatar-2.webp' },
  { name: 'Mas Dimas Prasetyo', location: 'Surabaya, Jatim', time: '1 mnt lalu', avatar: '/assets/landing/ken-total/avatar-1.webp' },
  { name: 'Pak Gunawan Santoso', location: 'Bandung, Jabar', time: '3 mnt lalu', avatar: '/assets/landing/ken-total/avatar-2.webp' },
  { name: 'Bapak Bambang Triyono', location: 'Medan, Sumut', time: '2 mnt lalu', avatar: '/assets/landing/ken-total/avatar-4.webp' },
  { name: 'Mas Rizky Pratama', location: 'Semarang, Jateng', time: '5 mnt lalu', avatar: '/assets/landing/ken-total/avatar-3.webp' },
  { name: 'Pak Agus Salim', location: 'Tangerang, Banten', time: 'Baru saja', avatar: '/assets/landing/ken-total/avatar-6.webp' },
  { name: 'Bapak Yusuf Hidayat', location: 'Makassar, Sulsel', time: '1 mnt lalu', avatar: '/assets/landing/ken-total/avatar-5.webp' },
  { name: 'Mas Eko Wahyudi', location: 'Balikpapan, Kaltim', time: 'Baru saja', avatar: '/assets/landing/ken-total/avatar-1.webp' },
  { name: 'Pak Taufik Hidayat', location: 'Cirebon, Jabar', time: '6 mnt lalu', avatar: '/assets/landing/ken-total/avatar-2.webp' },
  { name: 'Bapak Irfan Maulana', location: 'Padang, Sumbar', time: '2 mnt lalu', avatar: '/assets/landing/ken-total/avatar-5.webp' },
  { name: 'Mas Fauzi Rahman', location: 'Banjarmasin, Kalsel', time: '3 mnt lalu', avatar: '/assets/landing/ken-total/avatar-3.webp' },
  { name: 'Pak Salman Kusuma', location: 'Serang, Banten', time: '7 mnt lalu', avatar: '/assets/landing/ken-total/avatar-4.webp' },
  { name: 'Mas Bayu Anggoro', location: 'Yogyakarta, DIY', time: '1 mnt lalu', avatar: '/assets/landing/ken-total/avatar-1.webp' },
  { name: 'Pak Doni Kurniawan', location: 'Palembang, Sumsel', time: '4 mnt lalu', avatar: '/assets/landing/ken-total/avatar-2.webp' },
  { name: 'Mas Andika Putra', location: 'Denpasar, Bali', time: '2 mnt lalu', avatar: '/assets/landing/ken-total/avatar-3.webp' },
