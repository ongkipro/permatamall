          <div class="px-2">
            <span class="block text-[18px]">🚚</span>
            <span class="text-[12px] font-extrabold text-slate-900">Bisa COD</span>
            <p class="text-[10.5px] text-slate-500 font-medium">Bayar di Tempat</p>
          </div>
          <div class="px-2">
            <span class="block text-[18px]">🔒</span>
            <span class="text-[12px] font-extrabold text-slate-900">Privasi Rapat</span>
            <p class="text-[10.5px] text-slate-500 font-medium">Paket Polos Tertutup</p>
          </div>
          <div class="px-2">
            <span class="block text-[18px]">⭐</span>
            <span class="text-[12px] font-extrabold text-slate-900">Rating 4.9/5</span>
            <p class="text-[10.5px] text-slate-500 font-medium">4.200+ Box Terjual</p>
