---
/*
 * Native Astro landing page — Ken+total Minuman Serbuk Khusus Pria Dewasa.
 *
 * High-Converting Direct-Response (DR) Conversion Engine.
 * Features:
 * - High-Contrast Visuals & Real BPOM Evidence (MD 272882000100292)
 * - Before vs After Transformation Comparison
 * - 5-Second Auto-Sliding WhatsApp Chat Testimonial Carousel with Progress Bar & Dot Navigation
 * - 6 Verified All-Male Customer Reviews with Authentic Male Portraits
 * - Real Product Unboxing Gallery & Accurate Ken+total Serving Action Banner
 * - Native Hybrid COD Checkout & All-Male Realtime Social Proof Toast with Male Profile Photos
 * - 100% Native Cloudflare R2 Streaming (/assets/landing/ken-total/...).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';
import '../styles/landing-pages/ken-total.css';

export const prerender = false;

const SLUG = 'ken-total';
const PRODUCT_SLUG = 'ken-total-minuman-serbuk-khusus-pria-dewasa';

const product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);
if (!product) return Astro.rewrite('/404');

const formContext = await resolveFormModeContext(Astro.request);

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const seoTitle = 'Ken+total Minuman Serbuk Pria Dewasa — Stamina Kuat, Keras & Tahan Lama (BPOM Resmi)';
const seoDescription =
  'Ken+total formula herbal BPOM resmi (MD272882000100292) dengan ekstrak Ginseng Korea & Blackcurrant. Reaksi cepat, bikin stamina perkasa, ereksi kokoh, dan tahan lama tanpa efek berdebar. Bisa COD & Privasi 100% Aman.';

const sectionTitle = 'text-[24px] font-extrabold leading-[1.15] tracking-tight text-slate-950';
const body = 'text-[15px] leading-relaxed text-slate-700';
const dangerIcon = 'mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-[#DC2626]';

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;

const maleBuyers = [
  { name: 'Pak Hendra Wijaya', location: 'Jakarta Selatan', time: 'Baru saja', avatar: '/assets/landing/ken-total/avatar-2.webp' },
  { name: 'Mas Dimas Prasetyo', location: 'Surabaya, Jatim', time: '1 mnt lalu', avatar: '/assets/landing/ken-total/avatar-1.webp' },
  { name: 'Pak Gunawan Santoso', location: 'Bandung, Jabar', time: '3 mnt lalu', avatar: '/assets/landing/ken-total/avatar-2.webp' },
  { name: 'Bapak Bambang Triyono', location: 'Medan, Sumut', time: '2 mnt lalu', avatar: '/assets/landing/ken-total/avatar-4.webp' },
  { name: 'Mas Rizky Pratama', location: 'Semarang, Jateng', time: '5 mnt lalu', avatar: '/assets/landing/ken-total/avatar-3.webp' },
  { name: 'Pak Agus Salim', location: 'Tangerang, Banten', time: 'Baru saja', avatar: '/assets/landing/ken-total/avatar-6.webp' },
  { name: 'Bapak Yusuf Hidayat', location: 'Makassar, Sulsel', time: '1 mnt lalu', avatar: '/assets/landing/ken-total/avatar-5.webp' },
  { name: 'Mas Eko Wahyudi', location: 'Balikpapan, Kaltim', time: 'Baru saja', avatar: '/assets/landing/ken-total/avatar-1.webp' },
  { name: 'Pak Taufik Hidayat', location: 'Cirebon, Jabar', time: '6 mnt lalu', avatar: '/assets/landing/ken-total/avatar-2.webp' },
  { name: 'Bapak Irfan Maulana', location: 'Padang, Sumbar', time: '2 mnt lalu', avatar: '/assets/landing/ken-total/avatar-5.webp' },
  { name: 'Mas Fauzi Rahman', location: 'Banjarmasin, Kalsel', time: '3 mnt lalu', avatar: '/assets/landing/ken-total/avatar-3.webp' },
  { name: 'Pak Salman Kusuma', location: 'Serang, Banten', time: '7 mnt lalu', avatar: '/assets/landing/ken-total/avatar-4.webp' },
  { name: 'Mas Bayu Anggoro', location: 'Yogyakarta, DIY', time: '1 mnt lalu', avatar: '/assets/landing/ken-total/avatar-1.webp' },
  { name: 'Pak Doni Kurniawan', location: 'Palembang, Sumsel', time: '4 mnt lalu', avatar: '/assets/landing/ken-total/avatar-2.webp' },
  { name: 'Mas Andika Putra', location: 'Denpasar, Bali', time: '2 mnt lalu', avatar: '/assets/landing/ken-total/avatar-3.webp' },
  { name: 'Bapak Herman Susilo', location: 'Malang, Jatim', time: '5 mnt lalu', avatar: '/assets/landing/ken-total/avatar-4.webp' },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image="/assets/landing/ken-total/hero-action.webp"
  preloadImages="/assets/landing/ken-total/hero-action.webp"
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950 pb-24 font-sans antialiased selection:bg-red-500 selection:text-white">
    <MetaLandingTracker
      slug={SLUG}
      contentId={defaultCatalogContentId(product)}
      contentName={product.contentName}
      price={price}
    />

    <!-- ═══ 1. TOP ANNOUNCEMENT / URGENCY STRIP ═══ -->
    <div class="sticky top-0 z-30 bg-gradient-to-r from-red-950 via-neutral-950 to-red-950 px-3 py-2 text-center text-white shadow-md">
      <p class="text-[12px] font-bold tracking-wide flex items-center justify-center gap-1.5">
        <span class="inline-block animate-pulse text-amber-300">🔥 PROMO DISKON S/D 50%</span>
        <span class="text-slate-400">|</span>
        <span class="text-white">BAYAR DI TEMPAT <span class="bg-amber-400 text-black px-1.5 py-0.5 rounded text-[10px] uppercase font-black">BISA COD</span></span>
      </p>
    </div>

    <!-- ═══ 2. HERO SECTION (HIGH-CONVERTING HOOK) ═══ -->
