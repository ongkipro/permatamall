      <div class="px-5 pt-6">
        <!-- BPOM & Authentic Trust Badge -->
        <div class="flex items-center gap-2 mb-3">
          <span class="inline-flex items-center gap-1 rounded-md bg-red-100 border border-red-300 px-2.5 py-1 text-[11px] font-extrabold uppercase tracking-wider text-red-950">
            <span class="h-2 w-2 rounded-full bg-red-600 animate-ping"></span>
            BPOM RI MD272882000100292
          </span>
          <span class="inline-flex items-center rounded-md bg-emerald-100 border border-emerald-300 px-2 py-1 text-[11px] font-extrabold text-emerald-950">
            100% HERBAL ASLI
          </span>
        </div>

        <h1 class="text-[28px] font-black leading-[1.15] tracking-tight text-slate-950">
          Sering Loyo, Cepat Keluar &amp; Kurang Keras? <span
            class="box-decoration-clone px-1 text-white bg-gradient-to-r from-red-700 via-red-800 to-red-900 rounded"
            >Ken+total: Sekali Seduh Bikin Stamina Perkasa &amp; On Terus Tanpa Kendor!</span
          >
        </h1>

        <p class="mt-4 text-[15px] font-semibold leading-relaxed text-slate-800">
          Ekstrak <strong class="text-red-700 font-bold underline">Ginseng Merah Korea &amp; Blackcurrant Segar</strong> — melancarkan peredaran darah, mendongkrak ketegasan ereksi, dan bikin tahan lama beronde-ronde <span class="bg-amber-200 px-1 text-slate-950 font-bold">tanpa bikin jantung berdebar atau kepala pusing.</span>
        </p>
      </div>

      <!-- Hero Visual with High Impact Energy Aura -->
      <div class="relative mt-5">
        <div class="relative overflow-hidden border-y-2 border-red-900 bg-black shadow-[0_16px_36px_rgba(220,38,38,0.25)]">
          <img
            src="/assets/landing/ken-total/hero-action.webp"
            alt="Ken+total Solusi Ampuh Pria Tangguh Dengan Ginseng Korea"
            class="aspect-[16/9] w-full object-cover"
            width="800"
            height="450"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
        </div>

        <!-- Floating Glassmorphic Benefit Card -->
        <div
          class="relative z-20 mx-auto -mt-6 w-[92%] rounded-2xl border-2 border-red-300 bg-white/95 p-4 text-left shadow-[0_14px_34px_rgba(185,28,28,0.2)] backdrop-blur-md"
