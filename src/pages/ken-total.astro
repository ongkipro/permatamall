  <script slot="head" is:inline>
    function initStickyBarObserver() {
      const stickyBar = document.getElementById('sticky-purchase-bar');
      const orderForm = document.getElementById('form-pemesanan');
      const hero = document.getElementById('landing-hero');
      if (!stickyBar) return;

      let heroVisible = true;
      let formVisible = false;

      const applyStickyVisibility = () => {
        if (heroVisible || formVisible) {
          stickyBar.style.transform = 'translateY(100%)';
          stickyBar.style.opacity = '0';
          stickyBar.style.pointerEvents = 'none';
        } else {
          stickyBar.style.transform = 'translateY(0)';
          stickyBar.style.opacity = '1';
          stickyBar.style.pointerEvents = 'auto';
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.target === hero) heroVisible = entry.isIntersecting;
            if (entry.target === orderForm) formVisible = entry.isIntersecting;
          });
          applyStickyVisibility();
        },
        { threshold: 0.05, rootMargin: '0px 0px -40px 0px' }
      );

      if (hero) observer.observe(hero);
      if (orderForm) observer.observe(orderForm);
      applyStickyVisibility();
    }

    function initWaProofSlider() {
      const track = document.getElementById('wa-slider-track');
      const dots = document.querySelectorAll('.wa-dot');
      const prevBtn = document.getElementById('wa-slide-prev');
      const nextBtn = document.getElementById('wa-slide-next');
      const progressBar = document.getElementById('wa-progress-bar');
      if (!track) return;

      const slides = track.querySelectorAll('[data-wa-slide]');
      const totalSlides = slides.length;
      if (totalSlides <= 1) return;

      let currentIndex = 0;
      let autoSlideTimer = null;
      let progressTimer = null;
      let progressVal = 0;
      const INTERVAL_MS = 5000; // 5 detik per slide

      const resetProgress = () => {
        if (progressTimer) clearInterval(progressTimer);
        progressVal = 0;
        if (progressBar) progressBar.style.width = '0%';
        progressTimer = setInterval(() => {
          progressVal += 2;
          if (progressBar) progressBar.style.width = `${Math.min(progressVal, 100)}%`;
          if (progressVal >= 100) {
            clearInterval(progressTimer);
          }
        }, 100);
      };

      const updateUI = (index) => {
        currentIndex = (index + totalSlides) % totalSlides;
        const targetSlide = slides[currentIndex];
        if (targetSlide) {
          track.scrollTo({
            left: targetSlide.offsetLeft,
            behavior: 'smooth',
          });
        }
        dots.forEach((dot, i) => {
          if (i === currentIndex) {
            dot.classList.remove('w-1.5', 'bg-slate-300');
            dot.classList.add('w-4', 'bg-red-600');
          } else {
            dot.classList.remove('w-4', 'bg-red-600');
            dot.classList.add('w-1.5', 'bg-slate-300');
          }
        });
        resetProgress();
      };

      const startAutoSlide = () => {
        stopAutoSlide();
        resetProgress();
        autoSlideTimer = setInterval(() => {
          updateUI(currentIndex + 1);
        }, INTERVAL_MS);
      };

      const stopAutoSlide = () => {
        if (autoSlideTimer) {
          clearInterval(autoSlideTimer);
          autoSlideTimer = null;
        }
        if (progressTimer) {
          clearInterval(progressTimer);
          progressTimer = null;
        }
      };

      prevBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        updateUI(currentIndex - 1);
        startAutoSlide();
      });

      nextBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        updateUI(currentIndex + 1);
        startAutoSlide();
      });

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          e.preventDefault();
          const idx = parseInt(dot.getAttribute('data-index') || '0', 10);
          updateUI(idx);
          startAutoSlide();
        });
      });

      // Synchronize active dot when user manually swipes track
      let scrollTimeout;
      track.addEventListener('scroll', () => {
        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          const scrollLeft = track.scrollLeft;
          let closestIdx = 0;
          let minDiff = Infinity;
          slides.forEach((slide, idx) => {
            const diff = Math.abs(slide.offsetLeft - scrollLeft);
            if (diff < minDiff) {
              minDiff = diff;
              closestIdx = idx;
            }
          });
          if (closestIdx !== currentIndex) {
            currentIndex = closestIdx;
            dots.forEach((dot, i) => {
              if (i === currentIndex) {
                dot.classList.remove('w-1.5', 'bg-slate-300');
                dot.classList.add('w-4', 'bg-red-600');
              } else {
                dot.classList.remove('w-4', 'bg-red-600');
                dot.classList.add('w-1.5', 'bg-slate-300');
              }
            });
            resetProgress();
          }
        }, 80);
      });

      // Pause on hover/touch and resume on leave
      track.addEventListener('mouseenter', stopAutoSlide);
      track.addEventListener('mouseleave', startAutoSlide);
      track.addEventListener('touchstart', stopAutoSlide, { passive: true });
      track.addEventListener('touchend', startAutoSlide);

      startAutoSlide();
    }

    function initCountdownTimer() {
      const minEl = document.getElementById('countdown-minutes');
      const secEl = document.getElementById('countdown-seconds');
      if (!minEl || !secEl) return;

      const STORAGE_KEY = 'kt_promo_countdown_target';
      let targetTime = parseInt(sessionStorage.getItem(STORAGE_KEY) || '0', 10);
      const now = Date.now();

      // If no valid stored target or target has passed, initialize fresh 15-minute countdown (900 seconds)
      if (!targetTime || targetTime <= now || targetTime - now > 15 * 60 * 1000) {
        targetTime = now + 15 * 60 * 1000;
        sessionStorage.setItem(STORAGE_KEY, targetTime.toString());
      }

      const updateTimer = () => {
        const remainingMs = Math.max(0, targetTime - Date.now());
        const totalSeconds = Math.floor(remainingMs / 1000);

        if (totalSeconds <= 0) {
          // Reset to fresh 15 minutes
          targetTime = Date.now() + 15 * 60 * 1000;
          sessionStorage.setItem(STORAGE_KEY, targetTime.toString());
        }

        const mins = Math.floor(totalSeconds / 60);
        const secs = totalSeconds % 60;

        minEl.textContent = String(mins).padStart(2, '0');
        secEl.textContent = String(secs).padStart(2, '0');
      };

      updateTimer();
      setInterval(updateTimer, 1000);
    }

    const initAll = () => {
      initStickyBarObserver();
      initWaProofSlider();
      initCountdownTimer();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  </script>
