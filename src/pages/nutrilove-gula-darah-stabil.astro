---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { recentOrderCount } from '../lib/social-proof';
import { getStorefrontProduct, getStorefrontProducts } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { nativeLandingProductJsonLd } from '../lib/native-landing-product';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import {
  loadStoreCodDisabledProvinceCodes,
  resolveFormModeContext,
} from '../lib/form-mode';
import { getRuntimeEnv } from '../lib/env';
import type { Product } from '../data/products';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';

export const prerender = false;

const SLUG = 'nutrilove-gula-darah-stabil';
const PRODUCT_SLUG = 'cuka-sari-apel-100-original';

let product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);

// Fallback preview product to ensure seamless preview/standalone renders even before D1 sync
if (!product) {
  const [firstProduct] = await getStorefrontProducts(Astro.locals);
  product = firstProduct ?? {
    productId: '17981',
    slug: PRODUCT_SLUG,
    productName: 'NutriLove Cuka Apel 100% Original With The Mother',
    contentName: 'NutriLove Cuka Apel 100% Original With The Mother',
    headline: 'Paket Terapi Alami Gula Darah Stabil, Bebas Ngantuk & Kencing Malam',
    subheadline: 'Cuka Sari Apel Murni With The Mother (Beli 1 Gratis 3 Botol)',
    seoTitle: 'NutriLove Cuka Apel With The Mother — Solusi Alami Ngantuk Habis Makan, Kencing Malam & Gula Darah',
    seoDescription: 'Sering ngantuk berat habis makan nasi, bolak-balik kencing tengah malam, dan telapak kaki kebas kesemutan? Terapi alami NutriLove Cuka Apel With The Mother bantu redam lonjakan gula darah.',
    price: 97500,
    comparePrice: 199000,
    image: '/images/landing/nutrilove-cuka-apel/gula-darah-hero-brutal.webp',
    heroImage: '/images/landing/nutrilove-cuka-apel/gula-darah-hero-brutal.webp',
    category: 'Kesehatan',
    brand: 'NutriLove',
    relatedCategories: ['Kesehatan', 'Herbal'],
    description: 'Cuka Apel fermentasi alami with The Mother ukuran 500ml untuk membantu meredam lonjakan gula darah sehabis makan dan melancarkan sirkulasi saraf tepi.',
    benefits: [
      'Redam lonjakan gula darah sehabis makan nasi/manis',
      'Bebas ngantuk berat (food coma) dan lemas siang hari',
      'Kurangi bolak-balik kencing tengah malam & kebas kaki',
      'Fermentasi alami with The Mother tanpa pemanasan',
    ],
    keyPoints: [
      'Isi 500ml per botol',
      'Promo Beli 1 Gratis 3 (Total 4 Botol / 2.000 ml)',
      'Gratis Ongkir Se-Pulau Jawa & Bisa COD Seluruh Indonesia',
    ],
    idealFor: ['Pria dan wanita usia 40+ yang sering mengantuk berat habis makan nasi, sering kencing malam, kaki kebas kesemutan, dan ingin menjaga gula darah tetap stabil'],
    offerText: 'PROMO SPESIAL: BELI 1 GRATIS 3 (Total 4 Botol / 2.000 ml) Hanya Rp 97.500 • GRATIS ONGKIR SE-PULAU JAWA',
    ctaText: 'Pesan Sekarang (COD)',
    ratingValue: 4.9,
    reviewCount: 4120,
    soldCount: 6200,
    reviews: [],
    variants: [
      { id: '12', sku: 'BELI_2_GRATIS_2', label: 'BELI 1 GRATIS 3 (Dapat 4 Botol)', price: 97500, comparePrice: 199000 },
      { id: '13', sku: 'PAKET_6_BOTOL', label: 'PAKET 6 Botol (Hemat 50%)', price: 199000, comparePrice: 398000 },
    ],
  } as Product;
}

// Enforce exactly 2 packages: Beli 1 Gratis 3 (Total 4 Botol Rp 97.500) and Paket 6 Botol (Rp 199.000)
if (product) {
  product = {
    ...product,
    variants: [
      { id: '12', sku: 'BELI_2_GRATIS_2', label: 'BELI 1 GRATIS 3 (Dapat 4 Botol)', price: 97500, comparePrice: 199000 },
      { id: '13', sku: 'PAKET_6_BOTOL', label: 'PAKET 6 Botol (Hemat 50%)', price: 199000, comparePrice: 398000 },
    ],
  };
}

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const codDisabledProvinceCodes = await loadStoreCodDisabledProvinceCodes(database);
const formContext = await resolveFormModeContext(
  Astro.request,
  codDisabledProvinceCodes,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price ?? 97500;
const comparePrice = cheapest?.comparePrice ?? product.comparePrice ?? 199000;

const defaultUpsellVariantId = '13';

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;

const testimonials = [
  {
    name: 'Pak Hendro (56 th)',
    city: 'Surabaya',
    occupation: 'Pensiunan BUMN',
    rating: 5,
    highlight: 'gula darah puasa saya stabil di angka 108 dan tidur malam pulas gak bolak-balik ke kamar mandi lagi',
    quote: 'Dulu setiap habis makan siang rasanya mata berat sekali kayak dibius, malamnya tidur kebangun sampai 4 kali buat kencing, telapak kaki juga sering panas kesemutan. Terakhir cek gula darah sewaktu sempat tembus 235. Sejak rutin minum 1 sendok NutriLove campur air hangat sebelum makan, gula darah puasa saya stabil di angka 108 dan tidur malam pulas gak bolak-balik ke kamar mandi lagi!',
    image: '/images/landing/nutrilove-cuka-apel/testimoni-pak-hendro.webp',
  },
  {
    name: 'Ibu Wahyuni (48 th)',
    city: 'Solo',
    occupation: 'Ibu Rumah Tangga',
    rating: 5,
    highlight: 'kebas kesemutan di jari tangan dan telapak kaki hilang tuntas',
    quote: 'Tiap bangun subuh telapak kaki rasanya tebal kayak menginjak pasir dan jari tangan kaku kesemutan. Mau minum obat kimia terus takut kena ginjal. Alhamdulillah setelah rutin 3 minggu minum NutriLove yang ada endapan The Mother-nya ini, badan enteng seharian dan kebas kesemutan di jari tangan dan telapak kaki hilang tuntas.',
    image: '/images/landing/nutrilove-cuka-apel/testimoni-ibu-wahyuni.webp',
  },
  {
    name: 'Pak Bambang (52 th)',
    city: 'Semarang',
    occupation: 'Wiraswasta',
    rating: 5,
    highlight: 'habis makan nasi gak pernah ngantuk lemas lagi dan tengkuk leher langsung plong',
    quote: 'Kalau siang habis makan nasi padang pasti langsung lemas ngantuk berat dan tengkuk belakang kencang. Saya ambil Paket 6 Botol Rp 199.000 buat stok di rumah dan toko. Sekarang setiap sebelum makan saya minum 1 gelas, habis makan nasi gak pernah ngantuk lemas lagi dan tengkuk leher langsung plong!',
    image: '/images/landing/nutrilove-cuka-apel/testimoni-pak-bambang.webp',
  },
];

const sectionTitle = 'text-[clamp(21px,6.5vw,25px)] font-black text-slate-950 tracking-normal leading-[1.22]';
const sectionLead = 'text-[13.5px] sm:text-[14px] text-slate-600 leading-relaxed mt-2 max-w-[420px] mx-auto';
const socialProofOrders = await recentOrderCount(getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined);
---

<BaseLayout
  title="NutriLove Cuka Apel With The Mother — Solusi Alami Ngantuk Habis Makan, Kencing Malam & Gula Darah Stabil"
  description="Sering ngantuk berat habis makan nasi, bolak-balik kencing tengah malam, dan telapak kaki kebas kesemutan? Terapi alami NutriLove Cuka Apel With The Mother bantu kunci lonjakan gula darah."
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  image="/images/landing/nutrilove-cuka-apel/gula-darah-hero-brutal.webp"
  preloadImages="/images/landing/nutrilove-cuka-apel/gula-darah-hero-brutal.webp"
  product={nativeLandingProductJsonLd(product, canonical)}
>

  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={price}
  />

  <style is:global>
    .trust-strip i {
      font-size: 12px !important;
    }
    .total-box small,
    .district-item small,
    .payment-block-anchor small {
      font-size: 12px !important;
    }
  </style>

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-12 font-sans text-slate-900 shadow-2xl selection:bg-[#0F2F1F] selection:text-white antialiased">
    
    <!-- ═══ 1. URGENCY ANNOUNCEMENT BAR (TOP) ═══ -->
    <header class="flex items-center justify-between gap-2 border-b border-emerald-950 bg-[#0F2F1F] px-3.5 py-2 text-white shadow-xs">
      <div class="flex items-center gap-1.5 text-[12px] font-extrabold tracking-wide min-w-0">
        <span class="flex h-2 w-2 relative shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
        </span>
        <span class="text-amber-300 font-black uppercase shrink-0">PROMO:</span>
        <span class="text-slate-100 font-extrabold whitespace-nowrap">BELI 1 GRATIS 3 (4 BTL)</span>
      </div>
      <span class="whitespace-nowrap text-[12px] font-black tracking-wider text-amber-300 bg-emerald-800/90 px-2.5 py-0.5 rounded-full border border-emerald-600/60 shadow-xs shrink-0">
        GRATIS ONGKIR P. JAWA
      </span>
    </header>

    <!-- ═══ 2. HERO SECTION (BRUTAL OVERCLAIM GULA DARAH & NGANTUK HABIS MAKAN) ═══ -->
    <section id="landing-hero" class="bg-white text-center pb-8">
      <div class="px-4 sm:px-5 pt-5 sm:pt-6">
        
        <!-- Star Rating Social Proof -->
        <div class="mb-3 inline-flex items-center justify-center gap-1.5 text-[12px] font-bold text-slate-800 bg-emerald-50/90 px-3 py-1 rounded-full border border-emerald-200/80 shadow-2xs">
          <div class="flex items-center gap-0.5 shrink-0 text-amber-400 text-[13px] leading-none" role="img" aria-label="Rating 5 dari 5 bintang">
            ★ ★ ★ ★ ★
          </div>
          <span class="text-slate-900 font-extrabold">4.9 / 5.0</span>
          <span class="text-slate-400">•</span>
          <span class="text-slate-600 font-medium">(6.200+ Paket Terkirim)</span>
        </div>

        <!-- Main Impact Brutal Overclaim Headline (under 10 words, normal tracking) -->
        <h1 class="mx-auto max-w-[440px] text-[clamp(21px,6.8vw,26px)] font-black leading-[1.24] tracking-normal text-slate-950">
          Habis Makan Nasi Langsung Ngantuk Berat &amp; <span class="box-decoration-clone rounded-[0.18em] bg-red-100 text-red-700 px-1.5 py-0.5">Kencing Malam?</span>
        </h1>

        <!-- Subtitle (< 60 words for first viewport) -->
        <p class="mx-auto mt-2 max-w-[420px] text-[14px] leading-relaxed text-slate-600">
          Redam lonjakan gula darah sehabis makan nasi dengan <strong class="text-slate-950 font-bold">NutriLove Cuka Apel With The Mother</strong>. Cegah kebas kesemutan dan nikmati tidur pulas tanpa bolak-balik kencing.
        </p>

        <!-- ═══ HIGH-CONVERSION VALUE BANNER ═══ -->
        <div class="mx-auto mt-4 w-full max-w-[420px] rounded-xl bg-[#0F2F1F] p-3 text-center text-white shadow-sm border border-amber-400/50">
          <p class="text-[14px] sm:text-[15px] font-black uppercase tracking-wide text-amber-300 leading-tight">
            PROMO: BELI 1 GRATIS 3 (TOTAL 4 BOTOL)
          </p>
          <div class="mt-1.5 flex flex-wrap items-center justify-center gap-x-2 gap-y-0.5 text-[12px] font-bold text-slate-200">
            <span class="text-amber-300">Gratis Ongkir Se-Pulau Jawa</span>
            <span class="text-amber-400 font-black">•</span>
            <span>Bisa COD</span>
            <span class="text-amber-400 font-black">•</span>
            <span>Gratis Sloki Takar</span>
          </div>
        </div>
      </div>

      <!-- ═══ FULL-WIDTH HERO BRUTAL OVERCLAIM BANNER (RATIO 4:3) ═══ -->
      <div class="mt-5 relative w-full overflow-hidden bg-slate-950 aspect-[4/3] shadow-md border-y border-red-950">
        <img
          src="/images/landing/nutrilove-cuka-apel/gula-darah-hero-brutal.webp"
          alt="Bahaya Darah Kental Tinggi Gula & Plak vs Terapi Alami NutriLove Cuka Apel With The Mother"
          class="h-full w-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1200"
          height="896"
        />

        <div class="absolute top-3 left-3 bg-slate-950/90 text-red-400 text-[12px] font-black uppercase tracking-wider px-2.5 py-1 rounded-md shadow-md border border-red-500/40">
          ⚠ LONJAKAN GULA
        </div>

        <div class="absolute top-3 right-3 bg-red-600 text-white text-[12px] font-black uppercase tracking-wider px-2.5 py-1 rounded-md shadow-md border border-white/20">
          BELI 1 GRATIS 3
        </div>

        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/95 via-slate-950/80 to-transparent px-3 pt-8 pb-2.5 text-center">
          <p class="text-[12px] sm:text-[13px] font-medium text-amber-300 leading-tight">
            Kunci Lonjakan Gula Habis Makan • Cegah Kebas Kesemutan &amp; Kencing Malam
          </p>
        </div>
      </div>

      <!-- Above-the-Fold Primary CTA + Fold Sentinel -->
      <div class="mt-4 px-4 sm:px-5">
        <a
          href="#form-pemesanan"
          class="flex w-full min-h-[50px] items-center justify-center gap-2 rounded-xl bg-red-600 hover:bg-red-700 px-4 py-3 text-[14px] sm:text-[15px] font-bold tracking-normal text-white shadow-lg shadow-red-600/25 transition-colors active:scale-[0.99]"
        >
          <span>Ambil Promo Beli 1 Gratis 3 (Gratis Ongkir P. Jawa)</span>
          <span aria-hidden="true">↓</span>
        </a>
        <p class="mt-1.5 text-[12px] text-slate-500">
          Bayar di Tempat (COD) • Gratis Ongkir Se-Pulau Jawa • Gratis Sloki Takar &amp; Sedotan
        </p>
      </div>
      <div id="hero-fold-sentinel" class="h-px w-full" aria-hidden="true"></div>

      <!-- Clean Minimalist Trust Row -->
      <div class="mt-4 flex flex-wrap items-center justify-center gap-x-2 gap-y-1.5 px-3 text-[12px] font-bold text-slate-700">
        <span class="bg-emerald-50 px-2.5 py-1 rounded-full text-emerald-900 border border-emerald-200/80 whitespace-nowrap">Gratis Ongkir Se-Pulau Jawa</span>
        <span class="bg-slate-100 px-2.5 py-1 rounded-full text-slate-800 border border-slate-200/60 whitespace-nowrap">Bisa COD (Bayar di Tempat)</span>
        <span class="bg-slate-100 px-2.5 py-1 rounded-full text-slate-800 border border-slate-200/60 whitespace-nowrap">100% Raw With The Mother</span>
        <span class="bg-slate-100 px-2.5 py-1 rounded-full text-slate-800 border border-slate-200/60 whitespace-nowrap">Garansi Ganti Baru 100%</span>
      </div>

      <!-- 4 Key Somatic Pain Points (Brutal Self-Check Cards) -->
      <div class="mt-5 sm:mt-6 px-4 sm:px-5 text-left space-y-2.5">
        <div class="p-3 rounded-xl bg-red-50/50 border border-red-200/80 shadow-2xs">
          <div class="flex items-center justify-between gap-2">
            <h2 class="text-[14px] font-bold text-slate-950">1. Ngantuk Berat Habis Makan Nasi ("Food Coma")</h2>
            <span class="text-[12px] font-bold uppercase tracking-wider text-red-700 bg-red-100 px-2 py-0.5 rounded shrink-0">Sinyal #1</span>
          </div>
          <p class="text-[13px] sm:text-[13.5px] text-slate-600 mt-1 leading-relaxed">Baru 30 menit selesai makan siang, mata langsung berat mengantuk, badan lemas tak bertenaga karena glukosa darah melonjak drastis lalu anjlok.</p>
        </div>

        <div class="p-3 rounded-xl bg-red-50/50 border border-red-200/80 shadow-2xs">
          <div class="flex items-center justify-between gap-2">
            <h2 class="text-[14px] font-bold text-slate-950">2. Tidur Terganggu Bolak-Balik Kencing Malam</h2>
            <span class="text-[12px] font-bold uppercase tracking-wider text-red-700 bg-red-100 px-2 py-0.5 rounded shrink-0">Ginjal Kerja Keras</span>
          </div>
          <p class="text-[13px] sm:text-[13.5px] text-slate-600 mt-1 leading-relaxed">Terbangun 3–4 kali setiap tengah malam untuk buang air kecil dan tenggorokan terasa kering haus terus-menerus karena tubuh berusaha membuang kelebihan gula.</p>
        </div>

        <div class="p-3 rounded-xl bg-red-50/50 border border-red-200/80 shadow-2xs">
          <div class="flex items-center justify-between gap-2">
            <h2 class="text-[14px] font-bold text-slate-950">3. Telapak Kaki Panas, Tebal &amp; Jari Kesemutan</h2>
            <span class="text-[12px] font-bold uppercase tracking-wider text-red-700 bg-red-100 px-2 py-0.5 rounded shrink-0">Bahaya Saraf Tepi</span>
          </div>
          <p class="text-[13px] sm:text-[13.5px] text-slate-600 mt-1 leading-relaxed">Darah yang pekat oleh gula dan kolesterol gagal mengalir sampai ke ujung saraf mikro di jari tangan dan telapak kaki saat bangun tidur subuh.</p>
        </div>

        <div class="p-3 rounded-xl bg-red-50/50 border border-red-200/80 shadow-2xs">
          <div class="flex items-center justify-between gap-2">
            <h2 class="text-[14px] font-bold text-slate-950">4. Tengkuk Kaku &amp; Takut Ketergantungan Obat</h2>
            <span class="text-[12px] font-bold uppercase tracking-wider text-red-700 bg-red-100 px-2 py-0.5 rounded shrink-0">Risiko Komplikasi</span>
          </div>
          <p class="text-[13px] sm:text-[13.5px] text-slate-600 mt-1 leading-relaxed">Leher belakang sering tegang kliyengan, hasil cek gula &amp; kolesterol merah terus, tapi ngeri efek samping obat kimia ke ginjal jika diminum seumur hidup.</p>
        </div>
      </div>

      <!-- Narrative Pivot Callout -->
      <div class="mt-5 px-4 sm:px-5 text-left">
        <div class="border-l-4 border-emerald-600 pl-3.5 bg-emerald-50/80 py-2.5 pr-3 rounded-r-lg">
          <p class="text-[13.5px] sm:text-[14px] font-medium text-emerald-950 leading-relaxed italic">
            “Masalah utamanya bukan semata karena Anda makan nasi, melainkan <strong>enzim pemecah pati yang terlalu cepat mengubah karbohidrat menjadi lonjakan gula darah</strong>. Cukup 1 sendok Asam Asetat murni With The Mother 10 menit sebelum makan untuk mengerem lonjakan gula langsung dari lambung!”
          </p>
        </div>
      </div>

    </section>

    <!-- ═══ 3. SECTION: REALITA BAHAYA LONJAKAN GULA DARAH & DARAH KENTAL ═══ -->
    <section class="border-t border-slate-100 bg-slate-50/70 pt-10 pb-10 text-center">
      <div class="px-5">
        <h2 class={`${sectionTitle} mt-1`}>
          Mengapa Habis Makan Nasi Badan Lemas &amp; Kaki Kebas?
        </h2>
        <p class={`${sectionLead} text-center`}>
          Saat gula darah melonjak berulang kali setiap habis makan, darah menjadi kental seperti sirup dan menggores dinding pembuluh darah halus:
        </p>
      </div>

      <!-- IMAGE: SOMATIC NGANTUK BERAT & KAKI KEBAS (RATIO 4:3) -->
      <div class="mt-6 relative w-full overflow-hidden aspect-[4/3] bg-slate-100 shadow-2xs border-y border-slate-200/80">
        <img
          src="/images/landing/nutrilove-cuka-apel/gula-darah-mekanisme-brutal.webp"
          alt="Visual Bahaya Lonjakan Gula Darah, Plak Pembuluh Darah & Rasa Ngantuk Berat"
          class="h-full w-full object-cover object-center"
          loading="lazy"
          decoding="async"
          width="1200"
          height="896"
        />
        <div class="absolute bottom-0 inset-x-0 bg-slate-950/90 px-4 py-2 text-center text-white">
          <p class="text-[12.5px] font-medium text-amber-300">
            Ngantuk berat sehabis makan dan kebas kesemutan adalah alarm tubuh bahwa gula darah sedang melonjak.
          </p>
        </div>
      </div>

      <!-- Comparison Grid: Bahaya Dibiarkan vs Terapi NutriLove ACV -->
      <div class="mt-5 px-3.5 sm:px-4 grid grid-cols-2 gap-2 text-left">
        <div class="p-2.5 rounded-xl bg-red-50/70 border border-red-200/60 shadow-2xs">
          <p class="font-black text-red-900 uppercase tracking-wider text-[12px] pb-1.5 border-b border-red-200/50 mb-2">
            Jika Dibiarkan
          </p>
          <ul class="space-y-1.5 text-slate-900 font-bold text-[12px] sm:text-[13px]">
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-red-600 font-black text-[12px] mt-px shrink-0">✕</span>
              <span>Gula melonjak tiap makan</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-red-600 font-black text-[12px] mt-px shrink-0">✕</span>
              <span>Saraf tepi rusak &amp; kebas</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-red-600 font-black text-[12px] mt-px shrink-0">✕</span>
              <span>Ginjal bekerja terlalu berat</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-red-600 font-black text-[12px] mt-px shrink-0">✕</span>
              <span>Ketergantungan obat kimia</span>
            </li>
          </ul>
        </div>

        <div class="p-2.5 rounded-xl bg-emerald-50/80 border border-emerald-200/70 shadow-2xs">
          <p class="font-black text-emerald-900 uppercase tracking-wider text-[12px] pb-1.5 border-b border-emerald-200/50 mb-2">
            NutriLove ACV
          </p>
          <ul class="space-y-1.5 text-slate-800 font-bold text-[12px] sm:text-[13px]">
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-700 font-black text-[12px] mt-px shrink-0">✓</span>
              <span>Rem lonjakan gula 31%</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-700 font-black text-[12px] mt-px shrink-0">✓</span>
              <span>Sirkulasi saraf mikro lancar</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
