---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import Icon from '../components/shared/Icon.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('pompa-air-portable');
if (!product) throw new Error('Product pompa-air-portable not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = 'https://permatamall.shop/pompa-air-portable';
const seoTitle = 'Pompa Bensin & Cairan Manual Siphon: Kuras Bensin Aman Tanpa Disedot Mulut';
const seoDescription =
  'Pompa Tangan Manual Siphon Transfer Bensin, Oli & Air. Praktis sedot bensin tangki motor/mobil, kuras oli & aquarium aman tanpa risiko tersedot mulut. Garansi COD Rp 79rb.';

const sectionTitle = 'text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950';
const body = 'text-[16px] leading-relaxed text-slate-600';

interface Testimonial {
  name: string;
  location: string;
  avatar: string;
  proofImage?: string;
  problem: string;
  comment: string;
  highlight: string;
}

const testimonials: Testimonial[] = [
  {
    name: 'Pak Sugeng Priyadi',
    location: 'Semarang, Jawa Tengah',
    avatar: '/images/petani/petani-01.webp',
    proofImage: '/images/pompa-portable/pompa-testi-real1.webp',
    problem: 'Sering kapok sedot bensin pakai selang biasa bensin tersedot ke mulut',
    comment:
      'Dulu kalau mogok mau sedot bensin dari mobil <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">kapok banget bensin tertelan & bikin mual</strong>. Pakai Pompa Siphon ini <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">tinggal pencet bola karet 2-3 kali bensin langsung ngalir lancar</strong> ke jerigen!',
    highlight: 'Sedot bensin aman tanpa tersedot mulut',
  },
  {
    name: 'Pak Hendra Wijaya',
    location: 'Surabaya, Jawa Timur',
    avatar: '/images/petani/petani-07.webp',
    proofImage: '/images/pompa-portable/pompa-testi-real2.webp',
    problem: 'Kuras oli mesin dan air bak repot kalau pakai alat biasa',
    comment:
      'Sangat membantu buat kuras sisa oli & kuras bak air. <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">Bola pemompanya tebal elastis dan ada katup penguncinya</strong> jadi cairan tidak bakal balik lagi. Barang sesuai deskripsi!',
    highlight: 'Bola karet tebal & katup anti balik',
  },
  {
    name: 'Bu Rina Suryani',
    location: 'Bandung, Jawa Barat',
    avatar: '/images/petani/petani-dewi.webp',
    proofImage: '/images/pompa-portable/pompa-testi-real3.webp',
    problem: 'Susah kuras air galon & aquarium karena selang sering bocor di sambungan',
    comment:
      'Dilengkapi <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">klem besi pengunci di ujung selang</strong> jadi pas mompa <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">tidak ada bocor atau tetesan cairan sedikitpun</strong>. Pengiriman COD sangat cepat!',
    highlight: 'Dilengkapi klem besi anti bocor',
  },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image="/images/pompa-portable/01-hero-pompa-cairan-600.webp"
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Pompa Bensin Manual Siphon', url: '/pompa-air-portable' }
  ]}
  preloadImages={[
    {
      srcset: "/images/pompa-portable/01-hero-pompa-cairan-400.webp 400w, /images/pompa-portable/01-hero-pompa-cairan-600.webp 600w",
      sizes: "(max-width: 480px) 100vw, 480px"
    }
  ]}
>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <MetaLandingTracker slug="pompa-air-portable" productId={product.productId} contentName={product.contentName} price={product.price} />

    <!-- 1. URGENCY TOP BAR -->
    <div class="bg-[#EC7211] px-4 py-2.5 text-center">
      <p class="flex items-center justify-center gap-1.5 text-[12px] font-extrabold uppercase tracking-wide text-white">
        <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-white" aria-hidden="true" />
        PROMO POMPA SIPHON MANUAL: DISKON 50% GARANSI TOKO & COD 79RB!
      </p>
    </div>

    <!-- 2. HERO SECTION & FOTO HERO PRODUK (01-hero-pompa-cairan.webp) -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-7">
        <div class="mx-auto mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#FFF5E5] px-3.5 py-1 text-[11.5px] font-extrabold text-[#EC7211] border border-[#FFEACC]">
          <Icon name="lucide:shield-check" class="h-3.5 w-3.5 text-[#EC7211]" />
          POMPA TANGAN SIPHON BENSIN & CAIRAN MULTIFUNGSI
        </div>
        <h1 class="mx-auto max-w-[440px] text-[clamp(30px,8.5vw,35px)] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Kuras Bensin, Oli & Air <span class="hl-brush">Aman Tanpa Disedot Mulut!</span>
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[16px] font-semibold leading-relaxed text-slate-700">
          Alat Pompa Tangan Manual Siphon. <strong class="font-bold text-slate-950">Sedot & kuras bensin tangki motor/mobil, oli & air otomatis</strong> & <span class="font-bold text-slate-950 underline decoration-[#EC7211]/60 decoration-2 underline-offset-4">100% aman tanpa risiko bensin tersedot ke mulut, bebas listrik & baterai!</span>
        </p>
      </div>

      <!-- FOTO 1: HERO PRODUK (01-hero-pompa-cairan.webp - PRESISI DENGAN FRAME 16:9 LANDSCAPE) -->
      <div class="mt-6 w-full overflow-hidden border-y border-slate-200 bg-white">
        <img
          src="/images/pompa-portable/01-hero-pompa-cairan-600.webp"
          srcset="/images/pompa-portable/01-hero-pompa-cairan-400.webp 400w, /images/pompa-portable/01-hero-pompa-cairan-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Pompa Bensin Manual Pompa Oli Mobil Pompa Tangan Transfer Siphon"
          class="w-full h-auto block object-contain mx-auto"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="540"
          height="304"
        />

        <div class="bg-slate-950 px-4 py-2.5 text-center">
          <p class="flex items-center justify-center gap-1.5 text-[12.5px] font-bold text-[#FFD699]">
            <Icon name="lucide:droplets" class="h-4 w-4 text-[#EC7211] shrink-0" aria-hidden="true" />
            <span>Bola Karet Siphon High-Flow • Selang PVC Tebal • Klem Besi Anti Bocor!</span>
          </p>
        </div>
      </div>
    </section>

    <!-- 3. HIGHLIGHT SPECS BAR -->
    <section class="border-y border-orange-100 bg-[#FFF5E5]/60 px-5 py-5">
      <div class="grid grid-cols-2 gap-3 text-left">
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-3 shadow-xs">
          <Icon name="lucide:shield-alert" class="mt-0.5 h-5 w-5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[11px] font-extrabold tracking-wide uppercase text-slate-400">KEAMANAN</p>
            <p class="text-[13.5px] font-extrabold text-slate-950">Tanpa Disedot Mulut</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-3 shadow-xs">
          <Icon name="lucide:refresh-cw" class="mt-0.5 h-5 w-5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[11px] font-extrabold tracking-wide uppercase text-slate-400">KATUP KATUP</p>
            <p class="text-[13.5px] font-extrabold text-slate-950">Anti Arus Balik</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-3 shadow-xs">
          <Icon name="lucide:lock" class="mt-0.5 h-5 w-5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[11px] font-extrabold tracking-wide uppercase text-slate-400">PENGUNCI</p>
            <p class="text-[13.5px] font-extrabold text-slate-950">Klem Besi Tight-Fit</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-3 shadow-xs">
          <Icon name="lucide:truck" class="mt-0.5 h-5 w-5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[11px] font-extrabold tracking-wide uppercase text-slate-400">LAYANAN</p>
            <p class="text-[13.5px] font-extrabold text-slate-950">Bisa Bayar COD</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. CARA PAKAI & PANDUAN (03-cara-pakai.webp) -->
    <section class="px-5 py-9 border-b border-slate-100">
      <div class="text-center">
        <span class="text-[11.5px] font-extrabold uppercase tracking-widest text-[#EC7211]">PANDUAN & CARA PAKAI</span>
        <h2 class={sectionTitle + ' mt-1.5'}>Cara Pemakaian Praktis</h2>
        <p class={body + ' mt-2 font-medium text-[14.5px]'}>Cukup 3 langkah mudah untuk mengalirkan bensin & cairan:</p>
      </div>

      <!-- FOTO 3: CARA PAKAI (03-cara-pakai.webp - PRESISI PORTRAIT FRAME) -->
      <div class="mt-6 w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm">
        <img
          src="/images/pompa-portable/03-cara-pakai-600.webp"
          srcset="/images/pompa-portable/03-cara-pakai-400.webp 400w, /images/pompa-portable/03-cara-pakai-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Panduan Cara Pakai Pompa Siphon Bensin Manual"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="844"
        />
      </div>

      <div class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-xs">
        <ul class="space-y-3.5 text-[14.5px] text-slate-800">
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
            <span class="text-slate-500 font-medium">Jenis Produk</span>
            <span class="font-bold text-slate-950">Pompa Manual Transfer Siphon</span>
          </li>
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
            <span class="text-slate-500 font-medium">Bahan Bola Pompa</span>
            <span class="font-bold text-slate-950">Karet Sintetis Tebal & Elastis</span>
          </li>
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
            <span class="text-slate-500 font-medium">Bahan Selang</span>
            <span class="font-bold text-slate-950">PVC Transparan Fleksibel Tebal</span>
          </li>
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
            <span class="text-slate-500 font-medium">Sistem Pengunci</span>
            <span class="font-bold text-slate-950">2 Pcs Klem Besi Stainless</span>
          </li>
          <li class="flex items-center justify-between">
            <span class="text-slate-500 font-medium">Kesesuaian Cairan</span>
            <span class="font-bold text-slate-950">Bensin, Solar, Oli Mesin & Air</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- 5. KEGUNAAN & FUNGSI UTAMA POMPA (04-kegunaan-pompa.webp) -->
    <section class="px-5 py-9 border-b border-slate-100 bg-slate-50/50">
      <div class="text-center">
        <span class="text-[11.5px] font-extrabold uppercase tracking-widest text-[#EC7211]">MULTIFUNGSI CAIRAN</span>
        <h2 class={sectionTitle + ' mt-1.5'}>4 Kegunaan Utama Pompa</h2>
        <p class={body + ' mt-1.5 font-medium text-[14.5px]'}>Infografis rincian fungsi di berbagai kebutuhan:</p>
      </div>

      <!-- FOTO 4: KEGUNAAN POMPA (04-kegunaan-pompa.webp - PRESISI PORTRAIT FRAME) -->
      <div class="mt-6 w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm">
        <img
          src="/images/pompa-portable/04-kegunaan-pompa-600.webp"
          srcset="/images/pompa-portable/04-kegunaan-pompa-400.webp 400w, /images/pompa-portable/04-kegunaan-pompa-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Kegunaan Utama Pompa Siphon Bensin & Cairan"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="675"
        />
      </div>

      <div class="mt-6 space-y-3.5">
        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-orange-100 text-[#EC7211] font-extrabold text-[14px]">
            1
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Sedot & Transfer Bensin Tangki Motor / Mobil</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Transfer bensin darurat saat mogok di jalan tanpa bahaya bensin tersedot ke dalam mulut.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-orange-100 text-[#EC7211] font-extrabold text-[14px]">
            2
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Kuras Sisa Oli Mesin Kendaraan</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Kuras sisa oli mesin hingga bersih dari wadah oli tanpa perlu mengotori garasi.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-orange-100 text-[#EC7211] font-extrabold text-[14px]">
            3
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Kuras Bak Mandi, Aquarium & Galon Air</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Kuras air kotor aquarium atau sedot galon air dengan cepat tanpa repot angkat galon berat.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-orange-100 text-[#EC7211] font-extrabold text-[14px]">
            4
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Transfer Solar & Cairan Teknis Darurat</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Sangat berguna untuk pengisian solar genset atau transfer cairan minyak rumah tangga.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. KEUNGGULAN PRODUK & ALASAN MEMILIH (02-keunggulan-pompa.webp) -->
    <section class="px-5 py-9 border-b border-slate-100">
      <div class="text-center">
        <span class="text-[11.5px] font-extrabold uppercase tracking-widest text-[#EC7211]">SOLUSI TERBAIK</span>
        <h2 class={sectionTitle + ' mt-1.5'}>Keunggulan Pompa Siphon</h2>
        <p class={body + ' mt-2 font-medium'}>Alasan kenapa harus menggunakan alat pompa siphon ini:</p>
      </div>

      <!-- FOTO 2: KEUNGGULAN (02-keunggulan-pompa.webp - PRESISI PORTRAIT FRAME) -->
      <div class="mt-6 w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm">
        <img
          src="/images/pompa-portable/02-keunggulan-pompa-600.webp"
          srcset="/images/pompa-portable/02-keunggulan-pompa-400.webp 400w, /images/pompa-portable/02-keunggulan-pompa-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Keunggulan Pompa Siphon vs Sedot Mulut Manual"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="810"
        />
      </div>

      <div class="mt-6 space-y-3.5">
        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">100% Aman Tanpa Risiko Tersedot Mulut</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Bebas bahaya keracunan atau tertelan bensin/solar dan bebas bau bensin yang membekas di mulut.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Bola Pompa Karet Katup Anti Arus Balik</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Cukup tekan bola karet 2-3 kali, cairan otomatis menyedot dan mengalir lancar tanpa bocor balik.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Ringan & Siap Pakai Kapan Saja (Bebas Listrik)</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Bisa disimpan di dalam bagasi motor atau mobil untuk persiapan darurat saat mogok kehabisan bensin.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Dilengkapi Klem Pengunci Anti Bocor</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Sambungan bola pompa ke selang dikunci klem besi stainless sehingga tidak akan lepas saat penyedotan bensin.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. TESTIMONIALS PELANGGAN (FOTO BUKTI PEMAKAIAN REAL) -->
    <section class="px-5 py-9 border-b border-slate-100 bg-slate-50/50">
      <div class="text-center">
        <span class="text-[11.5px] font-extrabold uppercase tracking-widest text-[#EC7211]">ULASAN PEMBELI</span>
        <h2 class={sectionTitle + ' mt-1.5'}>Testimoni Pelanggan Real</h2>
      </div>

      <div class="mt-6 space-y-4">
        {testimonials.map((t) => (
          <div class="rounded-2xl border border-slate-200/80 bg-white p-4.5 shadow-xs">
            {t.proofImage && (
              <img
                src={t.proofImage}
                alt={`Foto bukti pemakaian dari ${t.name}`}
                class="mb-3.5 w-full h-auto block object-contain max-h-[360px] rounded-xl border border-slate-200 bg-slate-100 mx-auto"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                width="540"
                height="407"
              />
            )}
            <div class="flex items-center gap-3">
              <img src={t.avatar} alt={t.name} class="h-10 w-10 rounded-full object-cover ring-2 ring-orange-100" />
              <div>
                <h3 class="text-[14.5px] font-bold text-slate-950">{t.name}</h3>
                <p class="text-[12px] text-slate-500">{t.location}</p>
              </div>
            </div>
            <div class="mt-3 rounded-xl bg-[#FFF5E5]/70 p-3 text-[13.5px] leading-relaxed text-slate-700">
              <p set:html={t.comment} />
            </div>
            <div class="mt-2.5 flex items-center justify-between text-[11.5px]">
              <span class="font-bold text-[#EC7211]">✓ {t.highlight}</span>
              <span class="font-semibold text-slate-400">Pembeli Terverifikasi</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 8. SOCIAL PROOF DYNAMIC -->
    <SocialProof productSlug="pompa-air-portable" />

    <!-- 9. PRICING & HARGA SECTION (FOTO REAL BANNER HARGA PROMO COD) -->
    <section id="checkout" class="border-t-8 border-slate-100 bg-white py-12">
      <div class="px-5 pb-8 text-center">
        <p class="mx-auto mb-3 inline-flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.14em] text-[#EC7211]">
