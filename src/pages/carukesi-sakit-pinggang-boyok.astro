---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import {
  loadStoreCodDisabledProvinceCodes,
  resolveFormModeContext,
} from '../lib/form-mode';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';

export const prerender = false;

const SLUG = 'carukesi-sakit-pinggang-boyok';
const PRODUCT_SLUG = 'soothing-gristle-gel-cream-perawatan-cream-pijat-otot-sendi';

const product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);
if (!product) return Astro.rewrite('/404');

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const codDisabledProvinceCodes = await loadStoreCodDisabledProvinceCodes(database);
const formContext = await resolveFormModeContext(
  Astro.request,
  codDisabledProvinceCodes,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;
const comparePrice = cheapest?.comparePrice ?? product.comparePrice ?? 199000;
const discount = comparePrice > price ? Math.round((1 - price / comparePrice) * 100) : 50;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;

const workerBuyers = [
  { name: 'Rudianto', location: 'Jakarta Barat', time: '2 menit lalu' },
  { name: 'Gunawan', location: 'Bandung', time: '5 menit lalu' },
  { name: 'Rahmawati', location: 'Surabaya', time: '8 menit lalu' },
  { name: 'Hendra S.', location: 'Semarang', time: '12 menit lalu' },
  { name: 'Agus P.', location: 'Tangerang', time: '15 menit lalu' },
  { name: 'Dedi K.', location: 'Bekasi', time: '19 menit lalu' },
];

const sectionTitle = 'text-[clamp(22px,6.8vw,26px)] font-black text-slate-950 tracking-tight leading-[1.2]';
const sectionLead = 'text-[13.5px] text-slate-600 leading-relaxed mt-2 max-w-[420px] mx-auto';
---

<BaseLayout
  title="Carukési Relaxing Gel — Solusi Sakit Pinggang, Boyok & Saraf Kejepit"
  description="Pinggang serasa mau patah, kaku bangun tidur & duduk lama menusuk? Oles Carukési Gel: hangat meresap, pinggang enteng, bebas bungkuk & kerja lancar."
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  image="/images/landing/carukesi-sakit-pinggang-boyok/hero-pinggang.webp"
  preloadImages="/images/landing/carukesi-sakit-pinggang-boyok/hero-pinggang.webp"
>
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-6 font-sans text-slate-900 shadow-2xl selection:bg-blue-600 selection:text-white antialiased">
    <!-- ═══ 1. URGENCY ANNOUNCEMENT BAR (TOP NON-STICKY) ═══ -->
    <header class="flex items-center justify-between border-b border-blue-950 bg-[#0B1E40] px-4 py-2.5 text-white shadow-md">
      <div class="flex items-center gap-1.5 text-[11px] font-extrabold tracking-wide">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
        </span>
        <span class="text-amber-300 font-black uppercase">PROMO HARI INI:</span>
        <span class="text-slate-100">DISKON {discount}%</span>
      </div>
      <div class="flex items-center gap-1 text-[10.5px] font-bold text-white bg-blue-800/90 px-2.5 py-0.5 rounded-full border border-blue-600/60 shadow-xs">
        <Icon name="truck" class="h-3 w-3 text-amber-300" />
        <span>BISA COD</span>
      </div>
    </header>

    <!-- ═══ 2. HERO SECTION (FULL WIDTH HERO IMAGE & FLUID ICONS) ═══ -->
    <section id="landing-hero" class="bg-white text-center pb-8">
      <div class="px-5 pt-6">
        <!-- Main Brutal Headline -->
        <h1 class="mx-auto max-w-[440px] text-[clamp(24px,7.2vw,28px)] font-black leading-[1.18] tracking-tight text-slate-950">
          Pinggang Terasa Mau Patah, Bangun Tidur Kaku &amp; <span class="box-decoration-clone rounded-[0.18em] bg-[#0B1E40] px-2 py-0.5 text-white">Duduk Lama Menusuk?</span>
        </h1>

        <!-- Subtitle -->
        <p class="mx-auto mt-3 max-w-[410px] text-[15px] font-semibold leading-relaxed text-slate-700">
          <strong class="text-red-700 font-bold">Sekali Oles Hangat Meresap:</strong> Sensasi hangat menembus otot lumbar terdalam, melonggarkan saraf kejepit &amp; bebas bungkuk seketika!
        </p>

        <!-- Star Rating Social Proof -->
        <div class="mt-3.5 flex items-center justify-center gap-1.5 text-[12.5px] font-extrabold text-slate-800">
          <div class="flex items-center gap-0.5" aria-label="Rating 5 dari 5 bintang">
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          </div>
          <span class="text-slate-900 font-bold">4.9 / 5.0</span>
          <span class="text-slate-400">•</span>
          <span class="text-slate-600 font-medium">(2.120+ Pekerja &amp; Supir)</span>
        </div>
      </div>

      <!-- Hero Visual (100% FULL WIDTH EDGE-TO-EDGE) -->
      <div class="mt-5 relative w-full overflow-hidden bg-slate-900 aspect-[5/4]">
        <img
          src="/images/landing/carukesi-sakit-pinggang-boyok/hero-pinggang.webp"
          alt="Carukési Relaxing Gel Solusi Sakit Pinggang & Boyok"
          class="h-full w-full object-cover block"
          loading="eager"
          decoding="async"
          width="480"
          height="480"
        />
        <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2.5 text-center backdrop-blur-xs">
          <p class="text-[12.5px] font-bold text-amber-300 flex items-center justify-center gap-1.5">
            <Icon name="sparkles" class="h-4 w-4 text-amber-300 shrink-0" />
            <span>Sensasi Hangat Menembus Otot Lumbar Dalam 10 Detik</span>
          </p>
        </div>
      </div>

      <!-- Horizontal Trust Row -->
      <div class="mt-5 flex justify-center gap-4 px-4 text-slate-700">
        <span class="inline-flex items-center gap-1.5 text-[12px] font-bold text-slate-800">
          <Icon name="truck" class="h-4 w-4 text-[#0B1E40]" />
          Bisa COD
        </span>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-bold text-slate-800">
          <Icon name="lock-keyhole" class="h-4 w-4 text-[#0B1E40]" />
          Privasi 100%
        </span>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-bold text-slate-800">
          <Icon name="shield-check" class="h-4 w-4 text-[#0B1E40]" />
          Resmi BPOM
        </span>
      </div>

      <!-- 4 Key Value Checkmarks (Fluid Minimalist List) -->
      <div class="mt-6 px-5 text-left space-y-3.5">
        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 mt-0.5">
            <Icon name="check" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[14.5px] font-bold text-slate-950">Longgarkan Otot Pinggang Mengeras</h3>
            <p class="text-[13px] text-slate-600 mt-0.5 leading-relaxed">Meredakan kekakuan lumbar akibat duduk seharian, menyetir, atau angkat beban.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 mt-0.5">
            <Icon name="check" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[14.5px] font-bold text-slate-950">Redakan Gejala Saraf Kejepit Ringan</h3>
            <p class="text-[13px] text-slate-600 mt-0.5 leading-relaxed">Hentikan sensasi ngilu menusuk yang menjalar dari pinggang ke bokong dan paha.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 mt-0.5">
            <Icon name="check" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[14.5px] font-bold text-slate-950">Bangun Tidur Langsung Segar Enteng</h3>
            <p class="text-[13px] text-slate-600 mt-0.5 leading-relaxed">Tidak perlu lagi memiringkan badan menahan ngilu saat bangkit dari kasur di pagi hari.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 mt-0.5">
            <Icon name="check" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[14.5px] font-bold text-slate-950">100% Bebas Lengket &amp; Tidak Mengotori Baju</h3>
            <p class="text-[13px] text-slate-600 mt-0.5 leading-relaxed">Gel bening cepat kering, aroma herbal segar menenangkan tanpa bau balsem minyak.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 3. PROBLEM AGITATION SECTION (FLUID LIST) ═══ -->
    <section class="border-t border-slate-100 bg-red-50/35 px-5 py-10">
      <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-red-600">Bahaya Saraf Lumbar</span>
      <h2 class={`${sectionTitle} mt-1`}>
        Apakah Pinggang Anda Mengalami <span class="box-decoration-clone rounded-[0.18em] bg-[#0B1E40] px-2 py-0.5 text-white">Gejala Kritis Ini?</span>
      </h2>
      <p class={`${sectionLead} text-left`}>
        Jangan sepelekan boyok kaku! Otot punggung yang kejang terus-menerus bisa menekan bantalan tulang dan memicu saraf kejepit permanen (*HNP*).
      </p>

      <div class="mt-7 space-y-4">
        <div class="flex gap-3.5 items-start">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 mt-0.5">
            <Icon name="x" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-900">Bangun Pagi Pinggang Terasa Terkunci</h3>
            <p class="text-[13.5px] text-slate-600 mt-0.5 leading-relaxed">Harus memiringkan tubuh perlahan sambil menahan rasa sakit sebelum sanggup berdiri dari ranjang.</p>
          </div>
        </div>

        <div class="flex gap-3.5 items-start">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 mt-0.5">
            <Icon name="x" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-900">Duduk 30 Menit Sudah Nyut-Nyutan</h3>
            <p class="text-[13.5px] text-slate-600 mt-0.5 leading-relaxed">Pinggang bawah terasa panas seperti ditusuk jarum, bikin gelisah dan kerjaan terganggu.</p>
          </div>
        </div>

        <div class="flex gap-3.5 items-start">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 mt-0.5">
            <Icon name="x" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-900">Takut Membungkuk &amp; Angkat Barang</h3>
            <p class="text-[13.5px] text-slate-600 mt-0.5 leading-relaxed">Selalu was-was pinggang berbunyi 'krek' dan tubuh kaku tidak bisa ditegakkan kembali.</p>
          </div>
        </div>

        <div class="flex gap-3.5 items-start">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 mt-0.5">
            <Icon name="x" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-900">Takut Biaya Operasi Saraf Kejepit</h3>
            <p class="text-[13.5px] text-slate-600 mt-0.5 leading-relaxed">Khawatir memikirkan biaya fisioterapi dan operasi jutaan rupiah jika kondisi dibiarkan berlarut.</p>
          </div>
        </div>
      </div>

      <!-- Warning Callout -->
      <div class="mt-6 border-l-2 border-red-600 pl-4 text-left">
        <h3 class="text-[14.5px] font-bold text-slate-950">Peringatan Medis:</h3>
        <p class="text-[13px] leading-relaxed text-slate-600 mt-0.5">
          Pijat urut paksa yang sembarangan pada pinggang justru berisiko merusak bantalan saraf tulang belakang! Terapi oles gel herbal adalah cara teraman untuk merelaksasi otot lumbar dari luar.
        </p>
      </div>
    </section>

    <!-- ═══ 4. THE SOLUTION & MECHANISM ═══ -->
    <section class="border-t border-slate-100 bg-white px-5 py-10 text-center">
      <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-[#0B1E40]">Solusi Alami</span>
      <h2 class={`${sectionTitle} mt-1`}>
        Bagaimana Carukési Mengendurkan Otot Pinggang Yang Mengeras?
      </h2>
      <p class={`${sectionLead} text-center`}>
        Formula gel mikro transparan menyerap (*Fast Absorbing*) langsung ke jaringan otot lumbar terdalam.
      </p>

      <div class="mt-8 space-y-6 text-left">
        <div class="flex items-start gap-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#0B1E40] text-white font-black text-[14px]">
            01
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-950">Meredakan Ketegangan Otot Lumbar</h3>
            <p class="text-[13.5px] text-slate-600 mt-1 leading-relaxed">
              Sensasi hangat langsung bekerja mengendurkan serat otot punggung bawah yang kaku dan mengeras akibat kerja fisik berat atau duduk terlalu lama.
            </p>
          </div>
        </div>

        <div class="h-px bg-slate-100 w-full" />

        <div class="flex items-start gap-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#0B1E40] text-white font-black text-[14px]">
            02
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-950">Melancarkan Sirkulasi Darah Tulang Belakang</h3>
            <p class="text-[13.5px] text-slate-600 mt-1 leading-relaxed">
              Memperlebar pembuluh darah kapiler di sepanjang tulang lumbar, mengalirkan oksigen dan nutrisi segar untuk mempercepat pemulihan jaringan saraf.
            </p>
          </div>
        </div>

        <div class="h-px bg-slate-100 w-full" />

        <div class="flex items-start gap-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#0B1E40] text-white font-black text-[14px]">
            03
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-950">Bebas Bungkuk &amp; Kembali Bertenaga</h3>
            <p class="text-[13.5px] text-slate-600 mt-1 leading-relaxed">
              Otot kembali lentur tanpa rasa terikat. Tubuh kembali tegak, bebas membungkuk, dan siap beraktivitas tanpa bayang-bayang ngilu.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 5. CARA PEMAKAIAN (FULL WIDTH BANNER) ═══ -->
    <section class="border-t border-slate-100 bg-slate-50/50 pt-10 pb-10 text-center">
      <div class="px-5">
        <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-emerald-800">Petunjuk Penggunaan</span>
        <h2 class={`${sectionTitle} mt-1`}>
          3 Langkah Mudah Bebas Sakit Pinggang
        </h2>
      </div>

      <div class="mt-6 w-full overflow-hidden">
        <img
          src="/images/landing/carukesi-sakit-pinggang-boyok/cara-pakai-pinggang.webp"
          alt="Cara Pemakaian Carukési Gel Pada Pinggang"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="mt-5 px-5">
        <div class="border-l-2 border-emerald-600 pl-4 text-left">
          <p class="text-[13px] font-semibold text-slate-800 leading-relaxed">
            💡 <strong>Anjuran Pakai:</strong> Oleskan secara merata di area pinggang bawah 2–3 kali sehari (pagi sebelum mulai kerja dan malam sebelum tidur) untuk hasil kelenturan pinggang maksimal.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══ 6. SEBELUM VS SESUDAH (PERBANDINGAN VISUAL MENYATU) ═══ -->
    <section class="border-t border-slate-100 bg-white pt-10 pb-10 text-center">
      <div class="px-5">
        <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-amber-800">Hasil Nyata</span>
        <h2 class={`${sectionTitle} mt-1`}>
          Perbedaan Nyata Pada Pinggang Anda
        </h2>
      </div>

      <div class="mt-6 w-full overflow-hidden mb-6">
        <img
          src="/images/landing/carukesi-sakit-pinggang-boyok/before-after-pinggang.webp"
          alt="Sebelum vs Sesudah Menggunakan Carukési Gel Pada Pinggang"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Integrated Comparison Rows -->
      <div class="px-5 grid grid-cols-2 gap-3 text-left text-[12.5px]">
        <div class="p-3.5 rounded-lg bg-red-50/60 border-l-2 border-red-500">
          <p class="font-bold text-red-700 uppercase tracking-wider mb-2">❌ SEBELUM OLES</p>
          <ul class="space-y-1.5 text-slate-700 leading-relaxed font-medium">
            <li>• Pinggang kaku serasa patah</li>
            <li>• Duduk lama terasa ditusuk</li>
            <li>• Bangun tidur pinggang terkunci</li>
            <li>• Takut membungkuk &amp; angkat beban</li>
          </ul>
        </div>
        <div class="p-3.5 rounded-lg bg-emerald-50/70 border-l-2 border-emerald-600">
          <p class="font-bold text-emerald-800 uppercase tracking-wider mb-2">✅ SETELAH OLES</p>
          <ul class="space-y-1.5 text-slate-900 font-bold leading-relaxed">
            <li>• Pinggang enteng &amp; lentur</li>
            <li>• Nyaman duduk &amp; nyetir seharian</li>
