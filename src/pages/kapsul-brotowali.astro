---
import BaseLayout from '../layouts/BaseLayout.astro';
import RatingStars from '../components/shared/RatingStars.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import Icon from '../components/shared/Icon.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('kapsul-brotowali');
if (!product) throw new Error('Product kapsul-brotowali not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = 'https://permatamall.shop/kapsul-brotowali';
const seoTitle = 'Kapsul Brotowali Herbal Alami - Bebas Pegal Linu & Gula Darah Normal';
const seoDescription =
  'Kapsul Brotowali murni tanpa rasa pahit. Efektif bantu redakan pegal linu persendian, normalkan gula darah, & bersihkan darah kotor. Bisa COD.';

const sectionTitle = 'text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950';
const body = 'text-[16px] leading-relaxed text-slate-600';

const testimonials = [
  {
    name: 'Bu Warsini',
    location: 'Boyolali, Jawa Tengah',
    avatar: '/images/petani/petani-02.webp',
    problem: 'Pegal linu persendian dan kapok minum jamu brotowali yang pahit',
    comment:
      'Dulu kapok <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">minum jamu brotowali karena rasanya pahit banget bikin muntah</strong>. Pas nyoba kapsul brotowali ini, <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">praktis tanpa pahit dan linu persendian hilang tuntas</strong>!',
    highlight: 'Praktis tanpa pahit & linu hilang',
  },
  {
    name: 'Pak Sutarman',
    location: 'Solo, Jawa Tengah',
    avatar: '/images/petani/petani-08.webp',
    problem: 'Badan cepat capek dan gula darah sering tidak stabil',
    comment:
      'Badan yang tadinya <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">sering kaku dan gampang capek saat kerja</strong>, sekarang <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">terasa jauh lebih enteng bugar dan gula darah puasa stabil berkala</strong>.',
    highlight: 'Badan enteng & gula darah stabil',
  },
  {
    name: 'Bu Hartini',
    location: 'Sragen, Jawa Tengah',
    avatar: '/images/petani/petani-04.webp',
    problem: 'Tangan kaku susah ditekuk setiap bangun pagi',
    comment:
      'Tiap bangun tidur <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">Jari tangan sering kaku dan linu</strong>. Minum kapsul brotowali 3 hari berturut-turut, <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">persendian langsung lentur dan nyaman digerakkan</strong>.',
    highlight: 'Persendian lentur bebas kaku',
  },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={product.heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Kapsul Brotowali', url: '/kapsul-brotowali' }
  ]}

  preloadImages={[
    "/images/produk/kapsul-brotowali-showcase1.webp",
    "/images/produk/kapsul-brotowali-showcase2.webp"
  ]}>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <MetaLandingTracker slug="kapsul-brotowali" productId={product.productId} contentName={product.contentName} price={product.price} />

    <!-- 1. URGENCY TOP BAR -->
    <div class="bg-[#FF9900] px-4 py-2.5 text-center">
      <p class="flex items-center justify-center gap-1.5 text-[12px] font-extrabold uppercase tracking-wide text-white">
        <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-white" aria-hidden="true" />
        BELI 1 BOTOL 125RB, BELI 2 BOTOL 199RB, BELI 3 BOTOL 298RB FREE ONGKIR & COD!
      </p>
    </div>

    <!-- 2. HERO SECTION -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-7">
        <div class="mx-auto mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#FFF5E5] px-3.5 py-1 text-[11.5px] font-extrabold text-[#EC7211] border border-[#FFEACC]">
          <Icon name="lucide:sparkles" class="h-3.5 w-3.5 text-[#EC7211]" aria-hidden="true" />
          EKSTRAK BROTOWALI MURNI
        </div>
        <h1 class="mx-auto max-w-[440px] text-[clamp(32px,8.8vw,36px)] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Badan Pegal & Kaku Hilang! <span class="hl-brush">Khasiat Brotowali Tanpa Pahit!</span>
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[16px] font-semibold leading-relaxed text-slate-700">
          Kapsul Brotowali murni racikan herbal pilihan. <strong class="font-bold text-slate-950">100% bebas rasa pahit di lidah</strong> untuk memelihara kesehatan & meredakan linu persendian. <span class="font-bold text-slate-950 underline decoration-[#FF9900]/60 decoration-2 underline-offset-4">Badan bugar enteng seketika!</span>
        </p>
      </div>

      <div class="mt-7">
        <div class="relative overflow-hidden bg-slate-950 aspect-square rounded-xl shadow-2xl ring-1 ring-slate-900 w-full">
          <img
            src={product.heroImage}
            alt="Kapsul Brotowali Herbal Hero"
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="960"
            height="960"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-3 text-center backdrop-blur-sm">
            <p class="flex items-center justify-center gap-1.5 text-[12.5px] font-bold text-[#FFD699]">
              <Icon name="lucide:sparkles" class="h-4 w-4 text-[#FF9900] shrink-0" aria-hidden="true" />
              <span>KAPSUL HERBAL BROTOWALI: KHASIAT JAMU MURNI TANPA PAHITT!</span>
            </p>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-center gap-3 px-4">
          <div class="flex -space-x-2">
            {testimonials.map((t) => (
              <img src={t.avatar} alt={t.name} class="h-8 w-8 rounded-full border-2 border-white object-cover" width="32" height="32" loading="eager" decoding="async" />
            ))}
          </div>
          <div class="text-left">
            <div class="flex items-center gap-0.5">
            <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
            <span class="ml-1 text-[13px] font-bold text-slate-900">4.9/5</span>
            </div>
            <p class="text-[11px] font-medium text-slate-500">dari 1.890+ pembeli terpuaskan</p>
          </div>
        </div>

        <div class="mt-5 flex justify-center gap-4 px-4">
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:shield-check" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            100% Herbal Alami
          </span>
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:sparkles" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Tanpa Pahit
          </span>
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:truck" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Bisa COD
          </span>
        </div>
      </div>
    </section>

    <!-- 3. PAIN CHECKLIST SECTION -->
    <section class="border-t border-slate-100 bg-red-50/40 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-red-600">Sering Mengalami Ini?</span>
      <h2 class={sectionTitle}>Masalah Pegal Linu & Gula Darah <span class="hl-brush">Dianggap Sepele</span></h2>
      <p class={`${body} mt-3 mb-6`}>Banyak orang menahan rasa sakit persendian dan gula darah tinggi karena tidak sanggup minum jamu brotowali yang pahit:</p>
      <div class="space-y-4">
        {[
          ['Pegal Linu & Nyeri Persendian Kaku', 'Sensasi kaku di lutut, tumit, dan pinggang belakang saat bangun tidur atau setelah aktivitas kerja seharian.'],
          ['Gula Darah Naik & Badan Gampang Lemas', 'Kadar gula darah tidak stabil membuat tubuh terasa lemas, ngantukan, dan cepat kehilangan tenaga.'],
          ['Kapok Minum Jamu Karena Rasa Sangat Pahit', 'Keinginan minum herbal brotowali terhalang rasa pahit menyengat yang bertahan lama di lidah dan tenggorokan.']
        ].map(([title, desc]) => (
          <div class="flex items-start gap-3.5">
            <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center text-red-600"><Icon name="lucide:x-circle" class="h-5 w-5" aria-hidden="true" /></span>
            <div>
              <h3 class="text-[16px] font-bold text-slate-900">{title}</h3>
              <p class="mt-0.5 text-[15px] leading-relaxed text-slate-600">{desc}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-8 overflow-hidden rounded-md">
        <img fetchpriority="low" src="/images/produk/kapsul-brotowali-showcase1.webp"
          alt="Masalah pegal linu dan khasiat brotowali"
          class="aspect-square w-full object-cover rounded-md"
          loading="lazy"
          decoding="async"
          width="960"
          height="960"
        />
      </div>
    </section>

    <!-- 4. EDUKASI GELAP (Mekanisme Brotowali) -->
    <section class="border-t border-slate-100 bg-slate-950 px-5 py-10 text-white">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#FFD699]">Cara Kerja Alami</span>
      <h2 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-white">Mekanisme Brotowali <span class="text-[#FFD699]">Bersihkan Darah & Persendian</span></h2>
      <p class="mt-3 text-[16px] leading-relaxed text-slate-400">Tanaman brotowali (Tinospora crispa) kaya akan senyawa aktif pikrorizin dan tinokrisposid. Kapsul brotowali bekerja dari dalam tubuh lewat 2 tahap:</p>

      <div class="relative ml-2 mt-8 space-y-8 border-l border-slate-800 pl-6">
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-white ring-4 ring-slate-950">1</span>
          <h3 class="text-[16px] font-semibold text-[#FFD699]">Peredam Peradangan Persendian</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-slate-400">Kandungan flavonoid & alkaloid alami membantu meredakan pembengkakan dan kekakuan pada jaringan sendi yang linu.</p>
        </div>
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-white ring-4 ring-slate-950">2</span>
          <h3 class="text-[16px] font-semibold text-[#FFD699]">Penyeimbang Gula Darah & Pembersih Darah</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-slate-400">Membantu stimulasi sensitivitas insulin dan melancarkan metabolisme darah agar tubuh tetap fit bertenaga.</p>
        </div>
      </div>

      <div class="mt-8 overflow-hidden rounded-md bg-slate-900">
        <img fetchpriority="low" src="/images/produk/kapsul-brotowali-showcase2.webp"
          alt="Mekanisme pembersihan darah dan persendian kapsul brotowali"
          class="aspect-square w-full object-cover"
          loading="lazy"
          decoding="async"
          width="960"
          height="960"
        />
      </div>

      <div class="mt-6 rounded-md bg-slate-900 p-4">
        <p class="text-[14px] leading-relaxed text-slate-300"><strong class="text-[#FFD699]">Hasilnya:</strong> Persendian kembali lentur bebas linu, gula darah terjaga, dan badan terasa jauh lebih bugar tanpa sensasi pahit!</p>
      </div>
    </section>

    <!-- 5. FOTO ASLI PRODUK & SPESIFIKASI -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Foto Asli Produk</span>
      <h2 class={sectionTitle}>Lihat Bentuk Fisik & <span class="hl-brush">Kemasan Higienis</span></h2>
      <p class={`${body} mt-3 mb-6`}>Kapsul ekstrak brotowali murni dikemas dalam botol segel rapat yang aman dan praktis dibawa ke mana saja:</p>

      <div class="overflow-hidden rounded-2xl bg-gradient-to-b from-slate-900 via-slate-950 to-slate-900 p-6 shadow-2xl ring-1 ring-slate-800 flex flex-col items-center">
        <span class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#FF9900]/20 px-3 py-1 text-[11px] font-bold text-[#FFD699] ring-1 ring-[#FF9900]/40">
          <Icon name="lucide:shield-check" class="h-3.5 w-3.5 text-[#FF9900]" />
          FOTO REAL STOK KAPSUL BROTOWALI ORIGINAL
        </span>
        <img fetchpriority="low" src="/images/produk/kapsul-brotowali-benefit.webp"
          alt="Botol Kemasan Asli Kapsul Brotowali Herbal"
          class="max-h-[440px] w-auto object-contain rounded-xl shadow-2xl drop-shadow-[0_20px_20px_rgba(0,0,0,0.8)]"
          loading="lazy"
          decoding="async"
          width="960"
          height="960"
        />
        <div class="mt-4 flex flex-wrap justify-center gap-2 text-[11.5px] font-bold text-white">
          <span class="inline-flex items-center gap-1 rounded-md bg-slate-800/80 px-2.5 py-1"><Icon name="lucide:check" class="h-3 w-3 text-[#FF9900]" /> Jamu Indonesia</span>
          <span class="inline-flex items-center gap-1 rounded-md bg-slate-800/80 px-2.5 py-1"><Icon name="lucide:check" class="h-3 w-3 text-[#FF9900]" /> 100% Herbal Alami</span>
          <span class="inline-flex items-center gap-1 rounded-md bg-slate-800/80 px-2.5 py-1"><Icon name="lucide:check" class="h-3 w-3 text-[#FF9900]" /> Segel Rapat</span>
        </div>
      </div>
      <p class="mt-2.5 text-center text-[12.5px] font-semibold text-slate-600">Botol segel higienis Kapsul Brotowali murni 100% Original. Bebas BKO & tanpa rasa pahit.</p>

      <div class="mt-8 border-t-2 border-[#FFEACC] pt-5">
        <h3 class="flex items-center gap-2 text-[15px] font-bold text-slate-950">
          <Icon name="lucide:shield-check" class="h-4.5 w-4.5 text-[#EC7211]" aria-hidden="true" />
          Spesifikasi Kapsul Brotowali
        </h3>
        <div class="mt-3 space-y-2.5 text-[14px] leading-relaxed">
          <p><strong class="font-semibold text-slate-900">Komposisi:</strong> <span class="text-slate-600">100% Ekstrak Batang Brotowali Murni (Tinospora crispa)</span></p>
          <p><strong class="font-semibold text-slate-900">Isi kemasan:</strong> <span class="box-decoration-clone bg-[#FFF5E5] px-1.5 pb-0.5 font-semibold text-slate-900">Botol segel higienis isi 50 kapsul</span></p>
          <p><strong class="font-semibold text-slate-900">Kualitas:</strong> <span class="text-slate-600">Bebas Bahan Kimia Obat (BKO), aman dikonsumsi harian</span></p>
          <p><strong class="font-semibold text-slate-900">Harga Promo:</strong> <span class="text-slate-600">1 Botol 125rb, 2 Botol 199rb, 3 Botol 298rb (Free Ongkir)</span></p>
        </div>
      </div>
    </section>

    <!-- 6. CARA PAKAI (3 Langkah) -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Aturan Minum</span>
      <h2 class={sectionTitle}>3 Langkah Praktis Konsumsi Harian</h2>
      <p class={`${body} mt-3 mb-6`}>Tanpa perlu meracik atau menahan rasa pahit di lidah:</p>
      <figure class="overflow-hidden rounded-md ring-1 ring-slate-200">
        <figcaption class="flex items-center gap-2 bg-[#232F3E] px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.18em] text-white">
          <Icon name="lucide:workflow" class="h-4 w-4 shrink-0" aria-hidden="true" />
          3 Langkah Minum Kapsul Brotowali
        </figcaption>
        <div class="flex items-start justify-between gap-1 bg-gradient-to-b from-[#FFF5E5]/60 to-white px-3 py-6">
          {[
            ['lucide:pill', 'Minum Kapsul', 'Ambil 2 kapsul brotowali'],
            ['lucide:glass-water', 'Air Hangat', 'Gunakan 1 gelas air putih hangat'],
            ['lucide:smile', 'Rutin 2x Sehari', 'Minum pagi & malam sesudah makan']
          ].map(([icon, title, sub], i, arr) => (
            <>
              <div class="flex-1 text-center">
                <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[#FF9900] text-white">
                  <Icon name={icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <h3 class="mt-2.5 text-[13px] font-bold text-slate-900">{title}</h3>
                <p class="mx-auto mt-0.5 max-w-[110px] text-[11px] leading-tight text-slate-500">{sub}</p>
              </div>
              {i < arr.length - 1 && (
                <Icon name="lucide:chevron-right" class="mt-4 h-5 w-5 shrink-0 text-[#FFD699]" aria-hidden="true" />
              )}
            </>
          ))}
        </div>
        <div class="flex items-center justify-center gap-1.5 border-t border-[#FFEACC] bg-[#FFF5E5]/60 px-4 py-2.5 text-center text-[12px] font-semibold text-[#232F3E]">
          <Icon name="lucide:badge-check" class="h-4 w-4 shrink-0" aria-hidden="true" />
          Untuk konsumsi pencegahan dan pemeliharaan kesehatan cukup 1 kapsul sehari sesudah makan
        </div>
      </figure>

      <div class="mt-8 border-t border-slate-100 pt-6">
        <h3 class="text-[16px] font-extrabold tracking-tight text-slate-950">Kenapa Bukan Jamu Brotowali Seduh Biasa?</h3>
        <div class="mt-4 space-y-2.5 text-[14.5px] leading-relaxed">
          <p class="flex items-start gap-2.5">
            <Icon name="lucide:x" class="mt-1 h-4 w-4 shrink-0 text-red-600" aria-hidden="true" />
            <span class="text-slate-600">Jamu rebusan: rasanya sangat pahit menyengat, bikin mual, dan takaran antar rebusan tidak konsisten.</span>
          </p>
          <p class="flex items-start gap-2.5 border-l-2 border-[#FF9900] pl-3">
            <Icon name="lucide:check" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
            <span class="font-semibold text-slate-900">Kapsul Brotowali: 100% bebas rasa pahit di mulut, dosis ekstrak terukur presisi, serta harganya sangat terjangkau.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- 7. TESTIMONI PEMBELI -->
    <section class="border-t border-slate-100 bg-[#FFF5E5]/40 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Kata Pembeli</span>
      <h2 class={sectionTitle}>Cerita Mereka yang Bebas Linu <span class="hl-brush">Tanpa Rasa Pahit</span></h2>
      <p class={`${body} mt-3 mb-8`}>Ribuan keluarga Indonesia sudah membuktikannya:</p>

      <div class="space-y-9">
        {testimonials.map((t, index, arr) => (
          <div>
            <div class="flex items-center gap-3">
              <img
                src={t.avatar}
                alt={`Foto ${t.name}, pengguna Kapsul Brotowali`}
                class="h-11 w-11 shrink-0 rounded-full object-cover"
                width="44"
                height="44"
                loading="lazy"
                decoding="async"
              />
              <div class="min-w-0">
                <h3 class="flex items-center gap-1 text-[15px] font-bold text-slate-900">
                  {t.name}
                  <Icon name="lucide:badge-check" class="h-4 w-4 shrink-0 text-[#0073BB]" aria-hidden="true" />
                </h3>
                <p class="text-[11.5px] text-slate-500">{t.location}</p>
              </div>
              <div class="ml-auto flex gap-0.5">
                <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
              </div>
            </div>
            <p class="mt-1.5 text-[12px] font-semibold text-[#B45309]">Masalah: {t.problem}</p>
            <p class="mt-3 border-l-2 border-[#FF9900]/40 pl-3 text-[15px] italic leading-relaxed text-slate-700" set:html={`"${t.comment}"`} />
            <p class="mt-2.5 flex items-center gap-1.5 text-[13px] font-bold text-slate-900">
              <Icon name="lucide:check-circle-2" class="h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
              {t.highlight}
            </p>
            {index < arr.length - 1 && <div class="mt-8 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent" />}
          </div>
        ))}
      </div>
    </section>

    <!-- 8. JUJUR DARI AWAL -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Jujur dari Awal</span>
      <h2 class={sectionTitle}>Cocok untuk Siapa, dan Kapan ke Dokter?</h2>
      <p class={`${body} mt-3 mb-6`}>Kapsul Brotowali adalah jamu herbal alami pembantu kebugaran harian. Supaya Anda tidak salah beli:</p>

      <div class="space-y-2.5 text-[15px] leading-relaxed">
        <p class="flex items-start gap-2.5">
          <Icon name="lucide:check-circle-2" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Cocok untuk yang sering mengalami <strong class="font-semibold text-slate-900">pegal linu, nyeri sendi, dan badan kaku</strong> akibat aktivitas harian.</span>
        </p>
        <p class="flex items-start gap-2.5">
          <Icon name="lucide:check-circle-2" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Cocok untuk yang ingin <strong class="font-semibold text-slate-900">menjaga daya tahan tubuh dan stabilitas gula darah</strong> secara herbal alami tanpa pahit.</span>
        </p>
        <p class="mt-4 flex items-start gap-2.5 border-l-2 border-red-300 pl-3">
          <Icon name="lucide:stethoscope" class="mt-1 h-4 w-4 shrink-0 text-red-600" aria-hidden="true" />
          <span class="text-slate-700">Jika Anda mengalami <strong class="font-semibold text-red-700">gula darah sangat tinggi mendadak atau pembengkakan sendi kronis hebat</strong>, tetap konsultasikan ke fasilitas kesehatan terdekat. Herbal sifatnya mendampingi gaya hidup sehat.</span>
        </p>
      </div>
    </section>

    <!-- 9. BELANJA TANPA WAS-WAS / GARANSI COD -->
    <section class="border-t border-slate-100 bg-[#F2F3F3] px-5 py-10 text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center text-[#232F3E]">
        <Icon name="lucide:shield-check" class="h-12 w-12" aria-hidden="true" />
      </div>
      <h2 class="mb-2 text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Belanja Tanpa Was-Was</h2>
      <h3 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950">BAYAR SETELAH BARANG SAMPAI</h3>
      <p class="mx-auto mt-4 max-w-[340px] text-[16px] leading-relaxed text-slate-600">Pesan Kapsul Brotowali hari ini dengan sistem COD: Anda baru bayar ke kurir saat paket tiba di rumah.</p>

      <div class="mx-auto mt-8 max-w-[360px] space-y-6 text-left">
        {[
          ['lucide:truck', 'COD ke Seluruh Indonesia', 'Bayar tunai di tempat saat paket tiba. Tidak perlu transfer di muka.'],
          ['lucide:package-check', 'Paket Segel Sesuai Foto', 'Kapsul dikirim dalam botol segel rapat higienis, dikemas rapi & privasi aman.'],
          ['lucide:message-circle', 'Admin Siap Ditanya', 'Ragu soal dosis atau pemakaian? Chat admin via WhatsApp kapan saja.']
        ].map(([icon, title, desc]) => (
          <div class="flex items-start gap-4">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded bg-white text-[#232F3E]"><Icon name={icon} class="h-4.5 w-4.5" aria-hidden="true" /></span>
            <div>
              <h4 class="text-[16px] font-bold text-slate-900">{title}</h4>
              <p class="mt-1 text-[15px] leading-relaxed text-slate-500">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 10. FORM CHECKOUT -->
    <section id="checkout" class="border-t-8 border-slate-100 bg-white py-12">
      <div class="px-5 pb-8 text-center">
        <p class="mx-auto mb-3 inline-flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.14em] text-[#EC7211]">
          <Icon name="lucide:zap" class="h-4 w-4 shrink-0" aria-hidden="true" />
          Promo Hemat Paket Brotowali
        </p>
        <h2 class="mx-auto max-w-[340px] text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950">
          Isi Alamat Pengiriman, <span class="hl-brush">Bayar Saat Sampai</span>
        </h2>
        <p class="mx-auto mt-4 max-w-[320px] text-[15px] leading-relaxed text-slate-600">
          Form menyesuaikan wilayah Anda. Paket dikirim rapi, Anda bayar tunai ke kurir saat barang tiba di rumah.
        </p>
      </div>
      <GeoIpResolvedForm mode={formContext.mode} productSlug="kapsul-brotowali" embedded={true} />
    </section>

    <LpMiniFooter />
    <StickyCTA productSlug="kapsul-brotowali" />
    <SocialProof productSlug="kapsul-brotowali" />
  </main>
</BaseLayout>

