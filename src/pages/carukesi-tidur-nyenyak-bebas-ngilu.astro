        <h2 class="text-[22px] font-black tracking-tight text-slate-950">
          Lengkapi Data Pengiriman
        </h2>
        <p class="text-[13px] text-slate-600 mt-1 max-w-[360px] mx-auto leading-relaxed">
          Pilih paket promo di bawah dan isi alamat tujuan. Bayar uang tunai saat kurir tiba di rumah (COD).
        </p>
      </div>

      <GeoIpResolvedForm
        mode={formContext.mode}
        province={formContext.province}
        productSlug={product.slug}
        embedded={true}
      />
    </section>

    <!-- ═══ 12. STICKY PURCHASE BAR (MOBILE BOTTOM) ═══ -->
    <div
      id="sticky-purchase-bar"
      class="fixed inset-x-0 bottom-0 z-40 mx-auto flex w-full max-w-[480px] items-center justify-between border-t border-slate-200 bg-white/95 backdrop-blur-md px-5 py-2.5 pb-[max(0.6rem,env(safe-area-inset-bottom))] shadow-2xl transition-all duration-300"
      style="transform: translateY(100%); opacity: 0; pointer-events: none;"
    >
      <div>
        <p class="text-[9.5px] font-bold uppercase tracking-wider text-slate-500">Harga Promo</p>
        <p class="text-[16px] font-black text-red-700 leading-none">Rp{Math.round(price).toLocaleString('id-ID')}</p>
      </div>
      <a
        href="#form-pemesanan"
        class="inline-flex min-h-[40px] items-center justify-center rounded-xl bg-red-600 hover:bg-red-700 px-5 text-[12px] font-black uppercase tracking-wider text-white shadow-md transition-all active:scale-[0.98]"
      >
        <span>Pesan Sekarang (COD)</span>
        <Icon name="arrow-right" class="h-4 w-4 ml-1.5" />
      </a>
    </div>

    <!-- Realtime Social Proof Toast -->
    <SocialProofToast
      productLabel="Carukési Relaxing Gel 50g"
      productImage="/images/landing/carukesi-tidur-nyenyak-bebas-ngilu/product-thumb.webp"
      heroSelector="#landing-hero"
      formSelector="#form-pemesanan"
      buyers={tidurBuyers}
    />
  </main>

  <script slot="head" is:inline>
    function initStickyBarObserver() {
      const stickyBar = document.getElementById('sticky-purchase-bar');
      const orderForm = document.getElementById('form-pemesanan');
      const hero = document.getElementById('landing-hero');
      if (!stickyBar) return;

      let heroVisible = true;
      let formVisible = false;

      const applyStickyVisibility = () => {
        if (heroVisible || formVisible) {
          stickyBar.style.transform = 'translateY(100%)';
          stickyBar.style.opacity = '0';
          stickyBar.style.pointerEvents = 'none';
        } else {
          stickyBar.style.transform = 'translateY(0)';
          stickyBar.style.opacity = '1';
          stickyBar.style.pointerEvents = 'auto';
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.target === hero) heroVisible = entry.isIntersecting;
            if (entry.target === orderForm) formVisible = entry.isIntersecting;
          });
          applyStickyVisibility();
        },
        { threshold: 0.05, rootMargin: '0px 0px -40px 0px' }
      );

      if (hero) observer.observe(hero);
      if (orderForm) observer.observe(orderForm);
      applyStickyVisibility();
    }

    function initCountdownTimer() {
      const minEl = document.getElementById('countdown-minutes');
      const secEl = document.getElementById('countdown-seconds');
      if (!minEl || !secEl) return;

      const STORAGE_KEY = 'carukesi_promo_countdown_target';
      let targetTime = parseInt(sessionStorage.getItem(STORAGE_KEY) || '0', 10);
      const now = Date.now();

      if (!targetTime || targetTime <= now || targetTime - now > 15 * 60 * 1000) {
        targetTime = now + 15 * 60 * 1000;
        sessionStorage.setItem(STORAGE_KEY, targetTime.toString());
      }

      const updateTimer = () => {
        const remainingMs = Math.max(0, targetTime - Date.now());
        const totalSeconds = Math.floor(remainingMs / 1000);

        if (totalSeconds <= 0) {
          targetTime = Date.now() + 15 * 60 * 1000;
          sessionStorage.setItem(STORAGE_KEY, targetTime.toString());
        }

        const mins = Math.floor(totalSeconds / 60);
        const secs = totalSeconds % 60;

        minEl.textContent = String(mins).padStart(2, '0');
        secEl.textContent = String(secs).padStart(2, '0');
      };

      updateTimer();
      setInterval(updateTimer, 1000);
    }

    const initAll = () => {
      initStickyBarObserver();
      initCountdownTimer();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  </script>
</BaseLayout>
