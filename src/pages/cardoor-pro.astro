---
import BaseLayout from '../layouts/BaseLayout.astro';
import RatingStars from '../components/shared/RatingStars.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import Icon from '../components/shared/Icon.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('cardoor-pro');
if (!product) throw new Error('Product cardoor-pro not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = 'https://permatamall.shop/cardoor-pro';
const seoTitle = 'Cardoor Pro Bantal Peredam Pintu Mobil Anti Benturan & Bising';
const seoDescription =
  'Cardoor Pro peredam benturan pintu mobil. Redam suara tutup pintu banting, lindungi lecet body, perekat 3M super kuat. Paket 4 pcs, garansi COD.';

const sectionTitle = 'text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950';
const body = 'text-[16px] leading-relaxed text-slate-600';

const testimonials = [
  {
    name: 'Pak Gunawan Setyadi',
    location: 'Tangerang, Banten',
    avatar: '/images/pembeli/pembeli-pria-1.webp',
    problem: 'Pintu mobil sering dibanting penumpang sampai bersuara keras',
    comment:
      'Paling ngilu kalau <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">penumpang nutup pintu mobil dibanting keras</strong>. Pas dipasang Cardoor Pro ini di 4 titik pintu, <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">suaranya langsung jadi "blep" lembut mantap kayak mobil mewah</strong>!',
    highlight: 'Suara tutup pintu jadi lembut & mantap',
    proofImage: '/images/produk/cardoor-pro-testi1.webp',
  },
  {
    name: 'Mas Hendra Wijaya',
    location: 'Surabaya, Jawa Timur',
    avatar: '/images/pembeli/pembeli-pria-2.webp',
    problem: 'Sering ada lecet baret halus di pinggiran bodi pintu mobil',
    comment:
      'Dulu di pinggiran rangka pintu <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">sering lecet baret gesekan besi</strong>. Setelah nempel Cardoor Pro, <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">bodi mobil aman dari benturan & lecet</strong>. Perekatnya kuat sekali.',
    highlight: 'Bodi mobil aman bebas lecet benturan',
    proofImage: '/images/produk/cardoor-pro-testi2.webp',
  },
  {
    name: 'Bu Ratna Wulan',
    location: 'Bandung, Jawa Barat',
    avatar: '/images/pembeli/pembeli-wanita-1.webp',
    problem: 'Ragu perekat gampang lepas kalau mobil sering dicuci',
    comment:
      'Awalnya ragu lemnya bakalan lepas kalau kena air pas cuci mobil. Ternyata <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">perekat 3M nya super rekat</strong> dan <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">tetap nempel kokoh tidak bergeming sedikitpun</strong>.',
    highlight: 'Perekat 3M super kuat tahan cuci & hujan',
    proofImage: '/images/produk/cardoor-pro-showcase1.webp',
  },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={product.heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Cardoor Pro', url: '/cardoor-pro' }
  ]}

  preloadImages={[
    "/images/produk/cardoor-pro-hero.webp",
    "/images/produk/cardoor-pro-detail1.webp"
  ]}>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <MetaLandingTracker slug="cardoor-pro" productId={product.productId} contentName={product.contentName} price={product.price} />

    <!-- 1. URGENCY TOP BAR -->
    <div class="bg-[#FF9900] px-4 py-2.5 text-center">
      <p class="flex items-center justify-center gap-1.5 text-[12px] font-extrabold uppercase tracking-wide text-white">
        <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-white" aria-hidden="true" />
        PROMO CARDOOR PRO: PEREDAM PINTU MOBIL ANTI BENTURAN & COD 79RB!
      </p>
    </div>

    <!-- 2. HERO SECTION -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-7">
        <div class="mx-auto mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#FFF5E5] px-3.5 py-1 text-[11.5px] font-extrabold text-[#EC7211] border border-[#FFEACC]">
          <Icon name="lucide:shield" class="h-3.5 w-3.5 text-[#EC7211]" />
          PEREDAM BENTURAN PINTU MOBIL EKSKLUSIF
        </div>
        <h1 class="mx-auto max-w-[440px] text-[clamp(30px,8.5vw,35px)] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Tutup Pintu Mobil Halus & Kedap <span class="hl-brush">Bebas Bising & Lecet!</span>
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[16px] font-semibold leading-relaxed text-slate-700">
          Bantalan Karet Silikon Cardoor Pro. <strong class="font-bold text-slate-950">Redam benturan keras saat pintu ditutup banting</strong> & <span class="font-bold text-slate-950 underline decoration-[#FF9900]/60 decoration-2 underline-offset-4">lindungi bodi mobil dari lecet baret, perekat 3M super kuat!</span>
        </p>
      </div>

      <!-- SINGLE HERO PRODUCT INFOGRAPHIC IMAGE -->
      <div class="mt-7 w-full border-b border-slate-100">
        <div class="w-full border-t border-b border-slate-200 bg-slate-50">
          <img
            src="/images/produk/cardoor-pro-hero.webp"
            alt="Proteksi Maksimal Cover Kunci Pintu Mobil Presisi & Elegan Cardoor Pro"
            class="w-full h-auto block"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="800"
            height="1422"
          />
        </div>

        <div class="bg-slate-950 px-4 py-2.5 text-center border-t border-slate-800">
          <p class="flex items-center justify-center gap-1.5 text-[12.5px] font-bold text-[#FFD699]">
            <Icon name="lucide:car" class="h-4 w-4 text-[#FF9900] shrink-0" aria-hidden="true" />
            <span>Bahan Silikon Tebal Elastis • Perekat 3M Strong • Pemasangan PNP Mudah!</span>
          </p>
        </div>
      </div>
      <div class="mt-4 flex items-center justify-center gap-3 px-4">
        <div class="flex -space-x-2">
          {testimonials.map((t) => (
            <img src={t.avatar} alt={t.name} class="h-8 w-8 rounded-full border-2 border-white object-cover" width="32" height="32" loading="eager" decoding="async" />
          ))}
        </div>
        <div class="text-left">
          <div class="flex items-center gap-0.5">
            <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
            <span class="ml-1 text-[13px] font-bold text-slate-900">4.9/5</span>
          </div>
          <p class="text-[11px] font-medium text-slate-500">dari 2.400+ pemilik mobil puas</p>
        </div>
      </div>

      <div class="mt-5 flex justify-center gap-4 px-4">
        <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
          <Icon name="lucide:volume-x" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
          Redam Bising
        </span>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
          <Icon name="lucide:shield-check" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
          Anti Lecet Bodi
        </span>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
          <Icon name="lucide:truck" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
          Bisa COD
        </span>
      </div>

      <div class="mt-6 border-l-2 border-[#FF9900] px-5 pl-4 text-left">
        <h2 class="text-[15px] font-bold text-slate-950">Ngilu setiap kali mendengar pintu mobil dibanting keras?</h2>
        <p class="mt-1 text-[13.5px] leading-relaxed text-slate-600">Pasang Cardoor Pro di sudut pintu, bagasi & kap mesin. Getaran benturan diredam seketika, bodi mobil aman terlindungi.</p>
      </div>
    </section>

    <!-- 3. PAIN CHECKLIST (Sering Mengalami Ini?) -->
    <section class="border-t border-slate-100 bg-red-50/40 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-red-600">Masalah Pintu Mobil Harian</span>
      <h2 class={sectionTitle}>Kesal Pintu Mobil Ditutup Banting <span class="hl-brush">Bikin Bodi Lecet & Bising?</span></h2>
      <p class={`${body} mt-3 mb-6`}>Benturan besi ke besi pada pintu mobil berisiko merusak engsel & memicu baret:</p>
      
      <div class="space-y-4">
        {[
          ['Suara Benturan Tutup Pintu Keras', 'Pintu mobil bersuara "plang" nyaring saat ditutup, mengurangi rasa nyaman & terkesan murahan.'],
          ['Cat Pinggiran Rangka Pintu Baret Lecet', 'Benturan berulang memicu gesekan cat hingga mengelupas dan memicu karat pada bodi mobil.'],
          ['Engsel & Karet Pintu Cepat Aus', 'Getaran benturan banting membuat engsel pintu kendor dan peredam bawaan pabrik cepat rusak.']
        ].map(([title, desc]) => (
          <div class="flex items-start gap-3.5">
            <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center text-red-600"><Icon name="lucide:x-circle" class="h-5 w-5" aria-hidden="true" /></span>
            <div>
              <h3 class="text-[16px] font-bold text-slate-900">{title}</h3>
              <p class="mt-0.5 text-[15px] leading-relaxed text-slate-600">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. PEMASANGAN MUDAH DI PINTU & BAGASI (FOTO 2) -->
    <section class="border-t border-slate-100 bg-slate-950 px-5 py-10 text-white">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#FFD699]">Flexibel & Universal</span>
      <h2 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-white">Bisa Dipasang Di Mana Saja <span class="text-[#FFD699]">Pintu, Bagasi & Kap Mesin!</span></h2>
      <p class="mt-3 text-[16px] leading-relaxed text-slate-400">Desain pad silikon elastis universal cocok untuk semua merek mobil (Sedan, SUV, MPV, Hatchback):</p>

      <div class="mt-7 w-full border border-slate-800 rounded-lg overflow-hidden">
        <img fetchpriority="low" src="/images/produk/cardoor-pro-detail1.webp"
          alt="Fitur Cardoor Pro Peredam Benturan Logam"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
          width="640"
          height="640"
        />
      </div>

      <div class="relative ml-2 mt-8 space-y-8 border-l border-slate-800 pl-6">
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-white ring-4 ring-slate-950">1</span>
          <h3 class="text-[16px] font-semibold text-[#FFD699]">Bahan Silikon Tebal Elastis</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-slate-400">Silikon khusus berdaya membal tinggi yang menyerap energi benturan secara optimal saat pintu ditutup.</p>
        </div>
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-white ring-4 ring-slate-950">2</span>
          <h3 class="text-[16px] font-semibold text-[#FFD699]">Perekat Double Tape 3M Strong</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-slate-400">Daya rekat kuat tahan air & suhu panas. Tidak akan lepas meski mobil sering dicuci atau kena hujan deras.</p>
        </div>
      </div>

      <div class="mt-6 rounded-md bg-slate-900 p-4">
        <p class="text-[14px] leading-relaxed text-slate-300"><strong class="text-[#FFD699]">Hasilnya:</strong> Suara benturan pintu langsung diredam lembut, kabin terasa lebih kedap & bodi mobil terlindungi!</p>
      </div>
    </section>

    <!-- 5. FOTO ASLI DETAIL & VARIAN (FOTO 3, 4, 5) -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Foto Asli & Keunggulan Produk</span>
      <h2 class={sectionTitle}>Bahan Silikon Tebal <span class="hl-brush">Perekat 3M Super Kuat</span></h2>
      <p class={`${body} mt-3 mb-6`}>Tersedia dalam varian Polos dan Logo Brand Otomotif Premium:</p>

      <div class="w-full mb-4 border border-slate-200 rounded-lg overflow-hidden">
        <img fetchpriority="low" src="/images/produk/cardoor-pro-detail1.webp"
          alt="Fitur Meredam Suara Benturan Logam Kasar"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
          width="640"
          height="640"
        />
      </div>
      <p class="text-[12.5px] text-slate-500 mb-6">Membantu meredam suara benturan logam yang kasar menjadi suara padat & senyap.</p>

      <div class="w-full mb-4 border border-slate-200 rounded-lg overflow-hidden">
        <img fetchpriority="low" src="/images/produk/cardoor-pro-detail2.webp"
          alt="Pilihan Varian Polos & Logo Brand Otomotif Cardoor Pro"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
          width="640"
          height="266"
        />
      </div>
      <p class="text-[12.5px] text-slate-500 mb-6">Pilihan varian Tanpa Logo (Polos) dan Logo Brand Otomotif (Toyota, Honda, Mitsubishi, Daihatsu, Suzuki).</p>

      <div class="w-full border border-slate-200 rounded-lg overflow-hidden">
        <img fetchpriority="low" src="/images/produk/cardoor-pro-detail3.webp"
          alt="Pemasangan Mandiri PNP Tanpa Lem & Baut"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
          width="640"
          height="640"
        />
      </div>
      <p class="mt-2 text-[12.5px] text-slate-500">Pemasangan mandiri tanpa alat, tanpa baut, dan tanpa lem tambahan. Langsung rapi dalam sekejap.</p>

      <div class="mt-8 border-t-2 border-[#FFEACC] pt-5">
        <h3 class="flex items-center gap-2 text-[15px] font-bold text-slate-950">
          <Icon name="lucide:shield-check" class="h-4.5 w-4.5 text-[#EC7211]" aria-hidden="true" />
          Spesifikasi & Dimensi Cardoor Pro (4 Pcs/Set)
        </h3>

        <!-- SHOPEE SPEC DIAGRAM IMAGE -->
        <div class="my-4 w-full border border-slate-200 rounded-lg overflow-hidden">
          <img fetchpriority="low" src="/images/produk/cardoor-pro-spec.webp"
            alt="Dimensi Parameter 94mm x 70mm & Logo Brand Cardoor Pro 4Pcs/Set"
            class="w-full h-auto block"
            loading="lazy"
            decoding="async"
            width="800"
            height="800"
          />
        </div>

        <div class="mt-3 space-y-2.5 text-[14px] leading-relaxed">
          <p><strong class="font-semibold text-slate-900">Dimensi ukuran:</strong> <span class="box-decoration-clone bg-[#FFF5E5] px-1.5 pb-0.5 font-semibold text-slate-900">94 mm x 70 mm (Presisi Rangka Striker Pintu)</span></p>
          <p><strong class="font-semibold text-slate-900">Bahan utama:</strong> <span class="text-slate-600">Silikon Elastis High-Density Tahan Benturan</span></p>
          <p><strong class="font-semibold text-slate-900">Jenis perekat:</strong> <span class="text-slate-600">3M Double Sided Strong Adhesive (Tahan Air)</span></p>
          <p><strong class="font-semibold text-slate-900">Jumlah paket:</strong> <span class="text-slate-600">1 Paket Isi 4 Pcs Cover Peredam</span></p>
          <p><strong class="font-semibold text-slate-900">Pilihan Logo:</strong> <span class="text-slate-600">Polos, Toyota, Daihatsu, Honda, Suzuki, Mitsubishi, Nissan, Wuling, Kia, Hyundai</span></p>
        </div>
      </div>
    </section>

    <!-- 6. CARA PASANG (3 Langkah Mudah) -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Panduan Praktis</span>
      <h2 class={sectionTitle}>3 Langkah Pasang Cardoor Pro</h2>
      <p class={`${body} mt-3 mb-6`}>Pemasangan plug and play praktis, bisa dipasang sendiri dalam 1 menit:</p>

      <figure class="overflow-hidden rounded-md ring-1 ring-slate-200">
        <figcaption class="flex items-center gap-2 bg-[#232F3E] px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.18em] text-white">
          <Icon name="lucide:workflow" class="h-4 w-4 shrink-0" aria-hidden="true" />
          3 Langkah Pemasangan Mudah
        </figcaption>
        <div class="flex items-start justify-between gap-1 bg-gradient-to-b from-[#FFF5E5]/60 to-white px-3 py-6">
          {[
            ['lucide:sparkles', 'Bersihkan Area', 'Lap bersih area sudut pintu dari debu & minyak'],
            ['lucide:layers', 'Buka Stiker 3M', 'Lepas plastik pelindung lem perekat 3M'],
            ['lucide:check-circle-2', 'Tempel & Tekan', 'Tempelkan di titik benturan pintu lalu tekan 5 detik']
          ].map(([icon, title, sub], i, arr) => (
            <>
              <div class="flex-1 text-center">
                <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[#FF9900] text-white">
                  <Icon name={icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <h3 class="mt-2.5 text-[13px] font-bold text-slate-900">{title}</h3>
                <p class="mx-auto mt-0.5 max-w-[110px] text-[11px] leading-tight text-slate-500">{sub}</p>
              </div>
              {i < arr.length - 1 && (
                <Icon name="lucide:chevron-right" class="mt-4 h-5 w-5 shrink-0 text-[#FFD699]" aria-hidden="true" />
              )}
            </>
          ))}
        </div>
      </figure>
    </section>

    <!-- 7. TESTIMONIALS & BUKTI PEMAKAIAN (FOTO 6 & 7) -->
    <section class="border-t border-slate-100 bg-[#FFF5E5]/40 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Bukti Pembeli</span>
      <h2 class={sectionTitle}>Pengalaman Pengguna <span class="hl-brush">Cardoor Pro</span></h2>
      <p class={`${body} mt-3 mb-6`}>Kisah nyata pemilik mobil yang sudah merasakan manfaat peredam benturan ini:</p>

      <div class="space-y-6">
        {testimonials.map((t) => (
          <div class="rounded-2xl bg-white p-4.5 shadow-sm border border-amber-200/80">
            <div class="flex items-center gap-3 mb-2.5">
              <img
                src={t.avatar}
                alt={`Foto ${t.name}, pengguna Cardoor Pro`}
                class="h-11 w-11 shrink-0 rounded-full object-cover ring-2 ring-[#FF9900]/40"
                width="44"
                height="44"
                loading="lazy"
                decoding="async"
              />
              <div class="min-w-0">
                <h3 class="flex items-center gap-1 text-[15px] font-bold text-slate-900">
                  {t.name}
                  <Icon name="lucide:badge-check" class="h-4 w-4 shrink-0 text-[#0073BB]" aria-hidden="true" />
                </h3>
                <p class="text-[11.5px] text-slate-500">{t.location}</p>
              </div>
              <div class="ml-auto flex gap-0.5">
                <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
              </div>
            </div>

            <div class="mb-2 inline-block rounded-md bg-[#FFF5E5] px-2.5 py-0.5 text-[11.5px] font-bold text-[#EC7211]">
              ✓ {t.highlight}
            </div>

            <p class="text-[12px] font-semibold text-[#B45309] mb-1">Masalah: {t.problem}</p>
            <p class="text-[14.5px] leading-relaxed text-slate-700 mb-3.5" set:html={`"${t.comment}"`} />

            {t.proofImage && (
              <div class="w-full overflow-hidden rounded-xl border border-slate-200 bg-slate-50 mt-3">
                <img
                  src={t.proofImage}
                  alt={`Bukti pemakaian ${t.name} Cardoor Pro`}
                  class="w-full h-auto block"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- 8. JUJUR DARI AWAL -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Jujur Dari Awal</span>
      <h2 class={sectionTitle}>Tips Pemasangan Supaya Melekat Permanen</h2>
      <p class={`${body} mt-3 mb-6`}>Agar Cardoor Pro menempel kokoh dan tahan lama di mobil Anda:</p>

      <div class="space-y-2.5 text-[15px] leading-relaxed">
        <p class="flex items-start gap-2.5">
          <Icon name="lucide:check-circle-2" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Pastikan permukaan cat <strong class="font-semibold text-slate-900">benar-benar bersih dari debu, minyak atau cairan pengilap mobil</strong> sebelum ditempel.</span>
        </p>
        <p class="flex items-start gap-2.5">
          <Icon name="lucide:check-circle-2" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Tekan pad silikon selama <strong class="font-semibold text-slate-900">5-10 detik saat pertama kali ditempel</strong> agar lem 3M meresap sempurna.</span>
        </p>
        <p class="mt-4 flex items-start gap-2.5 border-l-2 border-[#FF9900] pl-3">
          <Icon name="lucide:info" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Hindari mencuci mobil dengan semprotan air tekanan tinggi <strong class="font-semibold text-slate-900">dalam waktu 24 jam pertama</strong> setelah pemasangan.</span>
        </p>
      </div>
    </section>

    <!-- 9. BELANJA TANPA WAS-WAS / PROMO & GARANSI COD (FOTO 8) -->
    <section class="border-t border-slate-100 bg-[#F2F3F3] pb-10 text-center">
      <div class="px-5 pt-10">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center text-[#232F3E]">
          <Icon name="lucide:shield-check" class="h-12 w-12" aria-hidden="true" />
        </div>
        <h2 class="mb-2 text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Belanja Tanpa Risiko</h2>
        <h3 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950">BAYAR SETELAH BARANG SAMPAI</h3>
        <p class="mx-auto mt-4 max-w-[340px] text-[16px] leading-relaxed text-slate-600">Pesan Cardoor Pro hari ini promo Rp79.000 secara COD: Anda baru bayar ke kurir saat paket tiba di rumah.</p>
      </div>

      <div class="mt-6 w-full border-t border-slate-200">
        <img fetchpriority="low" src="/images/produk/cardoor-pro-garansi.webp"
          alt="Promo Diskon 50% & Garansi Sampai Cardoor Pro"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
          width="640"
          height="640"
        />
      </div>

      <div class="mx-auto mt-8 max-w-[360px] space-y-6 px-5 text-left">
        {[
          ['lucide:truck', 'COD ke Seluruh Indonesia', 'Bayar tunai di tempat saat barang tiba. Tanpa perlu transfer di muka.'],
          ['lucide:package-check', 'Garansi Paket Original & Safe', 'Kemasan terbungkus rapat. Jika barang rusak atau kurang di jalan, kami ganti baru gratis!'],
          ['lucide:message-circle', 'Admin Pendampingan', 'Bisa berkonsultasi cara pemasangan dan jumlah kebutuhan titik tempel via WhatsApp admin.']
        ].map(([icon, title, desc]) => (
          <div class="flex items-start gap-4">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded bg-white text-[#232F3E]"><Icon name={icon} class="h-4.5 w-4.5" aria-hidden="true" /></span>
            <div>
              <h4 class="text-[16px] font-bold text-slate-900">{title}</h4>
              <p class="mt-1 text-[15px] leading-relaxed text-slate-500">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 10. CHECKOUT FORM -->
    <section id="checkout" class="border-t-8 border-slate-100 bg-white py-12">
      <div class="px-5 pb-8 text-center">
        <p class="mx-auto mb-3 inline-flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.14em] text-[#EC7211]">
          <Icon name="lucide:zap" class="h-4 w-4 shrink-0" aria-hidden="true" />
          Promo Cardoor Pro COD
        </p>
        <h2 class="mx-auto max-w-[340px] text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950">
          Isi Alamat Pengiriman, <span class="hl-brush">Bayar Saat Sampai</span>
        </h2>
        <p class="mx-auto mt-4 max-w-[320px] text-[15px] leading-relaxed text-slate-600">
          Form otomatis menyesuaikan lokasi Anda. Paket dikirim aman dan rapi, bayar tunai ke kurir saat barang tiba.
        </p>
      </div>
      <GeoIpResolvedForm mode={formContext.mode} productSlug="cardoor-pro" embedded={true} />
    </section>

    <LpMiniFooter />
    <StickyCTA productSlug="cardoor-pro" />
    <SocialProof productSlug="cardoor-pro" />
  </main>
</BaseLayout>

