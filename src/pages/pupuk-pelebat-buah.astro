---
import BaseLayout from '../layouts/BaseLayout.astro';
import RatingStars from '../components/shared/RatingStars.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import Icon from '../components/shared/Icon.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('pupuk-pelebat-buah');
if (!product) throw new Error('Product pupuk-pelebat-buah not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = 'https://pesantren.shop/pupuk-pelebat-buah';
const seoTitle = 'Pupuk Pelebat Buah Super: Bunga Lebat & Anti Rontok';
const seoDescription =
  'Pupuk Pelebat Buah racikan ampuh. Menstimulasi bunga & calon buah lebat melimpah anti rontok. Garansi COD.';

const sectionTitle = 'text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950';
const body = 'text-[16px] leading-relaxed text-slate-600';

const testimonials = [
  {
    name: 'Pak Sugeng Priyanto',
    location: 'Kediri, Jawa Timur',
    avatar: '/images/petani/petani-08.webp',
    problem: 'Pohon mangga rontok parah setiap kali berbunga',
    comment:
      'Pohon mangga di depan rumah biasanya <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">rontok parah tiap kali berbunga</strong>. Pas disiram pupuk ini 2 minggu sekali, <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">bunganya lengket gila-gilaan dan buahnya bergelayutan lebat</strong>!',
    highlight: 'Bunga lengket tak rontok & buah lebat',
  },
  {
    name: 'Pak Darmaji',
    location: 'Klaten, Jawa Tengah',
    avatar: '/images/petani/petani-01.webp',
    problem: 'Buah durian kerdil dan sering mogok berbuah',
    comment:
      'Tanaman durian sama jambu air di kebun yang dulu <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">buahnya kerdil dan gampang rontok</strong>, sekarang <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">buahnya jadi jumbo-jumbo dan makin manis legit</strong>. Rekomended banget!',
    highlight: 'Hasil buah jumbo & manis legit',
  },
  {
    name: 'Bu Ningsih',
    location: 'Sidoarjo, Jawa Timur',
    avatar: '/images/petani/petani-02.webp',
    problem: 'Tabulampot jeruk di teras tidak pernah keluar bunga',
    comment:
      'Jeruk santang di pot teras rumah sudah 1 tahun <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">cuma rimbun daun tidak pernah ada bunga</strong>. Setelah rutin dikasi pupuk ini, <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">langsung tumbuh pentil buah di tiap ujung dahan</strong>!',
    highlight: 'Tabulampot langsung berbuah rimbun',
  },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={product.heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Pupuk Pelebat Buah', url: '/pupuk-pelebat-buah' }
  ]}

  preloadImages={[
    "/images/produk/pupuk-pelebat-buah-real-detail1.webp",
    "/images/produk/pupuk-pelebat-buah-real-detail3.webp"
  ]}>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <MetaLandingTracker slug="pupuk-pelebat-buah" productId={product.productId} contentName={product.contentName} price={product.price} />

    <!-- 1. URGENCY TOP BAR -->
    <div class="bg-[#FF9900] px-4 py-2.5 text-center">
      <p class="flex items-center justify-center gap-1.5 text-[12px] font-extrabold uppercase tracking-wide text-white">
        <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-white" aria-hidden="true" />
        FORMULA PEMBUAHAN MAXIMAL: CEGAH RONTOK, LEBATKAN BUAH & BISA COD!
      </p>
    </div>

    <!-- 2. HERO SECTION -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-7">
        <div class="mx-auto mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#FFF5E5] px-3.5 py-1 text-[11.5px] font-extrabold text-[#EC7211] border border-[#FFEACC]">
          <Icon name="lucide:sparkles" class="h-3.5 w-3.5 text-[#EC7211]" />
          NUTRISI KALIUM & FOSFAT SUPER PEKAT
        </div>
        <h1 class="mx-auto max-w-[440px] text-[clamp(32px,8.8vw,36px)] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Bunga Tidak Boleh Rontok! <span class="hl-brush">Panen Buah Bergelayutan Lebat!</span>
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[16px] font-semibold leading-relaxed text-slate-700">
          Pupuk Pelebat Buah racikan khusus merangsang pembuahan lebat & mengunci calon buah. <strong class="font-bold text-slate-950">Kunci bunga agar tidak rontok diterjang angin & hujan.</strong> <span class="font-bold text-slate-950 underline decoration-[#FF9900]/60 decoration-2 underline-offset-4">Hasil panen bobot jumbo melimpah, buah lebih manis!</span>
        </p>
      </div>

      <!-- HERO IMAGE -->
      <div class="mt-6 w-full">
        <img
          src={product.heroImage}
          alt="Nutrisi Organik Pupuk Pelebat Buah-Buahan Super 250 Gram"
          class="w-full h-auto block"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="800"
          height="800"
        />
        <div class="bg-slate-950 px-4 py-3 text-center">
          <p class="flex items-center justify-center gap-1.5 text-[12.5px] font-bold text-[#FFD699]">
            <Icon name="lucide:tree-deciduous" class="h-4 w-4 text-[#FF9900] shrink-0" aria-hidden="true" />
            <span>Hasil panen bobot lebih mantap, kulit buah cerah & rasa jauh lebih manis!</span>
          </p>
        </div>
      </div>

        <div class="mt-4 flex items-center justify-center gap-3 px-4">
          <div class="flex -space-x-2">
            {testimonials.map((t) => (
              <img src={t.avatar} alt={t.name} class="h-8 w-8 rounded-full border-2 border-white object-cover" width="32" height="32" loading="eager" decoding="async" />
            ))}
          </div>
          <div class="text-left">
            <div class="flex items-center gap-0.5">
            <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
            <span class="ml-1 text-[13px] font-bold text-slate-900">4.9/5</span>
            </div>
            <p class="text-[11px] font-medium text-slate-500">dari 2.100+ petani terpuaskan</p>
          </div>
        </div>

        <div class="mt-5 flex justify-center gap-4 px-4">
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:shield-check" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Anti Rontok
          </span>
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:sparkles" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Buah Jumbo
          </span>
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:truck" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Bisa COD
          </span>
        </div>

        <div class="mt-6 border-l-2 border-[#FF9900] px-5 pl-4 text-left">
          <h2 class="text-[15px] font-bold text-slate-950">Tanaman hanya rimbun daun tidak menghasilkan uang.</h2>
          <p class="mt-1 text-[13.5px] leading-relaxed text-slate-600">Formula kalium & fosfat pekat ini memaksa nutrisi terfokus pembentukan bakal buah jumbo tanpa gugur.</p>
        </div>
    </section>

    <!-- 3. PAIN CHECKLIST (Sering Mengalami Ini?) -->
    <section class="border-t border-slate-100 bg-red-50/40 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-red-600">Masalah Utama Pohon Buah</span>
      <h2 class={sectionTitle}>Pohon Subur Rimbun Tapi <span class="hl-brush">Selalu Gagal Berbuah?</span></h2>
      <p class={`${body} mt-3 mb-6`}>Banyak pemilik tanaman kecewa bertahun-tahun merawat pohon tapi tidak pernah menikmati hasil panennya:</p>
      
      <div class="mb-6 w-full overflow-hidden rounded-xl border border-red-100 bg-white shadow-sm">
        <img fetchpriority="low" src="/images/produk/pupuk-pelebat-buah-real-detail1.webp"
          alt="Booster Tanaman Buah 250 Gram - Mencegah Rontok & Melebatkan Buah"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
          width="800"
          height="800"
        />
      </div>

      <div class="space-y-4">
        {[
          ['Bunga Rontok Berjatuhan Kena Hujan', 'Bunga sudah bermunculan tapi baru tertiup angin sedikit atau tersiram hujan langsung rontok berserakan di tanah.'],
          ['Buah Kerdil & Rasa Masam/Hambar', 'Kalaupun ada calon buah yang bertahan, ukurannya sangat kerdil dan rasanya masam atau hambar kurang berair.'],
          ['Pohon Mogok Berbuah (Fase Majal)', 'Pohon hanya membesar rimbun daun saja tapi bertahun-tahun tidak mau memproduksi tangkai bunga pembuahan.']
        ].map(([title, desc]) => (
          <div class="flex items-start gap-3.5">
            <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center text-red-600"><Icon name="lucide:x-circle" class="h-5 w-5" aria-hidden="true" /></span>
            <div>
              <h3 class="text-[16px] font-bold text-slate-900">{title}</h3>
              <p class="mt-0.5 text-[15px] leading-relaxed text-slate-600">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. EDUKASI GELAP (Mekanisme Pembuahan Maksimal) -->
    <section class="border-t border-slate-100 bg-slate-950 px-5 py-10 text-white">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#FFD699]">Mekanisme Pembuahan Maksimal</span>
      <h2 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-white">Kenapa Pupuk Ini <span class="text-[#FFD699]">Mampu Mengunci Bunga & Buah?</span></h2>
      <p class="mt-3 text-[16px] leading-relaxed text-slate-400">Kerontokan bunga terjadi karena kekosongan unsur Kalium dan Fosfat saat tanaman memasuki fase generatif. Pupuk ini bekerja 2 arah:</p>

      <div class="relative ml-2 mt-8 space-y-8 border-l border-slate-800 pl-6">
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-white ring-4 ring-slate-950">1</span>
          <h3 class="text-[16px] font-semibold text-[#FFD699]">Penstabil Tangkai Bunga (Anti Rontok)</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-slate-400">Kandungan Fosfat terlarut memperkuat ikatan sel pada tangkai bunga sehingga menempel kokoh, tahan goyangan angin & siraman hujan.</p>
        </div>
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-white ring-4 ring-slate-950">2</span>
          <h3 class="text-[16px] font-semibold text-[#FFD699]">Pengisi Pembesar Daging Buah</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-slate-400">Unsur Kalium pekat memompa penyerapan gula dan air ke dalam sel buah, membuat ukuran buah membengkak maksimal dan rasa lebih manis.</p>
        </div>
      </div>

      <div class="mt-8 overflow-hidden rounded-xl border border-slate-800 bg-slate-950">
        <img fetchpriority="low" src="/images/produk/pupuk-pelebat-buah-real-detail3.webp"
          alt="Hexagon Formulasi 100% Natural Nutrisi Organik Pupuk Pelebat Buah"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
          width="800"
          height="800"
        />
      </div>

      <div class="mt-6 rounded-md bg-slate-900 p-4">
        <p class="text-[14px] leading-relaxed text-slate-300"><strong class="text-[#FFD699]">Hasilnya:</strong> Dahan pohon sarat dengan buah jumbo manis berbobot mantap yang menempel kuat dari muda hingga siap panen!</p>
      </div>
    </section>

    <!-- 5. FOTO ASLI PRODUK & SPESIFIKASI -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Foto Asli & Hasil Panen</span>
      <h2 class={sectionTitle}>Cabang Pohon Lebat <span class="hl-brush">Penuh Buah Jumbo</span></h2>
      <p class={`${body} mt-3 mb-6`}>Dapat digunakan untuk semua jenis tanaman buah pot (tabulampot) maupun kebun pekarangan:</p>

      <div class="overflow-hidden rounded-xl border border-slate-200 bg-slate-100 mb-4">
        <img fetchpriority="low" src="/images/produk/pupuk-pelebat-buah-showcase1.webp"
          alt="Dahan Pohon Berbuah Lebat Melimpah"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
          width="800"
          height="597"
        />
      </div>
      <p class="text-[12.5px] text-slate-500 mb-6">Dahan pohon sarat dengan dompolan buah yang tumbuh lebat anti rontok.</p>

      <div class="overflow-hidden rounded-xl border border-slate-200 bg-slate-100">
        <img fetchpriority="low" src="/images/produk/pupuk-pelebat-buah-showcase2.webp"
          alt="Hasil Panen Dompolan Buah Rimbun Segar"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
          width="800"
          height="533"
        />
      </div>
      <p class="mt-2 text-[12.5px] text-slate-500">Hasil buah melimpah manis berbobot mantap di tiap cabang tanaman.</p>

      <div class="mt-8 border-t-2 border-[#FFEACC] pt-5">
        <h3 class="flex items-center gap-2 text-[15px] font-bold text-slate-950">
          <Icon name="lucide:shield-check" class="h-4.5 w-4.5 text-[#EC7211]" aria-hidden="true" />
          Spesifikasi Pupuk Pelebat Buah
        </h3>
        <div class="mt-3 space-y-2.5 text-[14px] leading-relaxed">
          <p><strong class="font-semibold text-slate-900">Formulasi:</strong> <span class="text-slate-600">Konsentrat Kalium & Fosfat Pekat + Unsur Mikro</span></p>
          <p><strong class="font-semibold text-slate-900">Bentuk:</strong> <span class="text-slate-600">Cairan pekat siap larut air</span></p>
          <p><strong class="font-semibold text-slate-900">Dosis pemakaian:</strong> <span class="box-decoration-clone bg-[#FFF5E5] px-1.5 pb-0.5 font-semibold text-slate-900">2 - 3 tutup botol per 10 liter air</span></p>
          <p><strong class="font-semibold text-slate-900">Frekuensi aplikasi:</strong> <span class="text-slate-600">Siram / semprot 1-2 minggu sekali</span></p>
        </div>
      </div>
    </section>

    <!-- 6. CARA PAKAI (3 Langkah) -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Panduan Pemakaian</span>
      <h2 class={sectionTitle}>3 Langkah Pakai Pupuk Pelebat Buah</h2>
      <p class={`${body} mt-3 mb-6`}>Sangat praktis tanpa perlu alat khusus, langsung terasa khasiatnya:</p>

      <figure class="overflow-hidden rounded-md ring-1 ring-slate-200">
        <figcaption class="flex items-center gap-2 bg-[#232F3E] px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.18em] text-white">
          <Icon name="lucide:workflow" class="h-4 w-4 shrink-0" aria-hidden="true" />
          3 Langkah Pemupukan Praktis
        </figcaption>
        <div class="flex items-start justify-between gap-1 bg-gradient-to-b from-[#FFF5E5]/60 to-white px-3 py-6">
          {[
            ['lucide:flask-conical', 'Campur Air', 'Larutkan 2-3 tutup botol pupuk ke 10 liter air bersih'],
            ['lucide:droplets', 'Siram / Semprot', 'Siramkan ke perakaran atau semprotkan halus ke dahan'],
            ['lucide:calendar-check', 'Aplikasi Rutin', 'Lakukan rutin 1-2 minggu sekali saat mulai ada bunga']
          ].map(([icon, title, sub], i, arr) => (
            <>
              <div class="flex-1 text-center">
                <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[#FF9900] text-white">
                  <Icon name={icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <h3 class="mt-2.5 text-[13px] font-bold text-slate-900">{title}</h3>
                <p class="mx-auto mt-0.5 max-w-[110px] text-[11px] leading-tight text-slate-500">{sub}</p>
              </div>
              {i < arr.length - 1 && (
                <Icon name="lucide:chevron-right" class="mt-4 h-5 w-5 shrink-0 text-[#FFD699]" aria-hidden="true" />
              )}
            </>
          ))}
        </div>
      </figure>

      <div class="mt-6 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <img fetchpriority="low" src="/images/produk/pupuk-pelebat-buah-real-detail2.webp"
          alt="Infografis Dosis Pemakaian & Keunggulan Nutrisi Organik Pelebat Buah"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
          width="800"
          height="800"
        />
      </div>
    </section>

    <!-- 7. TESTIMONIALS -->
    <section class="border-t border-slate-100 bg-[#FFF5E5]/40 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Bukti Pembeli</span>
      <h2 class={sectionTitle}>Pengalaman Panen <span class="hl-brush">Melimpah Petani</span></h2>
      <p class={`${body} mt-3 mb-8`}>Kisah nyata pekebun yang berhasil melipatgandakan panen buah:</p>

      <div class="space-y-9">
        {testimonials.map((t, index, arr) => (
          <div>
            <div class="flex items-center gap-3">
              <img
                src={t.avatar}
                alt={`Foto ${t.name}, petani pengguna pupuk`}
                class="h-11 w-11 shrink-0 rounded-full object-cover"
                width="44"
                height="44"
                loading="lazy"
                decoding="async"
              />
              <div class="min-w-0">
                <h3 class="flex items-center gap-1 text-[15px] font-bold text-slate-900">
                  {t.name}
                  <Icon name="lucide:badge-check" class="h-4 w-4 shrink-0 text-[#0073BB]" aria-hidden="true" />
                </h3>
                <p class="text-[11.5px] text-slate-500">{t.location}</p>
              </div>
              <div class="ml-auto flex gap-0.5">
                <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
              </div>
            </div>
            <p class="mt-1.5 text-[12px] font-semibold text-[#B45309]">Masalah: {t.problem}</p>
            <p class="mt-3 border-l-2 border-[#FF9900]/40 pl-3 text-[15px] italic leading-relaxed text-slate-700" set:html={`"${t.comment}"`} />
            <p class="mt-2.5 flex items-center gap-1.5 text-[13px] font-bold text-slate-900">
              <Icon name="lucide:check-circle-2" class="h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
              {t.highlight}
            </p>
            {index < arr.length - 1 && <div class="mt-8 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent" />}
          </div>
        ))}
      </div>
    </section>

    <!-- 8. JUJUR DARI AWAL -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Jujur Dari Awal</span>
      <h2 class={sectionTitle}>Aturan Pakai Agar Pembuahan Maksimal</h2>
      <p class={`${body} mt-3 mb-6`}>Agar hasil penyiraman pupuk pelebat buah bekerja optimal:</p>

      <div class="space-y-2.5 text-[15px] leading-relaxed">
        <p class="flex items-start gap-2.5">
          <Icon name="lucide:check-circle-2" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Gunakan dosis sesuai panduan, <strong class="font-semibold text-slate-900">jangan berlebihan</strong> karena konsentrat ini sangat pekat.</span>
        </p>
        <p class="flex items-start gap-2.5">
          <Icon name="lucide:check-circle-2" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Waktu penyiraman terbaik adalah <strong class="font-semibold text-slate-900">pagi hari sebelum jam 9 atau sore setelah jam 4</strong> agar nutrisi terserap sempurna.</span>
        </p>
        <p class="mt-4 flex items-start gap-2.5 border-l-2 border-[#FF9900] pl-3">
          <Icon name="lucide:info" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Untuk tanaman yang sudah bertahun-tahun mogok berbuah, perhatikan juga kecukupan sinar matahari dan pangkas dahan air yang tidak produktif.</span>
        </p>
      </div>
    </section>

    <!-- 9. BELANJA TANPA WAS-WAS / GARANSI COD -->
    <section class="border-t border-slate-100 bg-[#F2F3F3] px-5 py-10 text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center text-[#232F3E]">
        <Icon name="lucide:shield-check" class="h-12 w-12" aria-hidden="true" />
      </div>
      <h2 class="mb-2 text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Belanja Tanpa Risiko</h2>
      <h3 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950">BAYAR SETELAH BARANG SAMPAI</h3>
      <p class="mx-auto mt-4 max-w-[340px] text-[16px] leading-relaxed text-slate-600">Pesan Pupuk Pelebat Buah hari ini secara COD: Anda baru bayar ke kurir saat paket pupuk tiba di rumah.</p>

      <div class="mx-auto mt-8 max-w-[360px] space-y-6 text-left">
        {[
          ['lucide:truck', 'COD ke Seluruh Indonesia', 'Bayar tunai di tempat saat paket tiba. Tanpa perlu transfer di muka.'],
          ['lucide:package-check', 'Garansi Paket Original & Safe', 'Kemasan terbungkus rapat anti bocor. Jika bocor atau rusak di jalan, kami kirim ganti baru!'],
          ['lucide:message-circle', 'Admin Pendampingan Tanam', 'Bisa berkonsultasi takaran dan jadwal pemupukan tanaman Anda via WhatsApp admin.']
        ].map(([icon, title, desc]) => (
          <div class="flex items-start gap-4">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded bg-white text-[#232F3E]"><Icon name={icon} class="h-4.5 w-4.5" aria-hidden="true" /></span>
            <div>
              <h4 class="text-[16px] font-bold text-slate-900">{title}</h4>
              <p class="mt-1 text-[15px] leading-relaxed text-slate-500">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 10. CHECKOUT FORM -->
    <section id="checkout" class="border-t-8 border-slate-100 bg-white py-12">
      <div class="px-5 pb-8 text-center">
        <p class="mx-auto mb-3 inline-flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.14em] text-[#EC7211]">
          <Icon name="lucide:zap" class="h-4 w-4 shrink-0" aria-hidden="true" />
          Promo Pupuk Pelebat Buah COD
        </p>
        <h2 class="mx-auto max-w-[340px] text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950">
          Isi Alamat Pengiriman, <span class="hl-brush">Bayar Saat Sampai</span>
        </h2>
        <p class="mx-auto mt-4 max-w-[320px] text-[15px] leading-relaxed text-slate-600">
          Form otomatis menyesuaikan lokasi Anda. Paket dikirim aman dan rapi, bayar tunai ke kurir saat barang tiba.
        </p>
      </div>
      <GeoIpResolvedForm mode={formContext.mode} productSlug="pupuk-pelebat-buah" embedded={true} />
    </section>

    <LpMiniFooter />
    <StickyCTA productSlug="pupuk-pelebat-buah" />
    <SocialProof productSlug="pupuk-pelebat-buah" />
  </main>
