---
import BaseLayout from '../layouts/BaseLayout.astro';
import RatingStars from '../components/shared/RatingStars.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import Icon from '../components/shared/Icon.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('teh-kunyit-jahe');
if (!product) throw new Error('Product teh-kunyit-jahe not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = 'https://permatamall.shop/teh-kunyit-jahe';
const seoTitle = 'Teh Kunyit Jahe Celup Herbal - Lambung Adem & Badan Hangat Segar';
const seoDescription =
  'Teh celup rimpang kunyit jahe murni. Efektif redakan asam lambung, atasi perut kembung begah, & badan hangat bebas masuk angin. Garansi COD.';

const sectionTitle = 'text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950';
const body = 'text-[16px] leading-relaxed text-slate-600';

const testimonials = [
  {
    name: 'Mbak Ratna Swastika',
    location: 'Malang, Jawa Timur',
    avatar: '/images/petani/petani-04.webp',
    problem: 'Perut gampang kembung & begah',
    comment:
      'Rasanya hangat nikmat banget! Perut saya yang <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">gampang kembung & begah</strong> langsung <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">lega dan adem dalam hitungan menit</strong>.',
    highlight: 'Lambung adem & perut lega',
  },
  {
    name: 'Pak Sugeng Slamet',
    location: 'Kediri, Jawa Timur',
    avatar: '/images/petani/petani-08.webp',
    problem: 'Badan sering masuk angin & pegal-pegal',
    comment:
      'Langsung <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">segar badannya kalau habis minum teh ini</strong> pas masuk angin. Badan hangat, tidur nyenyak sepanjang malam.',
    highlight: 'Badan segar bebas masuk angin',
  },
  {
    name: 'Bu Sri Rahayu',
    location: 'Blitar, Jawa Timur',
    avatar: '/images/petani/petani-02.webp',
    problem: 'Asam lambung sering kumat bikin ulu hati perih',
    comment:
      'Tiap malam ulu hati <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">sering terasa perih panas akibat asam lambung</strong>. Seduh 1 kantong teh kunyit jahe ini, <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">perut langsung adem & bisa tidur pulas</strong>.',
    highlight: 'Perih ulu hati mereda pulas',
  },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={product.heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Teh Kunyit Jahe', url: '/teh-kunyit-jahe' }
  ]}

  preloadImages={[
    "/images/produk/teh-kunyit-jahe-real-detail1.webp",
    "/images/produk/teh-kunyit-jahe-real-detail2.webp"
  ]}>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <MetaLandingTracker slug="teh-kunyit-jahe" productId={product.productId} contentName={product.contentName} price={product.price} />

    <!-- 1. URGENCY TOP BAR -->
    <div class="bg-[#FF9900] px-4 py-2.5 text-center">
      <p class="flex items-center justify-center gap-1.5 text-[12px] font-extrabold uppercase tracking-wide text-white">
        <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-white" aria-hidden="true" />
        PROMO SPECIAL RP 99.000, TEH KUNYIT JAHE MURNI FREE ONGKIR & COD!
      </p>
    </div>

    <!-- 2. HERO SECTION -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-7">
        <div class="mx-auto mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#FFF5E5] px-3.5 py-1 text-[11.5px] font-extrabold text-[#EC7211] border border-[#FFEACC]">
          <Icon name="lucide:sparkles" class="h-3.5 w-3.5 text-[#EC7211]" aria-hidden="true" />
          RIMPANG ALAMI PILIHAN
        </div>
        <h1 class="mx-auto max-w-[440px] text-[clamp(32px,8.8vw,36px)] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Lambung Bebas Perih & Begah, <span class="hl-brush">Badan Hangat Segar Bugar!</span>
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[16px] font-semibold leading-relaxed text-slate-700">
          Racikan teh celup kunyit dan jahe murni untuk <strong class="font-bold text-slate-950">redakan asam lambung, atasi kembung, & badan hangat bebas masuk angin</strong>. <span class="font-bold text-slate-950 underline decoration-[#FF9900]/60 decoration-2 underline-offset-4">Tanpa pemanis buatan, tanpa pengawet.</span>
        </p>
      </div>

      <div class="mt-7">
        <div class="relative overflow-hidden bg-slate-950 aspect-[3/4] w-full">
          <img
            src={product.heroImage}
            alt="Teh Kunyit Jahe Celup Herbal"
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="800"
            height="1067"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-3 text-center backdrop-blur-sm">
            <p class="flex items-center justify-center gap-1.5 text-[12.5px] font-bold text-[#FFD699]">
              <Icon name="lucide:cup-soda" class="h-4 w-4 shrink-0 text-[#FF9900]" aria-hidden="true" />
              <span>Seduhan hangat harum alami tanpa pemanis buatan.</span>
            </p>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-center gap-3 px-4">
          <div class="flex -space-x-2">
            {testimonials.map((t) => (
              <img src={t.avatar} alt={t.name} class="h-8 w-8 rounded-full border-2 border-white object-cover" width="32" height="32" loading="eager" decoding="async" />
            ))}
          </div>
          <div class="text-left">
            <div class="flex items-center gap-0.5">
            <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
            <span class="ml-1 text-[13px] font-bold text-slate-900">4.9/5</span>
            </div>
            <p class="text-[11px] font-medium text-slate-500">dari 3.500+ pembeli terpuaskan</p>
          </div>
        </div>

        <div class="mt-5 flex justify-center gap-4 px-4">
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:heart-pulse" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Lambung Adem
          </span>
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:flame" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Badan Hangat
          </span>
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:truck" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Bisa COD
          </span>
        </div>

        <div class="mt-6 border-l-2 border-[#FF9900] px-5 pl-4 text-left">
          <h2 class="text-[15px] font-bold text-slate-950">Asam lambung & perut begah bikin tidur tidak tenang.</h2>
          <p class="mt-1 text-[13.5px] leading-relaxed text-slate-600">Perpaduan rimpang kunyit dan jahe adalah racikan alami nusantara yang paling teruji menenangkan pencernaan dan menghangatkan badan.</p>
        </div>
      </div>
    </section>

    <!-- 3. PAIN CHECKLIST SECTION -->
    <section class="border-t border-slate-100 bg-red-50/40 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-red-600">Sering Mengalami Ini?</span>
      <h2 class={sectionTitle}>Masalah Pencernaan & Masuk Angin <span class="hl-brush">Dianggap Sepele</span></h2>
      <p class={`${body} mt-3 mb-6`}>Banyak orang menahan rasa tidak nyaman di ulu hati dan badan dingin meriang:</p>
      <div class="space-y-4">
        {[
          ['Asam Lambung Naik & Perut Kembung', 'Rasa perih di ulu hati, dada panas, dan perut begah bergas yang sangat mengganggu setelah makan.'],
          ['Badan Masuk Angin & Sering Meriang', 'Badan dingin meriang, pegal-pegal di punggung, serta perut mules terasa penuh.'],
          ['Tenggorokan Gatal & Batuk Ringan', 'Sensasi gatal dan kering di saluran pernapasan yang membuat tidur malam tidak tenang.']
        ].map(([title, desc]) => (
          <div class="flex items-start gap-3.5">
            <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center text-red-600"><Icon name="lucide:x-circle" class="h-5 w-5" aria-hidden="true" /></span>
            <div>
              <h3 class="text-[16px] font-bold text-slate-900">{title}</h3>
              <p class="mt-0.5 text-[15px] leading-relaxed text-slate-600">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. EDUKASI GELAP (Mekanisme Kunyit Jahe) -->
    <section class="border-t border-slate-100 bg-slate-950 px-5 py-10 text-white">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#FFD699]">Perpaduan Rimpang Alami</span>
      <h2 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-white">Kenapa Kunyit & Jahe Murni <span class="text-[#FFD699]">Sangat Ampuh untuk Lambung?</span></h2>
      <p class="mt-3 text-[16px] leading-relaxed text-slate-400">Rimpang kunyit dan jahe memiliki efek komplementer yang saling melengkapi dalam memulihkan sistem pencernaan:</p>

      <div class="relative ml-2 mt-8 space-y-8 border-l border-slate-800 pl-6">
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-white ring-4 ring-slate-950">1</span>
          <h3 class="text-[16px] font-semibold text-[#FFD699]">Kurkuminoid Netralisir Asam Lambung</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-slate-400">Kunyit kaya kurkumin yang melapisi dinding mukosa lambung dari erosi asam berlebih dan meredakan rasa perih di ulu hati.</p>
        </div>
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-white ring-4 ring-slate-950">2</span>
          <h3 class="text-[16px] font-semibold text-[#FFD699]">Gingerol Penghangat & Pelancar Gas</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-slate-400">Jahe mengandung gingerol hangat yang mempercepat pembuangan gas terperangkap di usus serta menghentikan mual begah.</p>
        </div>
      </div>

      <div class="mt-8 overflow-hidden rounded-md">
        <img fetchpriority="low" src="/images/produk/teh-kunyit-jahe-real-detail1.webp"
          alt="Hasil seduhan harum rimpang kunyit jahe murni"
          class="w-full h-auto rounded-md object-contain bg-slate-900"
          loading="lazy"
          decoding="async"
          width="480"
          height="360"
        />
      </div>

      <div class="mt-6 rounded-md bg-slate-900 p-4">
        <p class="text-[14px] leading-relaxed text-slate-300"><strong class="text-[#FFD699]">Hasilnya:</strong> Lambung adem nyaman bebas begah, tenggorokan hangat plong, dan tubuh terasa segar sepanjang hari!</p>
      </div>
    </section>

    <!-- 5. FOTO ASLI PRODUK & SPESIFIKASI -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Foto Asli Produk</span>
      <h2 class={sectionTitle}>Lihat Kemasan & <span class="hl-brush">Isi Teh Celup</span></h2>
      <p class={`${body} mt-3 mb-6`}>Dikemas dalam kantong celup higienis siap seduh dengan kehangatan rimpang kunyit dan jahe murni:</p>

      <div class="overflow-hidden rounded-md">
        <img fetchpriority="low" src="/images/produk/teh-kunyit-jahe-real-detail2.webp"
          alt="Kemasan Teh Kunyit Jahe Celup Herbal higienis"
          class="w-full h-auto rounded-md object-contain bg-slate-900"
          loading="lazy"
          decoding="async"
          width="480"
          height="360"
        />
      </div>
      <p class="mt-2 text-[12.5px] text-slate-500">Kemasan teh celup higienis tanpa serbuk kimia atau pewarna buatan.</p>

      <div class="mt-8 border-t-2 border-[#FFEACC] pt-5">
        <h3 class="flex items-center gap-2 text-[15px] font-bold text-slate-950">
          <Icon name="lucide:shield-check" class="h-4.5 w-4.5 text-[#EC7211]" aria-hidden="true" />
          Spesifikasi Teh Kunyit Jahe
        </h3>
        <div class="mt-3 space-y-2.5 text-[14px] leading-relaxed">
          <p><strong class="font-semibold text-slate-900">Komposisi:</strong> <span class="text-slate-600">100% Rimpang Kunyit Murni & Jahe Pilihan (Curcuma longa & Zingiber officinale)</span></p>
          <p><strong class="font-semibold text-slate-900">Kemasan:</strong> <span class="box-decoration-clone bg-[#FFF5E5] px-1.5 pb-0.5 font-semibold text-slate-900">Kantong Teh Celup Higienis Pouch Kedap Udara</span></p>
          <p><strong class="font-semibold text-slate-900">Keamanan:</strong> <span class="text-slate-600">Bebas pemanis buatan, pengawet, dan pewarna sintetis</span></p>
          <p><strong class="font-semibold text-slate-900">Harga Promo:</strong> <span class="text-slate-600">Promo Khusus Rp 99.000 (Bisa COD & Free Ongkir)</span></p>
        </div>
      </div>
    </section>

    <!-- 6. CARA SEDUH (3 Langkah) -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Aturan Seduh</span>
      <h2 class={sectionTitle}>3 Langkah Menyeduh Kehangatan</h2>
      <p class={`${body} mt-3 mb-6`}>Cukup 3 menit untuk menikmati cangkir teh herbal yang hangat dan harum:</p>
      <figure class="overflow-hidden rounded-md ring-1 ring-slate-200">
        <figcaption class="flex items-center gap-2 bg-[#232F3E] px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.18em] text-white">
          <Icon name="lucide:workflow" class="h-4 w-4 shrink-0" aria-hidden="true" />
          3 Langkah Menyeduh Teh Kunyit Jahe
        </figcaption>
        <div class="flex items-start justify-between gap-1 bg-gradient-to-b from-[#FFF5E5]/60 to-white px-3 py-6">
          {[
            ['lucide:cup-soda', 'Seduh Teh', 'Celupkan 1 kantong teh ke cangkir'],
            ['lucide:flame', 'Air Panas', 'Tuang 200ml air panas mendidih'],
            ['lucide:clock', 'Tunggu 3 Menit', 'Aduk & nikmati hangat-hangat']
          ].map(([icon, title, sub], i, arr) => (
            <>
              <div class="flex-1 text-center">
                <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[#FF9900] text-white">
                  <Icon name={icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <h3 class="mt-2.5 text-[13px] font-bold text-slate-900">{title}</h3>
                <p class="mx-auto mt-0.5 max-w-[110px] text-[11px] leading-tight text-slate-500">{sub}</p>
              </div>
              {i < arr.length - 1 && (
                <Icon name="lucide:chevron-right" class="mt-4 h-5 w-5 shrink-0 text-[#FFD699]" aria-hidden="true" />
              )}
            </>
          ))}
        </div>
        <div class="flex items-center justify-center gap-1.5 border-t border-[#FFEACC] bg-[#FFF5E5]/60 px-4 py-2.5 text-center text-[12px] font-semibold text-[#232F3E]">
          <Icon name="lucide:badge-check" class="h-4 w-4 shrink-0" aria-hidden="true" />
          Bisa ditambahkan sedikit madu alami bila menyukai rasa manis herbal
        </div>
      </figure>

      <div class="mt-8 border-t border-slate-100 pt-6">
        <h3 class="text-[16px] font-extrabold tracking-tight text-slate-950">Kenapa Bukan Parutan Rimpang Mentah?</h3>
        <div class="mt-4 space-y-2.5 text-[14.5px] leading-relaxed">
          <p class="flex items-start gap-2.5">
            <Icon name="lucide:x" class="mt-1 h-4 w-4 shrink-0 text-red-600" aria-hidden="true" />
            <span class="text-slate-600">Parut rimpang sendiri: tangan kuning terkena getah kunyit, dapur kotor berantakan, dan butuh waktu lama meraciknya.</span>
          </p>
          <p class="flex items-start gap-2.5 border-l-2 border-[#FF9900] pl-3">
            <Icon name="lucide:check" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
            <span class="font-semibold text-slate-900">Teh Celup Kunyit Jahe: Praktis tinggal celup air panas, tanpa noda di tangan, dan cita rasanya konsisten nikmat.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- 7. TESTIMONI PEMBELI -->
    <section class="border-t border-slate-100 bg-[#FFF5E5]/40 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Kata Penikmat Teh</span>
      <h2 class={sectionTitle}>Cerita Mereka yang Perutnya <span class="hl-brush">Kembali Adem</span></h2>
      <p class={`${body} mt-3 mb-8`}>Ribuan keluarga Indonesia sudah membuktikannya:</p>

      <div class="space-y-9">
        {testimonials.map((t, index, arr) => (
          <div>
            <div class="flex items-center gap-3">
              <img
                src={t.avatar}
                alt={`Foto ${t.name}, pengguna Teh Kunyit Jahe`}
                class="h-11 w-11 shrink-0 rounded-full object-cover"
                width="44"
                height="44"
                loading="lazy"
                decoding="async"
              />
              <div class="min-w-0">
                <h3 class="flex items-center gap-1 text-[15px] font-bold text-slate-900">
                  {t.name}
                  <Icon name="lucide:badge-check" class="h-4 w-4 shrink-0 text-[#0073BB]" aria-hidden="true" />
                </h3>
                <p class="text-[11.5px] text-slate-500">{t.location}</p>
              </div>
              <div class="ml-auto flex gap-0.5">
                <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
              </div>
            </div>
            <p class="mt-1.5 text-[12px] font-semibold text-[#B45309]">Masalah: {t.problem}</p>
            <p class="mt-3 border-l-2 border-[#FF9900]/40 pl-3 text-[15px] italic leading-relaxed text-slate-700" set:html={`"${t.comment}"`} />
            <p class="mt-2.5 flex items-center gap-1.5 text-[13px] font-bold text-slate-900">
              <Icon name="lucide:check-circle-2" class="h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
              {t.highlight}
            </p>
            {index < arr.length - 1 && <div class="mt-8 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent" />}
          </div>
        ))}
      </div>
    </section>

    <!-- 8. JUJUR DARI AWAL -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Jujur dari Awal</span>
      <h2 class={sectionTitle}>Cocok untuk Siapa, dan Kapan ke Dokter?</h2>
      <p class={`${body} mt-3 mb-6`}>Teh Kunyit Jahe adalah minuman rimpang herbal untuk kenyamanan pencernaan dan kehangatan tubuh. Supaya Anda tidak salah beli:</p>

      <div class="space-y-2.5 text-[15px] leading-relaxed">
        <p class="flex items-start gap-2.5">
          <Icon name="lucide:check-circle-2" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Cocok untuk yang sering <strong class="font-semibold text-slate-900">kembung, perut begah, ulu hati perih ringan, dan masuk angin</strong>.</span>
        </p>
        <p class="flex items-start gap-2.5">
          <Icon name="lucide:check-circle-2" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Cocok untuk nikmati <strong class="font-semibold text-slate-900">seduhan herbal hangat alami tanpa pemanis sintetis</strong> setiap pagi atau malam.</span>
        </p>
        <p class="mt-4 flex items-start gap-2.5 border-l-2 border-red-300 pl-3">
          <Icon name="lucide:stethoscope" class="mt-1 h-4 w-4 shrink-0 text-red-600" aria-hidden="true" />
          <span class="text-slate-700">Bila Anda mengalami <strong class="font-semibold text-red-700">muntah darah, nyeri perut hebat mendadak, atau gerd kronis parah</strong>, segera periksakan diri ke dokter spesialis pencernaan. Teh herbal berfungsi menjaga kenyamanan harian.</span>
        </p>
      </div>
    </section>

    <!-- 9. BELANJA TANPA WAS-WAS / GARANSI COD -->
    <section class="border-t border-slate-100 bg-[#F2F3F3] px-5 py-10 text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center text-[#232F3E]">
        <Icon name="lucide:shield-check" class="h-12 w-12" aria-hidden="true" />
      </div>
      <h2 class="mb-2 text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Belanja Tanpa Was-Was</h2>
      <h3 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950">BAYAR SETELAH BARANG SAMPAI</h3>
