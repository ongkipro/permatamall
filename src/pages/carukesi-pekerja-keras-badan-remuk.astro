---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import {
  loadStoreCodDisabledProvinceCodes,
  resolveFormModeContext,
} from '../lib/form-mode';
import { getRuntimeEnv } from '../lib/env';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';

export const prerender = false;

const SLUG = 'carukesi-pekerja-keras-badan-remuk';
const PRODUCT_SLUG = 'soothing-gristle-gel-cream-perawatan-cream-pijat-otot-sendi';

const product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);
if (!product) return Astro.rewrite('/404');

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const codDisabledProvinceCodes = await loadStoreCodDisabledProvinceCodes(database);
const formContext = await resolveFormModeContext(
  Astro.request,
  codDisabledProvinceCodes,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;
const comparePrice = cheapest?.comparePrice ?? product.comparePrice ?? 199000;
const discount = comparePrice > price ? Math.round((1 - price / comparePrice) * 100) : 50;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;

const pekerjaBuyers = [
  { name: 'Bambang Sugianto', location: 'Surabaya', time: '3 menit lalu' },
  { name: 'Supriadi (Yanto)', location: 'Bekasi', time: '7 menit lalu' },
  { name: 'Eko Prasetyo', location: 'Karawang', time: '11 menit lalu' },
  { name: 'Dedi Kurniawan', location: 'Tangerang', time: '15 menit lalu' },
  { name: 'Agus Salim', location: 'Semarang', time: '19 menit lalu' },
];

const sectionTitle = 'text-[clamp(22px,6.8vw,26px)] font-black text-slate-950 tracking-tight leading-[1.2]';
const sectionLead = 'text-[13.5px] text-slate-600 leading-relaxed mt-2 max-w-[420px] mx-auto';
---

<BaseLayout
  title="Carukési Relaxing Gel — Solusi Badan Remuk & Pegal Kuli Pekerja Keras"
  description="Punggung remuk angkat beban, boyok linu di bengkel & otot kaku? Oles Carukési Gel: hangat tembus serat otot terdalam, pulih bertenaga dalam 10 detik."
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  image="/images/landing/carukesi-pekerja-keras-badan-remuk/hero-pekerja.webp"
  preloadImages="/images/landing/carukesi-pekerja-keras-badan-remuk/hero-pekerja.webp"
>
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-6 font-sans text-slate-900 shadow-2xl selection:bg-blue-600 selection:text-white antialiased">
    <!-- ═══ 1. URGENCY ANNOUNCEMENT BAR (TOP NON-STICKY) ═══ -->
    <header class="flex items-center justify-between border-b border-blue-950 bg-[#0B1E40] px-4 py-2.5 text-white shadow-md">
      <div class="flex items-center gap-1.5 text-[11px] font-extrabold tracking-wide">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
        </span>
        <span class="text-amber-300 font-black uppercase">PROMO HARI INI:</span>
        <span class="text-slate-100">DISKON {discount}%</span>
      </div>
      <div class="flex items-center gap-1 text-[10.5px] font-bold text-white bg-blue-800/90 px-2.5 py-0.5 rounded-full border border-blue-600/60 shadow-xs">
        <Icon name="truck" class="h-3 w-3 text-amber-300" />
        <span>BISA COD</span>
      </div>
    </header>

    <!-- ═══ 2. HERO SECTION (FULL WIDTH HERO IMAGE & FLUID ICONS) ═══ -->
    <section id="landing-hero" class="bg-white text-center pb-8">
      <div class="px-5 pt-6">
        <!-- Main Brutal Headline -->
        <h1 class="mx-auto max-w-[440px] text-[clamp(24px,7.2vw,28px)] font-black leading-[1.18] tracking-tight text-slate-950">
          Badan Remuk Angkat Beban, Pinggang Remuk &amp; <span class="box-decoration-clone rounded-[0.18em] bg-[#0B1E40] px-2 py-0.5 text-white">Otot Keras Mengunci?</span>
        </h1>

        <!-- Subtitle -->
        <p class="mx-auto mt-3 max-w-[410px] text-[15px] font-semibold leading-relaxed text-slate-700">
          <strong class="text-red-700 font-bold">Sekali Oles Hangat Meresap:</strong> Sensasi panas aktif menembus serat otot terdalam, lemaskan kram kaku seketika, bangun tidur badan enteng &amp; siap cari nafkah!
        </p>

        <!-- Star Rating Social Proof -->
        <div class="mt-3.5 flex items-center justify-center gap-1.5 text-[12.5px] font-extrabold text-slate-800">
          <div class="flex items-center gap-0.5" aria-label="Rating 5 dari 5 bintang">
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            <svg class="h-4 w-4 fill-amber-400 text-amber-400" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
          </div>
          <span class="text-slate-900 font-bold">4.9 / 5.0</span>
          <span class="text-slate-400">•</span>
          <span class="text-slate-600 font-medium">(2.650+ Pekerja Keras &amp; Lapangan)</span>
        </div>
      </div>

      <!-- Hero Visual (100% FULL WIDTH EDGE-TO-EDGE) -->
      <div class="mt-5 relative w-full overflow-hidden bg-slate-900 aspect-[5/4]">
        <img
          src="/images/landing/carukesi-pekerja-keras-badan-remuk/hero-pekerja.webp"
          alt="Carukési Relaxing Gel Solusi Badan Remuk Pekerja Keras"
          class="h-full w-full object-cover block"
          loading="eager"
          decoding="async"
          width="480"
          height="480"
        />
        <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-2.5 text-center backdrop-blur-xs">
          <p class="text-[12.5px] font-bold text-amber-300 flex items-center justify-center gap-1.5">
            <Icon name="sparkles" class="h-4 w-4 text-amber-300 shrink-0" />
            <span>Otot Kaku Langsung Lemas &amp; Segar Dalam 10 Detik</span>
          </p>
        </div>
      </div>

      <!-- Horizontal Trust Row -->
      <div class="mt-5 flex justify-center gap-4 px-4 text-slate-700">
        <span class="inline-flex items-center gap-1.5 text-[12px] font-bold text-slate-800">
          <Icon name="truck" class="h-4 w-4 text-[#0B1E40]" />
          Bisa COD
        </span>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-bold text-slate-800">
          <Icon name="lock-keyhole" class="h-4 w-4 text-[#0B1E40]" />
          Privasi 100%
        </span>
        <span class="inline-flex items-center gap-1.5 text-[12px] font-bold text-slate-800">
          <Icon name="shield-check" class="h-4 w-4 text-[#0B1E40]" />
          Resmi BPOM
        </span>
      </div>

      <!-- 4 Key Value Checkmarks (Fluid Minimalist List) -->
      <div class="mt-6 px-5 text-left space-y-3.5">
        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 mt-0.5">
            <Icon name="check" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[14.5px] font-bold text-slate-950">Atasi Pinggang Panas &amp; Boyok 'Mati Rasa'</h3>
            <p class="text-[13px] text-slate-600 mt-0.5 leading-relaxed">Meredakan tegang saraf tulang belakang akibat seharian bungkuk dan angkat karung/barang.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 mt-0.5">
            <Icon name="check" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[14.5px] font-bold text-slate-950">Bangun Subuh Badan Enteng Bertenaga</h3>
            <p class="text-[13px] text-slate-600 mt-0.5 leading-relaxed">Asam laktat (*penyebab pegal linu*) terbuang tuntas saat Anda tidur nyenyak di malam hari.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 mt-0.5">
            <Icon name="check" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[14.5px] font-bold text-slate-950">Bebas Efek Samping Obat Kimia Warung</h3>
            <p class="text-[13px] text-slate-600 mt-0.5 leading-relaxed">Tidak perlu lagi minum obat pusing/pegal kimia harian yang merusak fungsi lambung dan ginjal.</p>
          </div>
        </div>

        <div class="flex items-start gap-3">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 mt-0.5">
            <Icon name="check" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[14.5px] font-bold text-slate-950">Tidak Lengket &amp; Tidak Menodai Seragam</h3>
            <p class="text-[13px] text-slate-600 mt-0.5 leading-relaxed">Gel bening langsung meresap kering seketika tanpa bau balsem tua yang menyengat.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 3. PROBLEM AGITATION SECTION (FLUID LIST) ═══ -->
    <section class="border-t border-slate-100 bg-red-50/35 px-5 py-10">
      <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-red-600">Risiko Fisik Pekerja</span>
      <h2 class={`${sectionTitle} mt-1`}>
        Apakah Badan Anda Merasakan <span class="box-decoration-clone rounded-[0.18em] bg-[#0B1E40] px-2 py-0.5 text-white">Siksaan Kerja Ini?</span>
      </h2>
      <p class={`${sectionLead} text-left`}>
        Jangan korbankan kesehatan tulang belakang Anda demi pekerjaan. Kerusakan saraf terjepit (*HNP*) bisa membuat Anda lumpuh total!
      </p>

      <div class="mt-7 space-y-4">
        <div class="flex gap-3.5 items-start">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 mt-0.5">
            <Icon name="x" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-900">Boyok Ngilu Menusuk Saat Bangkit Dari Duduk/Jongkok</h3>
            <p class="text-[13.5px] text-slate-600 mt-0.5 leading-relaxed">Harus memegang lutut atau meja beberapa detik sebelum sanggup berdiri tegak.</p>
          </div>
        </div>

        <div class="flex gap-3.5 items-start">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 mt-0.5">
            <Icon name="x" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-900">Pundak &amp; Lengan Keras Kaku Seperti Batu</h3>
            <p class="text-[13.5px] text-slate-600 mt-0.5 leading-relaxed">Otot tegang kronis akibat seharian mengoperasikan mesin, memutar obeng, atau mengelas.</p>
          </div>
        </div>

        <div class="flex gap-3.5 items-start">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 mt-0.5">
            <Icon name="x" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-900">Ketergantungan Obat Pereda Nyeri Warung</h3>
            <p class="text-[13.5px] text-slate-600 mt-0.5 leading-relaxed">Minum obat pegal kimia setiap malam hanya menutupi sakit sesaat sambil merusak ginjal.</p>
          </div>
        </div>

        <div class="flex gap-3.5 items-start">
          <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-700 mt-0.5">
            <Icon name="x" class="h-3.5 w-3.5" />
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-900">Takut Kehilangan Penghasilan Karena Fisik Tumbang</h3>
            <p class="text-[13.5px] text-slate-600 mt-0.5 leading-relaxed">Keluarga di rumah bergantung pada fisik Anda yang sehat dan bertenaga setiap hari.</p>
          </div>
        </div>
      </div>

      <!-- Warning Callout -->
      <div class="mt-6 border-l-2 border-red-600 pl-4 text-left">
        <h3 class="text-[14.5px] font-bold text-slate-950">Solusi Pemulihan Tercepat:</h3>
        <p class="text-[13px] leading-relaxed text-slate-600 mt-0.5">
          Gel terapi oles herbal bekerja langsung di titik otot yang remuk. Lemaskan ketegangan dalam 10 detik tanpa membebani organ tubuh bagian dalam!
        </p>
      </div>
    </section>

    <!-- ═══ 4. THE SOLUTION & MECHANISM ═══ -->
    <section class="border-t border-slate-100 bg-white px-5 py-10 text-center">
      <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-[#0B1E40]">Mekanisme Kerja</span>
      <h2 class={`${sectionTitle} mt-1`}>
        Bagaimana Carukési Memulihkan Otot Yang Rusak &amp; Remuk?
      </h2>
      <p class={`${sectionLead} text-center`}>
        Formula gel mikro transparan menyerap (*Fast Absorbing*) langsung membakar asam laktat penyebab pegal berat.
      </p>

      <div class="mt-8 space-y-6 text-left">
        <div class="flex items-start gap-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#0B1E40] text-white font-black text-[14px]">
            01
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-950">Penetrasi Panas Cepat 10 Detik</h3>
            <p class="text-[13.5px] text-slate-600 mt-1 leading-relaxed">
              Rasa hangat menembus lapisan kulit tebal langsung mencairkan gumpalan otot yang kaku dan meradang.
            </p>
          </div>
        </div>

        <div class="h-px bg-slate-100 w-full" />

        <div class="flex items-start gap-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#0B1E40] text-white font-black text-[14px]">
            02
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-950">Menguras Asam Laktat &amp; Racun Otot</h3>
            <p class="text-[13.5px] text-slate-600 mt-1 leading-relaxed">
              Memperlancar aliran darah balik sehingga limbah metabolik kerja berat cepat terbuang dari tubuh.
            </p>
          </div>
        </div>

        <div class="h-px bg-slate-100 w-full" />

        <div class="flex items-start gap-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#0B1E40] text-white font-black text-[14px]">
            03
          </span>
          <div>
            <h3 class="text-[15px] font-bold text-slate-950">Kembalikan Tenaga Fisik Maksimal</h3>
            <p class="text-[13.5px] text-slate-600 mt-1 leading-relaxed">
              Bangun tidur pagi badan terasa segar bugar tanpa rasa remuk, siap bekerja mencari rezeki dengan semangat tinggi.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 5. CARA PEMAKAIAN (FULL WIDTH BANNER) ═══ -->
    <section class="border-t border-slate-100 bg-slate-50/50 pt-10 pb-10 text-center">
      <div class="px-5">
        <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-emerald-800">Petunjuk Penggunaan</span>
        <h2 class={`${sectionTitle} mt-1`}>
          3 Langkah Pulihkan Fisik Kerja Keras
        </h2>
      </div>

      <div class="mt-6 w-full overflow-hidden">
        <img
          src="/images/landing/carukesi-pekerja-keras-badan-remuk/cara-pakai-pekerja.webp"
          alt="Cara Pemakaian Carukési Gel Pada Pekerja Keras"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="mt-5 px-5">
        <div class="border-l-2 border-emerald-600 pl-4 text-left">
          <p class="text-[13px] font-semibold text-slate-800 leading-relaxed">
            💡 <strong>Anjuran Pakai:</strong> Oleskan secara merata di punggung, boyok, pundak, atau betis setelah mandi sore/malam sebelum tidur untuk pemulihan fisik total semalaman.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══ 6. SEBELUM VS SESUDAH (PERBANDINGAN VISUAL MENYATU) ═══ -->
    <section class="border-t border-slate-100 bg-white pt-10 pb-10 text-center">
      <div class="px-5">
        <span class="mb-2 block text-[11px] font-bold uppercase tracking-[0.2em] text-amber-800">Hasil Nyata</span>
        <h2 class={`${sectionTitle} mt-1`}>
          Perbedaan Nyata Pada Kekuatan Fisik Anda
        </h2>
      </div>

      <div class="mt-6 w-full overflow-hidden mb-6">
        <img
          src="/images/landing/carukesi-pekerja-keras-badan-remuk/before-after-pekerja.webp"
          alt="Sebelum vs Sesudah Menggunakan Carukési Gel Pada Otot Pekerja"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Integrated Comparison Rows -->
      <div class="px-5 grid grid-cols-2 gap-3 text-left text-[12.5px]">
        <div class="p-3.5 rounded-lg bg-red-50/60 border-l-2 border-red-500">
          <p class="font-bold text-red-700 uppercase tracking-wider mb-2">❌ SEBELUM OLES</p>
          <ul class="space-y-1.5 text-slate-700 leading-relaxed font-medium">
            <li>• Boyok remuk &amp; kaku bungkuk</li>
            <li>• Pundak tegang seperti batu</li>
            <li>• Ketergantungan obat kimia</li>
            <li>• Bangun tidur badan sakit semua</li>
          </ul>
        </div>
        <div class="p-3.5 rounded-lg bg-emerald-50/70 border-l-2 border-emerald-600">
          <p class="font-bold text-emerald-800 uppercase tracking-wider mb-2">✅ SETELAH OLES</p>
          <ul class="space-y-1.5 text-slate-900 font-bold leading-relaxed">
            <li>• Boyok enteng &amp; berdiri tegap</li>
            <li>• Otot rileks lentur bertenaga</li>
            <li>• Bebas kimia 100% aman ginjal</li>
