---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { getStorefrontProduct, getStorefrontProducts } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import {
  loadStoreCodDisabledProvinceCodes,
  resolveFormModeContext,
} from '../lib/form-mode';
import { getRuntimeEnv } from '../lib/env';
import type { Product } from '../data/products';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';

export const prerender = false;

const SLUG = 'nutrilove-cuka-apel';
const PRODUCT_SLUG = 'cuka-sari-apel-100-original';

let product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);

// Fallback preview product to ensure seamless preview/standalone renders even before D1 sync
if (!product) {
  const [firstProduct] = await getStorefrontProducts(Astro.locals);
  product = firstProduct ?? {
    productId: '17981',
    slug: PRODUCT_SLUG,
    productName: 'Cuka Sari Apel 100% Original',
    contentName: 'Cuka Sari Apel 100% Original With The Mother',
    headline: 'Paket Terapi Alami Kolesterol & Lemak Darah',
    subheadline: 'Cuka Sari Apel Murni With The Mother (Beli 1 Dapat 3)',
    seoTitle: 'NutriLove Cuka Apel With The Mother — Solusi Alami Tengkuk Kaku & Kolesterol Tinggi',
    seoDescription: 'Tengkuk leher sering kaku dan berat habis makan santan/berminyak? Terapi alami NutriLove Cuka Sari Apel Murni With The Mother bantu kikis plak kolesterol dan lancarkan aliran darah.',
    price: 97500,
    comparePrice: 199000,
    image: '/images/landing/nutrilove-cuka-apel/bundle-3-hero.webp',
    heroImage: '/images/landing/nutrilove-cuka-apel/bundle-3-hero.webp',
    category: 'Kesehatan',
    brand: 'NutriLove',
    relatedCategories: ['Kesehatan', 'Herbal'],
    description: 'Cuka Apel fermentasi alami with The Mother ukuran 500ml untuk membantu melarutkan plak kolesterol dan melancarkan sirkulasi darah.',
    benefits: [
      'Bantu melarutkan plak kolesterol & trigliserida',
      'Tengkuk dan leher belakang plong enteng',
      'Atasi kebas dan kesemutan pada jari tangan/kaki',
      'Fermentasi alami with The Mother tanpa pemanasan',
    ],
    keyPoints: [
      'Isi 500ml per botol',
      'Paket Promo Beli 1 Dapat 3 (Total 1.500 ml)',
      'Bisa COD seluruh Indonesia',
    ],
    idealFor: ['Pria dan wanita yang sering mengalami leher kaku, tensi tinggi, dan kolesterol tinggi akibat makanan berlemak'],
    offerText: 'PROMO SPESIAL: BELI 1 DAPAT 3 (Total 1.500 ml) Hanya Rp 97.500',
    ctaText: 'Pesan Sekarang (COD)',
    ratingValue: 4.9,
    reviewCount: 3840,
    soldCount: 5400,
    reviews: [],
    variants: [
      { id: '12', sku: 'BELI_2_GRATIS_2', label: 'BELI 1 Dapat 3', price: 97500, comparePrice: 199000 },
    ],
  } as Product;
}

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const codDisabledProvinceCodes = await loadStoreCodDisabledProvinceCodes(database);
const formContext = await resolveFormModeContext(
  Astro.request,
  codDisabledProvinceCodes,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price ?? 97500;
const comparePrice = cheapest?.comparePrice ?? product.comparePrice ?? 199000;
const discount = comparePrice > price ? Math.round((1 - price / comparePrice) * 100) : 51;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;

const indonesianBuyers = [
  { name: 'Pak Bambang S.', location: 'Semarang, Jawa Tengah', time: '2 menit lalu' },
  { name: 'Ibu Wahyuni', location: 'Solo, Jawa Tengah', time: '4 menit lalu' },
  { name: 'Pak Hendra T.', location: 'Bandung, Jawa Barat', time: '7 menit lalu' },
  { name: 'Ibu Hj. Maryam', location: 'Surabaya, Jawa Timur', time: '9 menit lalu' },
  { name: 'Pak Djoko W.', location: 'Jakarta Timur, DKI', time: '12 menit lalu' },
  { name: 'Ibu Sri Rahayu', location: 'Yogyakarta, DIY', time: '15 menit lalu' },
  { name: 'Pak Mulyadi', location: 'Bekasi, Jawa Barat', time: '18 menit lalu' },
  { name: 'Ibu Nurul H.', location: 'Tangerang Selatan, Banten', time: '22 menit lalu' },
];

const testimonials = [
  {
    name: 'Pak Bambang (52 th)',
    city: 'Semarang',
    occupation: 'Wiraswasta',
    rating: 5,
    highlight: 'tengkuk leher langsung plong dan hasil cek lab kolesterol turun ke 182',
    quote: 'Dulu kalau habis makan sop buntut atau gulai kambing, tengkuk leher belakang langsung kaku kayak ditarik kawat dan kepala pusing kliyengan. Terakhir cek lab kolesterol tembus 248. Setelah rutin minum 1 sendok NutriLove campur air hangat tiap pagi dan malam, tengkuk leher langsung plong dan hasil cek lab kolesterol turun ke 182. Badan berasa jauh lebih enteng bangun tidur!',
    image: '/images/landing/nutrilove-cuka-apel/testimoni-pak-bambang.webp',
  },
  {
    name: 'Ibu Wahyuni (48 th)',
    city: 'Solo',
    occupation: 'Ibu Rumah Tangga',
    rating: 5,
    highlight: 'kebas kesemutan di jari tangan dan kaki hilang',
    quote: 'Tiap subuh bangun tidur jari tangan sering kaku dan kesemutan, apalagi kalau malamnya makan gorengan. Mau minum obat kimia terus takut kena ginjal. Coba rutin NutriLove ini 3 minggu, rasanya segar buah apel asli dan sama sekali gak perih di maag. Sekarang kebas kesemutan di jari tangan dan kaki hilang sama sekali.',
    image: '/images/landing/nutrilove-cuka-apel/testimoni-ibu-wahyuni.webp',
  },
  {
    name: 'Pak Dimas (45 th)',
    city: 'Bandung',
    occupation: 'Karyawan Swasta',
    rating: 5,
    highlight: 'leher kaku gak pernah kambuh lagi walau makan enak',
    quote: 'Sering dinas luar kota dan makan berminyak bikin pundak tegang kayak mikul beban 5 kilo. Selalu sedia paket Beli 1 Dapat 3 ini di rumah dan kantor. Cukup 1 gelas pagi hari sebelum sarapan, leher kaku gak pernah kambuh lagi walau makan enak dan kepala tetap enteng seharian kerja di depan laptop.',
    image: '/images/landing/nutrilove-cuka-apel/testimoni-pak-dimas.webp',
  },
];

const sectionTitle = 'text-[clamp(21px,6.5vw,25px)] font-black text-slate-950 tracking-tight leading-[1.22]';
const sectionLead = 'text-[13.5px] sm:text-[14px] text-slate-600 leading-relaxed mt-2 max-w-[420px] mx-auto';
---

<BaseLayout
  title="NutriLove Cuka Apel With The Mother — Solusi Alami Tengkuk Kaku & Kolesterol Tinggi"
  description="Tengkuk sering kaku dan leher belakang berat habis makan santan? Terapi alami NutriLove Cuka Apel With The Mother bantu kikis plak kolesterol dan lancarkan peredaran darah."
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  image="/images/landing/nutrilove-cuka-apel/hero-banner.webp"
  preloadImages="/images/landing/nutrilove-cuka-apel/hero-banner.webp"
>
  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={price}
  />

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-28 font-sans text-slate-900 shadow-2xl selection:bg-[#0F2F1F] selection:text-white antialiased">
    
    <!-- ═══ 1. URGENCY ANNOUNCEMENT BAR (TOP) ═══ -->
    <header class="flex items-center justify-between border-b border-emerald-950 bg-[#0F2F1F] px-3.5 sm:px-4 py-2 text-white shadow-md">
      <div class="flex items-center gap-2 text-[11px] sm:text-[11.5px] font-extrabold tracking-wide min-w-0">
        <span class="flex h-2 w-2 relative shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
        </span>
        <span class="text-amber-300 font-black uppercase shrink-0">PROMO:</span>
        <span class="text-slate-100 truncate">BELI 1 DAPAT 3 (RP 97.500)</span>
      </div>
      <span class="whitespace-nowrap text-[10.5px] sm:text-[11px] font-black tracking-wider text-amber-300 bg-emerald-800/90 px-2.5 py-0.5 rounded-full border border-emerald-600/60 shadow-xs shrink-0 ml-2">
        BISA COD
      </span>
    </header>

    <!-- ═══ 2. HERO SECTION (HEADLINE, SOMATIC HOOK & BRUTAL OVERCLAIM BANNER) ═══ -->
    <section id="landing-hero" class="bg-white text-center pb-8">
      <div class="px-4 sm:px-5 pt-5 sm:pt-6">
        
        <!-- Star Rating Social Proof -->
        <div class="mb-3 inline-flex items-center justify-center gap-1.5 text-[11.5px] sm:text-[12px] font-bold text-slate-800 bg-emerald-50/90 px-3 py-1 rounded-full border border-emerald-200/80 shadow-2xs">
          <div class="flex items-center gap-0.5 shrink-0 text-amber-400 text-[13px] leading-none" role="img" aria-label="Rating 5 dari 5 bintang">
            ★ ★ ★ ★ ★
          </div>
          <span class="text-slate-900 font-extrabold">4.9 / 5.0</span>
          <span class="text-slate-400">•</span>
          <span class="text-slate-600 font-medium">(4.800+ Botol Terkirim)</span>
        </div>

        <!-- Main Impact Headline -->
        <h1 class="mx-auto max-w-[440px] text-[clamp(21px,6.8vw,26px)] font-black leading-[1.25] tracking-tight text-slate-950">
          Tengkuk Sering Kaku & Leher Belakang Berat? <span class="box-decoration-clone rounded-[0.18em] bg-red-100 text-red-700 px-1.5 py-0.5">Awas Kolesterol Jahat</span> Mulai Menyumbat
        </h1>

        <!-- Subtitle -->
        <p class="mx-auto mt-2.5 max-w-[420px] text-[13.5px] sm:text-[14.5px] font-semibold leading-relaxed text-slate-700">
          <strong class="text-emerald-950 font-bold">Bukan Sekadar Salah Bantal:</strong> Habis makan santan, gulai, rendang, atau gorengan kepala langsung kliyengan dan pundak tegang kencang? Jangan tunggu sampai pembuluh darah tersumbat total. Terapi 1 gelas rutin NutriLove Cuka Apel Murni <em>With The Mother</em> membantu mengikis plak kolesterol dan melarutkan lemak darah secara alami.
        </p>
      </div>

      <!-- ═══ FULL-WIDTH HERO BRUTAL OVERCLAIM BANNER (RATIO 4:3) ═══ -->
      <div class="mt-5 relative w-full overflow-hidden bg-slate-950 aspect-[4/3] shadow-md border-y border-red-950">
        <img
          src="/images/landing/nutrilove-cuka-apel/hero-banner.webp"
          alt="Bahaya Plak Kolesterol Menyumbat Arteri vs Terapi NutriLove Cuka Apel With The Mother"
          class="h-full w-full object-cover object-center"
          loading="eager"
          decoding="async"
          width="1200"
          height="896"
        />

        <div class="absolute top-3 right-3 bg-red-600 text-white text-[10.5px] sm:text-[11px] font-black uppercase tracking-wider px-2.5 py-1 rounded-md shadow-md border border-white/20 animate-pulse">
          PROMO: BELI 1 DAPAT 3
        </div>

        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/95 via-slate-950/80 to-transparent px-3 pt-8 pb-2.5 text-center">
          <p class="text-[11.5px] sm:text-[12.5px] font-extrabold text-amber-300 leading-tight">
            Kikis Plak Lemak Darah • Tengkuk Leher Kaku Kembali Plong
          </p>
        </div>
      </div>

      <!-- Clean Minimalist Trust Row -->
      <div class="mt-4 flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1.5 px-3 text-[11.5px] sm:text-[12px] font-bold text-slate-700">
        <span class="bg-slate-100 px-3 py-1 rounded-full text-slate-800 border border-slate-200/60">Bisa COD (Bayar di Tempat)</span>
        <span class="bg-slate-100 px-3 py-1 rounded-full text-slate-800 border border-slate-200/60">100% Fermentasi Murni</span>
        <span class="bg-slate-100 px-3 py-1 rounded-full text-slate-800 border border-slate-200/60">Garansi Anti Pecah</span>
      </div>

      <!-- 4 Key Physical Pain Points (Clean Structured Cards) -->
      <div class="mt-5 sm:mt-6 px-4 sm:px-5 text-left space-y-2.5">
        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 shadow-2xs">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-[13.5px] sm:text-[14px] font-bold text-slate-950">Tengkuk Kaku &amp; Pundak Kencang</h3>
            <span class="text-[10px] font-bold uppercase tracking-wider text-red-700 bg-red-100 px-2 py-0.5 rounded">Gejala Utama</span>
          </div>
          <p class="text-[12px] sm:text-[12.5px] text-slate-600 mt-1 leading-relaxed">Bangun tidur atau sehabis makan daging leher terasa tegang seperti ditarik kawat, susah menoleh dan pundak terasa berat.</p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 shadow-2xs">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-[13.5px] sm:text-[14px] font-bold text-slate-950">Jari Tangan &amp; Kaki Kebas / Kesemutan</h3>
            <span class="text-[10px] font-bold uppercase tracking-wider text-red-700 bg-red-100 px-2 py-0.5 rounded">Saraf Tepi</span>
          </div>
          <p class="text-[12px] sm:text-[12.5px] text-slate-600 mt-1 leading-relaxed">Aliran darah ke saraf perifer melambat karena dinding pembuluh mulai tertutup endapan plak lemak darah.</p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 shadow-2xs">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-[13.5px] sm:text-[14px] font-bold text-slate-950">Kepala Kliyengan Habis Makan Enak</h3>
            <span class="text-[10px] font-bold uppercase tracking-wider text-red-700 bg-red-100 px-2 py-0.5 rounded">Darah Kental</span>
          </div>
          <p class="text-[12px] sm:text-[12.5px] text-slate-600 mt-1 leading-relaxed">Konsumsi santan, gulai, atau gorengan bikin darah mengental seketika, suplai oksigen ke otak tersendat.</p>
        </div>

        <div class="p-3 rounded-xl bg-slate-50 border border-slate-200/80 shadow-2xs">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-[13.5px] sm:text-[14px] font-bold text-slate-950">Was-Was Kolesterol Tembus 240+</h3>
            <span class="text-[10px] font-bold uppercase tracking-wider text-red-700 bg-red-100 px-2 py-0.5 rounded">Risiko Tinggi</span>
          </div>
          <p class="text-[12px] sm:text-[12.5px] text-slate-600 mt-1 leading-relaxed">Takut ketergantungan obat kimia seumur hidup, tapi cemas risiko serangan jantung atau stroke mendadak.</p>
        </div>
      </div>

      <!-- Narrative Pivot Callout -->
      <div class="mt-5 px-4 sm:px-5 text-left">
        <div class="border-l-2 border-emerald-600 pl-3.5 bg-emerald-50/70 py-2.5 rounded-r-lg">
          <p class="text-[13px] sm:text-[13.5px] font-medium text-emerald-950 leading-relaxed italic">
            “Menurunkan kolesterol bukan tentang menahan lapar atau bergantung pada obat kimia keras seumur hidup. Cukup 1 ritual alami harian yang membersihkan sirkulasi pembuluh darah langsung dari akarnya.”
          </p>
        </div>
      </div>

      <!-- Mobile In-Between Direct CTA -->
      <div class="mt-5 px-4 sm:px-5">
        <a
          href="#form-pemesanan"
          class="flex w-full min-h-[46px] items-center justify-center rounded-xl bg-red-600 hover:bg-red-700 active:scale-[0.98] px-4 py-2.5 text-center text-[13.5px] font-black uppercase tracking-wider text-white shadow-lg shadow-red-600/20 transition-all"
        >
          Pesan Paket Beli 1 Dapat 3 (COD)
        </a>
        <p class="mt-2 text-center text-[11px] text-slate-500 font-medium">
          Bayar Tunai di Rumah Saat Barang Tiba • 100% Produk Original
        </p>
      </div>
    </section>

    <!-- ═══ 3. SECTION: REALITA BAHAYA KOLESTEROL & PENYEMPITAN ARTERI ═══ -->
    <section class="border-t border-slate-100 bg-slate-50/70 pt-10 pb-10 text-center">
      <div class="px-5">
        <span class="mb-2 block text-[11.5px] font-bold uppercase tracking-[0.2em] text-red-700">Peringatan Kesehatan</span>
        <h2 class={`${sectionTitle} mt-1`}>
          Jangan Tunggu Sampai Pembuluh Darah Tersumbat Total
        </h2>
        <p class={`${sectionLead} text-center`}>
          Kolesterol tinggi dijuluki "Silent Killer" karena plak lemak menumpuk bertahun-tahun tanpa rasa sakit hebat, sampai akhirnya pembuluh darah menyempit lebih dari 70%:
        </p>
      </div>

      <!-- IMAGE: LEHER KAKU TENGKUK TEGANG REAL FOTO (RATIO 4:3) -->
      <div class="mt-6 relative w-full overflow-hidden aspect-[4/3] bg-slate-100 shadow-2xs border-y border-slate-200/80">
        <img
          src="/images/landing/nutrilove-cuka-apel/kolesterol-leher-kaku.webp"
          alt="Gejala Kolesterol Tinggi: Leher Belakang dan Tengkuk Kaku Berat Setelah Makan"
          class="h-full w-full object-cover object-center"
          loading="lazy"
          decoding="async"
          width="1200"
          height="900"
        />
        <div class="absolute bottom-0 inset-x-0 bg-slate-950/85 backdrop-blur-xs px-4 py-2 text-center text-white">
          <p class="text-[12px] font-bold text-amber-300">
            Tengkuk kaku dan pundak tegang adalah sinyal fisik aliran darah Anda mulai terhambat oleh lemak darah.
          </p>
        </div>
      </div>

      <!-- Comparison Grid: Bahaya Dibiarkan vs Terapi NutriLove ACV -->
      <div class="mt-5 px-3.5 sm:px-4 grid grid-cols-2 gap-2 text-left">
        <div class="p-2.5 rounded-xl bg-red-50/70 border border-red-200/60 shadow-2xs">
          <p class="font-black text-red-900 uppercase tracking-wider text-[10.5px] sm:text-[11px] pb-1.5 border-b border-red-200/50 mb-2">
            Jika Dibiarkan
          </p>
          <ul class="space-y-1.5 text-slate-900 font-bold text-[11.5px] sm:text-[12px]">
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-red-600 font-black text-[11px] mt-px shrink-0">✕</span>
              <span>Plak lemak mengeras</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-red-600 font-black text-[11px] mt-px shrink-0">✕</span>
              <span>Darah kental &amp; kliyengan</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-red-600 font-black text-[11px] mt-px shrink-0">✕</span>
              <span>Ketergantungan obat</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-red-600 font-black text-[11px] mt-px shrink-0">✕</span>
              <span>Risiko stroke mendadak</span>
            </li>
          </ul>
        </div>

        <div class="p-2.5 rounded-xl bg-emerald-50/80 border border-emerald-200/70 shadow-2xs">
          <p class="font-black text-emerald-900 uppercase tracking-wider text-[10.5px] sm:text-[11px] pb-1.5 border-b border-emerald-200/50 mb-2">
            NutriLove ACV
          </p>
          <ul class="space-y-1.5 text-slate-800 font-bold text-[11.5px] sm:text-[12px]">
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-700 font-black text-[11px] mt-px shrink-0">✓</span>
              <span>Kikis plak lemak darah</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-700 font-black text-[11px] mt-px shrink-0">✓</span>
              <span>Dinding arteri lentur</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-700 font-black text-[11px] mt-px shrink-0">✓</span>
              <span>Tengkuk plong &amp; enteng</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-700 font-black text-[11px] mt-px shrink-0">✓</span>
              <span>100% Fermentasi alami</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ═══ 4. SECTION: MEKANISME BIOKIMIA ASAM ASETAT MELARUTKAN LEMAK DARAH ═══ -->
    <section class="border-t border-slate-100 bg-white pt-10 pb-10 text-center">
      <div class="px-5">
        <span class="mb-2 block text-[11.5px] font-bold uppercase tracking-[0.2em] text-[#0F2F1F]">Mekanisme Ilmiah Teruji</span>
        <h2 class={`${sectionTitle} mt-1`}>
          Bagaimana Cuka Apel Melarutkan Plak Kolesterol?
        </h2>
        <p class={`${sectionLead} text-center`}>
          Bukan klaim kosong. Senyawa Asam Asetat (Acetic Acid) murni dan Pektin aktif dari fermentasi apel asli bekerja secara biokimia di pembuluh darah:
        </p>
      </div>

      <!-- IMAGE: MEDICAL INFOGRAPHIC PEMBULUH DARAH TERSUMBAT VS BERSIH (RATIO 4:3) -->
      <div class="mt-6 relative w-full overflow-hidden aspect-[4/3] bg-slate-900 shadow-2xs border-y border-slate-200/80">
        <img
          src="/images/landing/nutrilove-cuka-apel/plak-pembuluh-darah.webp"
          alt="Perbandingan Pembuluh Darah Tersumbat Plak Kolesterol vs Aliran Darah Bersih Sehat"
          class="h-full w-full object-cover object-center"
          loading="lazy"
          decoding="async"
          width="1200"
          height="900"
        />

        <!-- Clean Semantic HTML Label Overlay (Zero Baked-in Text) -->
        <div class="absolute top-3 inset-x-3 flex justify-between gap-2">
          <span class="bg-red-600/90 backdrop-blur-xs text-white text-[10.5px] sm:text-[11px] font-bold px-2.5 py-1 rounded-md shadow-xs border border-white/20">
