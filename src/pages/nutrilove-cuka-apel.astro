                </div>

                <!-- 5 Filled Gold Stars -->
                <div class="flex items-center gap-0.5 text-amber-400 text-[12px] leading-none" role="img" aria-label={`Rating ${testi.rating} dari 5 bintang`}>
                  ★ ★ ★ ★ ★
                </div>
              </div>

              {testi.quote.includes(testi.highlight) ? (
                <p class="border-l-2 border-[#0F2F1F]/40 pl-3.5 text-[13.5px] sm:text-[14.5px] leading-relaxed text-slate-700 italic">
                  "{testi.quote.split(testi.highlight)[0]}
                  <strong class="text-slate-950 font-bold not-italic">{testi.highlight}</strong>
                  {testi.quote.split(testi.highlight)[1]}"
