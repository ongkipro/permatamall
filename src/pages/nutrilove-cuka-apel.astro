              <!-- Real Photo Proof -->
              <div class="mt-2.5 overflow-hidden rounded-xl aspect-[4/3] sm:aspect-[3/2] w-full bg-slate-100 border border-slate-200/80 shadow-2xs">
                <img
                  src={testi.image}
                  alt={`Bukti Ulasan Nyata ${testi.name}`}
                  class="h-full w-full object-cover object-center"
                  loading="lazy"
                  decoding="async"
                  width="1200"
                  height="900"
                />
              </div>
            </div>
          </>
        ))}
      </div>
    </section>

    <!-- ═══ 10. SECTION: JAMINAN KUALITAS & PENGIRIMAN AMAN ═══ -->
    <section class="border-t border-slate-100 bg-slate-50/60 px-4 sm:px-5 py-9 sm:py-10 text-center">
      <span class="mb-2 block text-[11.5px] font-bold uppercase tracking-[0.2em] text-[#0F2F1F]">Garansi Pembelian Resmi</span>
      <h2 class={`${sectionTitle} mt-1`}>
        Pengiriman Aman &amp; Bebas Khawatir
      </h2>

      <div class="mt-6 sm:mt-7 space-y-3 text-left">
        <div class="p-3.5 rounded-xl bg-white border border-slate-200/80 shadow-2xs">
          <h3 class="text-[14px] sm:text-[14.5px] font-bold text-slate-950">Packing Bubble Wrap Tebal &amp; Dus Kokoh</h3>
          <p class="text-[12.5px] sm:text-[13px] text-slate-600 mt-1 leading-relaxed">Setiap botol dibungkus bubble wrap berlapis dan dimasukkan box karton tebal khusus cairan agar tiba aman tanpa rembes.</p>
        </div>

        <div class="p-3.5 rounded-xl bg-white border border-slate-200/80 shadow-2xs">
          <h3 class="text-[14px] sm:text-[14.5px] font-bold text-slate-950">Bisa Bayar di Tempat (COD) Seluruh Indonesia</h3>
          <p class="text-[12.5px] sm:text-[13px] text-slate-600 mt-1 leading-relaxed">Bayar uang tunai dengan aman kepada kurir saat paket 3 botol tiba di alamat rumah Anda.</p>
        </div>

        <div class="p-3.5 rounded-xl bg-white border border-slate-200/80 shadow-2xs">
          <h3 class="text-[14px] sm:text-[14.5px] font-bold text-slate-950">Jaminan 100% Fermentasi Apel Murni</h3>
          <p class="text-[12.5px] sm:text-[13px] text-slate-600 mt-1 leading-relaxed">Bukan cuka sintetis atau asam cuka kimia warung. Murni fermentasi sari buah apel asli dengan induk cuka 'The Mother' yang kaya khasiat.</p>
        </div>
      </div>
    </section>

    <!-- ═══ 11. PENAWARAN KHUSUS & URGENCY PROMO (BELI 1 DAPAT 3) ═══ -->
    <section class="w-full border-t border-slate-100 bg-[#0F2F1F] text-white px-4 sm:px-5 py-7 text-center">
      <div class="max-w-[420px] mx-auto space-y-4">
        
        <!-- Countdown Timer Bar -->
        <div class="flex items-center justify-between bg-white/10 backdrop-blur-md rounded-2xl px-4 py-2.5 border border-white/20 shadow-inner">
          <span class="text-[12px] sm:text-[13px] font-extrabold text-slate-100">
            Promo Berakhir Dalam:
          </span>
          <div class="flex items-center gap-1.5 font-mono font-black text-[14px]">
            <span id="countdown-minutes" class="bg-red-600 text-white px-2.5 py-1 rounded-lg min-w-[32px] text-center shadow-md">15</span>
            <span class="text-amber-400 font-black text-[16px] leading-none animate-pulse">:</span>
            <span id="countdown-seconds" class="bg-red-600 text-white px-2.5 py-1 rounded-lg min-w-[32px] text-center shadow-md">00</span>
          </div>
        </div>

        <!-- Studio Product Bundle Shot -->
        <div class="relative w-full overflow-hidden rounded-2xl bg-white p-2 shadow-md border border-white/20">
          <img
            src="/images/landing/nutrilove-cuka-apel/bundle-3-hero.webp"
            alt="Paket Promo Beli 1 Dapat 3 NutriLove Cuka Apel 500ml Total 1.500ml"
            class="w-full aspect-square object-contain mx-auto max-h-[280px]"
            loading="lazy"
            decoding="async"
            width="1024"
            height="1024"
          />
          <div class="absolute top-3.5 right-3.5 bg-red-600 text-white text-[10.5px] font-black uppercase tracking-wider px-2.5 py-0.5 rounded-md shadow-md">
            TOTAL 1.500 ML
          </div>
        </div>

        <!-- High-Contrast Price Display -->
        <div class="space-y-1">
          <div class="inline-block bg-red-600 text-white px-3 py-1 font-black text-[12px] uppercase tracking-wider rounded-md shadow-xs">
            DISKON {discount}% HARI INI
          </div>

          <div class="flex items-baseline justify-center gap-2 pt-1">
            <span class="text-[14px] sm:text-[15px] font-medium text-slate-400 line-through">Rp{comparePrice.toLocaleString('id-ID')}</span>
            <span class="text-[30px] sm:text-[36px] font-black text-amber-300 font-mono tracking-tight leading-none">
              Rp{Math.round(price).toLocaleString('id-ID')}
            </span>
          </div>

          <div class="pt-1">
            <span class="inline-block bg-white/10 text-amber-200 border border-amber-400/30 text-[11.5px] sm:text-[12.5px] font-bold px-3 py-1.5 rounded-lg leading-tight">
              BELI 1 DAPAT 3 (Total 1.500 ml) Hanya Rp 97.500
            </span>
          </div>
        </div>

        <!-- Realtime Live Stock Bar -->
        <div class="space-y-1.5 pt-1 text-left">
          <div class="flex items-center justify-between text-[12px] sm:text-[12.5px] font-bold">
            <span class="flex items-center gap-1.5 text-slate-300">
              <span class="h-2 w-2 rounded-full bg-red-400 animate-ping shrink-0"></span>
              <span>Sisa Kuota Promo Hari Ini:</span>
            </span>
            <span id="stock-count-text" class="text-amber-300 font-mono font-bold">Tersisa 7 Paket Lagi</span>
          </div>
          <div class="w-full bg-white/20 rounded-full h-2 overflow-hidden">
            <div id="stock-progress-bar" class="bg-amber-400 h-full rounded-full transition-all duration-500" style="width: 45%;"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 12. FORMULIR PEMESANAN RESMI (CHECKOUT COD) ═══ -->
    <section id="form-pemesanan" class="bg-white px-0 pt-7 pb-4 scroll-mt-4 w-full">
      <div class="px-4 pb-2 text-center">
        <span class="inline-block text-[10.5px] sm:text-[11px] font-bold uppercase tracking-wider text-[#0F2F1F] bg-emerald-50 border border-emerald-200/80 px-3 py-1 rounded-full mb-1">
          Formulir Pemesanan Resmi
        </span>
        <h2 class="text-[20px] font-bold tracking-tight text-slate-950 leading-tight">
          Lengkapi Data Pengiriman
        </h2>
        <p class="text-[13px] sm:text-[13.5px] text-slate-600 mt-1 max-w-[380px] mx-auto leading-relaxed">
          Pilih paket di bawah dan isi alamat tujuan pengiriman. Bayar uang tunai langsung ke kurir saat 3 botol tiba di rumah (COD).
        </p>
      </div>

      <GeoIpResolvedForm
        mode={formContext.mode}
        province={formContext.province}
        productSlug={product.slug}
        selectedVariantId="12"
        embedded={true}
      />
    </section>

    <!-- ═══ STICKY MOBILE PURCHASE BAR ═══ -->
    <div
      id="sticky-purchase-bar"
      class="fixed inset-x-0 bottom-0 z-40 mx-auto flex w-full max-w-[480px] items-center justify-between border-t border-slate-200 bg-white/95 backdrop-blur-md px-4 py-2.5 pb-[max(0.75rem,env(safe-area-inset-bottom))] shadow-lg transition-all duration-300"
      style="transform: translateY(100%); opacity: 0; pointer-events: none;"
    >
      <div>
        <p class="text-[10.5px] font-bold uppercase tracking-wider text-slate-500">Harga Promo (3 Botol)</p>
        <p class="text-[16px] sm:text-[17px] font-bold text-red-700 leading-none font-mono">Rp{Math.round(price).toLocaleString('id-ID')}</p>
      </div>
      <a
        href="#form-pemesanan"
        class="inline-flex min-h-[44px] items-center justify-center bg-red-600 hover:bg-red-700 active:scale-[0.98] px-5 text-[13px] sm:text-[13.5px] font-bold uppercase tracking-wider text-white transition-all rounded-xl shadow-md shadow-red-600/20"
      >
        Pesan Sekarang (COD)
      </a>
    </div>

    <!-- Realtime Social Proof Toast -->
    <SocialProofToast
      productLabel="Cuka Sari Apel 100% Original (Beli 1 Dapat 3)"
      productImage="/images/landing/nutrilove-cuka-apel/product-thumb.webp"
      heroSelector="#landing-hero"
      formSelector="#form-pemesanan"
      buyers={indonesianBuyers}
    />
  </main>

  <script slot="head" is:inline>
    function initStickyBarObserver() {
      const stickyBar = document.getElementById('sticky-purchase-bar');
      const orderForm = document.getElementById('form-pemesanan');
      const hero = document.getElementById('landing-hero');
      if (!stickyBar) return;

      let heroVisible = true;
      let formVisible = false;

      const applyStickyVisibility = () => {
        if (heroVisible || formVisible) {
          stickyBar.style.transform = 'translateY(100%)';
          stickyBar.style.opacity = '0';
          stickyBar.style.pointerEvents = 'none';
        } else {
          stickyBar.style.transform = 'translateY(0)';
          stickyBar.style.opacity = '1';
          stickyBar.style.pointerEvents = 'auto';
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.target === hero) heroVisible = entry.isIntersecting;
            if (entry.target === orderForm) formVisible = entry.isIntersecting;
          });
          applyStickyVisibility();
        },
        { threshold: 0.05, rootMargin: '0px 0px -40px 0px' }
      );

      if (hero) observer.observe(hero);
      if (orderForm) observer.observe(orderForm);
      applyStickyVisibility();
    }

    function initCountdownTimer() {
      const minEl = document.getElementById('countdown-minutes');
      const secEl = document.getElementById('countdown-seconds');
      if (!minEl || !secEl) return;

      const DURATION_MS = 15 * 60 * 1000;
      const STORAGE_KEY = 'nutrilove_kolesterol_countdown_v1';
      let targetTime = parseInt(sessionStorage.getItem(STORAGE_KEY) || '0', 10);
      const now = Date.now();

      if (!targetTime || targetTime <= now || targetTime - now > DURATION_MS) {
        targetTime = now + DURATION_MS;
        sessionStorage.setItem(STORAGE_KEY, targetTime.toString());
      }

      const updateTimer = () => {
        const currentTime = Date.now();
        let remainingMs = targetTime - currentTime;

        if (remainingMs <= 0) {
          targetTime = currentTime + DURATION_MS;
          sessionStorage.setItem(STORAGE_KEY, targetTime.toString());
          remainingMs = DURATION_MS;
        }

        const totalSeconds = Math.floor(remainingMs / 1000);
        const mins = Math.floor(totalSeconds / 60);
        const secs = totalSeconds % 60;

        minEl.textContent = String(mins).padStart(2, '0');
        secEl.textContent = String(secs).padStart(2, '0');
      };

      updateTimer();
      setInterval(updateTimer, 1000);
    }

    function initStockCounter() {
      const stockText = document.getElementById('stock-count-text');
      const stockBar = document.getElementById('stock-progress-bar');
      if (!stockText || !stockBar) return;

      const STORAGE_KEY = 'nutrilove_kolesterol_stock_v1';
      let stock = parseInt(sessionStorage.getItem(STORAGE_KEY) || '0', 10);

      if (!stock || stock < 6 || stock > 12) {
        stock = Math.floor(Math.random() * (12 - 6 + 1)) + 6;
        sessionStorage.setItem(STORAGE_KEY, stock.toString());
      }

      const updateStockUI = (val) => {
        stockText.textContent = `Tersisa ${val} Paket Lagi`;
        const pct = Math.min(90, Math.max(35, Math.round((val / 15) * 100)));
        stockBar.style.width = `${pct}%`;
      };

      updateStockUI(stock);

      const delay = Math.floor(Math.random() * (60000 - 35000 + 1)) + 35000;
      setTimeout(() => {
        let current = parseInt(sessionStorage.getItem(STORAGE_KEY) || '0', 10);
        if (current > 3) {
          current -= 1;
          sessionStorage.setItem(STORAGE_KEY, current.toString());
          updateStockUI(current);
        }
      }, delay);
    }

    const initAll = () => {
      initStickyBarObserver();
      initCountdownTimer();
      initStockCounter();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  </script>
</BaseLayout>
