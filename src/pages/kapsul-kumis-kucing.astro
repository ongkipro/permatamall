---
import BaseLayout from '../layouts/BaseLayout.astro';
import RatingStars from '../components/shared/RatingStars.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import Icon from '../components/shared/Icon.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('kapsul-kumis-kucing');
if (!product) throw new Error('Product kapsul-kumis-kucing not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = 'https://permatamall.shop/kapsul-kumis-kucing';
const seoTitle = 'Kapsul Kumis Kucing Herbal - Peluruh Batu Ginjal & Kencing Plong';
const seoDescription =
  'Kapsul Kumis Kucing ekstrak herbal murni. Melancarkan kencing deras, hancurkan endapan batu ginjal, atasi anyang-anyangan & perih. Garansi COD.';

const sectionTitle = 'text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950';
const body = 'text-[16px] leading-relaxed text-slate-600';

const testimonials = [
  {
    name: 'Pak Hendra Sukmana',
    location: 'Cirebon, Jawa Barat',
    avatar: '/images/petani/petani-03.webp',
    problem: 'Kencing perih & sakit di pinggang sampai nahan tangis',
    comment:
      'Dulu tiap mau kencing <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">perih dan sakit banget di pinggang</strong> sampai nahan tangis. Minum kapsul kumis kucing ini 3 hari berturut-turut, keluar endapan putih dan <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">kencing langsung PLONG deras banget!</strong>',
    highlight: 'Kencing langsung PLONG & nyeri hilang',
  },
  {
    name: 'Bu Tri Wahyuni',
    location: 'Kudus, Jawa Tengah',
    avatar: '/images/petani/petani-06.webp',
    problem: 'Anyang-anyangan & pegal di pinggang belakang',
    comment:
      'Sering <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">anyang-anyangan & pegal di pinggang</strong>. Rutin minum ini kapsulnya praktis tidak berbau, sekarang <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">kencing lancar bebas perih</strong>.',
    highlight: 'Bebas anyang-anyangan & perih',
  },
  {
    name: 'Pak Gunawan',
    location: 'Sidoarjo, Jawa Timur',
    avatar: '/images/petani/petani-01.webp',
    problem: 'Endapan batu ginjal bikin badan berat',
    comment:
      'Sangat ampuh <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">meluruhkan endapan ginjal</strong>. Badan rasanya lebih ringan dan enteng bangun pagi.',
    highlight: 'Endapan ginjal luruh alami',
  },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={product.heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Kapsul Kumis Kucing', url: '/kapsul-kumis-kucing' }
  ]}

  preloadImages={[
    "/images/produk/kapsul-kumis-kucing-showcase1.webp",
    "/images/produk/kapsul-kumis-kucing-showcase2.webp"
  ]}>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <MetaLandingTracker slug="kapsul-kumis-kucing" productId={product.productId} contentName={product.contentName} price={product.price} />

    <!-- URGENCY TOP BAR -->
    <div class="bg-[#FF9900] px-4 py-2 text-center">
      <p class="flex items-center justify-center gap-1.5 text-[12px] font-extrabold tracking-wide text-white uppercase">
        <Icon name="lucide:zap" class="h-4 w-4 shrink-0" aria-hidden="true" />
        KUMIS KUCING EXTRACT MURNI: GARANSI BISA COD BAYAR DI TEMPAT!
      </p>
    </div>

    <!-- HERO SECTION -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-7">
        <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Ekstrak Herbal Saluran Kemih & Ginjal</span>
        <h1 class="mx-auto max-w-[440px] text-[clamp(32px,8.8vw,36px)] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Batu Ginjal Hancur Luruh, <span class="hl-brush">Kencing Langsung Plong Deras!</span>
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[16px] font-semibold leading-relaxed text-slate-700">
          Ekstrak Kapsul Kumis Kucing murni untuk <strong class="font-bold text-slate-950">hancurkan batu ginjal, atasi anyang-anyangan & kencing perih</strong> secara alami. <span class="font-bold text-slate-950 underline decoration-[#FF9900]/60 decoration-2 underline-offset-4">Tanpa bahan kimia, tanpa efek samping.</span>
        </p>
      </div>

      <!-- HERO IMAGE -->
      <div class="mt-7">
        <div class="relative w-full overflow-hidden bg-slate-950 shadow-2xl ring-1 ring-slate-800">
          <div class="aspect-[9/16] w-full overflow-hidden">
            <img
              src={product.heroImage}
              alt="Kapsul Kumis Kucing Herbal Peluruh Batu Ginjal"
              class="h-full w-full object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="941"
              height="1672"
            />
          </div>
          <div class="bg-slate-950/95 border-t border-slate-800/80 px-4 py-3 text-center backdrop-blur-sm">
            <p class="flex items-center justify-center gap-1.5 text-[12.5px] font-bold text-[#FFD699]">
              <Icon name="lucide:shield-check" class="h-4 w-4 shrink-0 text-[#FF9900]" aria-hidden="true" />
              <span>FORMULASI EKSTRAK PEKAT 100% HERBAL MURNI PELURUH BATU GINJAL</span>
            </p>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-center gap-3 px-4">
          <div class="flex -space-x-2">
            {testimonials.map((t) => (
              <img src={t.avatar} alt={t.name} class="h-8 w-8 rounded-full border-2 border-white object-cover" width="32" height="32" loading="eager" decoding="async" />
            ))}
          </div>
          <div class="text-left">
            <div class="flex items-center gap-0.5">
            <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
            <span class="ml-1 text-[13px] font-bold text-slate-900">4.9/5</span>
            </div>
            <p class="text-[11px] font-medium text-slate-500">dari 2.950+ pembeli puas</p>
          </div>
        </div>

        <div class="mt-5 flex justify-center gap-4 px-4">
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:droplets" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Peluruh Batu Ginjal
          </span>
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:activity" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Bebas Anyang-Anyangan
          </span>
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:truck" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Bisa COD
          </span>
        </div>

        <div class="mt-6 border-l-2 border-[#FF9900] px-5 pl-4 text-left">
          <h2 class="text-[15px] font-bold text-slate-950">Anyang-anyangan & kencing perih jangan dianggap remeh.</h2>
          <p class="mt-1 text-[13.5px] leading-relaxed text-slate-600">Itu sinyal awal kristal batu ginjal mulai mengikis saluran kemih Anda. Semakin ditunda, rasa sakitnya semakin menyiksa.</p>
        </div>
      </div>
    </section>

    <!-- PROBLEM SECTION -->
    <section class="border-t border-[#EAEDED] bg-red-50/40 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-red-600">Awas Bahaya Batu Ginjal & Infeksi</span>
      <h2 class={sectionTitle}>Gejala Menyiksa yang Sering <span class="hl-brush">Dianggap Sepele</span></h2>
      <p class={`${body} mt-3 mb-6`}>Jangan biarkan penumpukan kristal batu ginjal merusak hari-hari Anda:</p>
      <div class="space-y-4">
        {[
          ['Buang Air Kecil Terasa Perih & Panas', 'Sensasi terbakar dan sakit luar biasa tiap kali buang air kecil karena gesekan kristal garam di saluran kemih.'],
          ['Kencing Anyang-Anyangan & Tak Tuntas', 'Bolak-balik ke kamar mandi tiap 10 menit tapi kencing yang keluar cuma sedikit dan terasa tidak puas.'],
          ['Nyeri Pinggang Belakang Menjalar', 'Rasa pegal dan nyeri hebat di area pinggang belakang akibat ginjal bekerja ekstra keras menahan endapan kotoran.']
        ].map(([title, desc]) => (
          <div class="flex items-start gap-3.5">
            <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center text-red-600">
              <Icon name="lucide:x-circle" class="h-5 w-5" aria-hidden="true" />
            </span>
            <div>
              <h3 class="text-[16px] font-bold text-slate-900">{title}</h3>
              <p class="mt-0.5 text-[15px] leading-relaxed text-slate-600">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SHOWCASE SECTION -->
    <section class="border-t border-[#EAEDED] px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Foto Asli & Spesifikasi</span>
      <h2 class={sectionTitle}>Bahan Murni Diproses <span class="hl-brush">Secara Higienis</span></h2>
      <p class={`${body} mt-3 mb-6`}>Dikemas rapi dalam botol tersegel agar kualitas racikan herbal Kumis Kucing tetap terjaga utuh sampai ke tangan Anda:</p>

      <div class="w-full overflow-hidden rounded-lg bg-slate-950 shadow-2xl ring-1 ring-slate-800">
        <img fetchpriority="low" src="/images/produk/kapsul-kumis-kucing-showcase1.webp"
          alt="Kapsul Herbal Kumis Kucing Ekstrak Pekat"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
          width="941"
          height="1672"
        />
        <div class="bg-slate-950/95 border-t border-slate-800/80 px-4 py-2.5 text-center backdrop-blur-sm">
          <span class="inline-flex items-center gap-1.5 text-[11.5px] font-bold text-[#FFD699]">
            <Icon name="lucide:activity" class="h-3.5 w-3.5 text-[#FF9900]" />
            KHASIAT KHUSUS SALURAN KEMIH & PELURUH GINJAL
          </span>
        </div>
      </div>
      <p class="mt-2.5 text-center text-[12.5px] font-semibold text-slate-600">Formulasi kapsul herbal pekat murni tanpa campuran bahan kimia sintetis atau pengawet.</p>
    </section>

    <!-- MEKANISME KERJA -->
    <section class="border-t border-[#EAEDED] bg-slate-950 px-5 py-10 text-white">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#FFD699]">Mekanisme Kerja Herbal</span>
      <h2 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-white">Bagaimana Kumis Kucing <span class="text-[#FFD699]">Meluruhkan Batu Ginjal?</span></h2>
      <p class="mt-3 text-[16px] leading-relaxed text-slate-400">Senyawa aktif <em>Sinensetin</em> & <em>Kalium</em> tinggi pada daun kumis kucing bekerja secara alami melancarkan diuresis:</p>

      <div class="relative ml-2 mt-8 space-y-8 border-l border-slate-800 pl-6">
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-white ring-4 ring-slate-950">1</span>
          <h3 class="text-[16px] font-semibold text-[#FFD699]">Melarutkan Endapan Kristal Kalsium</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-slate-400">Kandungan kalium membantu mengikis ikatan kalsium oksalat pembentuk batu ginjal agar hancur bertahap menjadi endapan halus.</p>
        </div>
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-white ring-4 ring-slate-950">2</span>
          <h3 class="text-[16px] font-semibold text-[#FFD699]">Melancarkan Saluran Kemih (Diuretik)</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-slate-400">Merangsang aliran urine sehingga kencing terasa lancar, deras, serta membilas sisa kotoran dari saluran kemih.</p>
        </div>
      </div>

      <div class="mt-8 w-full overflow-hidden rounded-lg bg-slate-900 shadow-2xl ring-1 ring-slate-800">
        <img fetchpriority="low" src="/images/produk/kapsul-kumis-kucing-showcase2.webp"
          alt="Keunggulan & Sertifikasi BPOM Halal Kapsul Kumis Kucing"
          class="w-full h-auto block"
          loading="lazy"
          decoding="async"
          width="941"
          height="1672"
        />
        <div class="bg-slate-950/95 border-t border-slate-800/80 px-4 py-2.5 text-center backdrop-blur-sm">
          <span class="inline-flex items-center gap-1.5 text-[11.5px] font-bold text-[#FFD699]">
            <Icon name="lucide:shield-check" class="h-3.5 w-3.5 text-[#FF9900]" />
            SERTIFIKASI BPOM & HALAL MUI RESMI
          </span>
        </div>
      </div>

      <div class="mt-6 rounded-md bg-slate-900 p-4">
        <p class="text-[14px] leading-relaxed text-slate-300"><strong class="text-[#FFD699]">Hasilnya:</strong> kencing kembali lancar dan deras, rasa perih hilang, ginjal bersih dari endapan kristal.</p>
      </div>
    </section>

    <!-- CARA MINUM -->
    <section class="border-t border-[#EAEDED] px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Aturan Pakai</span>
      <h2 class={sectionTitle}>3 Langkah Minum Praktis</h2>
      <p class={`${body} mt-3 mb-6`}>Cukup diminum teratur setiap hari untuk hasil optimal:</p>
      <figure class="overflow-hidden rounded-md ring-1 ring-slate-200">
        <figcaption class="flex items-center gap-2 bg-[#232F3E] px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.18em] text-white">
          <Icon name="lucide:workflow" class="h-4 w-4 shrink-0" aria-hidden="true" />
          Aturan Minum Kapsul Kumis Kucing
        </figcaption>
        <div class="flex items-start justify-between gap-1 bg-gradient-to-b from-[#FFF5E5]/60 to-white px-3 py-6">
          {[
            ['lucide:pill', 'Ambil Kapsul', '2 Kapsul setelah makan'],
            ['lucide:glass-water', 'Minum Air', 'Bantu air putih hangat'],
            ['lucide:smile', 'Kencing Plong', 'Rasakan kencing deras & lega']
          ].map(([icon, title, sub], i, arr) => (
            <>
              <div class="flex-1 text-center">
                <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[#FF9900] text-white">
                  <Icon name={icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <h3 class="mt-2.5 text-[13px] font-bold text-slate-900">{title}</h3>
                <p class="mx-auto mt-0.5 max-w-[110px] text-[11px] leading-tight text-slate-500">{sub}</p>
              </div>
              {i < arr.length - 1 && (
                <Icon name="lucide:chevron-right" class="mt-4 h-5 w-5 shrink-0 text-[#FFD699]" aria-hidden="true" />
              )}
            </>
          ))}
        </div>
        <div class="flex items-center justify-center gap-1.5 border-t border-[#FFEACC] bg-[#FFF5E5]/60 px-4 py-2.5 text-center text-[12px] font-semibold text-[#232F3E]">
          <Icon name="lucide:badge-check" class="h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          Rutin minum 2x sehari untuk hasil maksimal luruhkan endapan ginjal
        </div>
      </figure>
    </section>

    <!-- TESTIMONIALS -->
    <section class="border-t border-[#EAEDED] bg-[#FFF5E5]/40 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Kata Pembeli</span>
      <h2 class={sectionTitle}>Cerita Pengguna yang <span class="hl-brush">Kencingnya Kembali Plong</span></h2>
      <p class={`${body} mt-3 mb-8`}>Ribuan pelanggan sudah merasakan sendiri khasiatnya:</p>

      <div class="space-y-9">
        {testimonials.map((t, index, arr) => (
          <div>
            <div class="flex items-center gap-3">
              <img
                src={t.avatar}
                alt={`Foto ${t.name}, pengguna Kapsul Kumis Kucing`}
                class="h-11 w-11 shrink-0 rounded-full object-cover"
                width="44"
                height="44"
                loading="lazy"
                decoding="async"
              />
              <div class="min-w-0">
                <h3 class="flex items-center gap-1 text-[15px] font-bold text-slate-900">
                  {t.name}
                  <Icon name="lucide:badge-check" class="h-4 w-4 shrink-0 text-[#0073BB]" aria-hidden="true" />
                </h3>
                <p class="text-[11.5px] text-slate-500">{t.location}</p>
              </div>
              <div class="ml-auto flex gap-0.5">
                <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
              </div>
            </div>
            <p class="mt-1.5 text-[12px] font-semibold text-[#B45309]">Masalah: {t.problem}</p>
            <p class="mt-3 border-l-2 border-[#FF9900]/40 pl-3 text-[15px] italic leading-relaxed text-slate-700" set:html={`"${t.comment}"`} />
            <p class="mt-2.5 flex items-center gap-1.5 text-[13px] font-bold text-slate-900">
              <Icon name="lucide:check-circle-2" class="h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
              {t.highlight}
            </p>
            {index < arr.length - 1 && <div class="mt-8 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent" />}
          </div>
        ))}
      </div>
    </section>

    <!-- JUJUR DARI AWAL -->
    <section class="border-t border-[#EAEDED] bg-white px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Jujur dari Awal</span>
      <h2 class={sectionTitle}>Siapa yang Cocok & <span class="hl-brush">Kapan Harus Ke Dokter</span></h2>
      <p class={`${body} mt-3 mb-6`}>Kapsul Kumis Kucing aman dikonsumsi harian sebagai perawatan herbal alami, namun harap perhatikan kriteria berikut:</p>

      <div class="space-y-4 rounded-md bg-slate-50 p-5 ring-1 ring-slate-200">
        <div class="flex items-start gap-3">
          <Icon name="lucide:check-circle-2" class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" />
          <p class="text-[14.5px] leading-relaxed text-slate-700"><strong class="text-slate-900">Sangat Cocok:</strong> Untuk penderita kencing kurang lancar, perih di akhir kencing, atau indikasi batu ginjal ukuran kecil (endapan kristal).</p>
        </div>
        <div class="flex items-start gap-3 border-t border-slate-200 pt-4">
          <Icon name="lucide:stethoscope" class="mt-0.5 h-5 w-5 shrink-0 text-amber-600" />
          <p class="text-[14.5px] leading-relaxed text-slate-700"><strong class="text-slate-900">Segera Ke Dokter:</strong> Apabila kencing disertai darah kental, demam tinggi, atau nyeri pinggang hebat tak tertahankan (indikasi batu ginjal ukuran besar yang menyumbat total).</p>
        </div>
      </div>
    </section>

    <!-- GARANSI BLOCK -->
    <section class="border-t border-[#EAEDED] bg-[#F2F3F3] px-5 py-10 text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center text-[#232F3E]">
        <Icon name="lucide:shield-check" class="h-12 w-12" aria-hidden="true" />
      </div>
      <h2 class="mb-2 text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Belanja Tanpa Was-Was</h2>
      <h3 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950">BAYAR SETELAH BARANG SAMPAI</h3>
      <p class="mx-auto mt-4 max-w-[340px] text-[16px] leading-relaxed text-slate-600">Pesan Kapsul Kumis Kucing hari ini dengan sistem COD: Anda baru bayar ke kurir saat paket sudah di tangan.</p>

      <div class="mx-auto mt-8 max-w-[360px] space-y-6 text-left">
        {[
          ['lucide:truck', 'COD ke Seluruh Indonesia', 'Bayar tunai di tempat saat paket tiba. Tidak perlu transfer di muka.'],
          ['lucide:package-check', 'Paket Sesuai Foto', 'Isi paket 100% original, dikirim rapi dan privasi terjaga.'],
          ['lucide:message-circle', 'Admin Siap Ditanya', 'Ragu soal aturan minum atau pengiriman? Chat admin via WhatsApp kapan saja.']
        ].map(([icon, title, desc]) => (
          <div class="flex items-start gap-4">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded bg-white text-[#232F3E]">
              <Icon name={icon} class="h-4.5 w-4.5" aria-hidden="true" />
            </span>
            <div>
              <h4 class="text-[16px] font-bold text-slate-900">{title}</h4>
              <p class="mt-1 text-[15px] leading-relaxed text-slate-500">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CHECKOUT SECTION -->
    <section id="checkout" class="border-t-8 border-slate-100 bg-white py-12">
      <div class="px-5 pb-8 text-center">
        <p class="mx-auto mb-3 inline-flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.14em] text-[#EC7211]">
          <Icon name="lucide:zap" class="h-4 w-4 shrink-0" aria-hidden="true" />
          Promo Kapsul Kumis Kucing
        </p>
