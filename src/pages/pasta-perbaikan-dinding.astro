---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import Icon from '../components/shared/Icon.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('pasta-perbaikan-dinding');
if (!product) throw new Error('Product pasta-perbaikan-dinding not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = 'https://permatamall.shop/pasta-perbaikan-dinding';
const seoTitle = 'Reparo Pasta Perbaikan Dinding Retak Anti Air & Jamur: Tambal Dinding Instan';
const seoDescription =
  'Reparo Pasta Perbaikan Dinding Retak 500g. Cepat kering, tahan air anti jamur, mudah dipakai DIY tanpa tukang, warna putih halus menyatu cat. COD Rp 99rb.';

const sectionTitle = 'text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950';
const body = 'text-[16px] leading-relaxed text-slate-600';

const testimonials = [
  {
    name: 'Pak Sugeng Widodo',
    location: 'Semarang, Jawa Tengah',
    avatar: '/images/petani/petani-07.webp',
    proofImage: '/images/pasta-dinding/pasta-dinding-testi-real1.webp',
    problem: 'Pusing dinding rumah retak rambut & rembes air hujan berulang kali',
    comment:
      'Dinding kamar mandi & ruang tamu <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">retak-retak rambut dan sering rembes air waktu hujan deras</strong>. Pakai Reparo ini tinggal oles & ratakan pakai kape, <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">5 menit langsung mulus rapi & tidak rembes lagi</strong>. Hemat biaya tukang!',
    highlight: 'Retak & rembes langsung mulus instan',
  },
  {
    name: 'Bu Ratna Dewi',
    location: 'Bandung, Jawa Barat',
    avatar: '/images/petani/petani-dewi.webp',
    proofImage: '/images/pasta-dinding/pasta-dinding-testi-real2.webp',
    problem: 'Tembok rumah banyak bekas paku & cat mengelupas bikin risih',
    comment:
      'Dulu risih banget lihat tembok banyak lubang paku dan cat yang ngelupas. Pas nyoba Pasta Reparo ini <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">hasilnya halus banget, warna putihnya menyatu sama tembok</strong>. Sangat praktis buat ibu-ibu!',
    highlight: 'Lubang paku tertutup halus menyatu',
  },
  {
    name: 'Pak Bambang Santoso',
    location: 'Bekasi, Jawa Barat',
    avatar: '/images/petani/petani-01.webp',
    proofImage: '/images/pasta-dinding/pasta-dinding-testi-real3.webp',
    problem: 'Khawatir dempul bau menyengat & tidak tahan lama saat kena bocor',
    comment:
      'Puas banget! Pastanya tidak ada bau kimia menyengat sama sekali. <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">Keringnya sangat cepat & benar-benar tahan air anti jamur</strong>. Paket COD aman sampai rumah.',
    highlight: 'Tahan air, anti jamur, tanpa bau',
  },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={product.heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Pasta Perbaikan Dinding', url: '/pasta-perbaikan-dinding' }
  ]}
  preloadImages={[
    {
      srcset: "/images/pasta-dinding/pasta-dinding-hero-400.webp 400w, /images/pasta-dinding/pasta-dinding-hero-600.webp 600w",
      sizes: "(max-width: 480px) 100vw, 480px"
    }
  ]}
>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <MetaLandingTracker slug="pasta-perbaikan-dinding" productId={product.productId} contentName={product.contentName} price={product.price} />

    <!-- 1. URGENCY TOP BAR -->
    <div class="bg-[#EC7211] px-4 py-2.5 text-center">
      <p class="flex items-center justify-center gap-1.5 text-[12px] font-extrabold uppercase tracking-wide text-white">
        <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-white" aria-hidden="true" />
        PROMO PASTA PERBAIKAN DINDING REPARO: DISKON 50% GARANSI RAPI & COD 99RB!
      </p>
    </div>

    <!-- 2. HERO SECTION & HERO FOTO PRODUK -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-7">
        <div class="mx-auto mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#FFF5E5] px-3.5 py-1 text-[11.5px] font-extrabold text-[#EC7211] border border-[#FFEACC]">
          <Icon name="lucide:sparkles" class="h-3.5 w-3.5 text-[#EC7211]" />
          FORMULA PASTA PENAMBAL DINDING INSTAN AJAIB
        </div>
        <h1 class="mx-auto max-w-[440px] text-[clamp(30px,8.5vw,35px)] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Tambal Dinding Retak & Rembes <span class="hl-brush">Rapi Halus Instan Tanpa Tukang!</span>
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[16px] font-semibold leading-relaxed text-slate-700">
          Pasta Penambal Dinding Reparo 500g. <strong class="font-bold text-slate-950">Dinding retak rambut, bocor lembap, berjamur, & lubang paku langsung mulus kembali dalam 5 menit!</strong> <span class="font-bold text-slate-950 underline decoration-[#EC7211]/60 decoration-2 underline-offset-4">Kering sempurna, tahan air & warna putih menyatu cat dinding tanpa bekas!</span>
        </p>
      </div>

      <!-- HERO IMAGE CONTAINER (PRESISI 1:1 FRAME SQUARE) -->
      <div class="mt-6 w-full overflow-hidden border-y border-slate-200 bg-white">
        <img
          src="/images/pasta-dinding/pasta-dinding-hero-600.webp"
          srcset="/images/pasta-dinding/pasta-dinding-hero-400.webp 400w, /images/pasta-dinding/pasta-dinding-hero-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Reparo Pasta Perbaikan Dinding Retak Instant Anti Air Anti Jamur"
          class="w-full h-auto block object-contain mx-auto"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="540"
          height="540"
        />

        <div class="bg-slate-950 px-4 py-2.5 text-center">
          <p class="flex items-center justify-center gap-1.5 text-[12.5px] font-bold text-[#FFD699]">
            <Icon name="lucide:shield-check" class="h-4 w-4 text-[#EC7211] shrink-0" aria-hidden="true" />
            <span>Formula Pasta Instant • Kedap Air & Anti Jamur • DIY Tanpa Tukang!</span>
          </p>
        </div>
      </div>
    </section>

    <!-- 3. HIGHLIGHT SPECS BAR -->
    <section class="border-y border-orange-100 bg-[#FFF5E5]/60 px-5 py-5">
      <div class="grid grid-cols-2 gap-3 text-left">
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-3 shadow-xs">
          <Icon name="lucide:clock" class="mt-0.5 h-5 w-5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[11px] font-extrabold tracking-wide uppercase text-slate-400">WAKTU KERING</p>
            <p class="text-[13.5px] font-extrabold text-slate-950">5 Menit Instan</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-3 shadow-xs">
          <Icon name="lucide:droplet-off" class="mt-0.5 h-5 w-5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[11px] font-extrabold tracking-wide uppercase text-slate-400">KETAHANAN</p>
            <p class="text-[13.5px] font-extrabold text-slate-950">Tahan Air & Jamur</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-3 shadow-xs">
          <Icon name="lucide:palette" class="mt-0.5 h-5 w-5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[11px] font-extrabold tracking-wide uppercase text-slate-400">HASIL AKHIR</p>
            <p class="text-[13.5px] font-extrabold text-slate-950">Putih Halus Menyatu</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-3 shadow-xs">
          <Icon name="lucide:truck" class="mt-0.5 h-5 w-5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[11px] font-extrabold tracking-wide uppercase text-slate-400">LAYANAN</p>
            <p class="text-[13.5px] font-extrabold text-slate-950">Garansi & COD</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. BEFORE AFTER VISUAL PROOF -->
    <section class="px-5 py-9 border-b border-slate-100">
      <div class="text-center">
        <span class="text-[11.5px] font-extrabold uppercase tracking-widest text-[#EC7211]">BUKTI PERBAIKAN REAL</span>
        <h2 class={sectionTitle + ' mt-1.5'}>Hasil Penambalan Instan</h2>
        <p class={body + ' mt-2.5 font-medium'}>
          Lihat sendiri dinding rusak retak & berlubang kembali mulus seperti dinding baru:
        </p>
      </div>

      <!-- FOTO SEBELUM SESUDAH PENAMBALAN -->
      <div class="mt-6 w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm">
        <img
          src="/images/pasta-dinding/pasta-dinding-sebelum-sesudah-600.webp"
          srcset="/images/pasta-dinding/pasta-dinding-sebelum-sesudah-400.webp 400w, /images/pasta-dinding/pasta-dinding-sebelum-sesudah-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Hasil Sebelum dan Sesudah Penambalan Dinding Retak Menggunakan Reparo"
          class="w-full h-auto block object-contain max-h-[480px] mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>

      <!-- FOTO HASIL HALUS MENYATU CAT -->
      <div class="mt-4 w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm">
        <img
          src="/images/pasta-dinding/pasta-dinding-hasil-halus-600.webp"
          srcset="/images/pasta-dinding/pasta-dinding-hasil-halus-400.webp 400w, /images/pasta-dinding/pasta-dinding-hasil-halus-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Tekstur Hasil Penambalan Reparo Halus Menyatu Dengan Warna Cat Tembok"
          class="w-full h-auto block object-contain max-h-[420px] mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>
    </section>

    <!-- 5. ALASAN MEMILIH REPARO (OVERCLAIM SECTION) -->
    <section class="px-5 py-9 border-b border-slate-100 bg-slate-50/50">
      <div class="text-center">
        <span class="text-[11.5px] font-extrabold uppercase tracking-widest text-[#EC7211]">SOLUSI TERBAIK DINDING RUMAH</span>
        <h2 class={sectionTitle + ' mt-1.5'}>5 Keunggulan Pasta Reparo</h2>
        <p class={body + ' mt-2 font-medium'}>Mengapa ribuan pemilik rumah memilih Reparo dibanding semen dempul biasa:</p>
      </div>

      <!-- FOTO KEMASAN & TAHAN AIR -->
      <div class="mt-6 grid grid-cols-2 gap-3">
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xs">
          <img
            src="/images/pasta-dinding/pasta-dinding-kemasan-600.webp"
            srcset="/images/pasta-dinding/pasta-dinding-kemasan-400.webp 400w, /images/pasta-dinding/pasta-dinding-kemasan-600.webp 600w"
            sizes="(max-width: 480px) 100vw, 480px"
            alt="Kemasan Pasta Perbaikan Dinding Reparo 500 Gram"
            class="w-full h-[150px] object-cover"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="540"
            height="540"
          />
          <div class="p-2.5 text-center">
            <p class="text-[12.5px] font-bold text-slate-950">Isi Bersih 500 Gram</p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xs">
          <img
            src="/images/pasta-dinding/pasta-dinding-tahan-air-600.webp"
            srcset="/images/pasta-dinding/pasta-dinding-tahan-air-400.webp 400w, /images/pasta-dinding/pasta-dinding-tahan-air-600.webp 600w"
            sizes="(max-width: 480px) 100vw, 480px"
            alt="Formulasi Kedap Tahan Air Anti Jamur Reparo"
            class="w-full h-[150px] object-cover"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="540"
            height="540"
          />
          <div class="p-2.5 text-center">
            <p class="text-[12.5px] font-bold text-slate-950">Kedap Air & Anti Jamur</p>
          </div>
        </div>
      </div>

      <div class="mt-6 space-y-3.5">
        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Cepat Kering & Hasil Rapi Instan</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Dempul langsung mengeras dalam hitungan menit tanpa perlu menunggu berhari-hari.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Tahan Air Rembesan & Anti Jamur/Kapang</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Membentuk lapisan waterproof kedap air yang mencegah kelembapan dinding muncul kembali.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Mudah Digunakan Sendiri (DIY Tanpa Tukang)</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Tinggal tekan tube, oleskan secukupnya, dan ratakan dengan kape. Sangat mudah & praktis!
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Hasil Halus & Warna Putih Menyatu Cat Tembok</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Warna putih krim khusus yang langsung menyamarkan retakan sehingga tampak mulus alami.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Tanpa Bau Menyengat & Ramah Lingkungan</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Bebas bahan beracun berbahaya (Non-toxic), sangat aman dipakai di dalam kamar tidur anak.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. CARA PAKAI PRAKTIS -->
    <section class="px-5 py-9 border-b border-slate-100">
      <div class="text-center">
        <span class="text-[11.5px] font-extrabold uppercase tracking-widest text-[#EC7211]">CARA PENGGUNAAN MUDAH</span>
        <h2 class={sectionTitle + ' mt-1.5'}>3 Langkah Pakai Praktis</h2>
        <p class={body + ' mt-2 font-medium'}>Siapa saja bisa menambal dinding sendiri dengan hasil sempurna:</p>
      </div>

      <!-- FOTO CARA PAKAI -->
      <div class="mt-6 w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm">
        <img
          src="/images/pasta-dinding/pasta-dinding-cara-pakai-600.webp"
          srcset="/images/pasta-dinding/pasta-dinding-cara-pakai-400.webp 400w, /images/pasta-dinding/pasta-dinding-cara-pakai-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Langkah Cara Penggunaan Pasta Perbaikan Dinding Reparo"
          class="w-full h-auto block object-contain max-h-[480px] mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>

      <div class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-xs">
        <ol class="space-y-3.5 text-[14.5px] text-slate-800">
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#EC7211] text-white font-bold text-[12px]">1</span>
            <span><strong class="font-bold text-slate-950">Bersihkan Area:</strong> Bersihkan debu, kotoran, atau sisa cat lama pada area tembok retak.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#EC7211] text-white font-bold text-[12px]">2</span>
            <span><strong class="font-bold text-slate-950">Oleskan Reparo:</strong> Oleskan pasta Reparo secukupnya tepat di atas permukaan yang retak.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#EC7211] text-white font-bold text-[12px]">3</span>
            <span><strong class="font-bold text-slate-950">Ratakan & Keringkan:</strong> Ratakan permukaan dengan kape spatula lalu tunggu 5 menit hingga kering mulus.</span>
          </li>
        </ol>
      </div>
    </section>

    <!-- 7. TESTIMONIALS PELANGGAN -->
    <section class="px-5 py-9 border-b border-slate-100 bg-slate-50/50">
      <div class="text-center">
        <span class="text-[11.5px] font-extrabold uppercase tracking-widest text-[#EC7211]">ULASAN PEMBELI</span>
        <h2 class={sectionTitle + ' mt-1.5'}>Testimoni Pembeli Real</h2>
      </div>

      <div class="mt-6 space-y-4">
        {testimonials.map((t) => (
          <div class="rounded-2xl border border-slate-200/80 bg-white p-4.5 shadow-xs">
            {t.proofImage && (
              <img
                src={t.proofImage}
                alt={`Foto bukti perbaikan dinding dari ${t.name}`}
                class="mb-3.5 w-full h-auto block object-contain max-h-[360px] rounded-xl border border-slate-200 bg-slate-100 mx-auto"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                width="540"
                height="959"
              />
            )}
            <div class="flex items-center gap-3">
              <img src={t.avatar} alt={t.name} class="h-10 w-10 rounded-full object-cover ring-2 ring-orange-100" />
              <div>
                <h3 class="text-[14.5px] font-bold text-slate-950">{t.name}</h3>
                <p class="text-[12px] text-slate-500">{t.location}</p>
              </div>
            </div>
            <div class="mt-3 rounded-xl bg-[#FFF5E5]/70 p-3 text-[13.5px] leading-relaxed text-slate-700">
              <p set:html={t.comment} />
            </div>
            <div class="mt-2.5 flex items-center justify-between text-[11.5px]">
              <span class="font-bold text-[#EC7211]">✓ {t.highlight}</span>
              <span class="font-semibold text-slate-400">Pembeli Terverifikasi</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 8. SOCIAL PROOF DYNAMIC -->
    <SocialProof productSlug="pasta-perbaikan-dinding" />

    <!-- 9. PRICING & HARGA SECTION (CHECKOUT FORM) -->
    <section id="checkout" class="border-t-8 border-slate-100 bg-white py-12">
      <div class="px-5 pb-8 text-center">
        <p class="mx-auto mb-3 inline-flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.14em] text-[#EC7211]">
          <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          Promo Pasta Reparo Dinding COD
        </p>
        <h2 class="mx-auto max-w-[340px] text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950">
          Isi Alamat Pengiriman, <span class="hl-brush">Bayar Saat Sampai</span>
        </h2>
        <p class="mx-auto mt-4 max-w-[320px] text-[15px] leading-relaxed text-slate-600">
          Form otomatis menyesuaikan lokasi Anda. Produk dikirim aman rapi, bayar tunai ke kurir saat barang tiba di rumah.
        </p>
      </div>

      <!-- FOTO BANNER GARANSI PROMO -->
      <div class="mx-auto mb-6 max-w-[440px] px-5">
        <div class="overflow-hidden rounded-2xl border border-slate-200 shadow-sm">
          <img
            src="/images/pasta-dinding/pasta-dinding-garansi-600.webp"
            srcset="/images/pasta-dinding/pasta-dinding-garansi-400.webp 400w, /images/pasta-dinding/pasta-dinding-garansi-600.webp 600w"
            sizes="(max-width: 480px) 100vw, 480px"
            alt="Banner Garansi Promo Pasta Perbaikan Dinding Reparo COD"
