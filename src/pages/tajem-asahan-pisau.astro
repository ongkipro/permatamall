---
import BaseLayout from '../layouts/BaseLayout.astro';
import RatingStars from '../components/shared/RatingStars.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import Icon from '../components/shared/Icon.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('asahan-portable');
if (!product) throw new Error('Product asahan-portable not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = 'https://permatamall.shop/tajem-asahan-pisau';
const seoTitle = 'TAJEM Asahan Pisau - Pisau Tumpul Tajam Lagi 10 Detik';
const seoDescription =
  'Asahan pisau genggam TAJEM: mata asah bersudut tetap, gesek 5-10 kali pisau tumpul kembali tajam. Travel size, muat di laci. Paket Beli 1 & Beli 2. Bisa COD.';

const sectionTitle = 'text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950';
const body = 'text-[16px] leading-relaxed text-slate-600';

const testimonials = [
  {
    name: 'Bu Imas',
    location: 'Garut, Jawa Barat',
    avatar: '/images/tajem/testi-imas.webp',
    proofPhoto: '/images/tajem/testi-imas-3x2.webp',
    problem: 'Pisau warung tumpul, motong daging jadi lama',
    comment:
      'Pisau di warung saya dipakai nonstop, <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">motong daging aja sampai digergaji-gergaji</strong>. Anak saya beliin TAJEM, digesek sebentar eh <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">sekali tebas langsung putus</strong>. Sekarang tiap pagi sebelum buka warung pasti saya gesek dulu.',
    highlight: 'Persiapan warung jauh lebih cepat',
  },
  {
    name: 'Pak Anwar',
    location: 'Pontianak, Kalimantan Barat',
    avatar: '/images/tajem/testi-anwar.webp',
    proofPhoto: '/images/tajem/testi-anwar-3x2.webp',
    problem: 'Pisau lipat buat mancing dan kemah sudah tumpul lama',
    comment:
      'Pisau lipat saya buat mancing <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">udah setahun tumpul, mau motong senar aja susah</strong>. TAJEM ini kecil, masuk kotak pancing. Gesek 10 kali di tepi sungai, <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">tajamnya balik kayak baru beli</strong>.',
    highlight: 'Praktis dibawa mancing dan kemah',
  },
  {
    name: 'Mbak Dita',
    location: 'Kendari, Sulawesi Tenggara',
    avatar: '/images/tajem/testi-dita.webp',
    proofPhoto: '/images/tajem/testi-dita-3x2.webp',
    problem: 'Motong tomat dan bawang selalu penyet',
    comment:
      'Saya kira pisau saya yang jelek, <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">motong tomat malah gepeng semua</strong>. Ternyata cuma tumpul. Habis digesek TAJEM, <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">irisan tomat tipis-tipis rapi banget</strong>. Nyesel nggak beli dari dulu.',
    highlight: 'Irisan kembali tipis dan rapi',
  },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image="/images/produk/asahan-portable-pakai.webp"
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'TAJEM Asahan Pisau', url: '/tajem-asahan-pisau' }
  ]}

  preloadImages={[
    "/images/tajem/tajem-hero.webp",
    "/images/tajem/testi-imas.webp"
  ]}>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <MetaLandingTracker slug="tajem-asahan-pisau" productId={product.productId} contentName={product.contentName} price={product.price} />

    <!-- TOP URGENCY BAR -->
    <div class="bg-[#FF9900] px-4 py-2 text-center">
      <p class="flex items-center justify-center gap-1.5 text-[12px] font-extrabold tracking-wide text-white">
        <Icon name="lucide:zap" class="h-4 w-4 shrink-0" aria-hidden="true" />
        PISAU TUMPUL 10 TAHUN? GESEK 5 DETIK TAJAM BRUTAL. BISA COD
      </p>
    </div>

    <!-- HERO SECTION -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-7">
        <div class="mx-auto mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#FFF5E5] px-3.5 py-1 text-[11.5px] font-extrabold text-[#EC7211] border border-[#FFEACC]">
          <Icon name="lucide:flame" class="h-3.5 w-3.5 text-[#EC7211]" />
          ASAHAN PORTABLE SUPER TAJAM
        </div>
        <h1 class="mx-auto max-w-[440px] text-[clamp(32px,8.8vw,36px)] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Pisau Tumpul Bikin Emosi Tiap Masak? <span class="hl-brush">Gesek 5 Detik, Tajam Brutal Lagi</span> Pakai TAJEM!
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[16px] font-semibold leading-relaxed text-slate-700">
          Tanpa batu asah, tanpa air, tanpa skill. Cukup tarik pisau di celah TAJEM <strong class="font-bold text-slate-950">5 kali</strong>, daging beku & tomat langsung teriris <span class="font-bold text-slate-950 underline decoration-[#FF9900]/60 decoration-2 underline-offset-4">sekali tebas tanpa sisa!</span>
        </p>
      </div>

      <div class="mt-7">
        <!-- UNCROPPED HERO IMAGE SCRAPED FROM AMANAHIN.MY.ID -->
        <div class="relative w-full overflow-hidden bg-slate-950 shadow-2xl ring-1 ring-slate-800">
          <div class="aspect-square w-full overflow-hidden">
            <img
              src="/images/tajem/tajem-hero.webp"
              alt="Demo tajam brutal pisau dapur mengiris tipis daging dan tomat setelah diasah dengan TAJEM portable sharpener"
              class="h-full w-full object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width="2048"
              height="2048"
            />
          </div>
          <div class="bg-slate-950/95 border-t border-slate-800/80 px-4 py-3 text-center backdrop-blur-sm">
            <p class="flex items-center justify-center gap-1.5 text-[12.5px] font-bold text-[#FFD699]">
              <Icon name="lucide:utensils" class="h-4 w-4 shrink-0 text-[#FF9900]" aria-hidden="true" />
              <span>Sekali gesek 5 detik, mata pisau tumpul kembali tajam presisi seperti baru dari pabrik.</span>
            </p>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-center gap-2.5 px-4">
          <div class="flex -space-x-2 overflow-hidden">
            <img src="/images/tajem/testi-imas.webp" alt="Avatar Bu Imas" class="inline-block h-7 w-7 rounded-full object-cover ring-2 ring-white" width="28" height="28" loading="eager" decoding="async" />
            <img src="/images/tajem/testi-anwar.webp" alt="Avatar Pak Anwar" class="inline-block h-7 w-7 rounded-full object-cover ring-2 ring-white" width="28" height="28" loading="eager" decoding="async" />
            <img src="/images/tajem/testi-dita.webp" alt="Avatar Mbak Dita" class="inline-block h-7 w-7 rounded-full object-cover ring-2 ring-white" width="28" height="28" loading="eager" decoding="async" />
          </div>
          <div class="flex items-center gap-1">
            <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
            <span class="text-[13px] font-bold text-slate-900">{product.ratingValue}/5</span>
            <p class="text-[11px] font-medium text-slate-500">dari {(product.soldCount ?? 0).toLocaleString('id-ID')}+ pembeli</p>
          </div>
        </div>

        <div class="mt-5 flex justify-center gap-4 px-4">
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:ruler" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Travel Size
          </span>
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:hand" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Gagang Anti Licin
          </span>
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:truck" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Bisa COD
          </span>
        </div>

        <div class="mt-6 border-l-2 border-[#FF9900] px-5 pl-4 text-left">
          <h2 class="text-[15px] font-bold text-slate-950">Pisau tumpul bukan cuma bikin lama.</h2>
          <p class="mt-1 text-[13.5px] leading-relaxed text-slate-600">Ia memaksa Anda menekan lebih keras, dan di situlah pisau paling sering meleset ke jari. Pisau tajam justru lebih aman.</p>
        </div>
      </div>
    </section>

    <!-- PROBLEM SECTION -->
    <section class="border-t border-[#EAEDED] bg-red-50/40 px-5 py-10">
      <span class="text-[11px] font-extrabold uppercase tracking-[0.2em] text-red-600 block mb-1">SERING MENGALAMI INI?</span>
      <h2 class={sectionTitle}>Tanda Pisau Anda Sudah <span class="text-red-600 underline decoration-red-400 decoration-2 underline-offset-4">Minta Diasah</span></h2>
      <p class={`${body} mt-3 mb-6 text-slate-700`}>Kalau salah satu saja terjadi di dapur Anda, pisau itu sudah lama menyiksa Anda diam-diam:</p>
      
      <div class="space-y-3.5">
        {[
          ['Tomat Penyet, Bawang Hancur', 'Bukan teriris rapi, bahan malah gepeng tertekan. Pisau tumpul menghancurkan serat, bukan memotongnya.'],
          ['Masak Jadi Dua Kali Lebih Lama', 'Satu ekor ayam yang harusnya beres 5 menit jadi setengah jam. Tangan pegal duluan sebelum masakan jadi.'],
          ['Pisau Sering Meleset, Jari Terancam', 'Karena tumpul, Anda menekan lebih keras. Sekali licin, mata pisau lari ke jari. Ini penyebab luka dapur paling umum.']
        ].map(([title, desc]) => (
          <div class="flex items-start gap-3.5 rounded-xl bg-white p-4 border border-red-100">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-red-100 text-red-600">
              <Icon name="lucide:x" class="h-4 w-4 text-red-600" aria-hidden="true" />
            </span>
            <div>
              <h3 class="text-[15px] font-bold text-slate-950">{title}</h3>
              <p class="text-[13.5px] text-slate-600 mt-1 leading-relaxed">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- PRODUCT KNOWLEDGE / EDUCATION -->
    <section class="border-t border-[#EAEDED] bg-slate-950 px-5 py-10 text-white">
      <span class="text-[11px] font-extrabold uppercase tracking-[0.2em] text-[#FF9900] block mb-1">KENAPA BISA BEGITU</span>
      <h2 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-white">Semua Pisau Pasti Tumpul: <span class="text-[#FF9900]">Masalahnya di Tepi Mata Pisau</span></h2>
      <p class="mt-3 text-[15px] leading-relaxed text-slate-300">Tepi mata pisau itu setipis rambut. Setiap kali beradu dengan talenan, tepi tipis ini pelan-pelan rusak lewat dua tahap:</p>

      <div class="relative ml-2 mt-8 space-y-8 border-l border-slate-800 pl-6">
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-slate-950 ring-4 ring-slate-950">1</span>
          <h3 class="text-[16px] font-bold text-[#FFEACC]">Tepi Pisau Melengkung dan Terlipat</h3>
          <p class="mt-1.5 text-[14px] leading-relaxed text-slate-300">Tiap benturan dengan talenan membuat tepi tipis pisau bengkok sedikit demi sedikit ke samping. Mata pisau masih ada, tapi arahnya sudah tidak lurus.</p>
        </div>
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-slate-950 ring-4 ring-slate-950">2</span>
          <h3 class="text-[16px] font-bold text-[#FFEACC]">Tepi Membulat, Pisau Resmi Tumpul</h3>
          <p class="mt-1.5 text-[14px] leading-relaxed text-slate-300">Lama-lama tepi yang terlipat itu aus dan membulat. Yang menyentuh bahan makanan bukan lagi sudut tajam, tapi permukaan tumpul. Mau ditekan sekuat apa pun, hasilnya penyet.</p>
        </div>
      </div>

      <div class="mt-8 -mx-5 w-[calc(100%+2.5rem)] overflow-hidden bg-slate-900 shadow-2xl ring-1 ring-slate-800">
        <div class="aspect-square w-full overflow-hidden">
          <img fetchpriority="low" src="/images/tajem/tajem-showcase1.webp"
            alt="Perbandingan sebelum dan sesudah: pisau tumpul merusak serat bahan vs pisau tajam mengiris tomat tipis setelah digesek TAJEM"
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
            width="2048"
            height="2048"
          />
        </div>
        <div class="bg-slate-950/95 border-t border-slate-800/80 px-4 py-2.5 text-center backdrop-blur-sm">
          <span class="inline-flex items-center gap-1.5 text-[11.5px] font-bold text-[#FFD699]">
            <Icon name="lucide:zap" class="h-3.5 w-3.5 text-[#FF9900]" />
            MATA ASAH LOGAM KHUSUS SUDUT V PRESISI
          </span>
        </div>
      </div>
      <p class="mt-2.5 text-center text-[12.5px] text-slate-400">Teknologi celah bersudut V mengembalikan ketajaman presisi bilah pisau.</p>

      <div class="mt-8 rounded-xl bg-slate-900 p-4 border border-slate-800">
        <p class="text-[14px] leading-relaxed text-slate-300"><strong class="text-[#FF9900]">Di sinilah TAJEM bekerja:</strong> celah asah di kepala logamnya sudah diatur pada sudut tetap. Saat pisau ditarik melewati celah itu, tepi yang terlipat diluruskan dan lapisan tumpul terkikis tipis, sudut tajam terbentuk lagi dalam hitungan detik.</p>
      </div>
    </section>

    <!-- PRODUCT SHOWCASE -->
    <section class="border-t border-[#EAEDED] px-5 py-10">
      <span class="text-[11px] font-extrabold uppercase tracking-[0.2em] text-[#EC7211] block mb-1">FOTO ASLI PRODUK</span>
      <h2 class={sectionTitle}>Sekecil Ini, Tapi <span class="hl-brush">Kerjanya Brutal</span></h2>
      <p class={`${body} mt-3 mb-6`}>Bentuknya cuma segenggam tangan, seperti gagang pisau. Taruh di laci dapur, kotak perkakas, atau tas kemah:</p>

      <div class="-mx-5 w-[calc(100%+2.5rem)] overflow-hidden bg-slate-950 shadow-2xl ring-1 ring-slate-800">
        <div class="aspect-square w-full overflow-hidden">
          <img fetchpriority="low" src="/images/tajem/tajem-showcase2.webp"
            alt="Foto asli asahan portable TAJEM dengan gagang ergonomis bertekstur dan mata asah logam di ujungnya"
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
            width="2048"
            height="2048"
          />
        </div>
        <div class="bg-slate-950/95 border-t border-slate-800/80 px-4 py-2.5 text-center backdrop-blur-sm">
          <span class="inline-flex items-center gap-1.5 text-[11.5px] font-bold text-[#FFD699]">
            <Icon name="lucide:ruler" class="h-3.5 w-3.5 text-[#FF9900]" />
            DESAIN PORTABLE & GAGANG ANTI LICIN
          </span>
        </div>
      </div>
      <p class="mt-2.5 text-[12.5px] text-slate-500 text-center">Mata asah logam di bagian atas, gagang bergelombang bertekstur supaya genggaman tidak licin walau tangan basah.</p>

      <div class="mt-6 -mx-5 w-[calc(100%+2.5rem)] overflow-hidden bg-slate-950 shadow-2xl ring-1 ring-slate-800">
        <div class="aspect-square w-full overflow-hidden">
          <img fetchpriority="low" src="/images/tajem/tajem-showcase3.webp"
            alt="Foto detail close-up celah mata asah logam bersudut V pada alat asahan portable TAJEM"
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
            width="2048"
            height="2048"
          />
        </div>
        <div class="bg-slate-950/95 border-t border-slate-800/80 px-4 py-2.5 text-center backdrop-blur-sm">
          <span class="inline-flex items-center gap-1.5 text-[11.5px] font-bold text-[#FFD699]">
            <Icon name="lucide:flame" class="h-3.5 w-3.5 text-[#FF9900]" />
            GESEK 5 DETIK PISAU TAJAM MAKSIMAL
          </span>
        </div>
      </div>
      <p class="mt-2.5 text-[12.5px] text-slate-500 text-center">Detail celah mata asah logam bersudut V yang presisi mengasah sudut bilah pisau dalam sekali tarik.</p>

      <div class="mt-6 -mx-5 w-[calc(100%+2.5rem)] overflow-hidden bg-slate-950 shadow-2xl ring-1 ring-slate-800">
        <div class="aspect-square w-full overflow-hidden">
          <img fetchpriority="low" src="/images/tajem/tajem-spec.webp"
            alt="Tabel spesifikasi produk pengasah pisau portable TAJEM"
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
            width="2048"
            height="2048"
          />
        </div>
        <div class="bg-slate-950/95 border-t border-slate-800/80 px-4 py-2.5 text-center backdrop-blur-sm">
          <span class="inline-flex items-center gap-1.5 text-[11.5px] font-bold text-[#FFD699]">
            <Icon name="lucide:check-circle" class="h-3.5 w-3.5 text-[#FF9900]" />
            SPESIFIKASI PRODUK TAJEM ORIGINAL
          </span>
        </div>
      </div>
      <p class="mt-2.5 text-[12.5px] text-slate-500 text-center">Tabel spesifikasi produk resmi pengasah pisau portable TAJEM.</p>

      <div class="mt-8 border-t-2 border-[#FFEACC] pt-5 space-y-2 text-[14px] leading-relaxed">
        <h3 class="flex items-center gap-2 text-[15px] font-bold text-slate-950 mb-3">
          <Icon name="lucide:shield-check" class="h-4.5 w-4.5 text-[#EC7211]" aria-hidden="true" />
          Spesifikasi TAJEM
        </h3>
        <p><strong class="font-bold text-slate-950">Mata asah:</strong> <span class="text-slate-600">kepala logam dengan celah asah bersudut tetap, tinggal gesek</span></p>
        <p><strong class="font-bold text-slate-950">Gagang:</strong> <span class="text-slate-600">ergonomis bergelombang, bertekstur anti licin</span></p>
        <p><strong class="font-bold text-slate-950">Ukuran:</strong> <span class="box-decoration-clone bg-[#FFF5E5] px-1.5 pb-0.5 font-bold text-slate-950">travel size, muat di laci, tas, dan kotak perkakas</span></p>
        <p><strong class="font-bold text-slate-950">Paket:</strong> <span class="text-slate-600">tersedia paket Beli 1 dan Beli 2 dengan harga lebih hemat</span></p>
      </div>
    </section>

    <!-- CARA PAKAI (3 STEP FIGURE) -->
    <section class="border-t border-[#EAEDED] px-5 py-10">
      <span class="text-[11px] font-extrabold uppercase tracking-[0.2em] text-slate-500 block mb-1">CARA PAKAI</span>
      <h2 class={sectionTitle}>Cuma 10 Detik, Tanpa Keahlian Apa Pun</h2>
      <p class={`${body} mt-3 mb-6`}>Kalau bisa memegang gagang pisau, Anda bisa memakai TAJEM. Sudut asah sudah diatur dari pabriknya:</p>
      <figure class="overflow-hidden rounded-xl ring-1 ring-slate-200/80">
        <figcaption class="flex items-center gap-2 bg-[#232F3E] px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.18em] text-white">
          <Icon name="lucide:workflow" class="h-4 w-4 shrink-0" aria-hidden="true" />
          3 Langkah Pemakaian TAJEM
        </figcaption>
        <div class="flex items-start justify-between gap-1 bg-gradient-to-b from-[#FFF5E5]/60 to-white px-3 py-6">
          {[
            ['lucide:grip', 'Genggam', 'Pegang TAJEM, taruh mata pisau di celah asah'],
            ['lucide:repeat', 'Gesek', 'Tarik pisau searah 5-10 kali'],
            ['lucide:utensils', 'Potong', 'Pisau langsung siap, uji ke tomat']
          ].map(([icon, title, sub], i, arr) => (
            <>
              <div class="flex-1 text-center">
                <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#FF9900] text-white font-bold">
                  <Icon name={icon} class="h-5 w-5" aria-hidden="true" />
                </span>
                <h3 class="mt-2.5 text-[13px] font-bold text-slate-950">{title}</h3>
                <p class="mx-auto mt-0.5 max-w-[110px] text-[11px] leading-tight text-slate-500">{sub}</p>
              </div>
              {i < arr.length - 1 && (
                <Icon name="lucide:chevron-right" class="mt-4 h-5 w-5 shrink-0 text-[#FF9900]" aria-hidden="true" />
              )}
            </>
          ))}
        </div>
        <div class="flex items-center justify-center gap-1.5 border-t border-[#FFEACC] bg-[#FFF5E5]/60 px-4 py-2.5 text-center text-[12px] font-semibold text-[#232F3E]">
          <Icon name="lucide:badge-check" class="h-4 w-4 shrink-0" aria-hidden="true" />
          Aman untuk pemula: jari tetap di gagang, jauh dari mata pisau
        </div>
      </figure>

      <div class="mt-8 border-t border-[#EAEDED] pt-6">
        <h3 class="text-[16px] font-extrabold tracking-tight text-slate-950">Kenapa Bukan Batu Asah Biasa?</h3>
        <div class="mt-4 space-y-3 text-[14.5px] leading-relaxed">
          <p class="flex items-start gap-2.5">
            <Icon name="lucide:x" class="mt-1 h-4 w-4 shrink-0 text-red-600" aria-hidden="true" />
            <span class="text-slate-600">Batu asah: harus direndam dulu, sudut asah harus dijaga manual. Salah sudut, pisau malah makin tumpul. Butuh latihan berbulan-bulan.</span>
          </p>
          <p class="flex items-start gap-2.5 border-l-2 border-[#FF9900] pl-3 py-1 bg-[#FFF5E5]/50 rounded-r-md">
            <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
            <span class="font-bold text-slate-950">TAJEM: sudut asah sudah dikunci di celahnya. Siapa pun yang menggesek, hasilnya sama tajamnya. Tanpa air, tanpa latihan, tanpa ritual.</span>
          </p>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS SECTION -->
    <section class="border-t border-[#EAEDED] bg-slate-50/80 px-5 py-10">
      <span class="text-[11px] font-extrabold uppercase tracking-[0.2em] text-[#EC7211] block mb-1">KATA PEMBELI</span>
      <h2 class={sectionTitle}>Cerita Mereka yang Pisaunya <span class="hl-brush">Hidup Lagi</span></h2>
      <p class={`${body} mt-3 mb-8`}>Dari dapur rumah sampai warung makan, ini kata mereka:</p>

      <div class="space-y-6">
        {testimonials.map((t) => (
          <div class="rounded-xl bg-white p-5 border border-slate-200/90">
            <div class="flex items-center gap-3 mb-3">
              <img
                src={t.avatar}
                alt={t.name}
                class="h-11 w-11 rounded-full object-cover shrink-0 border border-slate-200"
                width="44"
                height="44"
                loading="lazy"
                decoding="async"
              />
              <div>
                <h3 class="text-[15px] font-bold text-slate-950 flex items-center gap-1">
                  {t.name}
                  <Icon name="lucide:badge-check" class="h-4 w-4 text-[#0073BB] shrink-0" />
                </h3>
                <p class="text-[12px] text-slate-500">{t.location}</p>
              </div>
              <div class="ml-auto flex gap-0.5">
                <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
              </div>
            </div>

            <div class="mb-2 inline-block text-[12px] font-bold text-[#B45309]">
              Masalah: {t.problem}
            </div>

            <p class="text-[14px] leading-relaxed text-slate-700 italic border-l-2 border-[#FF9900] pl-3 py-0.5 mb-3" set:html={`"${t.comment}"`}></p>

            <div class="mb-3 flex items-center gap-1.5 text-[12.5px] font-bold text-[#EC7211]">
              <Icon name="lucide:check-circle-2" class="h-4 w-4 shrink-0" />
              <span>Hasil: {t.highlight}</span>
            </div>

            {t.proofPhoto && (
              <div class="overflow-hidden rounded-xl bg-slate-100 border border-slate-200 mt-3">
                <img
                  src={t.proofPhoto}
                  alt={`Foto riil pembeli ${t.name}`}
                  class="w-full aspect-[3/2] object-cover block"
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="400"
                />
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- HONESTY SECTION -->
    <section class="border-t border-[#EAEDED] px-5 py-10">
      <span class="text-[11px] font-extrabold uppercase tracking-[0.2em] text-[#EC7211] block mb-1">JUJUR DARI AWAL</span>
      <h2 class={sectionTitle}>Cocok untuk Pisau Apa Saja?</h2>
      <p class={`${body} mt-3 mb-6 text-slate-700`}>Supaya Anda tidak salah beli, ini batas kemampuan TAJEM apa adanya:</p>

      <div class="space-y-3 text-[15px] leading-relaxed">
        <p class="flex items-start gap-2.5">
          <Icon name="lucide:check-circle-2" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Cocok untuk <strong class="font-bold text-slate-950">pisau berbilah baja polos</strong>: pisau dapur, pisau daging, pisau buah, sampai pisau lipat untuk mancing dan kemah.</span>
        </p>
        <p class="flex items-start gap-2.5">
          <Icon name="lucide:check-circle-2" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Cocok untuk yang mau <strong class="font-bold text-slate-950">hasil cepat tanpa belajar teknik asah</strong>: dapur rumah, warung makan, dan perawatan rutin harian.</span>
        </p>
        <p class="mt-4 flex items-start gap-2.5 border-l-2 border-red-500 pl-3 py-1 bg-red-50/50 rounded-r-md">
          <Icon name="lucide:alert-triangle" class="mt-0.5 h-4 w-4 shrink-0 text-red-600" aria-hidden="true" />
          <span class="text-slate-700">Tidak untuk <strong class="font-bold text-red-700">pisau bergerigi (pisau roti), bilah keramik, dan gunting</strong>. Kalau bilah pisau Anda sudah gompal parah, itu perlu jasa asah profesional, bukan asahan genggam.</span>
        </p>
      </div>
    </section>

    <!-- GUARANTEE / COD -->
    <section class="border-t border-[#EAEDED] bg-slate-900 px-5 py-10 text-center text-white">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center text-[#FF9900]">
        <Icon name="lucide:shield-check" class="h-12 w-12" aria-hidden="true" />
      </div>
      <span class="mb-1 block text-[11px] font-extrabold uppercase tracking-[0.2em] text-[#FF9900]">BELANJA TANPA WAS-WAS</span>
      <h2 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] text-white">BAYAR SETELAH BARANG SAMPAI</h2>
      <p class="mx-auto mt-3 max-w-[340px] text-[15px] leading-relaxed text-slate-300">Pesan TAJEM hari ini dengan sistem COD: Anda baru bayar ke kurir saat paket sudah di tangan.</p>

      <div class="mx-auto mt-8 max-w-[360px] space-y-5 text-left">
        {[
          ['lucide:truck', 'COD ke Seluruh Indonesia', 'Bayar tunai di tempat saat paket tiba. Tidak perlu transfer di muka.'],
          ['lucide:package-check', 'Paket Sesuai Foto', 'Barang yang sampai persis seperti foto asli di atas, dikirim rapi dan aman.'],
          ['lucide:message-circle', 'Admin Siap Ditanya', 'Ragu soal pemakaian atau pengiriman? Chat admin via WhatsApp sebelum maupun sesudah pesan.']
        ].map(([icon, title, desc]) => (
          <div class="flex items-start gap-4">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded bg-slate-800 text-[#FF9900]"><Icon name={icon} class="h-4.5 w-4.5" aria-hidden="true" /></span>
            <div>
              <h3 class="text-[15.5px] font-bold text-white">{title}</h3>
              <p class="mt-0.5 text-[14px] leading-relaxed text-slate-300">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- CHECKOUT SECTION -->
    <section id="checkout" class="border-t-8 border-slate-100 bg-white py-12">
      <div class="px-5 pb-8 text-center">
        <div class="mx-auto mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#FFF5E5] px-3.5 py-1 text-[12px] font-extrabold text-[#EC7211] border border-[#FFEACC]">
          <span class="relative flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#FF9900] opacity-75"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-[#EC7211]"></span>
          </span>
          PAKET BELI 2 JAUH LEBIH HEMAT
        </div>
        <h2 class="mx-auto max-w-[340px] text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Isi Alamat Pengiriman, <span class="hl-brush">Bayar Saat Sampai</span>
        </h2>
        <p class="mx-auto mt-3 max-w-[320px] text-[15px] leading-relaxed text-slate-600">
          Form menyesuaikan wilayah Anda. Paket dikirim rapi, Anda bayar tunai ke kurir saat barang tiba di rumah.
        </p>
      </div>
      <GeoIpResolvedForm mode={formContext.mode} productSlug="asahan-portable" embedded={true} />
    </section>

    <LpMiniFooter />
    <StickyCTA productSlug="asahan-portable" />
    <SocialProof productSlug="asahan-portable" />
  </main>
</BaseLayout>

<style>
  .hl-brush {
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding-bottom: 0.14em;
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20320%2024'%20preserveAspectRatio='none'%3E%3Cpath%20d='M3%2013C55%206%20120%2016%20182%2011S292%208%20317%2012L315%2020C252%2015%20150%2023%2072%2019S13%2021%205%2020C2%2017%202%2016%203%2013Z'%20fill='%23FF9900'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: center 100%;
    background-size: 100% 0.32em;
  }
</style>
