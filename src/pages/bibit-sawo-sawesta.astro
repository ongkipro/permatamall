---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import Icon from '../components/shared/Icon.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('bibit-sawo-sawesta');
if (!product) throw new Error('Product bibit-sawo-sawesta not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = 'https://pesantren.shop/bibit-sawo-sawesta';
const seoTitle = 'Bibit Sawo Sawesta Super Jumbo: Cepat Berbuah Genjah di Pot Teras';
const seoDescription =
  'Bibit Sawo Sawesta Jumbo Okulasi Super Manis. Daging buah tebal legit tanpa asam, pohon genjah cepat berbuah di pot/lahan. Garansi COD Rp 99rb.';

const sectionTitle = 'text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950';
const body = 'text-[16px] leading-relaxed text-slate-600';

const testimonials = [
  {
    name: 'Pak Haji Mustofa',
    location: 'Kudus, Jawa Tengah',
    avatar: '/images/petani/petani-01.webp',
    problem: 'Tanam sawo lokal belasan tahun pohon tinggi tapi jarang berbuah',
    comment:
      'Dulu tanam sawo biasa <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">pohonnya tinggi banget 8 meter tapi jarang ada buahnya</strong>. Pas nyoba Bibit Sawo Sawesta okulasi ini <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">tanam 1.5 tahun di pot teras langsung dompolan lebat manis banget tanpa asam</strong>!',
    highlight: 'Berbuah lebat 1.5 tahun di pot teras',
  },
  {
    name: 'Bu Hajjah Siti',
    location: 'Boyolali, Jawa Tengah',
    avatar: '/images/petani/petani-dewi.webp',
    problem: 'Khawatir buah sawo banyak getah dan rasa tidak manis',
    comment:
      'Rasa sawo sawesta ini benar-benar beda! <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">Dagingnya tebal manis pasir legit tanpa getah lengket</strong>. Pohonnya juga sangat tahan panas di teras rumah. Cucu-cucu suka sekali!',
    highlight: 'Daging tebal manis pasir tanpa getah',
  },
  {
    name: 'Pak Slamet Riyadi',
    location: 'Sragen, Jawa Tengah',
    avatar: '/images/petani/petani-07.webp',
    problem: 'Takut bibit layu atau mati di pengiriman online',
    comment:
      'Pengiriman COD sangat cepat, bibit sawo sampai dalam keadaan segar bugar dengan perakaran kuat. <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">Sambungan okulasinya rapi & batang tebal kokoh</strong>. Penjual sangat amanah!',
    highlight: 'Bibit segar bugar & garansi COD',
  },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={product.heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Bibit Sawo Sawesta', url: '/bibit-sawo-sawesta' }
  ]}
  preloadImages={[
    {
      srcset: "/images/sawo/sawo-hero-400.webp 400w, /images/sawo/sawo-hero-600.webp 600w",
      sizes: "(max-width: 480px) 100vw, 480px"
    }
  ]}
>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <MetaLandingTracker slug="bibit-sawo-sawesta" productId={product.productId} contentName={product.contentName} price={product.price} />

    <!-- 1. URGENCY TOP BAR -->
    <div class="bg-[#EC7211] px-4 py-2.5 text-center">
      <p class="flex items-center justify-center gap-1.5 text-[12px] font-extrabold uppercase tracking-wide text-white">
        <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-white" aria-hidden="true" />
        PROMO BIBIT SAWO SAWESTA SUPER JUMBO: DISKON 50% GARANSI HIDUP & COD 99RB!
      </p>
    </div>

    <!-- 2. HERO SECTION & HERO FOTO PRODUK -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-7">
        <div class="mx-auto mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#FFF5E5] px-3.5 py-1 text-[11.5px] font-extrabold text-[#EC7211] border border-[#FFEACC]">
          <Icon name="lucide:sparkles" class="h-3.5 w-3.5 text-[#EC7211]" />
          VARIETAS SAWO SAWESTA OKULASI UNGGULAN
        </div>
        <h1 class="mx-auto max-w-[440px] text-[clamp(30px,8.5vw,35px)] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Buah Super Jumbo <span class="hl-brush">Manis Legit Genjah Berbuah Lebat!</span>
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[16px] font-semibold leading-relaxed text-slate-700">
          Bibit Sawo Sawesta Jumbo. <strong class="font-bold text-slate-950">Ukuran buah jumbo besar, daging tebal manis pasir legit tanpa rasa asam!</strong> <span class="font-bold text-slate-950 underline decoration-[#EC7211]/60 decoration-2 underline-offset-4">Pohon sangat genjah, cepat berbuah lebat 1-2 tahun walau ditanam di pot teras rumah!</span>
        </p>
      </div>

      <!-- HERO IMAGE CONTAINER (PAS FLUID UNCROPPED) -->
      <div class="mt-6 w-full overflow-hidden border-y border-slate-200 bg-white">
        <img
          src="/images/sawo/sawo-hero-600.webp"
          srcset="/images/sawo/sawo-hero-400.webp 400w, /images/sawo/sawo-hero-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Bibit Sawo Sawesta Super Jumbo Okulasi Genjah Berbuah Lebat"
          class="w-full h-auto block object-contain mx-auto"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="540"
          height="540"
        />

        <div class="bg-slate-950 px-4 py-2.5 text-center">
          <p class="flex items-center justify-center gap-1.5 text-[12.5px] font-bold text-[#FFD699]">
            <Icon name="lucide:sprout" class="h-4 w-4 text-[#EC7211] shrink-0" aria-hidden="true" />
            <span>Hasil Okulasi Vegetatif • Daging Tebal Manis Pasir • Genjah 1-2 Tahun!</span>
          </p>
        </div>
      </div>
    </section>

    <!-- 3. HIGHLIGHT SPECS BAR -->
    <section class="border-y border-orange-100 bg-[#FFF5E5]/60 px-5 py-5">
      <div class="grid grid-cols-2 gap-3 text-left">
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-3 shadow-xs">
          <Icon name="lucide:sparkles" class="mt-0.5 h-5 w-5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[11px] font-extrabold tracking-wide uppercase text-slate-400">UKURAN BUAH</p>
            <p class="text-[13.5px] font-extrabold text-slate-950">Super Jumbo Besar</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-3 shadow-xs">
          <Icon name="lucide:check-circle" class="mt-0.5 h-5 w-5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[11px] font-extrabold tracking-wide uppercase text-slate-400">RASA BUAH</p>
            <p class="text-[13.5px] font-extrabold text-slate-950">Manis Legit Pasir</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-3 shadow-xs">
          <Icon name="lucide:calendar" class="mt-0.5 h-5 w-5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[11px] font-extrabold tracking-wide uppercase text-slate-400">MASA BERBUAH</p>
            <p class="text-[13.5px] font-extrabold text-slate-950">Genjah 1-2 Tahun</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-3 shadow-xs">
          <Icon name="lucide:truck" class="mt-0.5 h-5 w-5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[11px] font-extrabold tracking-wide uppercase text-slate-400">LAYANAN</p>
            <p class="text-[13.5px] font-extrabold text-slate-950">Garansi & COD</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. DETAIL SPESIFIKASI BIBIT & BUAH SAWO SAWESTA -->
    <section class="px-5 py-9 border-b border-slate-100">
      <div class="text-center">
        <span class="text-[11.5px] font-extrabold uppercase tracking-widest text-[#EC7211]">KEUNGGULAN VARIETAS</span>
        <h2 class={sectionTitle + ' mt-1.5'}>Detail Daging & Bibit Sawo</h2>
        <p class={body + ' mt-2.5 font-medium'}>
          Varietas sawo unggulan dengan buah jumbo bertekstur manis pasir legit tanpa asam:
        </p>
      </div>

      <!-- FOTO INFOGRAFIS KEUNGGULAN SAWO -->
      <div class="mt-6 w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
        <img
          src="/images/sawo/sawo-infografis-600.webp"
          srcset="/images/sawo/sawo-infografis-400.webp 400w, /images/sawo/sawo-infografis-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Infografis Keunggulan Buah Sawo Sawesta Super Jumbo Manis"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>

      <!-- FOTO DAGING BUAH SAWO MANIS PASIR -->
      <div class="mt-4 w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
        <img
          src="/images/sawo/sawo-daging-600.webp"
          srcset="/images/sawo/sawo-daging-400.webp 400w, /images/sawo/sawo-daging-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Detail Daging Buah Sawo Sawesta Tebal Manis Pasir"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>

      <div class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-xs">
        <ul class="space-y-3.5 text-[14.5px] text-slate-800">
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
            <span class="text-slate-500 font-medium">Varietas Tanaman</span>
            <span class="font-bold text-slate-950">Sawo Sawesta Super Jumbo</span>
          </li>
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
            <span class="text-slate-500 font-medium">Sistem Perbanyakan</span>
            <span class="font-bold text-slate-950">Okulasi Sambung Vegetatif Unggul</span>
          </li>
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
            <span class="text-slate-500 font-medium">Tinggi Bibit Dikirim</span>
            <span class="font-bold text-slate-950">50 - 70 cm (Siap Tanam)</span>
          </li>
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
            <span class="text-slate-500 font-medium">Estimasi Berbuah</span>
            <span class="font-bold text-slate-950">1 - 2 Tahun Sejak Tanam</span>
          </li>
          <li class="flex items-center justify-between">
            <span class="text-slate-500 font-medium">Kebutuhan Lahan</span>
            <span class="font-bold text-slate-950">Tabulampot Pot Teras / Pekarangan</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- 5. ALASAN MEMILIH SAWO SAWESTA (OVERCLAIM SECTION) -->
    <section class="px-5 py-9 border-b border-slate-100 bg-slate-50/50">
      <div class="text-center">
        <span class="text-[11.5px] font-extrabold uppercase tracking-widest text-[#EC7211]">KENAPA HARUS TANAM SAWO SAWESTA?</span>
        <h2 class={sectionTitle + ' mt-1.5'}>4 Alasan Pilih Sawo Sawesta</h2>
        <p class={body + ' mt-2 font-medium'}>Perbandingan keunggulan dibanding sawo lokal biasa:</p>
      </div>

      <!-- FOTO POHON BERBUAH LEBAT & DOMPOLAN -->
      <div class="mt-6 w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
        <img
          src="/images/sawo/sawo-lebat-600.webp"
          srcset="/images/sawo/sawo-lebat-400.webp 400w, /images/sawo/sawo-lebat-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Pohon Sawo Sawesta Berbuah Lebat di Pot Teras"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>

      <div class="mt-4 w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
        <img
          src="/images/sawo/sawo-dompolan-600.webp"
          srcset="/images/sawo/sawo-dompolan-400.webp 400w, /images/sawo/sawo-dompolan-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Dompolan Buah Sawo Sawesta Super Jumbo Melimpah"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>

      <div class="mt-6 space-y-3.5">
        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Ukuran Buah Super Jumbo & Daging Tebal</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Bobot buah hingga 2x lipat lebih besar dibanding sawo lokal biasa, puas dinikmati keluarga.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Rasa Manis Pasir Legit Bebas Rasa Asam</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Sensasi manis gula pasir alami yang segar tanpa getah lengket di bibir.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Pohon Sangat Genjah Berbuah (1-2 Tahun)</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Hasil okulasi vegetatif unggulan langsung cepat belajar berbuah tanpa menunggu belasan tahun.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Sangat Cocok Untuk Tabulampot & Kebun</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Pohon tahan cuaca panas ekstrem, sangat rimbun berbuah di pot teras rumah maupun kebun.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. BIBIT OKULASI SIAP TANAM -->
    <section class="px-5 py-9 border-b border-slate-100">
      <div class="text-center">
        <span class="text-[11.5px] font-extrabold uppercase tracking-widest text-[#EC7211]">GARANSI BIBIT UNGGUL</span>
        <h2 class={sectionTitle + ' mt-1.5'}>Bibit Okulasi Siap Kirim</h2>
        <p class={body + ' mt-2 font-medium'}>Bibit sehat dengan perakaran kuat & batang kokoh siap tanam:</p>
      </div>

      <!-- FOTO BIBIT OKULASI SIAP KIRIM -->
      <div class="mt-6 w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
        <img
          src="/images/sawo/sawo-bibit-okulasi-600.webp"
          srcset="/images/sawo/sawo-bibit-okulasi-400.webp 400w, /images/sawo/sawo-bibit-okulasi-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Foto Bibit Sawo Sawesta Okulasi Unggul Siap Kirim"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>
    </section>

    <!-- 7. TESTIMONIALS PELANGGAN -->
    <section class="px-5 py-9 border-b border-slate-100 bg-slate-50/50">
      <div class="text-center">
        <span class="text-[11.5px] font-extrabold uppercase tracking-widest text-[#EC7211]">ULASAN PEMBELI</span>
        <h2 class={sectionTitle + ' mt-1.5'}>Testimoni Pembeli Real</h2>
      </div>

      <div class="mt-6 space-y-4">
        {testimonials.map((t) => (
          <div class="rounded-2xl border border-slate-200/80 bg-white p-4.5 shadow-xs">
            <div class="flex items-center gap-3">
              <img src={t.avatar} alt={t.name} class="h-10 w-10 rounded-full object-cover ring-2 ring-orange-100" />
              <div>
                <h3 class="text-[14.5px] font-bold text-slate-950">{t.name}</h3>
                <p class="text-[12px] text-slate-500">{t.location}</p>
              </div>
            </div>
            <div class="mt-3 rounded-xl bg-[#FFF5E5]/70 p-3 text-[13.5px] leading-relaxed text-slate-700">
              <p set:html={t.comment} />
            </div>
            <div class="mt-2.5 flex items-center justify-between text-[11.5px]">
              <span class="font-bold text-[#EC7211]">✓ {t.highlight}</span>
              <span class="font-semibold text-slate-400">Pembeli Terverifikasi</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 8. SOCIAL PROOF DYNAMIC -->
    <SocialProof productSlug="bibit-sawo-sawesta" />

    <!-- 9. PRICING & HARGA SECTION (CHECKOUT FORM) -->
    <section id="checkout" class="border-t-8 border-slate-100 bg-white py-12">
      <div class="px-5 pb-8 text-center">
        <p class="mx-auto mb-3 inline-flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.14em] text-[#EC7211]">
          <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          Promo Bibit Sawo Sawesta COD
        </p>
        <h2 class="mx-auto max-w-[340px] text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950">
          Isi Alamat Pengiriman, <span class="hl-brush">Bayar Saat Sampai</span>
        </h2>
        <p class="mx-auto mt-4 max-w-[320px] text-[15px] leading-relaxed text-slate-600">
          Form otomatis menyesuaikan lokasi Anda. Bibit dikirim aman bergaransi hidup, bayar tunai ke kurir saat barang tiba.
        </p>
      </div>

      <!-- FOTO BANNER GARANSI BIBIT -->
      <div class="mx-auto mb-6 max-w-[440px] px-5">
        <div class="overflow-hidden rounded-2xl border border-slate-200 shadow-sm">
          <img
            src="/images/sawo/sawo-garansi-600.webp"
            srcset="/images/sawo/sawo-garansi-400.webp 400w, /images/sawo/sawo-garansi-600.webp 600w"
            sizes="(max-width: 480px) 100vw, 480px"
            alt="Banner Garansi Bibit Sawo Sawesta Jumbo Cepat Berbuah COD"
            class="w-full h-auto block object-contain mx-auto"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="540"
            height="540"
          />
        </div>
      </div>

      <div class="mx-auto mb-6 max-w-[380px] px-5 text-center">
        <div class="rounded-2xl border-2 border-[#EC7211] bg-[#FFF5E5]/40 p-4">
          <p class="text-[12px] font-bold text-[#EC7211] uppercase tracking-wider">HARGA PROMO SPESIAL</p>
          <div class="mt-1 flex items-baseline justify-center gap-2">
            <span class="text-[14px] text-slate-400 line-through">Rp 250.000</span>
            <span class="text-[28px] font-black text-slate-950">Rp 99.000</span>
          </div>
          <p class="mt-0.5 text-[12px] font-medium text-slate-600">Beli 1 Pohon Rp 99.000 • 2 Pohon Rp 149.000 • 3 Pohon Rp 199.000</p>
        </div>
      </div>

      <GeoIpResolvedForm mode={formContext.mode} productSlug="bibit-sawo-sawesta" embedded={true} />
    </section>

    <!-- 10. FOOTER -->
    <LpMiniFooter />

    <!-- 11. STICKY CTA MOBILE -->
    <StickyCTA productSlug="bibit-sawo-sawesta" />
  </main>
</BaseLayout>

<style>
  .hl-brush {
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding-bottom: 0.14em;
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20320%2024'%20preserveAspectRatio='none'%3E%3Cpath%20d='M3%2013C55%206%20120%2016%20182%2011S292%208%20317%2012L315%2020C252%2015%20150%2023%2072%2019S13%2021%205%2020C2%2017%202%2016%203%2013Z'%20fill='%23EC7211'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: center 100%;
    background-size: 100% 0.32em;
  }
</style>
