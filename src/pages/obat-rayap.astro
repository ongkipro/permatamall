---
import BaseLayout from '../layouts/BaseLayout.astro';
import RatingStars from '../components/shared/RatingStars.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import Icon from '../components/shared/Icon.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('obat-rayap');
if (!product) throw new Error('Product obat-rayap not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = 'https://permatamall.shop/obat-rayap';
const seoTitle = 'Obat Pembasmi Rayap Rayentra DGV: Basmi Sampai Sarang & Ratu';
const seoDescription =
  'Cairan pembasmi rayap semprot ampuh Rayentra DGV. Membasmi rayap kayu, tanah, & pondasi rumah sampai ke sarang & ratunya. Garansi COD.';

const sectionTitle = 'text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950';
const body = 'text-[16px] leading-relaxed text-slate-600';

const testimonials = [
  {
    name: 'Pak Mulyono Hartono',
    location: 'Depok, Jawa Barat',
    avatar: '/images/petani/petani-08.webp',
    problem: 'Kusen pintu keropos digerogoti rayap',
    comment:
      'Kusen pintu rumah saya yang sudah <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">keropos digerogoti rayap</strong> langsung <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">bersih tuntas tidak ada rayap sama sekali</strong> setelah disemprot Rayentra DGV!',
    highlight: 'Kusen bersih bebas rayap',
  },
  {
    name: 'Pak Yusuf Rahmat',
    location: 'Bekasi, Jawa Barat',
    avatar: '/images/petani/petani-01.webp',
    problem: 'Plafon rumah hampir roboh diserang rayap tanah',
    comment:
      'Plafon rumah <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">hampir roboh diserang rayap tanah</strong>. Semprot Rayentra DGV ini 1 botol <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">langsung mati massal sampai ratunya!</strong>',
    highlight: 'Mati massal sampai ke sarang',
  },
  {
    name: 'Bu Ratna Dewi',
    location: 'Sleman, Yogyakarta',
    avatar: '/images/petani/petani-dewi.webp',
    problem: 'Lemari pakaian kayu jati kesayangan diserang rayap',
    comment:
      'Lemari kayu jati kesayangan mulai keluar <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">serbuk kayu dan jalur tanah</strong>. Disemprot Rayentra DGV <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">rayap hilang total dan pelitur lemarinya tidak rusak</strong> sama sekali.',
    highlight: 'Lemari kayu aman & pelitur tidak rusak',
  },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={product.heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Obat Rayap Rayentra DGV', url: '/obat-rayap' }
  ]}

  preloadImages={[
    "/images/produk/obat-rayap-showcase1.webp",
    "/images/produk/obat-rayap-hero.webp"
  ]}>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <MetaLandingTracker slug="obat-rayap" productId={product.productId} contentName={product.contentName} price={product.price} />

    <!-- 1. URGENCY TOP BAR -->
    <div class="bg-[#FF9900] px-4 py-2.5 text-center">
      <p class="flex items-center justify-center gap-1.5 text-[12px] font-extrabold uppercase tracking-wide text-white">
        <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-white" aria-hidden="true" />
        FORMULA PEMBASMI RAYAP SISTEMIK: MATI SAMPAI RATUNYA & COD 104RB!
      </p>
    </div>

    <!-- 2. HERO SECTION -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-7">
        <div class="mx-auto mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#FFF5E5] px-3.5 py-1 text-[11.5px] font-extrabold text-[#EC7211] border border-[#FFEACC]">
          <Icon name="lucide:shield-alert" class="h-3.5 w-3.5 text-[#EC7211]" />
          PEMBASMI RAYAP SUPER AMPUH
        </div>
        <h1 class="mx-auto max-w-[440px] text-[clamp(32px,8.8vw,36px)] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Rayap Lenyap Sampai ke Ratunya, <span class="hl-brush">Kayu Rumah Aman Selamanya!</span>
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[16px] font-semibold leading-relaxed text-slate-700">
          Cairan semprot Rayentra DGV bekerja sistemik meresap ke serat kayu untuk <strong class="font-bold text-slate-950">memusnahkan koloni rayap mati massal sampai ke sarangnya</strong>. <span class="font-bold text-slate-950 underline decoration-[#FF9900]/60 decoration-2 underline-offset-4">Sekali semprot, mati total.</span>
        </p>
      </div>

      <div class="mt-7">
        <div class="relative overflow-hidden bg-slate-950 aspect-square rounded-xl shadow-2xl ring-1 ring-slate-900 w-full">
          <img
            src={product.heroImage}
            alt="Paket 1 Liter & Spray Rayentra Anti Rayap Asli"
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="700"
            height="700"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-3 text-center backdrop-blur-sm">
            <p class="flex items-center justify-center gap-1.5 text-[12.5px] font-bold text-[#FFD699]">
              <Icon name="lucide:shield-check" class="h-4 w-4 text-[#FF9900] shrink-0" aria-hidden="true" />
              <span>FOTO REAL PAKET 1 LITER & SPRAY RAYENTRA ANTI RAYAP ORIGINAL</span>
            </p>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-center gap-3 px-4">
          <div class="flex -space-x-2">
            {testimonials.map((t) => (
              <img src={t.avatar} alt={t.name} class="h-8 w-8 rounded-full border-2 border-white object-cover" width="32" height="32" loading="eager" decoding="async" />
            ))}
          </div>
          <div class="text-left">
            <div class="flex items-center gap-0.5">
            <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
            <span class="ml-1 text-[13px] font-bold text-slate-900">4.9/5</span>
            </div>
            <p class="text-[11px] font-medium text-slate-500">dari 1.450+ pembeli terpuaskan</p>
          </div>
        </div>

        <div class="mt-5 flex justify-center gap-4 px-4">
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:bug-off" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Mati Massal
          </span>
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:shield-check" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Bebas Keropos
          </span>
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:truck" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Bisa COD
          </span>
        </div>

        <div class="mt-6 border-l-2 border-[#FF9900] px-5 pl-4 text-left">
          <h2 class="text-[15px] font-bold text-slate-950">Rayap bekerja 24 jam menggerogoti rumah Anda.</h2>
          <p class="mt-1 text-[13.5px] leading-relaxed text-slate-600">Kalau cuma disemprot obat biasa yang mati hanya di permukaan. Rayentra DGV meresap ke serat kayu dan dibawa ke sarang sampai ratunya mati.</p>
        </div>
      </div>
    </section>

    <!-- 3. PAIN CHECKLIST (Sering Mengalami Ini?) -->
    <section class="border-t border-slate-100 bg-red-50/40 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-red-600">Sering Mengalami Ini?</span>
      <h2 class={sectionTitle}>Tanda Rayap Menggerogoti <span class="hl-brush">Rumah Tanpa Disadari</span></h2>
      <p class={`${body} mt-3 mb-6`}>Jangan biarkan perabot & kusen kayu berharga Anda hancur menjadi serbuk:</p>
      <div class="space-y-4">
        {[
          ['Kusen & Pintu Berbunyi Rongga / Keropos', 'Saat diketok terdengar kosong, bagian luar tampak utuh tapi dalam sudah keropos tergerus rayap.'],
          ['Muncul Serbuk Kayu & Jalur Tanah', 'Garis-garis tanah hitam menempel di dinding dan lantai sekitar perabot kayu kesayangan Anda.'],
          ['Plafon Kayu Rentan Ambruk Tiba-Tiba', 'Rayap tanah menyerang struktur penopang atap, membahayakan keselamatan seluruh penghuni rumah.']
        ].map(([title, desc]) => (
          <div class="flex items-start gap-3.5">
            <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center text-red-600"><Icon name="lucide:x-circle" class="h-5 w-5" aria-hidden="true" /></span>
            <div>
              <h3 class="text-[16px] font-bold text-slate-900">{title}</h3>
              <p class="mt-0.5 text-[15px] leading-relaxed text-slate-600">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 4. EDUKASI GELAP (Cara Kerja Sistemik) -->
    <section class="border-t border-slate-100 bg-slate-950 px-5 py-10 text-white">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#FFD699]">Cara Kerja Sistemik</span>
      <h2 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-white">Kenapa Obat Biasa Gagal & <span class="text-[#FFD699]">Rayentra DGV Membasmi Total?</span></h2>
      <p class="mt-3 text-[16px] leading-relaxed text-slate-400">Membunuh rayap di permukaan tidak akan menghentikan serangan karena Ratu Rayap di dalam sarang terus bertelur ribuan butir per hari. Rayentra DGV menggunakan mekanisme Domino Effect:</p>

      <div class="relative ml-2 mt-8 space-y-8 border-l border-slate-800 pl-6">
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-white ring-4 ring-slate-950">1</span>
          <h3 class="text-[16px] font-semibold text-[#FFD699]">Penetrasi Serat Kayu Pekat</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-slate-400">Bahan aktif meresap ke pori-pori dalam kayu. Rayap pekerja yang memakan serat kayu terinfeksi racun lambat.</p>
        </div>
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-white ring-4 ring-slate-950">2</span>
          <h3 class="text-[16px] font-semibold text-[#FFD699]">Efek Berantai Ke Ratu Sarang</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-slate-400">Rayap yang terinfeksi membawa racun ke dalam sarang utama melalui kontak fisik dan suapan makanan, memicu kematian massal seluruh koloni termasuk Ratu.</p>
        </div>
      </div>

      <div class="mt-8 overflow-hidden rounded-md">
        <img fetchpriority="low" src="/images/produk/obat-rayap-showcase1.webp"
          alt="Hasil pembasmian rayap sistemik pada kayu"
          class="aspect-[4/3] w-full object-cover"
          loading="lazy"
          decoding="async"
          width="480"
          height="360"
        />
      </div>

      <div class="mt-6 rounded-md bg-slate-900 p-4">
        <p class="text-[14px] leading-relaxed text-slate-300"><strong class="text-[#FFD699]">Hasilnya:</strong> Seluruh koloni rayap musnah total sampai ke sarang terdalam, dan kayu rumah terlindungi dari serangan ulang!</p>
      </div>
    </section>

    <!-- 5. FOTO ASLI PRODUK & SPESIFIKASI -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Foto Asli & Aplikasi</span>
      <h2 class={sectionTitle}>Cairan Semprot Pekat <span class="hl-brush">Meresap Ke Serat Kayu</span></h2>
      <p class={`${body} mt-3 mb-6`}>Aplikasi praktis dan mudah langsung ke area perabot, kusen pintu, atau jalur rayap:</p>

      <div class="overflow-hidden rounded-2xl bg-gradient-to-b from-slate-900 via-slate-950 to-slate-900 p-6 shadow-2xl ring-1 ring-slate-800 flex flex-col items-center">
        <span class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#FF9900]/20 px-3 py-1 text-[11px] font-bold text-[#FFD699] ring-1 ring-[#FF9900]/40">
          <Icon name="lucide:shield-check" class="h-3.5 w-3.5 text-[#FF9900]" />
          FOTO REAL STOK 1 LITER RAYENTRA ASLI
        </span>
        <img fetchpriority="low" src="/images/produk/obat-rayap-hero.webp"
          alt="Jerigen 1 Liter & Spray Rayentra Anti Rayap Asli"
          class="max-h-[440px] w-auto object-contain rounded-xl shadow-2xl drop-shadow-[0_20px_20px_rgba(0,0,0,0.8)]"
          loading="lazy"
          decoding="async"
          width="700"
          height="700"
        />
        <div class="mt-4 flex flex-wrap justify-center gap-2 text-[11.5px] font-bold text-white">
          <span class="inline-flex items-center gap-1 rounded-md bg-slate-800/80 px-2.5 py-1"><Icon name="lucide:check" class="h-3 w-3 text-[#FF9900]" /> Paket 1 Liter + Spray</span>
          <span class="inline-flex items-center gap-1 rounded-md bg-slate-800/80 px-2.5 py-1"><Icon name="lucide:check" class="h-3 w-3 text-[#FF9900]" /> Formula Konsentrat</span>
          <span class="inline-flex items-center gap-1 rounded-md bg-slate-800/80 px-2.5 py-1"><Icon name="lucide:check" class="h-3 w-3 text-[#FF9900]" /> Segel Pabrik</span>
        </div>
      </div>
      <p class="mt-2.5 text-center text-[12.5px] font-semibold text-slate-600">Jerigen 1 Liter + Spray Rayentra Anti Rayap segel rapat 100% Original.</p>

      <div class="mt-8 border-t-2 border-[#FFEACC] pt-5">
        <h3 class="flex items-center gap-2 text-[15px] font-bold text-slate-950">
          <Icon name="lucide:shield-check" class="h-4.5 w-4.5 text-[#EC7211]" aria-hidden="true" />
          Spesifikasi Obat Rayap Rayentra DGV
        </h3>
        <div class="mt-3 space-y-2.5 text-[14px] leading-relaxed">
          <p><strong class="font-semibold text-slate-900">Bahan aktif:</strong> <span class="text-slate-600">Formula Insektisida Sistemik Pekat (Non-Repellent)</span></p>
          <p><strong class="font-semibold text-slate-900">Target hama:</strong> <span class="text-slate-600">Rayap kayu kering, rayap tanah, & rayap pondasi</span></p>
          <p><strong class="font-semibold text-slate-900">Kemasan:</strong> <span class="box-decoration-clone bg-[#FFF5E5] px-1.5 pb-0.5 font-semibold text-slate-900">Botol semprot praktis 250 ml / 500 ml</span></p>
          <p><strong class="font-semibold text-slate-900">Sifat cairan:</strong> <span class="text-slate-600">Tidak berwarna, tidak merusak finishing kayu / pelitur</span></p>
        </div>
      </div>
    </section>

    <!-- 6. CARA PAKAI (3 Langkah) -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Panduan Pemakaian</span>
      <h2 class={sectionTitle}>3 Langkah Praktis Basmi Rayap</h2>
      <p class={`${body} mt-3 mb-6`}>Tanpa perlu panggil jasa pest control mahal, siapapun bisa membasmi rayap sendiri:</p>

      <figure class="overflow-hidden rounded-md ring-1 ring-slate-200">
        <figcaption class="flex items-center gap-2 bg-[#232F3E] px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.18em] text-white">
          <Icon name="lucide:workflow" class="h-4 w-4 shrink-0" aria-hidden="true" />
          3 Langkah Pembasmian Rayap
        </figcaption>
        <div class="flex items-start justify-between gap-1 bg-gradient-to-b from-[#FFF5E5]/60 to-white px-3 py-6">
          {[
            ['lucide:crosshair', 'Kocok & Bidik', 'Kocok botol dan arahkan nozzle ke area kayu / jalur tanah'],
            ['lucide:spray-can', 'Semprot Merata', 'Semprotkan ke celah kusen, retakan, atau lubang kayu'],
            ['lucide:shield-check', 'Biarkan Meresap', 'Cairan meresap otomatis dan membawa racun ke sarang']
          ].map(([icon, title, sub], i, arr) => (
            <>
              <div class="flex-1 text-center">
                <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[#FF9900] text-white">
                  <Icon name={icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <h3 class="mt-2.5 text-[13px] font-bold text-slate-900">{title}</h3>
                <p class="mx-auto mt-0.5 max-w-[110px] text-[11px] leading-tight text-slate-500">{sub}</p>
              </div>
              {i < arr.length - 1 && (
                <Icon name="lucide:chevron-right" class="mt-4 h-5 w-5 shrink-0 text-[#FFD699]" aria-hidden="true" />
              )}
            </>
          ))}
        </div>
      </figure>
    </section>

    <!-- 7. TESTIMONIALS -->
    <section class="border-t border-slate-100 bg-[#FFF5E5]/40 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Bukti Pembeli</span>
      <h2 class={sectionTitle}>Cerita Rumah yang <span class="hl-brush">Bebas dari Rayap</span></h2>
      <p class={`${body} mt-3 mb-8`}>Bukti nyata pemilik rumah yang berhasil membasmi rayap tuntas:</p>

      <div class="space-y-9">
        {testimonials.map((t, index, arr) => (
          <div>
            <div class="flex items-center gap-3">
              <img
                src={t.avatar}
                alt={`Foto ${t.name}, pengguna Rayentra DGV`}
                class="h-11 w-11 shrink-0 rounded-full object-cover"
                width="44"
                height="44"
                loading="lazy"
                decoding="async"
              />
              <div class="min-w-0">
                <h3 class="flex items-center gap-1 text-[15px] font-bold text-slate-900">
                  {t.name}
                  <Icon name="lucide:badge-check" class="h-4 w-4 shrink-0 text-[#0073BB]" aria-hidden="true" />
                </h3>
                <p class="text-[11.5px] text-slate-500">{t.location}</p>
              </div>
              <div class="ml-auto flex gap-0.5">
                <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
              </div>
            </div>
            <p class="mt-1.5 text-[12px] font-semibold text-[#B45309]">Masalah: {t.problem}</p>
            <p class="mt-3 border-l-2 border-[#FF9900]/40 pl-3 text-[15px] italic leading-relaxed text-slate-700" set:html={`"${t.comment}"`} />
            <p class="mt-2.5 flex items-center gap-1.5 text-[13px] font-bold text-slate-900">
              <Icon name="lucide:check-circle-2" class="h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
              {t.highlight}
            </p>
            {index < arr.length - 1 && <div class="mt-8 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent" />}
          </div>
        ))}
      </div>
    </section>

    <!-- 8. JUJUR DARI AWAL -->
    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Jujur Dari Awal</span>
      <h2 class={sectionTitle}>Syarat Pemakaian Supaya Hasil Tuntas</h2>
      <p class={`${body} mt-3 mb-6`}>Agar pembasmian rayap berlangsung efektif dan tidak menyebar:</p>

      <div class="space-y-2.5 text-[15px] leading-relaxed">
        <p class="flex items-start gap-2.5">
          <Icon name="lucide:check-circle-2" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Semprotkan pada <strong class="font-semibold text-slate-900">titik awal kemunculan rayap dan area sekitarnya</strong> agar cairan meresap penuh.</span>
        </p>
        <p class="flex items-start gap-2.5">
          <Icon name="lucide:check-circle-2" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Jangan langsung membersihkan jalur tanah bekas rayap sebelum disemprot, <strong class="font-semibold text-slate-900">biarkan rayap kontak dengan racun dahulu</strong> agar terbawa ke sarang.</span>
        </p>
        <p class="mt-4 flex items-start gap-2.5 border-l-2 border-[#FF9900] pl-3">
          <Icon name="lucide:info" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Gunakan sarung tangan saat menyemprot dan jauhkannya dari jangkauan anak-anak serta makanan.</span>
        </p>
      </div>
    </section>

    <!-- 9. BELANJA TANPA WAS-WAS / GARANSI COD -->
    <section class="border-t border-slate-100 bg-[#F2F3F3] px-5 py-10 text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center text-[#232F3E]">
        <Icon name="lucide:shield-check" class="h-12 w-12" aria-hidden="true" />
      </div>
      <h2 class="mb-2 text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Belanja Tanpa Risiko</h2>
      <h3 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950">BAYAR SETELAH BARANG SAMPAI</h3>
      <p class="mx-auto mt-4 max-w-[340px] text-[16px] leading-relaxed text-slate-600">Pesan Rayentra DGV hari ini promo Rp104.000 secara COD: Anda baru bayar ke kurir saat paket sudah di tangan.</p>

      <div class="mx-auto mt-8 max-w-[360px] space-y-6 text-left">
