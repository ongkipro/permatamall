---
import '../styles/global.css';
import {
  DEFAULT_ADMIN_PASSWORD_HASH,
  getAdminCredential,
  normalizeAdminUsername,
  verifyAdminLoginPassword,
} from '../lib/admin-credentials';
import { ADMIN_SESSION_COOKIE_OPTIONS, SESSION_COOKIE_NAME, secureEqual, signJwt } from '../lib/auth';
import {
  clearAdminLoginAttempts,
  consumeAdminLoginAttempt,
} from '../lib/admin-login-rate-limit';
import { getEnvValue, getRuntimeEnv } from '../lib/env';
import { tenantConfig } from '../lib/tenant';

export const prerender = false;

let errorMessage = '';
let submittedUsername = '';
let focusPassword = false;

if (Astro.request.method === 'POST') {
  const env = getRuntimeEnv(Astro.locals);
  const sessions = env?.SESSION as KVNamespace | undefined;
  const database = env?.OMS_DB as D1Database | undefined;
  const authSecret = getEnvValue('AUTH_SECRET', env);
  const clientIp = Astro.request.headers.get('cf-connecting-ip')?.trim() || 'local';

  try {
    if (!sessions || !database || authSecret.length < 32) {
      Astro.response.status = 503;
      errorMessage = 'Login admin belum dikonfigurasi di server.';
    } else {
      const data = await Astro.request.formData();
      const username = normalizeAdminUsername(data.get('username'));
      submittedUsername = username;
      focusPassword = true;
      const password = String(data.get('password') || '').slice(0, 1024);
      const bootstrapAdminPassword = getEnvValue('BOOTSTRAP_ADMIN_PASSWORD', env);
      const rateLimit = await consumeAdminLoginAttempt(
        database,
        username,
        clientIp,
      );

      if (!rateLimit.allowed) {
        Astro.response.status = 429;
        Astro.response.headers.set(
          'Retry-After',
          String(
            Math.max(
              1,
              Math.ceil((rateLimit.resetAt - Date.now()) / 1000),
            ),
          ),
        );
        errorMessage = 'Terlalu banyak percobaan. Coba kembali dalam 15 menit.';
      } else {
        const credential = await getAdminCredential(database, username);
        const verificationCredential = credential ?? {
          username: '__invalid__',
          passwordHash: DEFAULT_ADMIN_PASSWORD_HASH,
        };
        const [usernameMatches, passwordMatches] = await Promise.all([
          secureEqual(username, credential?.username ?? '__invalid__'),
          verifyAdminLoginPassword(password, verificationCredential, bootstrapAdminPassword),
        ]);

        if (credential && usernameMatches && passwordMatches) {
          const { token, session } = await signJwt({ username: credential.username, role: credential.role }, authSecret);
          await Promise.all([
            sessions.put(
              `admin-session:${session.jti}`,
              JSON.stringify({
                username: session.username,
                role: session.role,
                must_change_password: credential.mustChangePassword,
                credential_updated_at: credential.updatedAt,
              }),
              { expirationTtl: 60 * 60 * 24 },
            ),
            clearAdminLoginAttempts(database, rateLimit.scopeKeys),
          ]);
          Astro.cookies.set(SESSION_COOKIE_NAME, token, {
            ...ADMIN_SESSION_COOKIE_OPTIONS,
            maxAge: 60 * 60 * 24,
          });
          return Astro.redirect(credential.mustChangePassword ? '/admin/profile' : '/admin/dashboard');
        }

        Astro.response.status = 401;
        errorMessage = 'Username atau password salah.';
      }
    }
  } catch (error) {
    console.error('admin-login', error);
    Astro.response.status = 500;
    errorMessage = 'Terjadi kesalahan sistem login.';
  }
}
---

<!DOCTYPE html>
<html lang={tenantConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`Login AdsBookCMS - ${tenantConfig.adminName}`} />
    <meta property="og:image" content="/og-admin.webp" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:image" content="/og-admin.webp" />
    <title>Login AdsBookCMS - {tenantConfig.adminName}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="admin-login-page text-slate-900 antialiased">
    <main class="admin-login-stage">
    <div class="admin-login-card w-full max-w-sm rounded-2xl border border-white/70 bg-white/95 text-slate-950 shadow-2xl backdrop-blur-md">
      <!-- Header -->
      <div class="admin-login-header flex flex-col items-center px-6 pt-7 pb-3 text-center">
        <h1 class="sr-only">Login AdsBookCMS - {tenantConfig.adminName}</h1>
        <img src="/images/logo.webp" alt="AdsBookCMS Logo" width="180" height="188" class="mx-auto mb-3 h-36 w-auto max-w-[220px] object-contain drop-shadow-md" />
        <p class="text-sm font-semibold text-slate-600">{tenantConfig.adminName}</p>
      </div>

      <div class="p-6 pt-0">
        {errorMessage && (
          <div id="loginError" class="mb-4 rounded-xl bg-rose-50 p-3 text-center text-xs font-semibold text-rose-700" role="alert" aria-live="assertive">
            {errorMessage}
          </div>
        )}

        <form id="loginForm" method="POST" class="space-y-4" aria-busy="false" aria-describedby={errorMessage ? 'loginError' : undefined}>
          <div class="space-y-2">
            <label for="username" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Username Admin</label>
            <input id="username" type="text" name="username" required autocomplete="username" autofocus={!focusPassword} value={submittedUsername} class="admin-input-flat focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-1" />
          </div>

          <div class="space-y-2">
            <label for="password" class="text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70">Password</label>
            <div class="relative">
              <input id="password" type="password" name="password" required autocomplete="current-password" autofocus={focusPassword} class="admin-input-flat pr-20 focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-1" />
              <button id="togglePassword" type="button" class="absolute right-0 top-0 h-full rounded-r-md px-3 py-2 text-xs font-medium text-slate-500 hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-600" aria-controls="password" aria-label="Tampilkan password" aria-pressed="false">Lihat</button>
            </div>
          </div>
          <button id="loginSubmit" type="submit" class="btn-primary min-h-[44px] w-full px-4 py-2">
            Masuk Dashboard
          </button>
        <p id="loginStatus" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
        </form>
      </div>
      <script>
        const form = document.getElementById('loginForm') as HTMLFormElement | null;
        const submit = document.getElementById('loginSubmit') as HTMLButtonElement | null;
        const password = document.getElementById('password') as HTMLInputElement | null;
        const toggle = document.getElementById('togglePassword') as HTMLButtonElement | null;
        const status = document.getElementById('loginStatus');
        let pending = false;

        form?.addEventListener('submit', (event) => {
          if (pending) {
            event.preventDefault();
            return;
          }
          if (!form.checkValidity() || !submit) return;
          pending = true;
          form.setAttribute('aria-busy', 'true');
          submit.disabled = true;
          submit.textContent = 'Memverifikasi…';
          if (status) status.textContent = 'Memverifikasi kredensial admin.';
        });

        toggle?.addEventListener('click', () => {
          if (!password) return;
          const visible = password.type === 'text';
          password.type = visible ? 'password' : 'text';
          toggle.textContent = visible ? 'Lihat' : 'Sembunyikan';
          toggle.setAttribute('aria-label', visible ? 'Tampilkan password' : 'Sembunyikan password');
          toggle.setAttribute('aria-pressed', String(!visible));
        });
      </script>
    </div>
    </main>
  </body>
</html>
