---
import '../styles/global.css';
import {
  getAdminCredential,
  normalizeAdminUsername,
  verifyAdminLoginPassword,
} from '../lib/admin-credentials';
import { SESSION_COOKIE_NAME, secureEqual, signJwt } from '../lib/auth';
import { getEnvValue, getRuntimeEnv } from '../lib/env';
import { tenantConfig } from '../lib/tenant';

export const prerender = false;

let errorMessage = '';
let submittedUsername = '';
let focusPassword = false;

// The middleware's cross-site guard only covers /api/admin/*, and this form
// posts to itself — so the login POST needs its own origin check. Without it a
// third-party page can silently log an admin into an attacker's session.
const loginOrigin = Astro.request.headers.get('origin');
const loginFetchSite = Astro.request.headers.get('sec-fetch-site');
const crossSiteLogin =
  (loginOrigin !== null && loginOrigin !== Astro.url.origin) ||
  loginFetchSite === 'cross-site';

if (Astro.request.method === 'POST' && crossSiteLogin) {
  Astro.response.status = 403;
  errorMessage = 'Permintaan login ditolak karena berasal dari domain lain.';
} else if (Astro.request.method === 'POST') {
  const env = getRuntimeEnv(Astro.locals);
  const sessions = env?.SESSION as KVNamespace | undefined;
  const database = env?.OMS_DB as D1Database | undefined;
  const authSecret = getEnvValue('AUTH_SECRET', env);
  const clientIp = Astro.request.headers.get('cf-connecting-ip')?.trim() || 'local';
  const attemptKey = `admin-login-attempts:${clientIp}`;

  try {
    if (!sessions || !database || authSecret.length < 32) {
      Astro.response.status = 503;
      errorMessage = 'Login admin belum dikonfigurasi di server.';
    } else {
      const data = await Astro.request.formData();
      const username = normalizeAdminUsername(data.get('username'));
      submittedUsername = username;
      const password = String(data.get('password') || '').slice(0, 1024);
      const bootstrapAdminPassword = getEnvValue('BOOTSTRAP_ADMIN_PASSWORD', env);
      const credential = await getAdminCredential(database, username);
      if (!credential) {
        Astro.response.status = 401;
        errorMessage = 'Username atau password salah.';
      } else {
        const attempts = Number(await sessions.get(attemptKey)) || 0;
        if (attempts >= 5) {
          Astro.response.status = 429;
          errorMessage = 'Terlalu banyak percobaan. Coba kembali dalam 15 menit.';
        } else {
          const [usernameMatches, passwordMatches] = await Promise.all([
            secureEqual(username, credential.username),
            verifyAdminLoginPassword(password, credential, bootstrapAdminPassword),
          ]);

          if (usernameMatches && passwordMatches) {
            const { token, session } = await signJwt({ username: credential.username, role: credential.role }, authSecret);
            await Promise.all([
              sessions.put(
                `admin-session:${session.jti}`,
                JSON.stringify({
                  username: session.username,
                  role: session.role,
                  must_change_password: credential.mustChangePassword,
                  credential_updated_at: credential.updatedAt,
                }),
                { expirationTtl: 60 * 60 * 24 },
              ),
              sessions.delete(attemptKey),
            ]);
            Astro.cookies.set(SESSION_COOKIE_NAME, token, {
              path: '/',
              httpOnly: true,
              secure: import.meta.env.PROD,
              sameSite: 'lax',
              maxAge: 60 * 60 * 24,
            });
            return Astro.redirect(credential.mustChangePassword ? '/admin/profile' : '/admin/dashboard');
          }

          await sessions.put(attemptKey, String(attempts + 1), { expirationTtl: 15 * 60 });
          focusPassword = true;
          errorMessage = 'Username atau password salah.';
        }
      }
    }
  } catch (error) {
    console.error('admin-login', error);
    Astro.response.status = 500;
    errorMessage = 'Terjadi kesalahan sistem login.';
  }
}
---

<!DOCTYPE html>
<html lang={tenantConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`Login AdsBookCMS - ${tenantConfig.adminName}`} />
    <meta property="og:image" content="/og-admin.webp" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:image" content="/og-admin.webp" />
    <title>Login AdsBookCMS - {tenantConfig.adminName}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="admin-login-page text-slate-900 antialiased selection:bg-blue-100 selection:text-blue-900">
    <div class="admin-login-panel">
      <!-- Header / Brand Context -->
      <header class="mb-10">
        <div class="flex items-center gap-3 mb-8">
          <img src="/images/logo.webp" alt="Permata Mall" width="120" height="40" class="h-10 w-auto object-contain drop-shadow-sm" />
          <span class="text-xl font-bold tracking-tight text-slate-900">{tenantConfig.adminName}</span>
        </div>
        <h1 class="mb-1.5 text-2xl font-bold tracking-tight text-slate-950">Masuk ke dashboard</h1>
        <p class="text-sm text-slate-500">Masukkan kredensial admin untuk melanjutkan.</p>
      </header>

      <!-- Form Area -->
      <main>
        {errorMessage && (
          <div id="loginError" class="mb-6 rounded-lg border border-rose-200 bg-rose-50 p-4 text-sm font-medium text-rose-800 flex items-start shadow-sm" role="alert" aria-live="assertive">
            <svg class="w-5 h-5 mr-2.5 shrink-0 text-rose-600 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span class="leading-relaxed">{errorMessage}</span>
          </div>
        )}

        <form id="loginForm" method="POST" class="space-y-5" aria-busy="false" aria-describedby={errorMessage ? 'loginError' : undefined}>
          <div class="space-y-1.5">
            <label for="username" class="block text-sm font-semibold text-slate-700">Username Admin</label>
            <input id="username" type="text" name="username" required autocomplete="username" autofocus={!focusPassword} value={submittedUsername} class="admin-input-flat w-full min-h-[44px] px-3.5 py-2.5 text-base md:text-sm border-slate-300 rounded-lg shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:border-blue-600 transition-shadow bg-white text-slate-900" />
          </div>

          <div class="space-y-1.5">
            <label for="password" class="block text-sm font-semibold text-slate-700">Password</label>
            <div class="relative flex items-center">
              <input id="password" type="password" name="password" required autocomplete="current-password" autofocus={focusPassword} class="admin-input-flat w-full min-h-[44px] pl-3.5 pr-16 py-2.5 text-base md:text-sm border-slate-300 rounded-lg shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:border-blue-600 transition-shadow bg-white text-slate-900" />
              <button id="togglePassword" type="button" class="absolute right-1 top-0 bottom-0 my-auto h-[44px] min-w-[44px] px-3 text-xs font-semibold text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 transition-colors" aria-controls="password" aria-label="Tampilkan password" aria-pressed="false">Lihat</button>
            </div>
          </div>

          <div class="pt-2">
            <button id="loginSubmit" type="submit" class="w-full min-h-[44px] inline-flex items-center justify-center rounded-lg bg-slate-900 px-4 py-2.5 text-sm font-semibold text-white shadow-md hover:bg-slate-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 transition-all disabled:pointer-events-none disabled:opacity-60">
              Masuk Dashboard
            </button>
          </div>
          <p id="loginStatus" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
        </form>
      </main>

      <!-- Footer -->
      <footer class="mt-12 pt-6 border-t border-slate-100 text-xs text-slate-400">
        <p>&copy; {new Date().getFullYear()} {tenantConfig.adminName}. Akses khusus administrator.</p>
      </footer>

      <script>
        const form = document.getElementById('loginForm') as HTMLFormElement | null;
        const submit = document.getElementById('loginSubmit') as HTMLButtonElement | null;
        const password = document.getElementById('password') as HTMLInputElement | null;
        const toggle = document.getElementById('togglePassword') as HTMLButtonElement | null;
        const status = document.getElementById('loginStatus');
        let pending = false;

        form?.addEventListener('submit', (event) => {
          if (pending) {
            event.preventDefault();
            return;
          }
          if (!form.checkValidity() || !submit) return;
          pending = true;
          form.setAttribute('aria-busy', 'true');
          submit.disabled = true;
          submit.textContent = 'Memverifikasi…';
          if (status) status.textContent = 'Memverifikasi kredensial admin.';
        });

        toggle?.addEventListener('click', () => {
          if (!password) return;
          const visible = password.type === 'text';
          password.type = visible ? 'password' : 'text';
          toggle.textContent = visible ? 'Lihat' : 'Sembunyikan';
          toggle.setAttribute('aria-label', visible ? 'Tampilkan password' : 'Sembunyikan password');
          toggle.setAttribute('aria-pressed', String(!visible));
        });
      </script>
    </div>

    <div class="admin-login-artwork" aria-hidden="true"></div>
  </body>
</html>
