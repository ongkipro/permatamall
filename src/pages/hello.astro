---
import '../styles/global.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import {
  DEFAULT_ADMIN_PASSWORD_HASH,
  getAdminCredential,
  normalizeAdminUsername,
  verifyAdminLoginPassword,
} from '../lib/admin-credentials';
import { ADMIN_SESSION_COOKIE_OPTIONS, SESSION_COOKIE_NAME, getAdminSessionKey, secureEqual, signJwt } from '../lib/auth';
import {
  clearAdminLoginAttempts,
  consumeAdminLoginAttempt,
} from '../lib/admin-login-rate-limit';
import { getEnvValue, getRuntimeEnv } from '../lib/env';
import { tenantConfig } from '../lib/tenant';

export const prerender = false;

let errorMessage = '';
let submittedUsername = '';
let focusPassword = false;

if (Astro.request.method === 'POST') {
  const env = getRuntimeEnv(Astro.locals);
  const sessions = env?.SESSION as KVNamespace | undefined;
  const database = env?.OMS_DB as D1Database | undefined;
  const authSecret = getEnvValue('AUTH_SECRET', env);
  const clientIp = Astro.request.headers.get('cf-connecting-ip')?.trim() || 'local';

  try {
    if (!sessions || !database || authSecret.length < 32) {
      Astro.response.status = 503;
      errorMessage = 'Login admin belum dikonfigurasi di server.';
    } else {
      const data = await Astro.request.formData();
      const username = normalizeAdminUsername(data.get('username'));
      submittedUsername = username;
      focusPassword = true;
      const password = String(data.get('password') || '').slice(0, 1024);
      const bootstrapAdminPassword = getEnvValue('BOOTSTRAP_ADMIN_PASSWORD', env);
      const rateLimit = await consumeAdminLoginAttempt(
        database,
        username,
        clientIp,
      );

      if (!rateLimit.allowed) {
        Astro.response.status = 429;
        Astro.response.headers.set(
          'Retry-After',
          String(
            Math.max(
              1,
              Math.ceil((rateLimit.resetAt - Date.now()) / 1000),
            ),
          ),
        );
        errorMessage = 'Terlalu banyak percobaan. Coba kembali dalam 15 menit.';
      } else {
        const credential = await getAdminCredential(database, username);
        const verificationCredential = credential ?? {
          username: '__invalid__',
          passwordHash: DEFAULT_ADMIN_PASSWORD_HASH,
        };
        const [usernameMatches, passwordMatches] = await Promise.all([
          secureEqual(username, credential?.username ?? '__invalid__'),
          verifyAdminLoginPassword(password, verificationCredential, bootstrapAdminPassword),
        ]);

        if (credential && usernameMatches && passwordMatches) {
          const { token, session } = await signJwt({ username: credential.username, role: credential.role }, authSecret);
          await Promise.all([
            sessions.put(
              getAdminSessionKey(session),
              JSON.stringify({
                username: session.username,
                role: session.role,
                must_change_password: credential.mustChangePassword,
              }),
              { expirationTtl: 60 * 60 * 24 },
            ),
            clearAdminLoginAttempts(database, rateLimit.scopeKeys),
          ]);
          Astro.cookies.set(SESSION_COOKIE_NAME, token, {
            ...ADMIN_SESSION_COOKIE_OPTIONS,
            maxAge: 60 * 60 * 24,
          });
          return Astro.redirect(credential.mustChangePassword ? '/admin/profile' : '/admin/dashboard');
        }

        Astro.response.status = 401;
        errorMessage = 'Username atau password salah.';
      }
    }
  } catch (error) {
    console.error('admin-login', error);
    Astro.response.status = 500;
    errorMessage = 'Terjadi kesalahan sistem login.';
  }
}
---

<!DOCTYPE html>
<html lang={tenantConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`Login AdsBookCMS - ${tenantConfig.adminName}`} />
    <meta property="og:image" content="/og-admin.webp" />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:image" content="/og-admin.webp" />
    <title>Login AdsBookCMS - {tenantConfig.adminName}</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg" />
  </head>
  <body class="bg-white text-slate-900 antialiased selection:bg-blue-100 selection:text-blue-900">
    <main class="flex min-h-dvh w-full flex-col lg:grid lg:grid-cols-2">

      <!-- Form Region -->
      <div class="flex flex-1 flex-col justify-center pl-[max(1.5rem,env(safe-area-inset-left))] pr-[max(1.5rem,env(safe-area-inset-right))] pt-[max(3rem,env(safe-area-inset-top))] pb-[max(3rem,env(safe-area-inset-bottom))] lg:flex-none lg:px-16 xl:px-24">
        <div class="mx-auto w-full max-w-sm">

          <!-- Header -->
          <div class="mb-8 flex flex-col items-start text-left">
            <img src="/images/logo.webp" alt="AdsBookCMS Logo" width="180" height="188" class="mb-6 h-10 w-auto object-contain lg:h-12" />
            <h1 class="text-2xl font-bold tracking-tight text-slate-900">Masuk ke Admin</h1>
            <p class="mt-2 text-sm font-medium text-slate-600">
              Akses operator <span class="font-semibold text-slate-800">{tenantConfig.adminName}</span>
            </p>
          </div>

          {errorMessage && (
            <div id="loginError" class="mb-6 rounded-lg bg-rose-50 p-4 text-sm font-medium text-rose-800 ring-1 ring-inset ring-rose-200/50" role="alert" aria-live="assertive">
              {errorMessage}
            </div>
          )}

          <form id="loginForm" method="POST" class="space-y-5" aria-busy="false" aria-describedby={errorMessage ? 'loginError' : undefined}>
            <div class="space-y-2">
              <label for="username" class="block text-sm font-semibold text-slate-900">Username</label>
              <input id="username" type="text" name="username" required autocomplete="username" autofocus={!focusPassword} value={submittedUsername} class="admin-input-flat focus-visible:border-blue-600 focus-visible:ring-1 focus-visible:ring-blue-600 motion-reduce:transition-none" />
            </div>

            <div class="space-y-2">
              <label for="password" class="block text-sm font-semibold text-slate-900">Password</label>
              <div class="relative">
                <input id="password" type="password" name="password" required autocomplete="current-password" autofocus={focusPassword} class="admin-input-flat pr-24 focus-visible:border-blue-600 focus-visible:ring-1 focus-visible:ring-blue-600 motion-reduce:transition-none" />
                <button id="togglePassword" type="button" class="absolute right-0 top-0 h-full rounded-r-md px-4 text-sm font-semibold text-slate-600 transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-600 motion-reduce:transition-none" aria-controls="password" aria-label="Tampilkan password" aria-pressed="false">Lihat</button>
              </div>
            </div>

            <button id="loginSubmit" type="submit" class="btn-primary mt-2 min-h-[44px] w-full border border-transparent text-base motion-reduce:transition-none sm:text-sm">
              Masuk
            </button>
            <p id="loginStatus" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
          </form>

          <!-- Note -->
          <p class="mt-8 text-center text-xs leading-relaxed text-slate-500 lg:text-left">
            Akses terbatas untuk operator toko.<br class="hidden lg:block" /> Gunakan akun admin yang telah diberikan.
          </p>

        </div>
      </div>

      <!-- Visual Region -->
      <div class="hidden lg:relative lg:block lg:h-full lg:w-full lg:overflow-hidden lg:bg-slate-950">
        <img src="/admin-login.webp" alt="" aria-hidden="true" fetchpriority="high" class="absolute inset-0 h-full w-full object-contain p-12 opacity-60 mix-blend-luminosity xl:p-20" />
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent"></div>

        <div class="absolute bottom-0 left-0 right-0 p-12 xl:p-20">
          <p class="text-2xl font-bold tracking-tight text-white">AdsBookCMS</p>
          <p class="mt-3 max-w-md text-base leading-relaxed text-slate-300">
            Sistem manajemen terpusat untuk operator dan administrator. Pastikan Anda berada di jaringan yang aman sebelum masuk.
          </p>
        </div>
      </div>

    </main>

    <script>
      const form = document.getElementById('loginForm') as HTMLFormElement | null;
      const submit = document.getElementById('loginSubmit') as HTMLButtonElement | null;
      const password = document.getElementById('password') as HTMLInputElement | null;
      const toggle = document.getElementById('togglePassword') as HTMLButtonElement | null;
      const status = document.getElementById('loginStatus');
      let pending = false;

      form?.addEventListener('submit', (event) => {
        if (pending) {
          event.preventDefault();
          return;
        }
        if (!form.checkValidity() || !submit) return;
        pending = true;
        form.setAttribute('aria-busy', 'true');
        submit.disabled = true;
        submit.textContent = 'Memverifikasi…';
        if (status) status.textContent = 'Memverifikasi kredensial admin.';
      });

      toggle?.addEventListener('click', () => {
        if (!password) return;
        const visible = password.type === 'text';
        password.type = visible ? 'password' : 'text';
        toggle.textContent = visible ? 'Lihat' : 'Sembunyikan';
        toggle.setAttribute('aria-label', visible ? 'Tampilkan password' : 'Sembunyikan password');
        toggle.setAttribute('aria-pressed', String(!visible));
      });
    </script>
  </body>
</html>
