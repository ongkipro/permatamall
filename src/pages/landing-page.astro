---
import Icon from '../components/shared/Icon.astro';
import SolutionListItem from '../components/shared/SolutionListItem.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { solutionEntries } from '../data/content';
import { tenantConfig } from '../lib/tenant';
const entries = [...solutionEntries].reverse();
const categories = Array.from(new Set(entries.map((e) => e.category)));
---

<BaseLayout
  title={`Katalog Penawaran Produk - ${tenantConfig.name}`}
  description={`Daftar penawaran produk ${tenantConfig.name} yang sedang live. Semua produk bisa dipesan dengan bayar di tempat (COD).`}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Landing Page', url: '/landing-page' },
  ]}
>
  <main id="konten-utama" class="min-h-screen bg-[#F2F3F3] text-slate-900 pb-12">
    <!-- Header Hero Section -->
    <section class="bg-white px-4 pt-6 pb-8 border-b border-[#EAEDED]">
      <div class="mx-auto">
        <div class="flex items-center gap-2">
          <span
            class="inline-flex items-center gap-1.5 rounded-full bg-[#FFF5E5] px-2.5 py-1 text-[11px] font-bold uppercase tracking-[0.05em] text-[#EC7211]"
          >
            <span class="h-1.5 w-1.5 rounded-full bg-[#FF9900]"></span>
            {entries.length} PENAWARAN LIVE
          </span>
        </div>

        <h1 class="mt-3.5 text-[24px] font-bold leading-[1.2] tracking-tight text-[#16191F]">
          Solusi Praktis Harian,<br />
          <span class="text-[#FF9900]">Bayar Saat Sampai</span>
        </h1>
        <p class="mt-2 text-[14px] leading-relaxed text-[#545B64]">
          Setiap halaman penawaran di bawah membahas solusi secara mendalam: masalah utama, bukti pemakaian, dan form
          pemesanan COD langsung.
        </p>

        <!-- Search Bar -->
        <div class="mt-5 relative">
          <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#879596]">
            <Icon name="lucide:search" class="h-4.5 w-4.5" aria-hidden="true" />
          </div>
          <input
            type="text"
            id="lp-search"
            placeholder="Cari solusi (contoh: ngorok, pisau)..."
            class="w-full pl-10 pr-4 py-3 rounded-[8px] bg-[#F9FAFB] text-[#16191F] placeholder-[#879596] text-[15px] font-medium border border-[#EAEDED] focus:border-[#FF9900] focus:ring-1 focus:ring-[#FF9900] focus:outline-none transition-colors"
          />
        </div>
      </div>
    </section>

    <!-- Main Content Container -->
    <section class="mx-auto px-4 pt-6">
      <!-- Category Filter Tabs -->
      <div class="mb-6 flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
        <button
          type="button"
          data-category="all"
          class="cat-filter active-cat min-h-11 shrink-0 rounded-full bg-[#232F3E] px-3.5 py-1.5 text-[12.5px] font-bold text-white transition-colors shadow-sm"
        >
          Semua ({entries.length})
        </button>
        {
          categories.map((cat) => {
            const count = entries.filter((e) => e.category === cat).length;
            return (
              <button
                type="button"
                data-category={cat}
                class="cat-filter min-h-11 shrink-0 rounded-full bg-white px-3.5 py-1.5 text-[12.5px] font-semibold text-[#545B64] border border-[#D5DBDB] hover:bg-[#EAEDED] transition-colors"
              >
                {cat} ({count})
              </button>
            );
          })
        }
      </div>

      <!-- Grid of LPs -->
      <div id="lp-grid" class="flex flex-col gap-3">
        {
          entries.map((item, index) => (
            <div
              data-category={item.category}
              data-title={item.title.toLowerCase()}
              data-excerpt={item.excerpt.toLowerCase()}
              class="lp-card-item"
            >
              <SolutionListItem item={item} featured={index === 0} />
            </div>
          ))
        }
      </div>

      <!-- Load More Container -->
      <div id="lp-load-more-container" class="mt-5 text-center">
        <button
          type="button"
          id="lp-load-more-btn"
          class="inline-flex h-[44px] w-full items-center justify-center gap-2 rounded-[8px] border border-[#D5DBDB] bg-white px-4 text-[14px] font-semibold text-[#16191F] transition-colors hover:bg-[#EAEDED] active:scale-[0.98]"
        >
          Tampilkan Lebih Banyak Penawaran
        </button>
        <p id="lp-load-more-status" class="mt-2 text-[12.5px] font-medium text-[#545B64]"></p>
      </div>

      <!-- Empty Search Result -->
      <div id="empty-state" class="hidden py-10 text-center rounded-[12px] bg-white border border-[#EAEDED] p-6 mt-4">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-[#F2F3F3] text-[#545B64]">
          <Icon name="lucide:search-x" class="h-6 w-6" aria-hidden="true" />
        </div>
        <h3 class="mt-3 text-[15px] font-bold text-[#16191F]">Penawaran Tidak Ditemukan</h3>
        <p class="mt-1 text-[13px] text-[#545B64]">
          Coba gunakan kata kunci lain seperti "pisau", "herbal", "jeruk", atau "kunci".
        </p>
        <button
          type="button"
          id="reset-search"
          class="mt-5 inline-flex h-[44px] items-center justify-center rounded-[8px] bg-[#232F3E] px-4 text-[13px] font-semibold text-white transition-colors hover:bg-[#16191F]"
        >
          Tampilkan Semua Penawaran
        </button>
      </div>

      <!-- Trust Assurance Box -->
      <div class="mt-8 rounded-[12px] border border-[#EAEDED] bg-white p-5 shadow-sm">
        <h2 class="text-[17px] font-extrabold text-[#16191F] flex items-center gap-2">
          <Icon name="lucide:shield-check" class="h-5 w-5 text-[#1D8348]" aria-hidden="true" />
          Jaminan Belanja COD di Pesantren.shop
        </h2>
        <div class="mt-4 grid grid-cols-1 gap-3 border-t border-[#EAEDED] pt-4">
          <div class="flex items-start gap-2.5">
            <span
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#FFF5E5] text-[#EC7211] font-bold text-[12px]"
              >1</span
            >
            <div>
              <h3 class="text-[13px] font-bold text-[#16191F]">Tanpa DP & Transfer</h3>
              <p class="text-[12px] text-[#545B64] mt-0.5">
                Semua pesanan diproses tanpa perlu transfer uang muka terlebih dahulu.
              </p>
            </div>
          </div>
          <div class="flex items-start gap-2.5">
            <span
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#FFF5E5] text-[#EC7211] font-bold text-[12px]"
              >2</span
            >
            <div>
              <h3 class="text-[13px] font-bold text-[#16191F]">Paket Sesuai Foto</h3>
              <p class="text-[12px] text-[#545B64] mt-0.5">
                Barang yang dikirim dijamin 100% sama dengan tampilan di halaman penawaran.
              </p>
            </div>
          </div>
          <div class="flex items-start gap-2.5">
            <span
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#FFF5E5] text-[#EC7211] font-bold text-[12px]"
              >3</span
            >
            <div>
              <h3 class="text-[13px] font-bold text-[#16191F]">Bayar Pas Terima</h3>
              <p class="text-[12px] text-[#545B64] mt-0.5">
                Periksa keutuhan paket dan bayar langsung ke kurir ekspedisi di alamat Anda.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Client-side Live Search & Category Filtering Script -->
    <script>
      const searchInput = document.getElementById('lp-search') as HTMLInputElement | null;
      const catButtons = document.querySelectorAll<HTMLButtonElement>('.cat-filter');
      const cardItems = document.querySelectorAll<HTMLElement>('.lp-card-item');
      const emptyState = document.getElementById('empty-state');
      const resetBtn = document.getElementById('reset-search');
      const loadMoreContainer = document.getElementById('lp-load-more-container');
      const loadMoreBtn = document.getElementById('lp-load-more-btn');
      const loadMoreStatus = document.getElementById('lp-load-more-status');

      const INITIAL_LIMIT = 8;
      const LOAD_STEP = 8;
      let visibleLimit = INITIAL_LIMIT;
      let currentCategory = 'all';

      function filterCards() {
        const query = searchInput?.value.toLowerCase().trim() || '';
        let matchingCount = 0;
        let displayedCount = 0;

        cardItems.forEach((card) => {
          const title = card.getAttribute('data-title') || '';
          const excerpt = card.getAttribute('data-excerpt') || '';
          const category = card.getAttribute('data-category') || '';

          const matchesCat = currentCategory === 'all' || category === currentCategory;
          const matchesQuery =
            !query || title.includes(query) || excerpt.includes(query) || category.toLowerCase().includes(query);

          if (matchesCat && matchesQuery) {
            matchingCount++;
            if (matchingCount <= visibleLimit) {
              card.style.display = '';
              displayedCount++;
            } else {
              card.style.display = 'none';
            }
          } else {
            card.style.display = 'none';
          }
        });

        if (emptyState) {
          emptyState.style.display = matchingCount === 0 ? 'block' : 'none';
        }

        if (loadMoreContainer && loadMoreBtn && loadMoreStatus) {
          if (matchingCount === 0) {
            loadMoreContainer.style.display = 'none';
          } else {
            loadMoreContainer.style.display = 'block';
            loadMoreStatus.textContent = `Menampilkan ${displayedCount} dari ${matchingCount} penawaran.`;
            if (displayedCount >= matchingCount) {
              loadMoreBtn.style.display = 'none';
            } else {
              loadMoreBtn.style.display = 'inline-flex';
            }
          }
        }
      }

      searchInput?.addEventListener('input', () => {
        visibleLimit = INITIAL_LIMIT;
        filterCards();
      });

      catButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          catButtons.forEach((b) => {
            b.classList.remove('bg-[#232F3E]', 'text-white', 'active-cat');
            b.classList.add('bg-white', 'text-[#545B64]', 'border', 'border-[#D5DBDB]');
          });
          btn.classList.remove('bg-white', 'text-[#545B64]', 'border', 'border-[#D5DBDB]');
          btn.classList.add('bg-[#232F3E]', 'text-white', 'active-cat');

          currentCategory = btn.getAttribute('data-category') || 'all';
          visibleLimit = INITIAL_LIMIT;
          filterCards();
        });
      });

      loadMoreBtn?.addEventListener('click', () => {
        visibleLimit += LOAD_STEP;
        filterCards();
      });

      resetBtn?.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentCategory = 'all';
        visibleLimit = INITIAL_LIMIT;
        catButtons.forEach((b) => {
          if (b.getAttribute('data-category') === 'all') {
            b.click();
          }
        });
        filterCards();
      });

      // Initial trigger to apply limit
      filterCards();
    </script>
  </main>
</BaseLayout>
