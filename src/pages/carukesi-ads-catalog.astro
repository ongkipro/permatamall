---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = false;

const ads = [
  {
    lp: '01',
    slug: 'carukesi-nyeri-sendi-lutut',
    title: 'Nyeri Sendi Lutut & Sholat Lancar',
    target: 'Lansia 50+, Penderita Osteoarthritis, Jamaah Sholat di Kursi',
    headline: 'Lutut Kletuk & Kaku Langsung Enteng 10 Detik',
    primaryText: 'Lutut kaku bunyi kemretek saat ditekuk? Oles gel hangat ini 10 detik langsung enteng, sujud sholat lancar tanpa kursi.',
  },
  {
    lp: '02',
    slug: 'carukesi-sakit-pinggang-boyok',
    title: 'Sakit Pinggang, Boyok & Saraf Kejepit',
    target: 'Supir Truk/Travel, Pekerja Duduk Lama, Pria Usia 35–55 th',
    headline: 'Boyok Mau Patah Langsung Rileks Sekali Oles',
    primaryText: 'Pinggang serasa mau patah & saraf kejepit nyeri? Gel herbal meresap kilat, boyok kaku langsung lemas bertenaga.',
  },
  {
    lp: '03',
    slug: 'carukesi-asam-urat-bengkak',
    title: 'Asam Urat Kumat & Sendi Bengkak',
    target: 'Penderita Asam Urat, Jempol Kaki Bengkak, Usia 40–60 th',
    headline: 'Asam Urat Kumat Bengkak Kempes Seketika',
    primaryText: 'Sendi jempol kaki bengkak merah & menusuk? Formula gel dingin-hangat redakan radang asam urat dalam hitungan menit.',
  },
  {
    lp: '04',
    slug: 'carukesi-leher-kaku-pundak',
    title: 'Leher Kaku (Tech Neck) & Pundak Tegang',
    target: 'Pekerja Kantoran, Programmer, Gamers, Usia 22–45 th',
    headline: 'Leher Kaku Pundak Berat Langsung Enteng Total',
    primaryText: 'Leher kaku & pundak tegang akibat seharian kerja depan layar? Sekali oles hangat, otot leher langsung lentur rileks.',
  },
  {
    lp: '05',
    slug: 'carukesi-kebas-kesemutan',
    title: 'Rematik, Tangan & Kaki Kebas Kesemutan',
    target: 'Penderita Rematik, Sensitif AC/Angin Malam, Usia 40–65 th',
    headline: 'Telapak Tangan Kebas & Kaki Kesemutan Hilang Total',
    primaryText: 'Telapak tangan mati rasa tebal & kaki kesemutan dingin? Hangat aktif lancarkan aliran saraf tepi dalam 10 detik.',
  },
  {
    lp: '06',
    slug: 'carukesi-lansia-gendong-cucu',
    title: 'Lansia Aktif Bebas Jalan & Gendong Cucu',
    target: 'Kakek-Nenek 55+, Anak Berbakti Beli Hadiah Orang Tua',
    headline: 'Sendi Tua Kembali Kuat Gendong Cucu Tercinta',
    primaryText: 'Sendi rapuh bikin susah jalan? Gel oles ini bikin langkah kaki lansia kokoh dan enteng momong cucu seharian.',
  },
  {
    lp: '07',
    slug: 'carukesi-pekerja-keras-badan-remuk',
    title: 'Badan Remuk Kuli & Buruh Pabrik',
    target: 'Kuli Logistik, Buruh Pabrik, Mekanik Bengkel, Pria 25–55 th',
    headline: 'Badan Remuk Kerja Kasar Pulih Segar Seketika',
    primaryText: 'Punggung remuk & otot linu sehabis banting tulang seharian? Oles gel cepat serap, badan segar bebas pegal semalaman.',
  },
  {
    lp: '08',
    slug: 'carukesi-olahraga-keseleo-engkel',
    title: 'Cedera Olahraga, Kram & Keseleo Engkel',
    target: 'Pemain Futsal, Pelari, Pesepeda, Usia 20–45 th',
    headline: 'Keseleo Engkel & Kram Otot Reda Hitungan Menit',
    primaryText: 'Engkel terkilir atau paha kram saat futsal? Sensasi hangat kilat redakan bengkak dan kaku otot seketika.',
  },
  {
    lp: '09',
    slug: 'carukesi-ibu-rumah-tangga-pegal',
    title: 'Tumit Menusuk & Betis Pegal IRT',
    target: 'Ibu Rumah Tangga, Plantar Fasciitis, Wanita 28–55 th',
    headline: 'Tumit Menusuk Bangun Pagi Hilang Sekali Oles',
    primaryText: 'Tumit sakit menusuk saat menapak pagi hari & betis kram di dapur? Oles malam hari, bangun tidur tumit enteng nyaman.',
  },
  {
    lp: '10',
    slug: 'carukesi-tidur-nyenyak-bebas-ngilu',
    title: 'Nyeri Sendi Malam Jam 2 Pagi & Tidur Pulas',
    target: 'Insomnia Akibat Nyeri Sendi, Darurat Nyeri Malam, Usia 40+',
    headline: 'Nyeri Sendi Jam 2 Pagi Reda Tidur Pulas Sampai Subuh',
    primaryText: 'Terbangun tengah malam karena sendi berdenyut ngilu? Gel hangat redakan nyeri seketika, tidur pulas nyaman sampai subuh.',
  },
];
---

<BaseLayout
  title="Katalog 10 LP & Brutal Overclaim Ads Copy — Carukési Relaxing Gel"
  description="Katalog daftar 10 Landing Page Direct-Response dan matriks Ads Copy Brutal Overclaim (Primary Text < 160 Karakter, Tanpa CTA)."
  hideHeader={true}
  hideFooter={true}
>
  <main class="min-h-screen bg-slate-950 text-slate-100 pb-20 selection:bg-red-500 selection:text-white font-sans">
    <!-- TOP HEADER -->
    <header class="border-b border-slate-800 bg-slate-900/90 sticky top-0 z-30 backdrop-blur-md px-4 lg:px-8 py-4 shadow-xl">
      <div class="max-w-6xl mx-auto flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2.5">
            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-extrabold uppercase tracking-wider bg-red-500/20 text-red-400 border border-red-500/30">Direct-Response Ads Suite</span>
            <span class="text-xs text-slate-400 font-medium">• Carukési Relaxing Gel</span>
          </div>
          <h1 class="text-lg sm:text-2xl font-black tracking-tight text-white mt-1">10 Landing Page & Brutal Overclaim Ads Copy</h1>
        </div>
        <div class="flex items-center gap-2 text-xs">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-bold">
            <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            10 / 10 LP Live
          </span>
          <button id="btn-copy-all" class="px-3.5 py-1.5 rounded-lg bg-red-600 hover:bg-red-500 text-white font-bold transition-all active:scale-95 shadow-md flex items-center gap-1.5 cursor-pointer">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"></path></svg>
            Salin Semua Ads Copy
          </button>
        </div>
      </div>
    </header>

    <!-- CONTENT WRAPPER -->
    <div class="max-w-6xl mx-auto px-4 lg:px-8 pt-6">

      <!-- RULE INFO BOX -->
      <div class="mb-6 p-4 rounded-xl bg-slate-900 border border-blue-500/20 flex flex-wrap items-center justify-between gap-4 text-xs">
        <div class="flex flex-wrap items-center gap-4 sm:gap-8">
          <div>
            <span class="text-slate-400">Batasan Karakter:</span>
            <span class="font-bold text-amber-300 ml-1">Primary Text &le; 160 Karakter</span>
          </div>
          <div>
            <span class="text-slate-400">Disiplin CTA:</span>
            <span class="font-bold text-emerald-400 ml-1">Native Story Hook (Tanpa Kata CTA)</span>
          </div>
          <div>
            <span class="text-slate-400">Total Angle:</span>
            <span class="font-bold text-white ml-1">10 Segmen Konsumen</span>
          </div>
        </div>
        <div class="text-slate-400 italic">
          *Klik tombol <strong class="text-white">Salin</strong> untuk instant copy ke Ads Manager.
        </div>
      </div>

      <!-- ADS CARDS GRID -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {ads.map((ad) => (
          <div class="rounded-2xl bg-slate-900/80 border border-slate-800 p-5 hover:border-slate-700 transition-all flex flex-col justify-between shadow-lg">
            <div>
              <div class="flex items-center justify-between gap-2 mb-2">
                <span class="px-2.5 py-0.5 rounded-md bg-blue-500/20 text-blue-400 text-[11px] font-black uppercase tracking-wider">
                  LP #{ad.lp}
                </span>
                <span class="text-[11px] text-slate-400 font-mono">
                  {ad.primaryText.length} Karakter
                </span>
              </div>
              <h2 class="text-base font-bold text-white mb-1 flex items-center justify-between">
                <span>{ad.title}</span>
                <a href={`https://permatamall.shop/${ad.slug}`} target="_blank" class="text-xs text-blue-400 hover:text-blue-300 hover:underline flex items-center gap-1 font-semibold">
                  Live LP &nearr;
                </a>
              </h2>
              
              <!-- Headline Box -->
              <div class="mt-3.5 bg-slate-950/80 p-3 rounded-xl border border-slate-800">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-[10px] uppercase font-extrabold text-slate-400 tracking-wider">Headline:</span>
                  <button data-copy={ad.headline} class="copy-btn text-[11px] text-red-400 hover:text-red-300 font-bold flex items-center gap-1 cursor-pointer">
                    Salin
                  </button>
                </div>
                <p class="text-[13.5px] font-black text-amber-300">{ad.headline}</p>
              </div>

              <!-- Primary Text Box -->
              <div class="mt-2.5 bg-slate-950/80 p-3 rounded-xl border border-slate-800">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-[10px] uppercase font-extrabold text-slate-400 tracking-wider">Primary Text:</span>
                  <button data-copy={ad.primaryText} class="copy-btn text-[11px] text-red-400 hover:text-red-300 font-bold flex items-center gap-1 cursor-pointer">
                    Salin
                  </button>
                </div>
                <p class="text-[13px] leading-relaxed text-slate-200">{ad.primaryText}</p>
              </div>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-800/80 flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-[11px] text-slate-400">
              <span>Target: {ad.target}</span>
              <span class="font-mono text-emerald-400">/{ad.slug}</span>
            </div>
          </div>
        ))}
      </div>

    </div>

    <!-- TOAST NOTIFICATION -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 bg-emerald-600 text-white font-bold text-xs px-4 py-2.5 rounded-xl shadow-2xl transition-all duration-300 opacity-0 pointer-events-none transform translate-y-4">
      Teks berhasil disalin ke clipboard!
    </div>
  </main>

  <script is:inline>
    function showToast(msg = 'Teks berhasil disalin ke clipboard!') {
      const toast = document.getElementById('toast');
      if (!toast) return;
      toast.textContent = msg;
      toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
      toast.classList.add('opacity-100', 'translate-y-0');
      setTimeout(() => {
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
      }, 2000);
    }

    document.querySelectorAll('.copy-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-copy');
        if (!text) return;
        navigator.clipboard.writeText(text).then(() => {
          showToast();
          const orig = btn.textContent;
          btn.textContent = '✓ Tersalin!';
          setTimeout(() => btn.textContent = orig, 1500);
        });
      });
    });

    const btnCopyAll = document.getElementById('btn-copy-all');
    if (btnCopyAll) {
      btnCopyAll.addEventListener('click', () => {
        const fullText = `=== 10 BRUTAL OVERCLAIM ADS COPY CARUKÉSI RELAXING GEL ===

[LP 01 - NYERI SENDI LUTUT & SHOLAT]
URL: https://permatamall.shop/carukesi-nyeri-sendi-lutut
Headline: Lutut Kletuk & Kaku Langsung Enteng 10 Detik
Primary Text: Lutut kaku bunyi kemretek saat ditekuk? Oles gel hangat ini 10 detik langsung enteng, sujud sholat lancar tanpa kursi.

[LP 02 - SAKIT PINGGANG BOYOK & SARAF KEJEPIT]
URL: https://permatamall.shop/carukesi-sakit-pinggang-boyok
Headline: Boyok Mau Patah Langsung Rileks Sekali Oles
Primary Text: Pinggang serasa mau patah & saraf kejepit nyeri? Gel herbal meresap kilat, boyok kaku langsung lemas bertenaga.

[LP 03 - ASAM URAT KUMAT & SENDI BENGKAK]
URL: https://permatamall.shop/carukesi-asam-urat-bengkak
Headline: Asam Urat Kumat Bengkak Kempes Seketika
Primary Text: Sendi jempol kaki bengkak merah & menusuk? Formula gel dingin-hangat redakan radang asam urat dalam hitungan menit.

[LP 04 - LEHER KAKU TECH NECK & PUNDAK TEGANG]
URL: https://permatamall.shop/carukesi-leher-kaku-pundak
Headline: Leher Kaku Pundak Berat Langsung Enteng Total
Primary Text: Leher kaku & pundak tegang akibat seharian kerja depan layar? Sekali oles hangat, otot leher langsung lentur rileks.

[LP 05 - REMATIK, TANGAN & KAKI KEBAS KESEMUTAN]
URL: https://permatamall.shop/carukesi-kebas-kesemutan
Headline: Telapak Tangan Kebas & Kaki Kesemutan Hilang Total
Primary Text: Telapak tangan mati rasa tebal & kaki kesemutan dingin? Hangat aktif lancarkan aliran saraf tepi dalam 10 detik.

[LP 06 - LANSIA AKTIF BEBAS JALAN & GENDONG CUCU]
URL: https://permatamall.shop/carukesi-lansia-gendong-cucu
Headline: Sendi Tua Kembali Kuat Gendong Cucu Tercinta
Primary Text: Sendi rapuh bikin susah jalan? Gel oles ini bikin langkah kaki lansia kokoh dan enteng momong cucu seharian.

[LP 07 - BADAN REMUK KULI & BURUH PABRIK]
URL: https://permatamall.shop/carukesi-pekerja-keras-badan-remuk
Headline: Badan Remuk Kerja Kasar Pulih Segar Seketika
Primary Text: Punggung remuk & otot linu sehabis banting tulang seharian? Oles gel cepat serap, badan segar bebas pegal semalaman.

[LP 08 - CEDERA OLAHRAGA, KRAM & KESELEO ENGKEL]
URL: https://permatamall.shop/carukesi-olahraga-keseleo-engkel
Headline: Keseleo Engkel & Kram Otot Reda Hitungan Menit
Primary Text: Engkel terkilir atau paha kram saat futsal? Sensasi hangat kilat redakan bengkak dan kaku otot seketika.

[LP 09 - TUMIT MENUSUK & BETIS PEGAL IRT]
URL: https://permatamall.shop/carukesi-ibu-rumah-tangga-pegal
Headline: Tumit Menusuk Bangun Pagi Hilang Sekali Oles
Primary Text: Tumit sakit menusuk saat menapak pagi hari & betis kram di dapur? Oles malam hari, bangun tidur tumit enteng nyaman.

[LP 10 - NYERI MALAM JAM 2 PAGI & TIDUR PULAS]
URL: https://permatamall.shop/carukesi-tidur-nyenyak-bebas-ngilu
Headline: Nyeri Sendi Jam 2 Pagi Reda Tidur Pulas Sampai Subuh
Primary Text: Terbangun tengah malam karena sendi berdenyut ngilu? Gel hangat redakan nyeri seketika, tidur pulas nyaman sampai subuh.`;

        navigator.clipboard.writeText(fullText).then(() => {
          showToast('Seluruh 10 Ads Copy berhasil disalin!');
        });
      });
    }
  </script>
</BaseLayout>
