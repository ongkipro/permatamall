---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { recentOrderCount } from '../lib/social-proof';
import { getStorefrontProduct, getStorefrontProducts } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { nativeLandingProductJsonLd } from '../lib/native-landing-product';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import {
  loadStoreCodDisabledProvinceCodes,
  resolveFormModeContext,
} from '../lib/form-mode';
import { getRuntimeEnv } from '../lib/env';
import type { Product } from '../data/products';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';

export const prerender = false;

const SLUG = 'nutrilove-perut-buncit-detox';
const PRODUCT_SLUG = 'cuka-sari-apel-100-original';

let product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);

// Fallback preview product to ensure seamless preview/standalone renders even before D1 sync
if (!product) {
  const [firstProduct] = await getStorefrontProducts(Astro.locals);
  product = firstProduct ?? {
    productId: '17981',
    slug: PRODUCT_SLUG,
    productName: 'NutriLove Cuka Apel 100% Original With The Mother',
    contentName: 'NutriLove Cuka Apel 100% Original With The Mother',
    headline: 'Paket Detox Lemak Perut Buncit, Begah & Pencernaan Plong',
    subheadline: 'Cuka Sari Apel Murni With The Mother (Beli 1 Gratis 3 Botol)',
    seoTitle: 'NutriLove Cuka Apel With The Mother — Solusi Alami Kempeskan Perut Buncit Keras, Begah & Susah BAB',
    seoDescription: 'Perut buncit keras kayak batu, celana makin sempit, dan sering begah susah BAB? Detox alami 1 sendok NutriLove Cuka Apel With The Mother bantu luruhkan lemak visceral perut.',
    price: 97500,
    comparePrice: 199000,
    image: '/images/landing/nutrilove-cuka-apel/perut-buncit-hero-brutal.webp',
    heroImage: '/images/landing/nutrilove-cuka-apel/perut-buncit-hero-brutal.webp',
    category: 'Kesehatan',
    brand: 'NutriLove',
    relatedCategories: ['Kesehatan', 'Herbal'],
    description: 'Cuka Apel fermentasi alami with The Mother ukuran 500ml untuk membantu meluruhkan lemak visceral perut buncit, mengatasi perut begah, dan melancarkan BAB.',
    benefits: [
      'Bantu luruhkan lemak visceral (perut buncit keras)',
      'Perut begah kembung langsung kempes & BAB lancar pagi hari',
      'Kunci nafsu ngemil malam tanpa perlu diet menyiksa',
      'Fermentasi alami with The Mother kaya enzim probiotik hidup',
    ],
    keyPoints: [
      'Isi 500ml per botol',
      'Promo Beli 1 Gratis 3 (Total 4 Botol / 2.000 ml)',
      'Gratis Ongkir Se-Pulau Jawa & Bisa COD Seluruh Indonesia',
    ],
    idealFor: ['Pria dan wanita usia 30–55 tahun yang memiliki keluhan perut buncit keras, celana sempit, metabolisme melambat, sering begah, dan susah BAB'],
    offerText: 'PROMO SPESIAL: BELI 1 GRATIS 3 (Total 4 Botol / 2.000 ml) Hanya Rp 97.500 • GRATIS ONGKIR SE-PULAU JAWA',
    ctaText: 'Pesan Sekarang (COD)',
    ratingValue: 4.9,
    reviewCount: 4650,
    soldCount: 6800,
    reviews: [],
    variants: [
      { id: '12', sku: 'BELI_2_GRATIS_2', label: 'BELI 1 GRATIS 3 (Dapat 4 Botol)', price: 97500, comparePrice: 199000 },
      { id: '13', sku: 'PAKET_6_BOTOL', label: 'PAKET 6 Botol (Hemat 50%)', price: 199000, comparePrice: 398000 },
    ],
  } as Product;
}

// Enforce exactly 2 packages: Beli 1 Gratis 3 (Total 4 Botol Rp 97.500) and Paket 6 Botol (Rp 199.000)
if (product) {
  product = {
    ...product,
    variants: [
      { id: '12', sku: 'BELI_2_GRATIS_2', label: 'BELI 1 GRATIS 3 (Dapat 4 Botol)', price: 97500, comparePrice: 199000 },
      { id: '13', sku: 'PAKET_6_BOTOL', label: 'PAKET 6 Botol (Hemat 50%)', price: 199000, comparePrice: 398000 },
    ],
  };
}

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const codDisabledProvinceCodes = await loadStoreCodDisabledProvinceCodes(database);
const formContext = await resolveFormModeContext(
  Astro.request,
  codDisabledProvinceCodes,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price ?? 97500;
const comparePrice = cheapest?.comparePrice ?? product.comparePrice ?? 199000;

const defaultUpsellVariantId = '13';

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;

const testimonials = [
  {
    name: 'Ibu Rina (39 th)',
    city: 'Bekasi',
    occupation: 'Ibu Rumah Tangga & Kuliner',
    rating: 5,
    highlight: 'lingkar perut susut 8 cm dan celana lama longgar lagi',
    quote: 'Minum 1 sloki campur air hangat malam hari, subuhnya langsung BAB plong kotoran hitam rontok tanpa melilit. Dalam 2 minggu lingkar perut susut 8 cm dan celana lama longgar lagi!',
    image: '/images/landing/nutrilove-cuka-apel/testimoni-ibu-rina-proof.webp',
  },
  {
    name: 'Pak Dimas (45 th)',
    city: 'Bandung',
    occupation: 'Karyawan Swasta',
    rating: 5,
    highlight: 'perut kempes lembek dan turun 2 nomor celana',
    quote: 'Perut tadinya keras padat mentok di meja kerja. Masuk botol kedua rutin minum NutriLove, perut kempes lembek dan turun 2 nomor celana tanpa diet menyiksa!',
    image: '/images/landing/nutrilove-cuka-apel/testimoni-pak-dimas-proof.webp',
  },
  {
    name: 'Ibu Dewi (43 th)',
    city: 'Semarang',
    occupation: 'Pengusaha Kue',
    rating: 5,
    highlight: 'perut kempes rata dan nafas plong enteng',
    quote: 'Perut buncit keras menonjol dan sembelit berhari-hari. Hari ke-3 rutin minum NutriLove ACV, kerak usus rontok tuntas, perut kempes rata dan nafas plong enteng!',
    image: '/images/landing/nutrilove-cuka-apel/testimoni-ibu-dewi-proof.webp',
  },
];

const sectionTitle = 'text-[clamp(22px,6.8vw,26px)] font-black text-slate-950 tracking-normal leading-[1.2]';
const sectionLead = 'text-[15px] sm:text-[16px] text-slate-700 leading-relaxed mt-2 max-w-[420px] mx-auto';
const socialProofOrders = await recentOrderCount(getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined);
---

<BaseLayout
  title="NutriLove Cuka Apel With The Mother — Detox Alami Perut Buncit Keras, Begah & Susah BAB"
  description="Perut buncit keras kayak batu, celana makin sempit, dan sering begah susah BAB? Detox alami 1 sendok NutriLove Cuka Apel With The Mother bantu luruhkan lemak visceral perut."
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  image="/images/landing/nutrilove-cuka-apel/perut-buncit-hero-brutal.webp"
  preloadImages="/images/landing/nutrilove-cuka-apel/perut-buncit-hero-brutal.webp"
  product={nativeLandingProductJsonLd(product, canonical)}
>

  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={price}
  />

  <style is:global>
    .trust-strip i {
      font-size: 12px !important;
    }
    .total-box small,
    .district-item small,
    .payment-block-anchor small {
      font-size: 12px !important;
    }
  </style>

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-12 font-sans text-slate-900 shadow-2xl selection:bg-[#0F2F1F] selection:text-white antialiased">
    
    <!-- ═══ 1. URGENCY ANNOUNCEMENT BAR (TOP) ═══ -->
    <header class="flex items-center justify-between gap-2 border-b border-emerald-950 bg-[#0F2F1F] px-3.5 py-2 text-white shadow-xs">
      <div class="flex items-center gap-1.5 text-[12px] font-extrabold tracking-wide min-w-0">
        <span class="flex h-2 w-2 relative shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
        </span>
        <span class="text-amber-300 font-black uppercase shrink-0">PROMO:</span>
        <span class="text-slate-100 font-extrabold whitespace-nowrap">BELI 1 GRATIS 3 (4 BTL)</span>
      </div>
      <span class="whitespace-nowrap text-[12px] font-black tracking-wider text-amber-300 bg-emerald-800/90 px-2.5 py-0.5 rounded-full border border-emerald-600/60 shadow-xs shrink-0">
        GRATIS ONGKIR P. JAWA
      </span>
    </header>

    <!-- ═══ 2. HERO SECTION (BRUTAL OVERCLAIM PERUT BUNCIT KERAS & DETOX USUS) ═══ -->
    <section id="landing-hero" class="bg-white text-center pb-8">
      <div class="px-4 sm:px-5 pt-5 sm:pt-6">
        
        <!-- Star Rating Social Proof -->
        <div class="mb-3 inline-flex items-center justify-center gap-1.5 text-[13px] font-bold text-slate-800 bg-emerald-50/90 px-3.5 py-1 rounded-full border border-emerald-200/80 shadow-2xs">
          <div class="flex items-center gap-0.5 shrink-0 text-amber-400 text-[14px] leading-none" role="img" aria-label="Rating 5 dari 5 bintang">
            ★ ★ ★ ★ ★
          </div>
          <span class="text-slate-900 font-extrabold">4.9 / 5.0</span>
          <span class="text-slate-400">•</span>
          <span class="text-slate-600 font-medium">(6.800+ Paket Terkirim)</span>
        </div>

        <!-- Main Impact Brutal Overclaim Headline -->
        <h1 class="mx-auto max-w-[440px] text-[clamp(22px,7vw,28px)] font-black leading-[1.22] tracking-normal text-slate-950">
          Perut Buncit Keras Kayak Batu &amp; <span class="box-decoration-clone rounded-[0.18em] bg-red-100 text-red-700 px-1.5 py-0.5">Susah BAB?</span>
        </h1>

        <!-- Subtitle -->
        <p class="mx-auto mt-2 max-w-[420px] text-[15px] sm:text-[16px] leading-relaxed text-slate-700">
          Luruhkan kerak usus dan lemak visceral membandel dengan <strong class="text-slate-950 font-bold">NutriLove Cuka Apel With The Mother</strong>. Perut kempes enteng, BAB subuh lancar plong.
        </p>
      </div>

      <!-- ═══ FULL-WIDTH HERO BRUTAL OVERCLAIM BANNER (RATIO 4:3) ═══ -->
      <div class="mt-4 relative w-full overflow-hidden bg-slate-950 aspect-[4/3] shadow-md border-y border-red-950">
        <img
          src="/images/landing/nutrilove-cuka-apel/perut-buncit-hero-brutal.webp"
          alt="Perbandingan Perut Buncit Lemak Visceral vs Perut Kempes Ramping Dengan NutriLove Cuka Apel With The Mother"
          class="h-full w-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1200"
          height="896"
        />

        <div class="absolute top-3 right-3 bg-red-600 text-white text-[12px] font-black uppercase tracking-wider px-2.5 py-1 rounded-md shadow-md border border-white/20">
          BELI 1 GRATIS 3
        </div>

        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/95 via-slate-950/80 to-transparent px-3 pt-8 pb-2.5 text-center">
          <p class="text-[13px] sm:text-[14px] text-amber-300 leading-tight">
            Luruhkan Lemak Visceral • BAB Subuh Lancar Plong
          </p>
        </div>
      </div>

      <!-- Above-the-Fold Primary CTA + Fold Sentinel -->
      <div class="mt-4 px-4 sm:px-5">
        <a
          href="#form-pemesanan"
          class="flex w-full min-h-[52px] items-center justify-center gap-2 rounded-xl bg-red-600 hover:bg-red-700 px-4 py-3 text-[15px] sm:text-[16px] font-extrabold tracking-normal text-white shadow-lg shadow-red-600/25 transition-colors active:scale-[0.99]"
        >
          <span>Ambil Promo Beli 1 Gratis 3 (COD)</span>
          <span aria-hidden="true">↓</span>
        </a>
      </div>
      <div id="hero-fold-sentinel" class="h-px w-full" aria-hidden="true"></div>

      <!-- Clean High-Trust Value Bar (No Slop / No Chip Overload) -->
      <div class="mt-3.5 flex items-center justify-center gap-4 text-[12.5px] sm:text-[13px] font-semibold text-slate-700">
        <div class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          <span>Bisa Bayar COD</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          <span>Gratis Ongkir P. Jawa</span>
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="h-4 w-4 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
          <span>Aman Lambung</span>
        </div>
      </div>

      <!-- 4 Key Somatic Pain Points (Concise & Clean) -->
      <div class="mt-7 px-4 sm:px-5 text-left">
        <div class="flex items-center justify-between mb-3 border-b border-slate-100 pb-2">
          <h2 class="text-[14px] font-black uppercase tracking-wider text-slate-900">4 Tanda Kerak Usus &amp; Lemak Menumpuk</h2>
          <span class="text-xs font-bold text-red-600">Perlu Diwaspadai</span>
        </div>

        <div class="space-y-2.5">
          <div class="p-3.5 rounded-xl bg-slate-50/80 border border-slate-200/80 shadow-2xs">
            <div class="flex items-center justify-between gap-2">
              <h2 class="text-[15px] font-bold text-slate-950">1. Perut Keras &amp; Mengganjal</h2>
              <span class="text-xs font-bold uppercase tracking-wider text-red-700 bg-red-100/80 px-2 py-0.5 rounded-full shrink-0">Lemak Organ</span>
            </div>
            <p class="text-[15px] text-slate-700 mt-1 leading-relaxed">Timbunan lemak mengunci organ dalam. Terasa padat keras saat ditekan, begah saat duduk, dan sesak saat membungkuk.</p>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-50/80 border border-slate-200/80 shadow-2xs">
            <div class="flex items-center justify-between gap-2">
              <h2 class="text-[15px] font-bold text-slate-950">2. Kerak Usus &amp; BAB Macet</h2>
              <span class="text-xs font-bold uppercase tracking-wider text-red-700 bg-red-100/80 px-2 py-0.5 rounded-full shrink-0">Usus Kotor</span>
            </div>
            <p class="text-[15px] text-slate-700 mt-1 leading-relaxed">Sisa makanan berhari-hari membusuk jadi gas racun. Perut kembung kencang seperti balon dan BAB susah tuntas.</p>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-50/80 border border-slate-200/80 shadow-2xs">
            <div class="flex items-center justify-between gap-2">
              <h2 class="text-[15px] font-bold text-slate-950">3. Metabolisme Mampet (35+ Thn)</h2>
              <span class="text-xs font-bold uppercase tracking-wider text-red-700 bg-red-100/80 px-2 py-0.5 rounded-full shrink-0">Metabolisme</span>
            </div>
            <p class="text-[15px] text-slate-700 mt-1 leading-relaxed">Makan sedikit langsung menumpuk jadi lemak di perut bawah dan pinggang. Kancing celana kerja makin sesak.</p>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-50/80 border border-slate-200/80 shadow-2xs">
            <div class="flex items-center justify-between gap-2">
              <h2 class="text-[15px] font-bold text-slate-950">4. Lapar Mata Jam 9 Malam</h2>
              <span class="text-xs font-bold uppercase tracking-wider text-red-700 bg-red-100/80 px-2 py-0.5 rounded-full shrink-0">Craving Gula</span>
            </div>
            <p class="text-[15px] text-slate-700 mt-1 leading-relaxed">Lonjakan hormon insulin memicu sinyal lapar palsu di otak. Selalu ingin ngunyah gorengan atau camilan manis.</p>
          </div>
        </div>
      </div>

      <!-- Narrative Pivot Callout -->
      <div class="mt-4 px-4 sm:px-5 text-left">
        <div class="border-l-4 border-emerald-600 pl-3.5 bg-emerald-50/90 py-2.5 pr-3.5 rounded-r-xl">
          <p class="text-[14.5px] sm:text-[15px] text-emerald-950 leading-relaxed">
            💡 <strong>Jangan siksa usus dengan teh pencahar melilit!</strong> Untuk kempeskan perut buncit keras, Anda butuh koloni probiotik <em>'The Mother'</em> untuk meluruhkan kerak usus dan lemak visceral dari dalam.
          </p>
        </div>
      </div>

    </section>

    <!-- ═══ 3. SECTION: MENGAPA DIET BIASA GAGAL MENGEMPESKAN PERUT BUNCIT? ═══ -->
    <section class="border-t border-slate-100 bg-slate-50/70 pt-8 pb-8 text-center">
      <div class="px-5">
        <h2 class={`${sectionTitle} mt-1`}>
          Kenapa Diet Biasa Gagal Kempeskan Perut?
        </h2>
        <p class={`${sectionLead} text-center`}>
          Teh pelangsing biasa cuma buang cairan. NutriLove meluruhkan lemak visceral dan membersihkan kerak usus secara tuntas:
        </p>
      </div>

      <!-- IMAGE: SOMATIC PERUT BUNCIT CELANA SEMPIT (RATIO 4:3) -->
      <div class="mt-6 relative w-full overflow-hidden aspect-[4/3] bg-slate-900 shadow-2xs border-y border-slate-200/80">
        <img
          src="/images/landing/nutrilove-cuka-apel/perut-buncit-mekanisme-brutal.webp"
          alt="Detox Lemak Visceral & Pembersih Kerak Usus dengan NutriLove Cuka Apel With The Mother"
          class="h-full w-full object-cover object-center"
          loading="lazy"
          decoding="async"
          width="1200"
          height="896"
        />
        <div class="absolute bottom-0 inset-x-0 bg-slate-950/90 px-4 py-2.5 text-center text-white">
          <p class="text-[13px] sm:text-[14px] text-slate-200">
            Enzim probiotik aktif <strong class="text-amber-300 font-bold">'The Mother'</strong> meluruhkan lemak visceral padat dan membilas kerak kotoran usus sampai bersih.
          </p>
        </div>
      </div>

      <!-- Comparison Grid: Teh Pencahar Biasa vs Terapi NutriLove ACV -->
      <div class="mt-5 px-3.5 sm:px-4 grid grid-cols-2 gap-2.5 text-left">
        <div class="p-3 rounded-xl bg-red-50/80 border border-red-200/80 shadow-2xs">
          <p class="font-black text-red-900 uppercase tracking-wider text-[12.5px] pb-1.5 border-b border-red-200/60 mb-2">
            Teh/Pil Pencahar (Bahaya)
          </p>
          <ul class="space-y-2 text-slate-900 font-bold text-[13px] sm:text-[13.5px]">
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-red-600 font-black text-[13px] mt-px shrink-0">✕</span>
              <span>Mulas melilit lemas seharian</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-red-600 font-black text-[13px] mt-px shrink-0">✕</span>
              <span>Cuma buang cairan (bukan lemak)</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-red-600 font-black text-[13px] mt-px shrink-0">✕</span>
              <span>Usus malas &amp; ketergantungan</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-red-600 font-black text-[13px] mt-px shrink-0">✕</span>
              <span>Berhenti, perut makin buncit</span>
            </li>
          </ul>
        </div>

        <div class="p-3 rounded-xl bg-emerald-50/90 border border-emerald-200/80 shadow-2xs">
          <p class="font-black text-emerald-900 uppercase tracking-wider text-[12.5px] pb-1.5 border-b border-emerald-200/60 mb-2">
            NutriLove ACV (Alami)
          </p>
          <ul class="space-y-2 text-slate-800 font-bold text-[13px] sm:text-[13.5px]">
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-700 font-black text-[13px] mt-px shrink-0">✓</span>
              <span>Bakar lemak visceral padat</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-700 font-black text-[13px] mt-px shrink-0">✓</span>
              <span>BAB subuh lancar tanpa melilit</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-700 font-black text-[13px] mt-px shrink-0">✓</span>
              <span>Rontokkan kerak kotoran usus</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-700 font-black text-[13px] mt-px shrink-0">✓</span>
              <span>Kenyang awet tahan ngemil</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ═══ 4. SECTION: 6 KHASIAT UTAMA NUTRILOVE ═══ -->
    <section class="border-t border-slate-100 bg-white pt-10 pb-10 text-center">
      <div class="px-5">
        <h2 class={`${sectionTitle}`}>
          6 Khasiat Nyata NutriLove Untuk Perut Kempes &amp; Plong
        </h2>
        <p class={`${sectionLead} text-center`}>
          Fermentasi apel murni with The Mother kaya enzim alami tanpa bahan kimia pencahar:
        </p>
      </div>

      <!-- PRECISE COMMERCIAL PRODUCT STILL LIFE IMAGE (RATIO 4:3) -->
      <div class="mt-6 relative w-full overflow-hidden bg-slate-900 aspect-[4/3] shadow-sm border-y border-slate-200/80">
        <img
          src="/images/landing/nutrilove-cuka-apel/manfaat-cuka-apel.webp"
          alt="Kemasan Asli NutriLove Cuka Apel With The Mother 500ml Dengan Buah Apel Segar"
          class="h-full w-full object-cover object-center"
          loading="lazy"
          decoding="async"
          width="1200"
          height="896"
        />

        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/90 via-slate-950/60 to-transparent px-4 pt-6 pb-2.5 text-center">
          <p class="text-[13px] text-slate-200">
            Kemasan Resmi <strong class="text-amber-300 font-bold">NutriLove Cuka Apel 500ml</strong> With The Mother
