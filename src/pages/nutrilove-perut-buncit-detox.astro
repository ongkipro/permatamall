---
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { recentOrderCount } from '../lib/social-proof';
import { getStorefrontProduct, getStorefrontProducts } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import {
  loadStoreCodDisabledProvinceCodes,
  resolveFormModeContext,
} from '../lib/form-mode';
import { getRuntimeEnv } from '../lib/env';
import type { Product } from '../data/products';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';

export const prerender = false;

const SLUG = 'nutrilove-perut-buncit-detox';
const PRODUCT_SLUG = 'cuka-sari-apel-100-original';

let product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);

// Fallback preview product to ensure seamless preview/standalone renders even before D1 sync
if (!product) {
  const [firstProduct] = await getStorefrontProducts(Astro.locals);
  product = firstProduct ?? {
    productId: '17981',
    slug: PRODUCT_SLUG,
    productName: 'Cuka Sari Apel 100% Original',
    contentName: 'Cuka Sari Apel 100% Original With The Mother',
    headline: 'Paket Detox Lemak Perut Buncit & Pencernaan Plong',
    subheadline: 'Cuka Sari Apel Murni With The Mother (Beli 1 Dapat 3)',
    seoTitle: 'NutriLove Cuka Apel With The Mother — Solusi Alami Kempeskan Perut Buncit Keras, Begah & Susah BAB',
    seoDescription: 'Perut buncit keras kayak batu, celana makin sempit, dan sering begah susah BAB? Detox alami 1 sendok NutriLove Cuka Apel With The Mother bantu luruhkan lemak visceral perut.',
    price: 97500,
    comparePrice: 199000,
    image: '/images/landing/nutrilove-cuka-apel/perut-buncit-hero-brutal.webp',
    heroImage: '/images/landing/nutrilove-cuka-apel/perut-buncit-hero-brutal.webp',
    category: 'Kesehatan',
    brand: 'NutriLove',
    relatedCategories: ['Kesehatan', 'Herbal'],
    description: 'Cuka Apel fermentasi alami with The Mother ukuran 500ml untuk membantu meluruhkan lemak visceral perut buncit, mengatasi perut begah, dan melancarkan BAB.',
    benefits: [
      'Bantu luruhkan lemak visceral (perut buncit keras)',
      'Perut begah kembung langsung kempes & BAB lancar pagi hari',
      'Kunci nafsu ngemil malam tanpa perlu diet menyiksa',
      'Fermentasi alami with The Mother kaya enzim probiotik hidup',
    ],
    keyPoints: [
      'Isi 500ml per botol',
      'Paket Promo Beli 1 Dapat 3 (Total 1.500 ml)',
      'Bisa COD seluruh Indonesia',
    ],
    idealFor: ['Pria dan wanita usia 30–55 tahun yang memiliki keluhan perut buncit keras, celana sempit, metabolisme melambat, sering begah, dan susah BAB'],
    offerText: 'PROMO SPESIAL: BELI 1 DAPAT 3 (Total 1.500 ml) Hanya Rp 97.500',
    ctaText: 'Pesan Sekarang (COD)',
    ratingValue: 4.9,
    reviewCount: 4650,
    soldCount: 6800,
    reviews: [],
    variants: [
      { id: '12', sku: 'BELI_2_GRATIS_2', label: 'BELI 1 Dapat 3', price: 97500, comparePrice: 199000 },
      { id: '13', sku: 'PAKET_6_BOTOL', label: 'PAKET 6 Botol', price: 149000, comparePrice: 398000 },
      { id: '14', sku: 'PAKET_9_BOTOL', label: 'PAKET 9 Botol', price: 195000, comparePrice: 597000 },
    ],
  } as Product;
}

const database = getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined;
const codDisabledProvinceCodes = await loadStoreCodDisabledProvinceCodes(database);
const formContext = await resolveFormModeContext(
  Astro.request,
  codDisabledProvinceCodes,
);

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price ?? 97500;
const comparePrice = cheapest?.comparePrice ?? product.comparePrice ?? 199000;
const discount = comparePrice > price ? Math.round((1 - price / comparePrice) * 100) : 51;

const defaultUpsellVariantId = (
  product.variants.find((v) => v.sku === 'PAKET_6_BOTOL' || /6\s*botol/i.test(v.label)) ??
  product.variants[1] ??
  product.variants[0]
)?.id;

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;

const testimonials = [
  {
    name: 'Ibu Rina (39 th)',
    city: 'Bekasi',
    occupation: 'Ibu Rumah Tangga & Pengusaha Kuliner',
    rating: 5,
    highlight: 'lingkar perut susut 7 cm dalam 3 minggu dan celana lama yang tadinya sesak sekarang longgar semua',
    quote: 'Sejak lewat umur 35, perut bawah rasanya buncit keras banget dan susah BAB sampai 3 hari sekali. Sudah coba teh pelangsing malah mulas melilit di perut. Pas ganti ke NutriLove Cuka Apel yang ada The Mother-nya ini tiap pagi dan sebelum makan, BAB lancar plong tiap pagi tanpa melilit, lingkar perut susut 7 cm dalam 3 minggu dan celana lama yang tadinya sesak sekarang longgar semua!',
    image: '/images/landing/nutrilove-cuka-apel/testimoni-ibu-rina.webp',
  },
  {
    name: 'Pak Dimas (45 th)',
    city: 'Bandung',
    occupation: 'Karyawan Swasta',
    rating: 5,
    highlight: 'perut buncit yang tadinya keras begah jadi kempes enteng dan nafas gak ngos-ngosan lagi',
    quote: 'Duduk kerja seharian ditambah sering makan malam bikin perut maju ke depan sampai ikat pinggang mentok di lubang terakhir. Mau olahraga gak sempat. Saya rutin minum Paket 6 Botol ini bareng istri, baru jalan botol kedua perut buncit yang tadinya keras begah jadi kempes enteng dan nafas gak ngos-ngosan lagi pas naik tangga!',
    image: '/images/landing/nutrilove-cuka-apel/testimoni-pak-dimas.webp',
  },
  {
    name: 'Ibu Wahyuni (48 th)',
    city: 'Solo',
    occupation: 'Wiraswasta',
    rating: 5,
    highlight: 'keinginan ngemil gorengan malam hari berhenti sendiri dan badan turun 4,5 kg tanpa lemas',
    quote: 'Penyakit saya itu kalau malam suka lapar mata pengen ngemil manis dan gorengan, besok paginya perut langsung begah penuh gas. Sejak minum 1 sloki NutriLove pakai air hangat sore hari, keinginan ngemil gorengan malam hari berhenti sendiri dan badan turun 4,5 kg tanpa lemas. Aman banget di lambung!',
    image: '/images/landing/nutrilove-cuka-apel/testimoni-ibu-wahyuni.webp',
  },
];

const sectionTitle = 'text-[clamp(21px,6.5vw,25px)] font-black text-slate-950 tracking-normal leading-[1.22]';
const sectionLead = 'text-[13.5px] sm:text-[14px] text-slate-600 leading-relaxed mt-2 max-w-[420px] mx-auto';
const socialProofOrders = await recentOrderCount(getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined);
---

<BaseLayout
  title="NutriLove Cuka Apel With The Mother — Detox Alami Perut Buncit Keras, Begah & Susah BAB"
  description="Perut buncit keras kayak batu, celana makin sempit, dan sering begah susah BAB? Detox alami 1 sendok NutriLove Cuka Apel With The Mother bantu luruhkan lemak visceral perut."
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  image="/images/landing/nutrilove-cuka-apel/perut-buncit-hero-brutal.webp"
  preloadImages="/images/landing/nutrilove-cuka-apel/perut-buncit-hero-brutal.webp"
>

  <MetaLandingTracker
    slug={SLUG}
    contentId={defaultCatalogContentId(product)}
    contentName={product.contentName}
    price={price}
  />

  <style is:global>
    .trust-strip i {
      font-size: 12px !important;
    }
    .total-box small,
    .district-item small,
    .payment-block-anchor small {
      font-size: 12px !important;
    }
  </style>

  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-12 font-sans text-slate-900 shadow-2xl selection:bg-[#0F2F1F] selection:text-white antialiased">
    
    <!-- ═══ 1. URGENCY ANNOUNCEMENT BAR (TOP) ═══ -->
    <header class="flex items-center justify-between gap-2 border-b border-emerald-950 bg-[#0F2F1F] px-3.5 py-2 text-white shadow-xs">
      <div class="flex items-center gap-1.5 text-[12px] font-extrabold tracking-wide min-w-0">
        <span class="flex h-2 w-2 relative shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
        </span>
        <span class="text-amber-300 font-black uppercase shrink-0">PROMO HARI INI:</span>
        <span class="text-slate-100 font-extrabold whitespace-nowrap">BELI 1 DAPAT 3</span>
      </div>
      <span class="whitespace-nowrap text-[12px] font-black tracking-wider text-amber-300 bg-emerald-800/90 px-2.5 py-0.5 rounded-full border border-emerald-600/60 shadow-xs shrink-0">
        BISA COD
      </span>
    </header>

    <!-- ═══ 2. HERO SECTION (BRUTAL OVERCLAIM PERUT BUNCIT KERAS & DETOX USUS) ═══ -->
    <section id="landing-hero" class="bg-white text-center pb-8">
      <div class="px-4 sm:px-5 pt-5 sm:pt-6">
        
        <!-- Star Rating Social Proof -->
        <div class="mb-3 inline-flex items-center justify-center gap-1.5 text-[12px] font-bold text-slate-800 bg-emerald-50/90 px-3 py-1 rounded-full border border-emerald-200/80 shadow-2xs">
          <div class="flex items-center gap-0.5 shrink-0 text-amber-400 text-[13px] leading-none" role="img" aria-label="Rating 5 dari 5 bintang">
            ★ ★ ★ ★ ★
          </div>
          <span class="text-slate-900 font-extrabold">4.9 / 5.0</span>
          <span class="text-slate-400">•</span>
          <span class="text-slate-600 font-medium">(6.800+ Paket Terkirim)</span>
        </div>

        <!-- Main Impact Brutal Overclaim Headline (under 10 words, normal tracking) -->
        <h1 class="mx-auto max-w-[440px] text-[clamp(21px,6.8vw,26px)] font-black leading-[1.24] tracking-normal text-slate-950">
          Perut Buncit Keras Kayak Batu &amp; <span class="box-decoration-clone rounded-[0.18em] bg-red-100 text-red-700 px-1.5 py-0.5">Susah BAB?</span>
        </h1>

        <!-- Subtitle -->
        <p class="mx-auto mt-2 max-w-[420px] text-[14px] leading-relaxed text-slate-600">
          Luruhkan lemak visceral membandel dan bersihkan sisa kerak usus dengan <strong class="text-slate-950 font-bold">NutriLove Cuka Apel With The Mother</strong>. Perut buncit begah langsung kempes enteng tanpa mulas melilit.
        </p>

        <!-- ═══ HIGH-CONVERSION VALUE BANNER ═══ -->
        <div class="mx-auto mt-4 w-full max-w-[420px] rounded-2xl bg-gradient-to-b from-[#0F2F1F] via-[#143e2a] to-[#0F2F1F] px-3.5 py-3 text-center text-white shadow-md border-2 border-amber-400/60">
          <div class="flex items-center justify-center gap-1.5">
            <span class="flex h-2 w-2 relative shrink-0">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-300 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-400"></span>
            </span>
            <span class="text-[clamp(13.5px,4.3vw,17px)] font-black uppercase tracking-wide text-amber-300 drop-shadow-xs leading-tight">
              PAKET DETOX: BELI 1 DAPAT 3 BOTOL (1.500 ML)
            </span>
          </div>
          <div class="mt-1.5 flex flex-wrap items-center justify-center gap-x-1.5 gap-y-0.5 text-[12px] font-bold text-slate-100 leading-snug">
            <span>Gratis Sloki Takar + Sedotan Anti-Ngilu</span>
            <span class="text-amber-400 font-black">•</span>
            <span class="text-amber-200 font-extrabold">Bisa Bayar di Tempat (COD)</span>
          </div>
        </div>
      </div>

      <!-- ═══ FULL-WIDTH HERO BRUTAL OVERCLAIM BANNER (RATIO 4:3) ═══ -->
      <div class="mt-5 relative w-full overflow-hidden bg-slate-950 aspect-[4/3] shadow-md border-y border-red-950">
        <img
          src="/images/landing/nutrilove-cuka-apel/perut-buncit-hero-brutal.webp"
          alt="Perbandingan Perut Buncit Lemak Visceral vs Perut Kempes Ramping Dengan NutriLove Cuka Apel With The Mother"
          class="h-full w-full object-cover object-center"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="1200"
          height="896"
        />

        <div class="absolute top-3 left-3 bg-slate-950/90 text-red-400 text-[12px] font-black uppercase tracking-wider px-2.5 py-1 rounded-md shadow-md border border-red-500/40">
          ⚠ LEMAK VISCERAL
        </div>

        <div class="absolute top-3 right-3 bg-red-600 text-white text-[12px] font-black uppercase tracking-wider px-2.5 py-1 rounded-md shadow-md border border-white/20">
          BELI 1 DAPAT 3
        </div>

        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/95 via-slate-950/80 to-transparent px-3 pt-8 pb-2.5 text-center">
          <p class="text-[12px] sm:text-[13px] font-medium text-amber-300 leading-tight">
            Aktifkan Pembakaran Lemak Perut • BAB Lancar Plong Tanpa Mulas Melilit
          </p>
        </div>
      </div>

      <!-- Above-the-Fold Primary CTA + Fold Sentinel -->
      <div class="mt-4 px-4 sm:px-5">
        <a
          href="#form-pemesanan"
          class="flex w-full min-h-[48px] items-center justify-center gap-2 rounded-xl bg-red-600 hover:bg-red-700 px-4 py-3 text-[14px] sm:text-[15px] font-black uppercase tracking-wide text-white shadow-lg shadow-red-600/25 transition-colors active:scale-[0.99]"
        >
          <span>Ambil Promo Detox Beli 1 Dapat 3 ↓</span>
        </a>
        <p class="mt-1.5 text-[12px] text-slate-500">
          Bayar di Tempat Saat Paket Sampai • Gratis Sloki Takar &amp; Sedotan
        </p>
      </div>
      <div id="hero-fold-sentinel" class="h-px w-full" aria-hidden="true"></div>

      <!-- Clean Minimalist Trust Row -->
      <div class="mt-4 flex flex-wrap items-center justify-center gap-x-2 gap-y-1.5 px-3 text-[12px] font-bold text-slate-700">
        <span class="bg-emerald-50 px-2.5 py-1 rounded-full text-emerald-900 border border-emerald-200/80 whitespace-nowrap">Kaya Probiotik Hidup</span>
        <span class="bg-slate-100 px-2.5 py-1 rounded-full text-slate-800 border border-slate-200/60 whitespace-nowrap">Bisa COD (Bayar di Tempat)</span>
        <span class="bg-slate-100 px-2.5 py-1 rounded-full text-slate-800 border border-slate-200/60 whitespace-nowrap">Bukan Obat Pencahar</span>
        <span class="bg-slate-100 px-2.5 py-1 rounded-full text-slate-800 border border-slate-200/60 whitespace-nowrap">Aman Untuk Maag</span>
      </div>

      <!-- 4 Key Somatic Pain Points -->
      <div class="mt-5 sm:mt-6 px-4 sm:px-5 text-left space-y-2.5">
        <div class="p-3 rounded-xl bg-red-50/50 border border-red-200/80 shadow-2xs">
          <div class="flex items-center justify-between gap-2">
            <h2 class="text-[14px] font-bold text-slate-950">1. Perut Maju &amp; Keras Saat Ditekan (Visceral Fat)</h2>
            <span class="text-[12px] font-bold uppercase tracking-wider text-red-700 bg-red-100 px-2 py-0.5 rounded shrink-0">Lemak Organ</span>
          </div>
          <p class="text-[13px] sm:text-[13.5px] text-slate-600 mt-1 leading-relaxed">Bukan sekadar lemak kulit, melainkan lemak visceral yang membungkus organ dalam dan hati (fatty liver) sehingga perut terasa padat keras dan sesak saat membungkuk.</p>
        </div>

        <div class="p-3 rounded-xl bg-red-50/50 border border-red-200/80 shadow-2xs">
          <div class="flex items-center justify-between gap-2">
            <h2 class="text-[14px] font-bold text-slate-950">2. Perut Begah Penuh Gas &amp; Susah BAB Berhari-hari</h2>
            <span class="text-[12px] font-bold uppercase tracking-wider text-red-700 bg-red-100 px-2 py-0.5 rounded shrink-0">Usus Kotor</span>
          </div>
          <p class="text-[13px] sm:text-[13.5px] text-slate-600 mt-1 leading-relaxed">Kurangnya enzim pencernaan membuat sisa makanan membusuk jadi gas di usus, perut kembung kencang seperti balon dan BAB tidak tuntas.</p>
        </div>

        <div class="p-3 rounded-xl bg-red-50/50 border border-red-200/80 shadow-2xs">
          <div class="flex items-center justify-between gap-2">
            <h2 class="text-[14px] font-bold text-slate-950">3. Metabolisme Mampet Sejak Lewat Usia 35 Tahun</h2>
            <span class="text-[12px] font-bold uppercase tracking-wider text-red-700 bg-red-100 px-2 py-0.5 rounded shrink-0">Susah Turun BB</span>
          </div>
          <p class="text-[13px] sm:text-[13.5px] text-slate-600 mt-1 leading-relaxed">Makan sedikit saja langsung jadi lemak di pinggang dan perut bawah, sementara kancing kemeja dan celana kerja makin hari makin sesak.</p>
        </div>

        <div class="p-3 rounded-xl bg-red-50/50 border border-red-200/80 shadow-2xs">
          <div class="flex items-center justify-between gap-2">
            <h2 class="text-[14px] font-bold text-slate-950">4. Suka Lapar Mata &amp; Ngemil Manis Malam Hari</h2>
            <span class="text-[12px] font-bold uppercase tracking-wider text-red-700 bg-red-100 px-2 py-0.5 rounded shrink-0">Craving Gula</span>
          </div>
          <p class="text-[13px] sm:text-[13.5px] text-slate-600 mt-1 leading-relaxed">Lonjakan insulin sehabis makan memicu sinyal lapar palsu di malam hari, membuat Anda sulit menahan godaan gorengan, roti, dan minuman manis.</p>
        </div>
      </div>

      <!-- Narrative Pivot Callout -->
      <div class="mt-5 px-4 sm:px-5 text-left">
        <div class="border-l-4 border-emerald-600 pl-3.5 bg-emerald-50/80 py-2.5 pr-3 rounded-r-lg">
          <p class="text-[13.5px] sm:text-[14px] font-medium text-emerald-950 leading-relaxed italic">
            “Jangan siksa usus Anda dengan teh pelangsing pencahar yang hanya menguras cairan tubuh dan bikin perut melilit! Untuk mengempeskan perut buncit keras, Anda butuh <strong>Asam Asetat &amp; Probiotik The Mother</strong> yang mengaktifkan enzim pembakar lemak visceral sekaligus membersihkan sisa kerak pencernaan.”
          </p>
        </div>
      </div>

    </section>

    <!-- ═══ 3. SECTION: MENGAPA DIET BIASA GAGAL MENGEMPESKAN PERUT BUNCIT? ═══ -->
    <section class="border-t border-slate-100 bg-slate-50/70 pt-10 pb-10 text-center">
      <div class="px-5">
        <h2 class={`${sectionTitle} mt-1`}>
          Kenapa Sudah Kurangi Makan Tapi Perut Tetap Buncit?
        </h2>
        <p class={`${sectionLead} text-center`}>
          Selama hormon insulin tinggi dan bakteri baik di usus kalah jumlah, tubuh akan mengunci cadangan lemak di area perut dan pinggang:
        </p>
      </div>

      <!-- IMAGE: SOMATIC PERUT BUNCIT CELANA SEMPIT (RATIO 4:3) -->
      <div class="mt-6 relative w-full overflow-hidden aspect-[4/3] bg-slate-900 shadow-2xs border-y border-slate-200/80">
        <img
          src="/images/landing/nutrilove-cuka-apel/perut-buncit-mekanisme-brutal.webp"
          alt="Detox Lemak Visceral & Pembersih Kerak Usus dengan NutriLove Cuka Apel With The Mother"
          class="h-full w-full object-cover object-center"
          loading="lazy"
          decoding="async"
          width="1200"
          height="896"
        />
        <div class="absolute bottom-0 inset-x-0 bg-slate-950/90 px-4 py-2 text-center text-white">
          <p class="text-[12px] text-amber-300">
            Enzim probiotik aktif <strong>'The Mother'</strong> meluruhkan timbunan lemak visceral dan membersihkan kerak sisa makanan di usus.
          </p>
        </div>
      </div>

      <!-- Comparison Grid: Teh Pencahar Biasa vs Terapi NutriLove ACV -->
      <div class="mt-5 px-3.5 sm:px-4 grid grid-cols-2 gap-2 text-left">
        <div class="p-2.5 rounded-xl bg-red-50/70 border border-red-200/60 shadow-2xs">
          <p class="font-black text-red-900 uppercase tracking-wider text-[12px] pb-1.5 border-b border-red-200/50 mb-2">
            Teh/Pil Pencahar
          </p>
          <ul class="space-y-1.5 text-slate-900 font-bold text-[12px]">
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-red-600 font-black text-[12px] mt-px shrink-0">✕</span>
              <span>Perut mulas melilit hebat</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-red-600 font-black text-[12px] mt-px shrink-0">✕</span>
              <span>Hanya buang cairan tubuh</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-red-600 font-black text-[12px] mt-px shrink-0">✕</span>
              <span>Usus jadi malas bekerja</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-red-600 font-black text-[12px] mt-px shrink-0">✕</span>
              <span>Berhenti minum BB naik lagi</span>
            </li>
          </ul>
        </div>

        <div class="p-2.5 rounded-xl bg-emerald-50/80 border border-emerald-200/70 shadow-2xs">
          <p class="font-black text-emerald-900 uppercase tracking-wider text-[12px] pb-1.5 border-b border-emerald-200/50 mb-2">
            NutriLove ACV
          </p>
          <ul class="space-y-1.5 text-slate-800 font-bold text-[12px]">
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-700 font-black text-[12px] mt-px shrink-0">✓</span>
              <span>Aktifkan enzim bakar lemak</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-700 font-black text-[12px] mt-px shrink-0">✓</span>
              <span>BAB lancar tanpa melilit</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-700 font-black text-[12px] mt-px shrink-0">✓</span>
              <span>Perut begah langsung plong</span>
            </li>
            <li class="flex items-start gap-1.5 leading-snug">
              <span class="text-emerald-700 font-black text-[12px] mt-px shrink-0">✓</span>
              <span>Kenyang awet tahan ngemil</span>
            </li>
