---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('bibit-rambutan');
if (!product) throw new Error('Product bibit-rambutan not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = 'https://pesantren.shop/bibit-rambutan';
const seoTitle = 'BIBIT UNGGUL RAMBUTAN PULASAN FB - Amanah Toko';
const seoDescription =
  'Bibit Unggul Rambutan Pulasan Eksotis Okulasi Cepat Berbuah. Daging tebal, manis legit ngelotok tidak lengket di biji. Promo Diskon 50% Rp 85.000 COD.';
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={product.heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  preloadImages={['/images/rambutan/promo-banner.webp', '/images/rambutan/rambutan-hero.webp']}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Bibit Unggul Rambutan Pulasan', url: '/bibit-rambutan' },
  ]}
>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950 font-sans shadow-lg">
    <MetaLandingTracker
      slug="bibit-rambutan"
      productId={product.productId}
      contentName={product.contentName}
      price={product.price}
    />

    <!-- PROMO BANNER TOP IMAGE (LCP) -->
    <div class="w-full">
      <img
        src="/images/rambutan/promo-banner.webp"
        alt="Promo Diskon Spesial Hari Ini"
        class="w-full h-auto block"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="540"
        height="240"
      />

      <!-- HERO HEADLINE & SUBTITLE SECTION -->
      <section class="px-5 pt-5 pb-4 bg-gradient-to-b from-emerald-50 to-white text-center">
        <h1 class="text-[clamp(21px,6.5vw,26px)] font-black leading-[1.28] text-slate-950 uppercase tracking-tight">
          Panen Buah Eksotis Super Manis di Halaman Sendiri! Tanam Bibit Rambutan Pulasan Langka yang Cepat Berbuah.
        </h1>

        <div class="mt-3.5 p-3.5 bg-emerald-100/70 border border-emerald-300 rounded-xl text-left">
          <p class="text-[14px] leading-relaxed text-slate-800 font-medium">
            Hindari menanam pohon rambutan biasa yang buahnya asam, berair, dan dagingnya susah lepas dari biji. Bibit
            unggul Pulasan ini adalah primadona buah eksotis berkelas premium! Menghasilkan buah berdaging tebal, manis
            legit, dan sangat mudah mengelupas dari bijinya (ngelotok).
          </p>
        </div>

        <!-- HERO IMAGE (LCP Secondary) -->
        <div class="mt-4 rounded-2xl overflow-hidden shadow-md border border-slate-200">
          <img
            src="/images/rambutan/rambutan-hero.webp"
            alt="Bibit Unggul Rambutan Pulasan Berbuah Lebat"
            class="w-full h-auto block"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="540"
            height="960"
          />
        </div>

        <!-- WEBP VIDEO DEMONSTRATION (Zero initial payload with 7.9KB poster & lazy load) -->
        <div class="mt-4 rounded-2xl overflow-hidden shadow-md border border-slate-200">
          <img
            id="snaptik-video"
            src="/images/rambutan/video-snaptik-poster.webp"
            data-src="/images/rambutan/video-snaptik.webp"
            alt="Demonstrasi Panen Buah Pulasan Manis"
            class="w-full h-auto block"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="280"
            height="280"
          />
        </div>
        <script is:inline>
          if ('IntersectionObserver' in window) {
            const vImg = document.getElementById('snaptik-video');
            if (vImg) {
              const obs = new IntersectionObserver(
                (entries) => {
                  entries.forEach((e) => {
                    if (e.isIntersecting) {
                      vImg.src = vImg.getAttribute('data-src');
                      obs.disconnect();
                    }
                  });
                },
                { rootMargin: '200px' },
              );
              obs.observe(vImg);
            }
          }
        </script>
      </section>

      <!-- SECTION 1: MASALAH YANG SERING TERJADI -->
      <section class="px-5 py-6 bg-red-50/60 border-t border-b border-red-200">
        <h2 class="text-center font-extrabold text-[19px] text-red-700 leading-snug">
          😤 MASALAH YANG SERING TERJADI SAAT MENANAM BUAH
        </h2>

        <ul class="mt-4 space-y-2.5 text-[14px] leading-relaxed text-slate-800 font-medium">
          <li class="flex items-start gap-2.5 p-2.5 bg-white rounded-lg border border-red-100 shadow-2xs">
            <span class="shrink-0 text-red-600">❌</span>
            <span
              >Tanam rambutan biasa, tapi pas panen daging buahnya lengket di biji (susah dan bikin malas makan)</span
            >
          </li>
          <li class="flex items-start gap-2.5 p-2.5 bg-white rounded-lg border border-red-100 shadow-2xs">
            <span class="shrink-0 text-red-600">❌</span>
            <span>Beli bibit asal-asalan yang bertahun-tahun dirawat tapi tidak kunjung berbuah</span>
          </li>
          <li class="flex items-start gap-2.5 p-2.5 bg-white rounded-lg border border-red-100 shadow-2xs">
            <span class="shrink-0 text-red-600">❌</span>
            <span>Bosan dengan koleksi tanaman buah di pekarangan rumah yang jenisnya itu-itu saja</span>
          </li>
          <li class="flex items-start gap-2.5 p-2.5 bg-white rounded-lg border border-red-100 shadow-2xs">
            <span class="shrink-0 text-red-600">❌</span>
            <span>Ingin makan buah Pulasan tapi jarang ada di pasar dan harganya sangat mahal</span>
          </li>
          <li class="flex items-start gap-2.5 p-2.5 bg-white rounded-lg border border-red-100 shadow-2xs">
            <span class="shrink-0 text-red-600">❌</span>
            <span>Pernah tertipu beli bibit online tapi yang datang malah tanaman layu atau mati</span>
          </li>
        </ul>

        <div
          class="mt-4 p-3.5 bg-amber-100 border border-amber-300 rounded-xl text-amber-950 font-bold text-[13.5px] leading-relaxed"
        >
          👉 Menunggu pohon berbuah butuh waktu dan tenaga. Jangan sampai Anda membuang waktu bertahun-tahun merawat
          bibit abal-abal yang hasil panennya mengecewakan!
        </div>

        <div class="mt-4 rounded-xl overflow-hidden shadow-xs border border-red-200">
          <img
            src="/images/rambutan/rambutan-masalah.webp"
            alt="Masalah Bibit Rambutan Biasa vs Pulasan"
            class="w-full h-auto block"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="540"
            height="540"
          />
        </div>
      </section>

      <!-- SECTION 2: SOLUSI PANEN EKSOTIS -->
      <section class="px-5 py-6 bg-emerald-50/70 text-center">
        <h2 class="font-extrabold text-[20px] text-emerald-900 leading-snug">
          SOLUSI PANEN EKSOTIS: BIBIT UNGGUL RAMBUTAN PULASAN
        </h2>
        <p class="mt-2 text-[14px] leading-relaxed text-slate-700 font-medium">
          Bibit hasil perbanyakan vegetatif pilihan (okulasi/sambung pucuk) dari indukan yang sudah berbuah lebat.
        </p>

        <div class="mt-4 rounded-xl overflow-hidden shadow-md border border-emerald-200">
          <img
            src="/images/rambutan/rambutan-solusi.webp"
            alt="Solusi Bibit Rambutan Pulasan Unggul Okulasi"
            class="w-full h-auto block"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="540"
            height="540"
          />
        </div>
      </section>

      <!-- SECTION 3: FEATURES GRID (RAMBUTAN FITUR 1-6) -->
      <section class="bg-white">
        <div class="px-5 pt-6 pb-2 text-center bg-emerald-900 text-white">
          <h2 class="font-extrabold text-[19px] uppercase tracking-wide">
            KENAPA BIBIT PULASAN INI WAJIB ADA DI KEBUN ANDA?
          </h2>
        </div>

        <div class="space-y-0">
          <div class="w-full">
            <img
              src="/images/rambutan/rambutan-fitur-1.webp"
              alt="Daging Buah Tebal Manis Legit & Ngelotok"
              class="w-full h-auto block"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              width="540"
              height="540"
            />
          </div>
          <div class="w-full">
            <img
              src="/images/rambutan/rambutan-fitur-2.webp"
              alt="Cepat Berbuah Hasil Perbanyakan Vegetatif Okulasi"
              class="w-full h-auto block"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              width="540"
              height="540"
            />
          </div>
          <div class="w-full">
            <img
              src="/images/rambutan/rambutan-fitur-3.webp"
              alt="Buah Eksotis Langka Bernilai Tinggi"
              class="w-full h-auto block"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              width="540"
              height="540"
            />
          </div>
          <div class="w-full">
            <img
              src="/images/rambutan/rambutan-fitur-4.webp"
              alt="Cocok Untuk Tabulampot & Lahan Pekarangan"
              class="w-full h-auto block"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              width="540"
              height="540"
            />
          </div>
          <div class="w-full">
            <img
              src="/images/rambutan/rambutan-fitur-5.webp"
              alt="Tahan Berbagai Cuaca & Bebas Hama"
              class="w-full h-auto block"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              width="540"
              height="540"
            />
          </div>
          <div class="w-full">
            <img
              src="/images/rambutan/rambutan-fitur-6.webp"
              alt="Garansi Pengiriman Amankan Bibit Segar"
              class="w-full h-auto block"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              width="540"
              height="540"
            />
          </div>
        </div>
      </section>

      <!-- SECTION 4: HASIL LANGSUNG TERLIHAT & TESTIMONI -->
      <section class="px-5 py-6 bg-slate-50 border-t border-b border-slate-200">
        <h2 class="font-extrabold text-[19.5px] text-slate-900 mb-3 text-center">⭐ HASIL YANG LANGSUNG TERLIHAT</h2>

        <ul class="space-y-2 text-[14px] leading-relaxed text-slate-800 font-medium">
          <li class="flex items-start gap-2 p-2 bg-white rounded-lg border border-slate-200">
            <span class="text-emerald-600 shrink-0 font-black">✔</span>
            <span>Pekarangan rumah jadi lebih hijau, teduh, dan produktif</span>
          </li>
          <li class="flex items-start gap-2 p-2 bg-white rounded-lg border border-slate-200">
            <span class="text-emerald-600 shrink-0 font-black">✔</span>
            <span>Rasa bangga memiliki pohon buah langka yang dijamin bikin tetangga penasaran</span>
          </li>
          <li class="flex items-start gap-2 p-2 bg-white rounded-lg border border-slate-200">
            <span class="text-emerald-600 shrink-0 font-black">✔</span>
            <span>Keluarga bisa puas makan buah Pulasan manis tanpa harus beli mahal di luar</span>
          </li>
          <li class="flex items-start gap-2 p-2 bg-white rounded-lg border border-slate-200">
            <span class="text-emerald-600 shrink-0 font-black">✔</span>
            <span>Waktu luang di rumah jadi lebih bermanfaat dan bebas stres dengan berkebun</span>
          </li>
          <li class="flex items-start gap-2 p-2 bg-white rounded-lg border border-slate-200">
            <span class="text-emerald-600 shrink-0 font-black">✔</span>
            <span>Hati tenang karena merawat bibit berkualitas yang pasti menjanjikan hasil panen melimpah</span>
          </li>
        </ul>

        <!-- TESTIMONIAL CAROUSEL / IMAGES -->
        <div class="mt-8 text-center">
          <h2 class="font-extrabold text-[20px] text-slate-950">Ribuan Orang Sudah Membuktikan</h2>
          <p class="text-[13px] text-slate-500 font-semibold mt-0.5 mb-4">(Slide/Geser Kekiri dan Kekanan)</p>

          <div class="space-y-4">
            <div class="rounded-xl overflow-hidden shadow-md border border-slate-200">
              <img
                src="/images/rambutan/testi-1.webp"
                alt="Testimoni Pembeli Bibit Rambutan Pulasan 1"
                class="w-full h-auto block mx-auto"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                width="450"
                height="900"
              />
            </div>
            <div class="rounded-xl overflow-hidden shadow-md border border-slate-200">
              <img
                src="/images/rambutan/testi-2.webp"
                alt="Testimoni Pembeli Bibit Rambutan Pulasan 2"
                class="w-full h-auto block mx-auto"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                width="450"
                height="900"
              />
            </div>
            <div class="rounded-xl overflow-hidden shadow-md border border-slate-200">
              <img
                src="/images/rambutan/testi-3.webp"
                alt="Testimoni Pembeli Bibit Rambutan Pulasan 3"
                class="w-full h-auto block mx-auto"
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                width="450"
                height="900"
              />
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 5: SPECIAL PRICING BOX -->
      <section class="px-5 py-8 bg-gradient-to-b from-amber-50 to-orange-50 text-center border-t border-amber-200">
        <h2 class="text-[21px] font-black text-slate-950">Harga Promo Spesial hari ini !!!</h2>

        <div
          class="mt-3 inline-block bg-red-600 text-white font-black text-[13px] uppercase tracking-widest px-4 py-1 rounded-full shadow-xs"
        >
          DISKON 50%
        </div>

        <div class="mt-4 flex items-center justify-center gap-3">
          <span class="text-[16px] font-bold text-slate-400 line-through">DARI Rp170,000</span>
          <span class="text-[32px] font-black text-red-600">Jadi 85rb</span>
        </div>

        <p class="mt-3 text-[14px] leading-relaxed text-slate-700 font-medium max-w-[400px] mx-auto">
          Segera pesan sebelum kehabisan dan mulai wujudkan impian memiliki pohon Rambutan Pulasan di rumah Anda!
        </p>
      </section>

      <!-- ORDER FORM SECTION -->
      <section id="order-form" class="bg-white border-t border-slate-200">
        <!-- SCALEV ORDER FORM INTEGRATION -->
        <GeoIpResolvedForm mode={formContext.mode} productSlug="bibit-rambutan" embedded={true} />
      </section>

      <!-- SOCIAL PROOF NOTIFICATION -->
      <SocialProof productSlug="bibit-rambutan" />

      <!-- FOOTER & GUARANTEE IMAGES -->
      <section class="px-5 py-6 bg-slate-900 text-white text-center border-t border-slate-800">
        <div class="space-y-4 mb-6">
          <div class="overflow-hidden rounded-xl shadow-md border border-slate-800">
            <img
              src="/images/rambutan/garansi-1.webp"
              alt="Keuntungan Belanja Di Toko Kami"
              class="w-full h-auto block mx-auto"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              width="540"
              height="928"
            />
          </div>
          <div class="overflow-hidden rounded-xl shadow-md border border-slate-800">
            <img
              src="/images/rambutan/garansi-2.webp"
              alt="Garansi Pengiriman Bibit Amanah"
              class="w-full h-auto block mx-auto"
              loading="lazy"
              decoding="async"
              fetchpriority="low"
              width="540"
              height="360"
            />
          </div>
        </div>

        <LpMiniFooter />
      </section>

      <!-- STICKY BOTTOM CTA -->
      <StickyCTA productSlug="bibit-rambutan" />
    </div>
  </main>
</BaseLayout>
