---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import Icon from '../components/shared/Icon.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('kacamata-anti-radiasi');
if (!product) throw new Error('Product kacamata-anti-radiasi not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = 'https://permatamall.shop/kacamata-anti-radiasi';
const seoTitle = 'Kacamata Anti Radiasi Blueray Photochromic: Filter Sinar Biru & UV 400';
const seoDescription =
  'Kacamata Anti Radiasi Blueray Photochromic. Lensa ganda tangkal sinar biru gadget & berubah gelap outdoor UV 400. Frame titanium ringan promo COD Rp 99rb.';

const sectionTitle = 'text-[clamp(26px,6.8vw,30px)] font-extrabold leading-[1.14] tracking-tight text-slate-950';
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={product.heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Kacamata Anti Radiasi', url: '/kacamata-anti-radiasi' }
  ]}
  preloadImages={[
    {
      srcset: "/images/kacamata-radiasi/kacamata-hero-400.webp 400w, /images/kacamata-radiasi/kacamata-hero-600.webp 600w",
      sizes: "(max-width: 480px) 100vw, 480px"
    }
  ]}
>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <MetaLandingTracker slug="kacamata-anti-radiasi" productId={product.productId} contentName={product.contentName} price={product.price} />

    <!-- 1. URGENCY TOP BAR -->
    <div class="bg-[#EC7211] px-4 py-2 text-center">
      <p class="flex items-center justify-center gap-1.5 text-[11.5px] font-extrabold uppercase tracking-wide text-white">
        <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-white" aria-hidden="true" />
        PROMO DISKON 50% GARANSI LENSA & COD RP 99.000!
      </p>
    </div>

    <!-- 2. HERO SECTION & FOTO HERO UTAMA -->
    <section class="bg-white pb-6 text-center">
      <div class="px-5 pt-6">
        <div class="mx-auto mb-2.5 inline-flex items-center gap-1.5 rounded-full bg-[#FFF5E5] px-3.5 py-1 text-[11px] font-extrabold text-[#EC7211] border border-[#FFEACC]">
          <Icon name="lucide:sparkles" class="h-3.5 w-3.5 text-[#EC7211]" />
          TEKNOLOGI DUAL LENSA BLUERAY & PHOTOCHROMIC
        </div>
        <h1 class="mx-auto max-w-[440px] text-[clamp(28px,7.8vw,33px)] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Bebas Mata Lelah & Pusing <span class="hl-brush">100% Lindungi Radiasi!</span>
        </h1>
        <p class="mx-auto mt-3 max-w-[380px] text-[15px] font-semibold leading-relaxed text-slate-700">
          Filter 99% sinar biru gadget & otomatis bertransisi berubah gelap saat terkena sinar matahari UV400!
        </p>
      </div>

      <!-- HERO IMAGE CONTAINER (PAS FLUID UNCROPPED) -->
      <div class="mt-5 w-full overflow-hidden border-y border-slate-200 bg-white">
        <img
          src="/images/kacamata-radiasi/kacamata-hero-600.webp"
          srcset="/images/kacamata-radiasi/kacamata-hero-400.webp 400w, /images/kacamata-radiasi/kacamata-hero-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Kacamata Anti Radiasi Blueray Photochromic Filter Sinar Biru UV 400"
          class="w-full h-auto block object-contain mx-auto"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="540"
          height="959"
        />

        <div class="bg-slate-950 px-4 py-2 text-center">
          <p class="flex items-center justify-center gap-1.5 text-[12px] font-bold text-[#FFD699]">
            <Icon name="lucide:glasses" class="h-4 w-4 text-[#EC7211] shrink-0" aria-hidden="true" />
            <span>Dual Lensa Blueray + Photochromic • Frame Titanium • Unisex</span>
          </p>
        </div>
      </div>
    </section>

    <!-- 3. HIGHLIGHT SPECS BAR -->
    <section class="border-y border-orange-100 bg-[#FFF5E5]/60 px-5 py-4">
      <div class="grid grid-cols-2 gap-2.5 text-left">
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-2.5 shadow-xs">
          <Icon name="lucide:shield-check" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[10.5px] font-extrabold tracking-wide uppercase text-slate-400">FILTER RADIASI</p>
            <p class="text-[13px] font-extrabold text-slate-950">99% Blueray Cut</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-2.5 shadow-xs">
          <Icon name="lucide:sun" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[10.5px] font-extrabold tracking-wide uppercase text-slate-400">OUTDOOR SUN</p>
            <p class="text-[13px] font-extrabold text-slate-950">Photochromic UV400</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-2.5 shadow-xs">
          <Icon name="lucide:feather" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[10.5px] font-extrabold tracking-wide uppercase text-slate-400">BAHAN FRAME</p>
            <p class="text-[13px] font-extrabold text-slate-950">Titanium Alloy Ringan</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-2.5 shadow-xs">
          <Icon name="lucide:truck" class="mt-0.5 h-4.5 w-4.5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[10.5px] font-extrabold tracking-wide uppercase text-slate-400">LAYANAN</p>
            <p class="text-[13px] font-extrabold text-slate-950">Garansi & COD</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. SECTION FITUR 1: LENSA BLUERAY CUT (FILTER LAYAR GADGET) -->
    <section class="px-5 py-7 border-b border-slate-100">
      <div class="text-center">
        <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#EC7211]">PROTEKSI INDOOR</span>
        <h2 class={sectionTitle + ' mt-1'}>Filter Sinar Biru Gadget</h2>
      </div>

      <div class="mt-4 w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
        <img
          src="/images/kacamata-radiasi/kacamata-blueray-600.webp"
          srcset="/images/kacamata-radiasi/kacamata-blueray-400.webp 400w, /images/kacamata-radiasi/kacamata-blueray-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Filter Lensa Blueray Penangkal Sinar Biru HP dan Komputer"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>
    </section>

    <!-- 5. SECTION FITUR 2: LENSA PHOTOCHROMIC OUTDOOR SUN -->
    <section class="px-5 py-7 border-b border-slate-100 bg-slate-50/50">
      <div class="text-center">
        <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#EC7211]">PROTEKSI OUTDOOR</span>
        <h2 class={sectionTitle + ' mt-1'}>Transisi Gelap Otomatis</h2>
      </div>

      <div class="mt-4 w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
        <img
          src="/images/kacamata-radiasi/kacamata-photochromic-600.webp"
          srcset="/images/kacamata-radiasi/kacamata-photochromic-400.webp 400w, /images/kacamata-radiasi/kacamata-photochromic-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Lensa Photochromic Otomatis Berubah Gelap Saat Kena Sinar Matahari"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>
    </section>

    <!-- 6. SECTION FITUR 3: UJI BUKTI LASER UV TEST -->
    <section class="px-5 py-7 border-b border-slate-100">
      <div class="text-center">
        <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#EC7211]">BUKTI EFEKTIVITAS</span>
        <h2 class={sectionTitle + ' mt-1'}>Uji Bukti Penyinaran UV</h2>
      </div>

      <div class="mt-4 w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
        <img
          src="/images/kacamata-radiasi/kacamata-tes-uv-600.webp"
          srcset="/images/kacamata-radiasi/kacamata-tes-uv-400.webp 400w, /images/kacamata-radiasi/kacamata-tes-uv-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Hasil Uji Bukti Penyinaran Laser Sinar Biru UV Pada Lensa Kacamata"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>
    </section>

    <!-- 7. SECTION FITUR 4: FRAME TITANIUM ALLOY FLEXIBLE -->
    <section class="px-5 py-7 border-b border-slate-100 bg-slate-50/50">
      <div class="text-center">
        <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#EC7211]">MATERIAL PREMIUM</span>
        <h2 class={sectionTitle + ' mt-1'}>Frame Titanium Ringan</h2>
      </div>

      <div class="mt-4 w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
        <img
          src="/images/kacamata-radiasi/kacamata-frame-titanium-600.webp"
          srcset="/images/kacamata-radiasi/kacamata-frame-titanium-400.webp 400w, /images/kacamata-radiasi/kacamata-frame-titanium-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Frame Titanium Alloy Ultra Ringan Lentur Anti Patah"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>
    </section>

    <!-- 8. SECTION FITUR 5: DESAIN STYLISH UNISEX -->
    <section class="px-5 py-7 border-b border-slate-100">
      <div class="text-center">
        <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#EC7211]">DESAIN MODERN</span>
        <h2 class={sectionTitle + ' mt-1'}>Desain Unisex Pria & Wanita</h2>
      </div>

      <div class="mt-4 w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
        <img
          src="/images/kacamata-radiasi/kacamata-desain-600.webp"
          srcset="/images/kacamata-radiasi/kacamata-desain-400.webp 400w, /images/kacamata-radiasi/kacamata-desain-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Desain Kacamata Anti Radiasi Stylish Unisex Pria dan Wanita"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>
    </section>

    <!-- 9. TABEL SPESIFIKASI PRODUK -->
    <section class="px-5 py-7 border-b border-slate-100 bg-slate-50/50">
      <div class="text-center">
        <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#EC7211]">SPESIFIKASI TEKNIS</span>
        <h2 class={sectionTitle + ' mt-1'}>Spesifikasi Kacamata</h2>
      </div>

      <div class="mt-4 rounded-2xl border border-slate-200 bg-white p-4.5 shadow-xs">
        <ul class="space-y-3 text-[14px] text-slate-800">
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2">
            <span class="text-slate-500 font-medium">Bahan Lensa</span>
            <span class="font-bold text-slate-950">Polycarbonate Blueray Photochromic</span>
          </li>
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2">
            <span class="text-slate-500 font-medium">Bahan Frame</span>
            <span class="font-bold text-slate-950">Titanium Alloy Ultra Light Anti Patah</span>
          </li>
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2">
            <span class="text-slate-500 font-medium">Proteksi Radiasi</span>
            <span class="font-bold text-slate-950">99% Blue Light Cut & UV 400</span>
          </li>
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2">
            <span class="text-slate-500 font-medium">Model & Ukuran</span>
            <span class="font-bold text-slate-950">Unisex All Size (Pria & Wanita)</span>
          </li>
          <li class="flex items-center justify-between">
            <span class="text-slate-500 font-medium">Kelengkapan</span>
            <span class="font-bold text-slate-950">Kacamata + Hardcase + Lap + Kartu Tes</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- 10. TESTIMONIALS & KELENGKAPAN PAKET REAL -->
    <section class="px-5 py-7 border-b border-slate-100">
      <div class="text-center">
        <span class="text-[11px] font-extrabold uppercase tracking-widest text-[#EC7211]">ULASAN PEMBELI</span>
        <h2 class={sectionTitle + ' mt-1'}>Testimoni & Kelengkapan Paket</h2>
      </div>

      <div class="mt-4 w-full overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-xs">
        <img
          src="/images/kacamata-radiasi/kacamata-kelengkapan-600.webp"
          srcset="/images/kacamata-radiasi/kacamata-kelengkapan-400.webp 400w, /images/kacamata-radiasi/kacamata-kelengkapan-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Testimoni Real & Kelengkapan Paket Kacamata Anti Radiasi Blueray Photochromic"
          class="w-full h-auto block object-contain mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="1376"
        />
      </div>
    </section>

    <!-- 11. SOCIAL PROOF DYNAMIC -->
    <SocialProof productSlug="kacamata-anti-radiasi" />

    <!-- 12. PRICING & HARGA SECTION (CHECKOUT FORM & BANNER GARANSI PROMO) -->
    <section id="checkout" class="border-t-8 border-slate-100 bg-white py-10">
      <div class="px-5 pb-6 text-center">
        <p class="mx-auto mb-2 inline-flex items-center gap-1.5 text-[11.5px] font-bold uppercase tracking-[0.14em] text-[#EC7211]">
          <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          Promo Kacamata Anti Radiasi COD
        </p>
        <h2 class="mx-auto max-w-[340px] text-[clamp(26px,6.8vw,30px)] font-extrabold leading-[1.12] tracking-tight text-slate-950">
          Isi Alamat Pengiriman, <span class="hl-brush">Bayar Saat Sampai</span>
        </h2>
      </div>

      <!-- FOTO BANNER GARANSI PROMO -->
      <div class="mx-auto mb-5 max-w-[440px] px-5">
        <div class="overflow-hidden rounded-2xl border border-slate-200 shadow-sm">
          <img
            src="/images/kacamata-radiasi/kacamata-garansi-600.webp"
            srcset="/images/kacamata-radiasi/kacamata-garansi-400.webp 400w, /images/kacamata-radiasi/kacamata-garansi-600.webp 600w"
            sizes="(max-width: 480px) 100vw, 480px"
            alt="Banner Garansi Promo Kacamata Anti Radiasi Blueray Photochromic COD"
            class="w-full h-auto block object-contain mx-auto"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="540"
            height="766"
          />
        </div>
      </div>

      <div class="mx-auto mb-6 max-w-[380px] px-5 text-center">
        <div class="rounded-2xl border-2 border-[#EC7211] bg-[#FFF5E5]/40 p-3.5">
          <p class="text-[11.5px] font-bold text-[#EC7211] uppercase tracking-wider">HARGA PROMO SPESIAL</p>
          <div class="mt-0.5 flex items-baseline justify-center gap-2">
            <span class="text-[13.5px] text-slate-400 line-through">Rp 250.000</span>
            <span class="text-[26px] font-black text-slate-950">Rp 99.000</span>
          </div>
          <p class="mt-0.5 text-[11.5px] font-medium text-slate-600">Set Lengkap + Hardcase + Lap + Kartu Tes • Promo Diskon 50% Khusus Hari Ini</p>
        </div>
      </div>

      <GeoIpResolvedForm mode={formContext.mode} productSlug="kacamata-anti-radiasi" embedded={true} />
    </section>

    <!-- 13. FOOTER -->
    <LpMiniFooter />

    <!-- 14. STICKY CTA MOBILE -->
    <StickyCTA productSlug="kacamata-anti-radiasi" />
  </main>
</BaseLayout>

<style>
  .hl-brush {
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    padding-bottom: 0.14em;
    background-image: url("data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20320%2024'%20preserveAspectRatio='none'%3E%3Cpath%20d='M3%2013C55%206%20120%2016%20182%2011S292%208%20317%2012L315%2020C252%2015%20150%2023%2072%2019S13%2021%205%2020C2%2017%202%2016%203%2013Z'%20fill='%23EC7211'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: center 100%;
    background-size: 100% 0.32em;
  }
</style>
