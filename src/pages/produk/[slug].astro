---
import Breadcrumb from '../../components/shared/Breadcrumb.astro';
import MetaViewContentTracker from '../../components/tracking/MetaViewContentTracker.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStorefrontProduct } from '../../lib/catalog';
import Icon from '../../components/shared/Icon.astro';
import RatingStars from '../../components/shared/RatingStars.astro';
import GeoIpResolvedForm from '../../components/forms/GeoIpResolvedForm.astro';
import { resolveFormModeContext } from '../../lib/form-mode';
import { tenantConfig } from '../../lib/tenant';
import '../../styles/form-hybrid.css';

export const prerender = false;

const product = await getStorefrontProduct(Astro.locals, Astro.params.slug || '');
const formContext = await resolveFormModeContext(Astro.request);
if (!product) {
  return Astro.redirect('/produk');
}

const cheapestVariant = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const displayPrice = cheapestVariant?.price ?? product.price;
const displayComparePrice = cheapestVariant?.comparePrice ?? product.comparePrice;
const displayDiscount =
  displayComparePrice > displayPrice ? Math.round((1 - displayPrice / displayComparePrice) * 100) : 0;

const ratingValue = product.ratingValue;
const reviewCount = product.reviewCount;
const soldCount = product.soldCount;
const hasAggregateRating =
  typeof ratingValue === 'number' && typeof reviewCount === 'number' && reviewCount > 0;
const hasSoldCount = typeof soldCount === 'number' && soldCount > 0;
const formattedRating = hasAggregateRating ? ratingValue.toFixed(1) : null;
const soldLabel = hasSoldCount
  ? soldCount >= 1000
    ? `${(soldCount / 1000).toFixed(1).replace('.0', '')}rb+ terjual`
    : `${soldCount} terjual`
  : null;

const productAccentMap: Record<string, string> = {
  bensu: '#0F2A5F',
  aussie: '#8B1E1E',
  kojien: '#4C1D95',
  saratoga: '#14532D',
};
const productAccent = productAccentMap[product.slug] || tenantConfig.themeColor;
const canonical = `${tenantConfig.siteUrl}/produk/${product.slug}`;
const productTitle = product.seoTitle;
const productDescription = product.seoDescription;
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.productName,
  description: product.seoDescription,
  image: [new URL(product.heroImage, tenantConfig.siteUrl).toString()],
  sku: product.productId,
  category: product.category,
  brand: {
    '@type': 'Brand',
    name: tenantConfig.name,
  },
  ...(hasAggregateRating
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: formattedRating,
          reviewCount: String(reviewCount),
        },
      }
    : {}),
  ...(product.reviews.length > 0
    ? {
        review: product.reviews.map((review) => ({
          '@type': 'Review',
          author: {
            '@type': 'Person',
            name: review.name,
          },
          reviewRating: {
            '@type': 'Rating',
            ratingValue: String(review.rating),
            bestRating: '5',
          },
          reviewBody: review.comment,
          datePublished: review.date,
        })),
      }
    : {}),
  offers: product.variants.map((variant) => ({
    '@type': 'Offer',
    url: canonical,
    priceCurrency: 'IDR',
    price: String(variant.price),
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    name: variant.label,
  })),
};
const productSchemaJson = JSON.stringify(productSchema).replace(/</g, '\\u003c');
---

<BaseLayout
  title={productTitle}
  description={productDescription}
  image={product.heroImage}
  preloadImages={product.heroImage}
  canonical={canonical}
  hideHeader={false}
  hideFooter={false}
  contentWidth={tenantConfig.storefrontTemplate === 'wide-catalog' ? 'wide' : 'compact'}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Produk', url: '/produk' },
    { name: product.productName, url: `/produk/${product.slug}` },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={productSchemaJson} />
  </Fragment>
  <main
    id="konten-utama"
    class:list={[
      'min-h-screen bg-[#FAFAFA] pb-12 text-[#263238]',
      tenantConfig.storefrontTemplate === 'wide-catalog' && 'mx-auto max-w-6xl lg:px-6 lg:pb-16 lg:pt-8',
    ]}
  >
    <Breadcrumb
      items={[{ label: 'Beranda', href: '/' }, { label: 'Produk', href: '/produk' }, { label: product.productName }]}
    />
    <MetaViewContentTracker
      slug={product.slug}
      productId={product.productId}
      contentName={product.productName}
      price={displayPrice}
    />
    <section class:list={['bg-white', tenantConfig.storefrontTemplate === 'wide-catalog' && 'lg:grid lg:grid-cols-2 lg:overflow-hidden lg:rounded-xl lg:border lg:border-slate-200']}>
      <img
        src={product.heroImage}
        alt={`Gambar produk ${product.productName} untuk kategori ${product.category}`}
        title={`${product.productName} - ${product.headline}`}
        width="480"
        height="480"
        fetchpriority="high"
        loading="eager"
        decoding="async"
        class:list={[
          'aspect-square w-full object-cover',
          tenantConfig.storefrontTemplate === 'wide-catalog' && 'bg-white object-contain p-6 lg:p-10',
        ]}
      />

      <div class:list={['px-5 py-5', tenantConfig.storefrontTemplate === 'wide-catalog' && 'lg:flex lg:flex-col lg:justify-center lg:p-10']}>
        <div class="flex flex-wrap items-end gap-x-2.5 gap-y-1.5">
          <span class="text-[30px] font-bold leading-none tracking-[-0.03em]" style={`color: ${productAccent}`}>
            Rp{Math.round(displayPrice).toLocaleString('id-ID')}
          </span>
          {
            displayComparePrice > displayPrice && (
              <span class="pb-[2px] text-[15px] font-medium leading-none text-slate-400 line-through decoration-1">
                Rp{Math.round(displayComparePrice).toLocaleString('id-ID')}
              </span>
            )
          }
          {
            displayDiscount > 0 && (
              <span class="mb-[1px] inline-flex items-center rounded-md bg-slate-900 px-2 py-1 text-[10px] font-extrabold leading-none text-white">
                Hemat {displayDiscount}%
              </span>
            )
          }
        </div>

        <h1 class="mt-3 text-[19px] font-bold leading-[1.3] tracking-[-0.02em] text-[#263238]">
          <span
            class="mb-2 inline-flex rounded-md px-2 py-1 text-[10px] font-medium uppercase leading-none tracking-[0.08em] text-white"
            style={`background-color: ${productAccent}`}>{product.category}</span
          >
          <span class="block">{product.productName}</span>
          <span class="mt-1 block text-[16px] font-medium leading-[1.45] tracking-[-0.01em] text-[#616161]"
            >{product.headline}</span
          >
        </h1>
        <p class="mt-2 text-[14px] leading-[1.65] text-[#616161]">{product.subheadline}</p>

        {
          (hasAggregateRating || hasSoldCount) && (
            <div class="mt-4 flex flex-wrap items-center gap-3 border-t border-[#E5E7EB] pt-4 text-[13px] font-medium text-[#616161]">
              {hasAggregateRating && (
                <>
                  <div class="flex items-center gap-1.5">
                    <RatingStars
                      rating={ratingValue}
                      starClass="h-[13px] w-[13px]"
                      label={`Rating produk ${formattedRating} dari 5 bintang`}
                    />
                    <span class="font-semibold" style={`color: ${productAccent}`}>{formattedRating}</span>
                  </div>
                  <span>{reviewCount} penilaian</span>
                </>
              )}
              {hasAggregateRating && hasSoldCount && <span class="h-3 w-px bg-slate-200" />}
              {hasSoldCount && <span>{soldLabel}</span>}
            </div>
          )
        }
      </div>
    </section>

    <section class="mt-2 bg-white px-5 py-4">
      <div class="flex items-start gap-3">
        <div
          class="mt-0.5 flex h-9 w-9 items-center justify-center rounded-full bg-[#F3F4F6]"
          style={`color: ${productAccent}`}
        >
          <Icon name="lucide:truck" class="h-[18px] w-[18px]" aria-hidden="true" />
        </div>
        <div>
          <p class="text-[14px] font-semibold text-[#263238]">Informasi Pengiriman</p>
          <p class="mt-1 text-[12px] leading-5 text-[#616161]">
            Biaya pengiriman dihitung otomatis di halaman checkout setelah alamat pengiriman dilengkapi.
          </p>
        </div>
      </div>
    </section>

    <section class="mt-2 bg-white px-5 py-5">
      <div class="flex items-center justify-between border-b border-[#E5E7EB] pb-3">
        <h2 class="text-[15px] font-semibold text-[#263238]">Varian & Harga</h2>
        <span class="text-[12px] font-medium" style={`color: ${productAccent}`}>Referensi produk</span>
      </div>
      <div class="divide-y divide-slate-100">
        {
          product.variants.map((v) => (
            <div class="flex items-start justify-between gap-4 py-4">
              <div class="min-w-0 flex-1">
                <div class="flex items-start gap-2">
                  <div
                    class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-[#F3F4F6]"
                    style={`color: ${productAccent}`}
                  >
                    <Icon name="lucide:check" class="h-[11px] w-[11px]" aria-hidden="true" />
                  </div>
                  <div class="min-w-0">
                    <p class="text-[14px] font-semibold leading-5 text-[#263238]">{v.label}</p>
                    {v.sku && (
                      <span class="mt-1 block text-[11px] font-medium uppercase tracking-wide text-slate-400">
                        SKU {v.sku}
                      </span>
                    )}
                  </div>
                </div>
              </div>
              <div class="shrink-0 text-right">
                <p class="text-[16px] font-bold leading-none" style={`color: ${productAccent}`}>
                  Rp{Math.round(v.price).toLocaleString('id-ID')}
                </p>
                {v.comparePrice && (
                  <p class="mt-1 text-[12px] leading-none text-slate-400 line-through">
                    Rp{Math.round(v.comparePrice).toLocaleString('id-ID')}
                  </p>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-2 bg-white px-5 py-5">
      <h2 class="border-b border-[#E5E7EB] pb-3 text-[15px] font-semibold text-[#263238]">Informasi Produk</h2>
      <div class="mt-4 grid gap-5 text-[14px] leading-6 text-[#616161]">
        <p>{product.description}</p>

        <div class="grid gap-3 border-b border-[#E5E7EB] pb-4">
          <div class="flex items-start gap-3">
            <Icon
              name="lucide:pencil"
              class="mt-0.5 h-[18px] w-[18px] shrink-0"
              style={`color: ${productAccent}`}
              aria-hidden="true"
            />
            <div>
              <p class="font-semibold text-[#263238]">Kategori</p>
              <p>{product.category}</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <Icon
              name="lucide:package"
              class="mt-0.5 h-[18px] w-[18px] shrink-0"
              style={`color: ${productAccent}`}
              aria-hidden="true"
            />
            <div>
              <p class="font-semibold text-[#263238]">Fokus Produk</p>
              <p>{product.tag}</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <Icon
              name="lucide:sliders-horizontal"
              class="mt-0.5 h-[18px] w-[18px] shrink-0"
              style={`color: ${productAccent}`}
              aria-hidden="true"
            />
            <div>
              <p class="font-semibold text-[#263238]">Ketersediaan</p>
              <p>Stok tersedia untuk seluruh varian yang ditampilkan.</p>
            </div>
          </div>
        </div>

        <div class="grid gap-4 border-b border-[#E5E7EB] pb-4">
          <div class="flex items-center gap-2">
            <Icon name="lucide:check" class="h-[17px] w-[17px]" style={`color: ${productAccent}`} aria-hidden="true" />
            <h3 class="text-[14px] font-semibold text-[#263238]">Manfaat Utama</h3>
          </div>
          <div class="space-y-3">
            {
              product.benefits.map((b) => (
                <div class="grid grid-cols-[6px_1fr] gap-3">
                  <span
                    class="mt-[9px] h-1.5 w-1.5 rounded-full"
                    style={`background-color: ${productAccent}`}
                    aria-hidden="true"
                  />
                  <span class="min-w-0 leading-6">{b}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="grid gap-4 border-b border-[#E5E7EB] pb-4">
          <div class="flex items-center gap-2">
            <Icon name="lucide:plus" class="h-[17px] w-[17px]" style={`color: ${productAccent}`} aria-hidden="true" />
            <h3 class="text-[14px] font-semibold text-[#263238]">Poin Penting Produk</h3>
          </div>
          <div class="space-y-3">
            {
              product.keyPoints.map((point) => (
                <div class="grid grid-cols-[6px_1fr] gap-3">
                  <span
                    class="mt-[9px] h-1.5 w-1.5 rounded-full"
                    style={`background-color: ${productAccent}`}
                    aria-hidden="true"
                  />
                  <span class="min-w-0 leading-6">{point}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div>
          <div class="mb-3 flex items-center gap-2">
            <Icon
              name="lucide:download"
              class="h-[17px] w-[17px]"
              style={`color: ${productAccent}`}
              aria-hidden="true"
            />
            <h3 class="text-[14px] font-semibold text-[#263238]">Ideal Untuk</h3>
          </div>
          <div class="flex flex-wrap gap-x-3 gap-y-2">
            {
              product.idealFor.map((item) => (
                <span class="inline-flex items-center gap-1.5 text-[12px] font-medium text-[#616161]">
                  <span
                    class="h-1.5 w-1.5 rounded-full"
                    style={`background-color: ${productAccent}`}
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {
      (hasAggregateRating || product.reviews.length > 0) && (
        <section class="mt-2 bg-white px-5 py-5">
          <div class="border-b border-[#E5E7EB] pb-3">
            <div class="flex items-center gap-2">
              <RatingStars max={1} starClass="h-[17px] w-[17px]" label="Penilaian produk" />
              <h2 class="text-[15px] font-semibold text-[#263238]">Penilaian Produk</h2>
            </div>
            {hasAggregateRating && (
              <div class="mt-1 text-[13px] font-medium text-[#616161]">
                Skor {formattedRating}/5 dari {reviewCount} penilaian pelanggan
              </div>
            )}
          </div>

          {product.reviews.length > 0 && (
            <div class="mt-4 space-y-5">
              {product.reviews.map((review) => (
                <div class="border-b border-[#E5E7EB] pb-4 last:border-0 last:pb-0">
                  <div class="flex items-center gap-2.5">
                    <img
                      src={review.avatar}
                      alt={`Foto profil ${review.name}`}
                      class="h-10 w-10 shrink-0 rounded-full object-cover"
                      width="40"
                      height="40"
                      loading="lazy"
                      decoding="async"
                    />
                    <div class="min-w-0">
                      <div class="flex items-center gap-1">
                        <p class="text-[12px] font-semibold text-slate-700">{review.name}</p>
                        {review.verified && (
                          <svg viewBox="0 0 22 22" class="h-3.5 w-3.5 shrink-0" role="img" aria-label="Pembelian terverifikasi">
                            <path
                              fill="#1D9BF0"
                              d="M20.396 11c-.018-.646-.215-1.275-.57-1.816-.354-.54-.852-.972-1.438-1.246.223-.607.27-1.264.14-1.897-.131-.634-.437-1.218-.882-1.687-.47-.445-1.053-.75-1.687-.882-.633-.13-1.29-.083-1.897.14-.273-.587-.704-1.086-1.245-1.44S11.647 1.62 11 1.604c-.646.017-1.273.213-1.813.568s-.969.854-1.24 1.44c-.608-.223-1.267-.272-1.902-.14-.635.13-1.22.436-1.69.882-.445.47-.749 1.055-.878 1.688-.13.633-.08 1.29.144 1.896-.587.274-1.087.705-1.443 1.245-.356.54-.555 1.17-.574 1.817.02.647.218 1.276.574 1.817.356.54.856.972 1.443 1.245-.224.606-.274 1.263-.144 1.896.13.634.433 1.218.877 1.688.47.443 1.054.747 1.689.878.634.132 1.293.082 1.901-.14.272.587.702 1.087 1.242 1.443s1.17.555 1.816.573c.647-.018 1.276-.216 1.817-.572s.973-.856 1.245-1.443c.606.223 1.263.27 1.897.14.633-.131 1.217-.436 1.687-.88.446-.47.752-1.055.883-1.69.132-.634.083-1.293-.14-1.901.587-.272 1.086-.703 1.441-1.243.355-.54.552-1.168.57-1.814zM9.44 15.43l-3.1-3.1 1.42-1.42 1.68 1.69 4.8-4.81 1.42 1.42-6.22 6.22z"
                            />
                          </svg>
                        )}
                      </div>
                      <p class="text-[11px] text-slate-400">{review.location} • {review.date}</p>
                    </div>
                  </div>
                  <RatingStars rating={review.rating} class="mt-2" starClass="h-2.5 w-2.5" />
                  <p class="mt-2 text-[13px] leading-6 text-slate-600">{review.comment}</p>
                </div>
              ))}
            </div>
          )}
        </section>
      )
    }

    <section class="mt-2 bg-white px-5 py-4">
      <div class="flex items-start gap-3 text-[12px] leading-5 text-[#616161]">
        <Icon name="lucide:info" class="mt-0.5 h-4 w-4 shrink-0" style={`color: ${productAccent}`} aria-hidden="true" />
        <p>Silakan isi form di bawah untuk langsung memesan varian yang Anda pilih.</p>
      </div>
    </section>

    <section class="mt-2 overflow-hidden">
      <GeoIpResolvedForm mode={formContext.mode} province={formContext.province} productSlug={product.slug} embedded={true} />
    </section>
  </main>
</BaseLayout>
