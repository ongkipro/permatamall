---
import Breadcrumb from '../../components/shared/Breadcrumb.astro';
import MetaViewContentTracker from '../../components/tracking/MetaViewContentTracker.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getStorefrontProduct } from '../../lib/catalog';
import Icon from '../../components/shared/Icon.astro';
import RatingStars from '../../components/shared/RatingStars.astro';
import GeoIpResolvedForm from '../../components/forms/GeoIpResolvedForm.astro';
import ProductImageSlider from '../../components/storefront/ProductImageSlider';
import { resolveFormModeContext } from '../../lib/form-mode';
import { tenantConfig } from '../../lib/tenant';
import '../../styles/form-hybrid.css';

export const prerender = false;

const product = await getStorefrontProduct(Astro.locals, Astro.params.slug || '');
const formContext = await resolveFormModeContext(Astro.request);
if (!product) {
  return Astro.redirect('/produk');
}

const cheapestVariant = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const displayPrice = cheapestVariant?.price ?? product.price;
const displayComparePrice = cheapestVariant?.comparePrice ?? product.comparePrice;
const displayDiscount =
  displayComparePrice > displayPrice ? Math.round((1 - displayPrice / displayComparePrice) * 100) : 0;

const ratingValue = product.ratingValue;
const reviewCount = product.reviewCount;
const soldCount = product.soldCount;
const hasAggregateRating =
  typeof ratingValue === 'number' && typeof reviewCount === 'number' && reviewCount > 0;
const hasSoldCount = typeof soldCount === 'number' && soldCount > 0;
const formattedRating = hasAggregateRating ? ratingValue.toFixed(1) : null;
const soldLabel = hasSoldCount
  ? soldCount >= 1000
    ? `${(soldCount / 1000).toFixed(1).replace('.0', '')}rb+ terjual`
    : `${soldCount} terjual`
  : null;

const productImages = product.images && product.images.length > 0 ? product.images : [product.heroImage];

const productAccent = '#C5A880';
const canonical = `${tenantConfig.siteUrl}/produk/${product.slug}`;
const productTitle = product.seoTitle;
const productDescription = product.seoDescription;
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.productName,
  description: product.seoDescription,
  image: [new URL(product.heroImage, tenantConfig.siteUrl).toString()],
  sku: product.productId,
  category: product.category,
  brand: {
    '@type': 'Brand',
    name: tenantConfig.name,
  },
  ...(hasAggregateRating
    ? {
        aggregateRating: {
          '@type': 'AggregateRating',
          ratingValue: formattedRating,
          reviewCount: String(reviewCount),
        },
      }
    : {}),
  ...(product.reviews.length > 0
    ? {
        review: product.reviews.map((review) => ({
          '@type': 'Review',
          author: {
            '@type': 'Person',
            name: review.name,
          },
          reviewRating: {
            '@type': 'Rating',
            ratingValue: String(review.rating),
            bestRating: '5',
          },
          reviewBody: review.comment,
          datePublished: review.date,
        })),
      }
    : {}),
  offers: product.variants.map((variant) => ({
    '@type': 'Offer',
    url: canonical,
    priceCurrency: 'IDR',
    price: String(variant.price),
    availability: 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/NewCondition',
    name: variant.label,
  })),
};
const productSchemaJson = JSON.stringify(productSchema).replace(/</g, '\\u003c');
---

<BaseLayout
  title={productTitle}
  description={productDescription}
  image={product.heroImage}
  preloadImages={product.heroImage}
  canonical={canonical}
  hideHeader={false}
  hideFooter={false}
  contentWidth="compact"
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Produk', url: '/produk' },
    { name: product.productName, url: `/produk/${product.slug}` },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={productSchemaJson} />
  </Fragment>
  <main
    id="konten-utama"
    class="mx-auto min-h-screen w-full max-w-[480px] bg-[#F8F7F4] pb-24 text-[#111111]"
  >
    <Breadcrumb
      items={[{ label: 'Beranda', href: '/' }, { label: 'Produk', href: '/produk' }, { label: product.productName }]}
    />
    <MetaViewContentTracker
      slug={product.slug}
      productId={product.productId}
      contentName={product.productName}
      price={displayPrice}
    />
    <section class="border-b border-[#E5E5E5] bg-[#F8F7F4]">
      <div class="px-4 pt-4">
      <ProductImageSlider
        client:load
        images={productImages}
        productName={product.productName}
        badgeText={product.tag || 'Bestseller'}
        discountPercentage={displayDiscount}
      />
      </div>

      <div class="px-5 py-6">
        <div class="flex flex-wrap items-end gap-x-2.5 gap-y-1.5">
          <span class="text-[30px] font-semibold leading-none tracking-[-0.035em] text-[#111111]">
            Rp{Math.round(displayPrice).toLocaleString('id-ID')}
          </span>
          {
            displayComparePrice > displayPrice && (
              <span class="pb-[2px] text-[14px] font-medium leading-none text-[#77736C] line-through decoration-1">
                Rp{Math.round(displayComparePrice).toLocaleString('id-ID')}
              </span>
            )
          }
          {
            displayDiscount > 0 && (
              <span class="mb-[1px] inline-flex items-center rounded-full bg-[#C5A880] px-2.5 py-1 text-[10px] font-bold leading-none text-[#111111]">
                Hemat {displayDiscount}%
              </span>
            )
          }
        </div>

        <h1 class="mt-4 text-[20px] font-semibold leading-[1.3] tracking-[-0.025em] text-[#111111]">
          <span
            class="mb-3 inline-flex rounded-sm bg-[#C5A880] px-2.5 py-1 text-[9px] font-semibold uppercase leading-none tracking-[0.15em] text-[#111111]"
            >{product.category}</span
          >
          <span class="block">{product.productName}</span>
          <span class="mt-1.5 block text-[15px] font-medium leading-[1.5] tracking-[-0.01em] text-[#555555]"
            >{product.headline}</span
          >
        </h1>
        <p class="mt-3 text-[14px] leading-[1.7] text-[#555555]">{product.subheadline}</p>

        {
          (hasAggregateRating || hasSoldCount) && (
            <div class="mt-5 flex flex-wrap items-center gap-3 border-t border-[#E5E5E5] pt-4 text-[12px] font-medium text-[#555555]">
              {hasAggregateRating && (
                <>
                  <div class="flex items-center gap-1.5">
                    <RatingStars
                      rating={ratingValue}
                      starClass="h-[13px] w-[13px]"
                      label={`Rating produk ${formattedRating} dari 5 bintang`}
                    />
                    <span class="font-semibold text-[#111111]">{formattedRating}</span>
                  </div>
                  <span>{reviewCount} penilaian</span>
                </>
              )}
              {hasAggregateRating && hasSoldCount && <span class="h-3 w-px bg-[#D8D6D0]" />}
              {hasSoldCount && <span>{soldLabel}</span>}
            </div>
          )
        }
      </div>
    </section>

    <section class="border-b border-[#E5E5E5] bg-white px-5 py-5">
      <div class="flex items-start gap-3">
        <div
          class="mt-0.5 flex h-9 w-9 items-center justify-center rounded-none border border-[#C5A880] bg-[#F8F7F4]"
          style={`color: ${productAccent}`}
        >
          <Icon name="lucide:truck" class="h-[18px] w-[18px]" aria-hidden="true" />
        </div>
        <div>
          <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[#111111]">Informasi Pengiriman</p>
          <p class="mt-1.5 text-[12px] leading-5 text-[#555555]">
            Biaya pengiriman dihitung otomatis di halaman checkout setelah alamat pengiriman dilengkapi.
          </p>
        </div>
      </div>
    </section>

    <section class="border-b border-[#E5E5E5] bg-[#F8F7F4] px-5 py-6">
      <div class="flex items-center justify-between border-b border-[#D8D6D0] pb-3">
        <h2 class="text-[12px] font-semibold uppercase tracking-[0.12em] text-[#111111]">Varian & Harga</h2>
        <span class="text-[10px] font-semibold uppercase tracking-[0.08em] text-[#8A704F]">Referensi produk</span>
      </div>
      <div class="divide-y divide-[#E5E5E5]">
        {
          product.variants.map((v) => (
            <div class="flex items-start justify-between gap-4 py-4">
              <div class="min-w-0 flex-1">
                <div class="flex items-start gap-2">
                  <div
                    class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-none border border-[#C5A880] bg-white"
                    style={`color: ${productAccent}`}
                  >
                    <Icon name="lucide:check" class="h-[11px] w-[11px]" aria-hidden="true" />
                  </div>
                  <div class="min-w-0">
                    <p class="text-[14px] font-semibold leading-5 text-[#111111]">{v.label}</p>
                    {v.sku && (
                      <span class="mt-1 block text-[10px] font-medium uppercase tracking-[0.1em] text-[#77736C]">
                        SKU {v.sku}
                      </span>
                    )}
                  </div>
                </div>
              </div>
              <div class="shrink-0 text-right">
                <p class="text-[16px] font-bold leading-none text-[#111111]">
                  Rp{Math.round(v.price).toLocaleString('id-ID')}
                </p>
                {v.comparePrice && (
                  <p class="mt-1 text-[11px] leading-none text-[#77736C] line-through">
                    Rp{Math.round(v.comparePrice).toLocaleString('id-ID')}
                  </p>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="border-b border-[#E5E5E5] bg-white px-5 py-6">
      <h2 class="border-b border-[#E5E5E5] pb-3 text-[12px] font-semibold uppercase tracking-[0.12em] text-[#111111]">Informasi Produk</h2>
      <div class="mt-4 grid gap-5 text-[14px] leading-6 text-[#555555]">
        <p>{product.description}</p>

        <div class="grid gap-3 border-b border-[#E5E5E5] pb-4">
          <div class="flex items-start gap-3">
            <Icon
              name="lucide:pencil"
              class="mt-0.5 h-[18px] w-[18px] shrink-0"
              style={`color: ${productAccent}`}
              aria-hidden="true"
            />
            <div>
              <p class="font-semibold text-[#111111]">Kategori</p>
              <p>{product.category}</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <Icon
              name="lucide:package"
              class="mt-0.5 h-[18px] w-[18px] shrink-0"
              style={`color: ${productAccent}`}
              aria-hidden="true"
            />
            <div>
              <p class="font-semibold text-[#111111]">Fokus Produk</p>
              <p>{product.tag}</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <Icon
              name="lucide:sliders-horizontal"
              class="mt-0.5 h-[18px] w-[18px] shrink-0"
              style={`color: ${productAccent}`}
              aria-hidden="true"
            />
            <div>
              <p class="font-semibold text-[#111111]">Ketersediaan</p>
              <p>Stok tersedia untuk seluruh varian yang ditampilkan.</p>
            </div>
          </div>
        </div>

        <div class="grid gap-4 border-b border-[#E5E5E5] pb-4">
          <div class="flex items-center gap-2">
            <Icon name="lucide:check" class="h-[17px] w-[17px]" style={`color: ${productAccent}`} aria-hidden="true" />
            <h3 class="text-[13px] font-semibold uppercase tracking-[0.08em] text-[#111111]">Manfaat Utama</h3>
          </div>
          <div class="space-y-3">
            {
              product.benefits.map((b) => (
                <div class="grid grid-cols-[8px_1fr] gap-3">
                  <span
                    class="mt-3 h-px w-2 bg-[#C5A880]"
                    aria-hidden="true"
                  />
                  <span class="min-w-0 leading-6">{b}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div class="grid gap-4 border-b border-[#E5E5E5] pb-4">
          <div class="flex items-center gap-2">
            <Icon name="lucide:plus" class="h-[17px] w-[17px]" style={`color: ${productAccent}`} aria-hidden="true" />
            <h3 class="text-[13px] font-semibold uppercase tracking-[0.08em] text-[#111111]">Poin Penting Produk</h3>
          </div>
          <div class="space-y-3">
            {
              product.keyPoints.map((point) => (
                <div class="grid grid-cols-[8px_1fr] gap-3">
                  <span
                    class="mt-3 h-px w-2 bg-[#C5A880]"
                    aria-hidden="true"
                  />
                  <span class="min-w-0 leading-6">{point}</span>
                </div>
              ))
            }
          </div>
        </div>

        <div>
          <div class="mb-3 flex items-center gap-2">
            <Icon
              name="lucide:download"
              class="h-[17px] w-[17px]"
              style={`color: ${productAccent}`}
              aria-hidden="true"
            />
            <h3 class="text-[13px] font-semibold uppercase tracking-[0.08em] text-[#111111]">Ideal Untuk</h3>
          </div>
          <div class="flex flex-wrap gap-x-3 gap-y-2">
            {
              product.idealFor.map((item) => (
                <span class="inline-flex items-center gap-2 text-[12px] font-medium text-[#555555]">
                  <span
                    class="h-px w-2 bg-[#C5A880]"
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </span>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {
      (hasAggregateRating || product.reviews.length > 0) && (
        <section class="border-b border-[#E5E5E5] bg-[#F8F7F4] px-5 py-6">
          <div class="border-b border-[#E5E5E5] pb-3.5">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <RatingStars max={1} starClass="h-[17px] w-[17px]" label="Penilaian produk" />
                <h2 class="text-[12px] font-semibold uppercase tracking-[0.12em] text-[#111111]">Penilaian Produk</h2>
              </div>
              <span class="text-[10px] font-semibold uppercase tracking-wider text-[#8A704F]">100% Real Buyer</span>
            </div>
            
            <div class="mt-2.5 flex items-center justify-between border-t border-[#E5E5E5] pt-2.5">
              <div class="flex items-center gap-1.5 text-[12px] font-bold text-[#111111]">
                <span class="text-[#C5A880]">★ {formattedRating || '4.9'} / 5.0</span>
                <span class="text-[#555555]">• {reviewCount || 248}+ Ulasan Pembeli Terverifikasi</span>
              </div>
            </div>
          </div>

          {product.reviews.length > 0 && (
            <div class="mt-4 space-y-4">
              {product.reviews.map((review) => (
                <div class="border-b border-[#E5E5E5] pb-4 last:border-0 last:pb-0">
                  <div class="flex items-center gap-3">
                    <div 
                      class="flex h-10 w-10 shrink-0 items-center justify-center border border-[#C5A880]/60 bg-[#111111] text-[13px] font-bold uppercase text-[#C5A880]"
                      style="font-family: 'Cinzel', serif;"
                    >
                      {review.name.charAt(0)}
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-1.5">
                        <p class="text-[12px] font-bold text-[#111111]">{review.name}</p>
                        {review.verified && (
                          <span class="inline-flex items-center gap-0.5 border border-[#C5A880]/40 bg-white px-1.5 py-0.5 text-[8px] font-semibold uppercase tracking-wider text-[#8A704F]">
                            Verified
                          </span>
                        )}
                      </div>
                      <p class="mt-0.5 flex items-center gap-2 text-[11px] text-[#77736C]"><span>{review.location}</span><span class="h-3 w-px bg-[#E5E5E5]" aria-hidden="true" /><span>{review.date}</span></p>
                    </div>
                  </div>
                  <RatingStars rating={review.rating} class="mt-2" starClass="h-2.5 w-2.5" />
                  <p class="mt-1.5 text-[13px] leading-6 text-[#555555]">"{review.comment}"</p>
                </div>
              ))}
            </div>
          )}
        </section>
      )
    }

    <section class="border-b border-[#E5E5E5] bg-white px-5 py-5">
      <div class="flex items-start gap-3 text-[12px] leading-5 text-[#555555]">
        <Icon name="lucide:info" class="mt-0.5 h-4 w-4 shrink-0" style={`color: ${productAccent}`} aria-hidden="true" />
        <p>Silakan isi form di bawah untuk langsung memesan varian yang Anda pilih.</p>
      </div>
    </section>

    <section id="form-pemesanan" class="mt-4 overflow-hidden rounded-none border border-[#D8D6D0] bg-white p-2">
      <GeoIpResolvedForm mode={formContext.mode} province={formContext.province} productSlug={product.slug} embedded={true} />
    </section>

    <!-- Sticky Mobile Purchase Bar -->
    <div class="fixed inset-x-0 bottom-0 z-40 mx-auto flex w-full max-w-[480px] items-center justify-between border-t border-[#D8D6D0] bg-[#F8F7F4]/95 px-5 py-3 shadow-[0_-8px_24px_rgba(17,17,17,0.08)] backdrop-blur-md lg:hidden">
      <div>
        <p class="text-[9px] font-semibold uppercase tracking-[0.12em] text-[#555555]">Harga Promo</p>
        <p class="text-base font-bold text-[#111111]">Rp{Math.round(displayPrice).toLocaleString('id-ID')}</p>
      </div>
      <a
        href="#form-pemesanan"
        class="inline-flex min-h-11 items-center justify-center rounded-none border border-[#111111] bg-[#111111] px-6 text-[10px] font-semibold uppercase tracking-[0.1em] text-[#F8F7F4] transition-colors hover:bg-[#2A2A2A] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111] active:scale-[0.98]"
      >
        Pesan Sekarang (COD)
      </a>
    </div>
  </main>
</BaseLayout>
