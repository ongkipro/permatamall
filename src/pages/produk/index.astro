---
import PageIntro from '../../components/shared/PageIntro.astro';
import ProductListItem from '../../components/shared/ProductListItem.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatIdr } from '../../lib/format-idr';
import { getStorefrontProducts } from '../../lib/catalog';
import { tenantConfig } from '../../lib/tenant';

const products = await getStorefrontProducts(Astro.locals);
const catalogProducts = products.slice(0, 15);
---

<BaseLayout
  title={`Produk - ${tenantConfig.name}`}
  description={`Pilih produk ${tenantConfig.name}, lihat varian, stok, dan harga sebelum memesan.`}
  contentWidth="compact"
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Produk', url: '/produk' },
  ]}
>
  <main id="konten-utama" class="min-h-screen bg-[#F8F7F4] text-[#111111]">
    <PageIntro
      badge="Semua Produk"
      title={`Produk ${tenantConfig.name}`}
      description="Pilih produk berdasarkan kebutuhan Anda, lalu lihat varian dan harga sebelum memesan."
      breadcrumbs={[{ label: 'Beranda', href: '/' }, { label: 'Produk' }]}
    />

    <section aria-label="Daftar produk" class="mx-auto max-w-[480px] px-4 py-8">
      {catalogProducts.length > 0 ? (
        <div class="grid grid-cols-2 gap-3">
          {catalogProducts.map((product) => <ProductListItem product={product} formatPrice={formatIdr} />)}
        </div>
      ) : (
        <div class="border-y border-[#E5E5E5] py-10 text-center">
          <h2 class="text-lg font-semibold text-[#111111]">Katalog sedang disiapkan</h2>
          <p class="mt-2 text-sm leading-6 text-[#555555]">Produk akan muncul setelah konten dan varian diterbitkan.</p>
        </div>
      )}
    </section>
  </main>
</BaseLayout>
