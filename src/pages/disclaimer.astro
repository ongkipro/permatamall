---
import LegalPage from '../components/shared/LegalPage.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { legalPages } from '../data/legal';
import { tenantConfig } from '../lib/tenant';

const page = legalPages.disclaimer;

<BaseLayout
  shell="storefront"
  title={`Disclaimer - ${tenantConfig.name}`}
  description={page.description}
  noindex={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Disclaimer', url: '/disclaimer' },
  ]}
>
  <LegalPage
    badge={page.badge}
    title={page.title}
    description={page.description}
    sections={page.sections}
    breadcrumbs={[{ label: 'Beranda', href: '/' }, { label: 'Disclaimer' }]}
  />
</BaseLayout>
