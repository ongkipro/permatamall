---
import BaseLayout from '../layouts/BaseLayout.astro';
import RatingStars from '../components/shared/RatingStars.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import Icon from '../components/shared/Icon.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('alat-anti-ngorok');
if (!product) throw new Error('Product alat-anti-ngorok not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = 'https://permatamall.shop/lega-anti-ngorok';
const seoTitle = 'LEGA Anti Ngorok - Solusi Tidur Hening Tanpa Dengkuran';
const seoDescription =
  'Klip hidung silikon medis LEGA dengan nodul magnetik. Melebarkan rongga napas dari dalam, dengkuran reda sejak malam pertama. Beli 1 dapat 3 pcs + box. Bisa COD.';

const sectionTitle = 'text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950';
const body = 'text-[16px] leading-relaxed text-slate-600';

const testimonials = [
  {
    name: 'Bu Rahma',
    location: 'Bekasi, Jawa Barat',
    avatar: '/images/lega/testi-bu-rahma.webp',
    problem: 'Suami ngorok kencang, sering ngungsi kamar',
    comment:
      'Suami ngorok kencang banget sampai saya sering <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">ngungsi ke kamar sebelah</strong>. Pas dicobain LEGA, <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">malam pertama langsung hening</strong>. Alhamdulillah sekarang bisa tidur nyenyak sekamar lagi.',
    highlight: 'Malam pertama langsung hening',
  },
  {
    name: 'Pak Hasan',
    location: 'Makassar, Sulawesi Selatan',
    avatar: '/images/lega/testi-pak-hasan.webp',
    problem: 'Malu ngorok saat dinas sekamar teman kantor',
    comment:
      'Suka sungkan kalau dinas luar kota sama teman kantor karena <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">ngorok saya berisik</strong>. Pakai klip ini ternyata nyaman, tidak mengganjal, dan kata teman <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">suara ngorok saya hilang total</strong>.',
    highlight: 'Tidak malu lagi saat menginap',
  },
  {
    name: 'Mas Bayu',
    location: 'Sleman, Yogyakarta',
    avatar: '/images/lega/testi-mas-bayu.webp',
    problem: 'Bangun pagi leher kering, badan tetap capek',
    comment:
      'Dulu tiap bangun pagi <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">leher kering dan badan masih capek</strong>. Sejak pakai LEGA, napas rasanya plong banget, <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">bangun pagi segar bugar</strong>.',
    highlight: 'Bangun pagi terasa segar',
  },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image="/images/lega/foto-produk-set.webp"
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'LEGA Anti Ngorok', url: '/lega-anti-ngorok' }
  ]}

  preloadImages={[
    "/images/lega/produk-hero.webp",
    "/images/lega/before-after.webp"
  ]}>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <MetaLandingTracker slug="lega-anti-ngorok" productId={product.productId} contentName={product.contentName} price={product.price} />

    <div class="bg-[#FF9900] px-4 py-2 text-center">
      <p class="flex items-center justify-center gap-1.5 text-[12px] font-extrabold tracking-wide text-white">
        <Icon name="lucide:zap" class="h-4 w-4 shrink-0" aria-hidden="true" />
        BELI 1 DAPAT 3 PCS + BOX, BAYAR DI TEMPAT (COD)
      </p>
    </div>

    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-7">
        <h1 class="mx-auto max-w-[440px] text-[clamp(32px,8.8vw,36px)] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Suami Ngorok Kencang Tiap Malam? <span class="hl-brush">Langsung Hening Pulas</span> Pakai LEGA!
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[16px] font-semibold leading-relaxed text-slate-700">
          Cukup pasang <strong class="font-bold text-slate-950">3 detik di hidung</strong> sebelum tidur. Napas langsung plong, dengkuran reda semalaman. <span class="font-bold text-slate-950 underline decoration-[#FF9900]/60 decoration-2 underline-offset-4">Tanpa obat, tanpa alat listrik.</span>
        </p>
      </div>

      <div class="mt-7">
        <div class="relative overflow-hidden bg-slate-950 aspect-[4/3] w-full">
          <img
            src="/images/lega/produk-hero.webp"
            alt="Pasangan Indonesia tidur nyenyak bebas dengkuran dengan klip hidung LEGA"
            class="h-full w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="480"
            height="360"
          />
          <div class="absolute bottom-0 left-0 right-0 bg-slate-950/85 px-4 py-3 text-center backdrop-blur-sm">
            <p class="flex items-start justify-center gap-1.5 text-[12.5px] font-bold text-[#FFD699]">
              <Icon name="lucide:moon" class="mt-0.5 h-4 w-4 shrink-0 text-[#FFD699]" aria-hidden="true" />
              <span class="text-left leading-tight">Malam kembali hening: pasangan tidur nyenyak, Anda bangun segar.</span>
            </p>
          </div>
        </div>

        <div class="mt-4 flex items-center justify-center gap-3 px-4">
          <div class="flex -space-x-2">
            {testimonials.map((t) => (
              <img src={t.avatar} alt={t.name} class="h-8 w-8 rounded-full border-2 border-white object-cover" width="32" height="32" loading="eager" decoding="async" />
            ))}
          </div>
          <div class="text-left">
            <div class="flex items-center gap-0.5">
            <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
            <span class="ml-1 text-[13px] font-bold text-slate-900">4.9/5</span>
            </div>
            <p class="text-[11px] font-medium text-slate-500">dari 2.100+ pembeli puas</p>
          </div>
        </div>

        <div class="mt-5 flex justify-center gap-4 px-4">
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:package" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            3 Pcs + Box
          </span>
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:feather" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Silikon Medis
          </span>
          <span class="inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700">
            <Icon name="lucide:truck" class="h-4 w-4 text-[#232F3E]" aria-hidden="true" />
            Bisa COD
          </span>
        </div>

        <div class="mt-6 border-l-2 border-[#FF9900] px-5 pl-4 text-left">
          <h2 class="text-[15px] font-bold text-slate-950">Ngorok bukan sekadar suara berisik.</h2>
          <p class="mt-1 text-[13.5px] leading-relaxed text-slate-600">Ia tanda jalan napas Anda menyempit saat tidur. Yang rugi bukan cuma pasangan: kualitas tidur Anda sendiri anjlok diam-diam.</p>
        </div>
      </div>
    </section>

    <section class="border-t border-slate-100 bg-red-50/40 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-red-600">Sering Mengalami Ini?</span>
      <h2 class={sectionTitle}>Dampak Ngorok yang Sering <span class="hl-brush">Dianggap Sepele</span></h2>
      <p class={`${body} mt-3 mb-6`}>Banyak orang tidak sadar dengkuran pelan-pelan merusak kualitas hidup satu rumah:</p>
      <div class="space-y-4">
        {[
          ['Pasangan Jadi Sulit Tidur', 'Suara dengkuran kencang membuat pasangan tidak bisa terlelap, terpaksa tidur belakangan atau pindah kamar.'],
          ['Bangun Pagi Badan Tetap Lelah', 'Aliran napas tersumbat membuat pasokan oksigen berkurang. Jam tidur panjang, tapi bangun tetap capek dan pusing.'],
          ['Sungkan Tidur Bersama Orang Lain', 'Menginap di rumah saudara atau dinas kantor jadi bikin cemas: takut dengkuran mengganggu satu ruangan.']
        ].map(([title, desc]) => (
          <div class="flex items-start gap-3.5">
            <span class="mt-1 flex h-5 w-5 shrink-0 items-center justify-center text-red-600"><Icon name="lucide:x-circle" class="h-5 w-5" aria-hidden="true" /></span>
            <div>
              <h3 class="text-[16px] font-bold text-slate-900">{title}</h3>
              <p class="mt-0.5 text-[15px] leading-relaxed text-slate-600">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="border-t border-slate-100 bg-slate-950 px-5 py-10 text-white">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#FFD699]">Cara Kerja Presisi</span>
      <h2 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-white">Dengkuran Lahir dari <span class="text-[#FFD699]">Jalan Napas yang Menyempit</span></h2>
      <p class="mt-3 text-[16px] leading-relaxed text-slate-400">Saat terlelap, otot rongga hidung melemas dan celah udara menguncup. Udara yang sama dipaksa lewat jalan sempit, jaringan bergetar, lahirlah suara ngorok. LEGA menyerang akarnya lewat dua mekanisme:</p>

      <div class="relative ml-2 mt-8 space-y-8 border-l border-slate-800 pl-6">
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-white ring-4 ring-slate-950">1</span>
          <h3 class="text-[16px] font-semibold text-[#FFD699]">Pelebaran Rongga Hidung (Nasal Dilation)</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-slate-400">Klip menyangga dinding dalam cuping hidung agar tidak menguncup saat Anda menarik napas dalam. Oksigen masuk lancar lewat hidung, mulut tidak perlu ikut terbuka.</p>
        </div>
        <div class="relative">
          <span class="absolute -left-[35px] flex h-6 w-6 items-center justify-center rounded-full bg-[#FF9900] text-[11px] font-bold text-white ring-4 ring-slate-950">2</span>
          <h3 class="text-[16px] font-semibold text-[#FFD699]">Nodul Magnetik Penstabil Posisi</h3>
          <p class="mt-1.5 text-[15px] leading-relaxed text-slate-400">Dua nodul magnetik halus di ujung klip menjaga posisinya tetap stabil di septum hidung: tidak bergeser dan tidak lepas walau Anda banyak berganti posisi tidur.</p>
        </div>
      </div>

      <div class="mt-8 overflow-hidden rounded-md">
        <img fetchpriority="low" src="/images/lega/before-after.webp"
          alt="Perbandingan sebelum dan sesudah memakai LEGA: dari ngorok berisik menjadi tidur hening"
          class="aspect-[4/3] w-full object-cover"
          loading="lazy"
          decoding="async"
          width="480"
          height="360"
        />
      </div>

      <div class="mt-6 rounded-md bg-slate-900 p-4">
        <p class="text-[14px] leading-relaxed text-slate-300"><strong class="text-[#FFD699]">Hasilnya:</strong> napas lewat hidung kembali lega sepanjang malam, getaran jaringan mereda, dan kamar kembali hening sejak malam pertama pemakaian.</p>
      </div>
    </section>

    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Foto Asli Produk</span>
      <h2 class={sectionTitle}>Lihat Bentuk Fisik & <span class="hl-brush">Isi Paketnya</span></h2>
      <p class={`${body} mt-3 mb-6`}>Satu paket berisi 3 klip silikon bening + box akrilik penyimpan. Satu di nakas, satu di tas kerja, satu untuk bepergian:</p>

      <div class="overflow-hidden rounded-md">
        <img fetchpriority="low" src="/images/lega/foto-produk-set.webp"
          alt="Foto asli paket LEGA: 3 klip silikon bening dengan box akrilik transparan"
          class="aspect-square w-full object-cover"
          loading="lazy"
          decoding="async"
          width="480"
          height="360"
        />
      </div>
      <p class="mt-2 text-[12.5px] text-slate-500">Isi paket: 3 klip LEGA + 1 box akrilik. Box menjaga klip bebas debu dan tetap higienis.</p>

      <div class="mt-6 overflow-hidden rounded-md">
        <img fetchpriority="low" src="/images/lega/foto-produk-detail.webp"
          alt="Detail klip silikon medis LEGA dengan nodul magnetik di kedua ujungnya"
          class="aspect-[4/3] w-full object-cover"
          loading="lazy"
          decoding="async"
          width="480"
          height="360"
        />
      </div>
      <p class="mt-2 text-[12.5px] text-slate-500">Silikon medis super halus, hypoallergenic, mengikuti kontur hidung. Tidak lecet, tidak sakit.</p>

      <div class="mt-8 border-t-2 border-[#FFEACC] pt-5">
        <h3 class="flex items-center gap-2 text-[15px] font-bold text-slate-950">
          <Icon name="lucide:shield-check" class="h-4.5 w-4.5 text-[#EC7211]" aria-hidden="true" />
          Spesifikasi LEGA
        </h3>
        <div class="mt-3 space-y-2.5 text-[14px] leading-relaxed">
          <p><strong class="font-semibold text-slate-900">Bahan:</strong> <span class="text-slate-600">100% silikon medis (BPA free), hypoallergenic, tanpa bau</span></p>
          <p><strong class="font-semibold text-slate-900">Teknologi:</strong> <span class="text-slate-600">dual magnetic node penstabil posisi</span></p>
          <p><strong class="font-semibold text-slate-900">Isi kemasan:</strong> <span class="box-decoration-clone bg-[#FFF5E5] px-1.5 pb-0.5 font-semibold text-slate-900">3 pcs klip LEGA + 1 box akrilik</span></p>
          <p><strong class="font-semibold text-slate-900">Perawatan:</strong> <span class="text-slate-600">bilas air mengalir, pakai berulang (hemat, bukan sekali buang)</span></p>
        </div>
      </div>
    </section>

    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Cara Pakai</span>
      <h2 class={sectionTitle}>Cuma 3 Detik Sebelum Tidur</h2>
      <p class={`${body} mt-3 mb-6`}>Tanpa setting rumit, tanpa baterai, tanpa perlu biasakan alat besar di wajah:</p>
      <figure class="overflow-hidden rounded-md ring-1 ring-slate-200">
        <figcaption class="flex items-center gap-2 bg-[#232F3E] px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.18em] text-white">
          <Icon name="lucide:workflow" class="h-4 w-4 shrink-0" aria-hidden="true" />
          3 Langkah Pemakaian LEGA
        </figcaption>
        <div class="flex items-start justify-between gap-1 bg-gradient-to-b from-[#FFF5E5]/60 to-white px-3 py-6">
          {[
            ['lucide:hand', 'Pasang', 'Jepitkan lembut di dalam hidung'],
            ['lucide:moon', 'Tidur', 'Napas plong, kamar hening'],
            ['lucide:droplets', 'Bilas', 'Cuci air mengalir, simpan di box']
          ].map(([icon, title, sub], i, arr) => (
            <>
              <div class="flex-1 text-center">
                <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[#FF9900] text-white">
                  <Icon name={icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <h3 class="mt-2.5 text-[13px] font-bold text-slate-900">{title}</h3>
                <p class="mx-auto mt-0.5 max-w-[110px] text-[11px] leading-tight text-slate-500">{sub}</p>
              </div>
              {i < arr.length - 1 && (
                <Icon name="lucide:chevron-right" class="mt-4 h-5 w-5 shrink-0 text-[#FFD699]" aria-hidden="true" />
              )}
            </>
          ))}
        </div>
        <div class="flex items-center justify-center gap-1.5 border-t border-[#FFEACC] bg-[#FFF5E5]/60 px-4 py-2.5 text-center text-[12px] font-semibold text-[#232F3E]">
          <Icon name="lucide:badge-check" class="h-4 w-4 shrink-0" aria-hidden="true" />
          Umumnya butuh 2-3 malam untuk terbiasa dengan rasa klip di hidung
        </div>
      </figure>

      <div class="mt-8 border-t border-slate-100 pt-6">
        <h3 class="text-[16px] font-extrabold tracking-tight text-slate-950">Kenapa Bukan Plester Hidung Sekali Pakai?</h3>
        <div class="mt-4 space-y-2.5 text-[14.5px] leading-relaxed">
          <p class="flex items-start gap-2.5">
            <Icon name="lucide:x" class="mt-1 h-4 w-4 shrink-0 text-red-600" aria-hidden="true" />
            <span class="text-slate-600">Plester: lem sering bikin kulit hidung iritasi, dan harus dibuang tiap pagi (boros ratusan ribu per bulan).</span>
          </p>
          <p class="flex items-start gap-2.5 border-l-2 border-[#FF9900] pl-3">
            <Icon name="lucide:check" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
            <span class="font-semibold text-slate-900">LEGA: silikon lembut tanpa lem, dicuci dan dipakai ulang. Sekali beli, dapat 3 pcs untuk pemakaian jangka panjang.</span>
          </p>
        </div>
      </div>
    </section>

    <section class="border-t border-slate-100 bg-[#FFF5E5]/40 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Kata Pembeli</span>
      <h2 class={sectionTitle}>Cerita Mereka yang Kamarnya <span class="hl-brush">Kembali Hening</span></h2>
      <p class={`${body} mt-3 mb-8`}>Ribuan keluarga Indonesia sudah membuktikannya:</p>

      <div class="space-y-9">
        {testimonials.map((t, index, arr) => (
          <div>
            <div class="flex items-center gap-3">
              <img
                src={t.avatar}
                alt={`Foto ${t.name}, pengguna LEGA Anti Ngorok`}
                class="h-11 w-11 shrink-0 rounded-full object-cover"
                width="44"
                height="44"
                loading="lazy"
                decoding="async"
              />
              <div class="min-w-0">
                <h3 class="flex items-center gap-1 text-[15px] font-bold text-slate-900">
                  {t.name}
                  <Icon name="lucide:badge-check" class="h-4 w-4 shrink-0 text-[#0073BB]" aria-hidden="true" />
                </h3>
                <p class="text-[11.5px] text-slate-500">{t.location}</p>
              </div>
              <div class="ml-auto flex gap-0.5">
                <RatingStars rating={5} max={5} starClass="h-3.5 w-3.5" />
              </div>
            </div>
            <p class="mt-1.5 text-[12px] font-semibold text-[#B45309]">Masalah: {t.problem}</p>
            <p class="mt-3 border-l-2 border-[#FF9900]/40 pl-3 text-[15px] italic leading-relaxed text-slate-700" set:html={`"${t.comment}"`} />
            <p class="mt-2.5 flex items-center gap-1.5 text-[13px] font-bold text-slate-900">
              <Icon name="lucide:check-circle-2" class="h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
              {t.highlight}
            </p>
            {index < arr.length - 1 && <div class="mt-8 h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent" />}
          </div>
        ))}
      </div>
    </section>

    <section class="border-t border-slate-100 px-5 py-10">
      <span class="mb-2 block text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Jujur dari Awal</span>
      <h2 class={sectionTitle}>Cocok untuk Siapa, dan Kapan ke Dokter?</h2>
      <p class={`${body} mt-3 mb-6`}>LEGA bukan alat medis dan bukan obat. Supaya Anda tidak salah beli:</p>

      <div class="space-y-2.5 text-[15px] leading-relaxed">
        <p class="flex items-start gap-2.5">
          <Icon name="lucide:check-circle-2" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Cocok untuk <strong class="font-semibold text-slate-900">ngorok ringan sampai sedang dari hidung</strong>: napas terasa berat saat hidung mampet atau tidur telentang.</span>
        </p>
        <p class="flex items-start gap-2.5">
          <Icon name="lucide:check-circle-2" class="mt-1 h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          <span class="text-slate-700">Cocok untuk yang ingin solusi <strong class="font-semibold text-slate-900">tanpa obat dan tanpa alat listrik</strong>, praktis dibawa menginap atau dinas.</span>
        </p>
        <p class="mt-4 flex items-start gap-2.5 border-l-2 border-red-300 pl-3">
          <Icon name="lucide:stethoscope" class="mt-1 h-4 w-4 shrink-0 text-red-600" aria-hidden="true" />
          <span class="text-slate-700">Kalau dengkuran Anda sangat keras dan disertai <strong class="font-semibold text-red-700">napas seperti berhenti lalu tersentak bangun</strong> (gejala sleep apnea), periksakan ke dokter. Itu butuh penanganan medis, bukan alat bantu.</span>
        </p>
      </div>
    </section>

    <section class="border-t border-slate-100 bg-[#F2F3F3] px-5 py-10 text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center text-[#232F3E]">
        <Icon name="lucide:shield-check" class="h-12 w-12" aria-hidden="true" />
      </div>
      <h2 class="mb-2 text-[11px] font-medium uppercase tracking-[0.2em] text-[#232F3E]">Belanja Tanpa Was-Was</h2>
      <h3 class="text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950">BAYAR SETELAH BARANG SAMPAI</h3>
      <p class="mx-auto mt-4 max-w-[340px] text-[16px] leading-relaxed text-slate-600">Pesan LEGA hari ini dengan sistem COD: Anda baru bayar ke kurir saat paket sudah di tangan.</p>

      <div class="mx-auto mt-8 max-w-[360px] space-y-6 text-left">
        {[
          ['lucide:truck', 'COD ke Seluruh Indonesia', 'Bayar tunai di tempat saat paket tiba. Tidak perlu transfer di muka.'],
          ['lucide:package-check', 'Paket Sesuai Foto', 'Isi paket persis seperti foto asli di atas: 3 klip + box akrilik, dikirim rapi dan privasi terjaga.'],
          ['lucide:message-circle', 'Admin Siap Ditanya', 'Ragu soal pemakaian atau pengiriman? Chat admin via WhatsApp sebelum maupun sesudah pesan.']
        ].map(([icon, title, desc]) => (
          <div class="flex items-start gap-4">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded bg-white text-[#232F3E]"><Icon name={icon} class="h-4.5 w-4.5" aria-hidden="true" /></span>
            <div>
              <h4 class="text-[16px] font-bold text-slate-900">{title}</h4>
              <p class="mt-1 text-[15px] leading-relaxed text-slate-500">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="checkout" class="border-t-8 border-slate-100 bg-white py-12">
      <div class="px-5 pb-8 text-center">
        <p class="mx-auto mb-3 inline-flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.14em] text-[#EC7211]">
          <Icon name="lucide:zap" class="h-4 w-4 shrink-0" aria-hidden="true" />
          Promo Beli 1 Dapat 3 Pcs
        </p>
        <h2 class="mx-auto max-w-[340px] text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950">
          Isi Alamat Pengiriman, <span class="hl-brush">Bayar Saat Sampai</span>
        </h2>
        <p class="mx-auto mt-4 max-w-[320px] text-[15px] leading-relaxed text-slate-600">
          Form menyesuaikan wilayah Anda. Paket dikirim rapi, Anda bayar tunai ke kurir saat barang tiba di rumah.
        </p>
      </div>
      <GeoIpResolvedForm mode={formContext.mode} productSlug="alat-anti-ngorok" embedded={true} />
    </section>

    <LpMiniFooter />
    <StickyCTA productSlug="alat-anti-ngorok" />
    <SocialProof productSlug="alat-anti-ngorok" />
  </main>
</BaseLayout>

