---
import { ProductForm } from '../../../components/admin/ProductForm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AdminPageHeader from '../../../components/admin/AdminPageHeader.astro';
import { isCanonicalSampleProductId } from '../../../lib/sample-product';
export const prerender = false;

const productId = Astro.url.searchParams.get('id')?.trim() || '';
if (!/^\d+$/.test(productId)) return Astro.redirect('/admin/products', 302);
const isSampleProduct = isCanonicalSampleProductId(productId);
---

<AdminLayout title={isSampleProduct ? "Data Contoh Produk" : "Edit Produk"} activeMenu="products">
  <div class="mx-auto max-w-7xl space-y-5">
    <AdminPageHeader
      eyebrow="Catalog"
      title={isSampleProduct ? "Data contoh produk" : "Edit produk"}
      description={isSampleProduct
        ? "Aussie adalah data contoh bawaan yang tidak dapat diubah atau dihapus. Unggah produk lain untuk penggunaan sebenarnya."
        : "Perbarui identitas produk dan varian. Product ID tersedia di ringkasan; varian yang sudah dipakai order tidak dapat dihapus."}
    />
    <ProductForm productId={productId} client:load />
  </div>
</AdminLayout>
