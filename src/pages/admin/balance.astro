---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminPageHeader from "../../components/admin/AdminPageHeader.astro";
import PaymentReconciliationQueue from "../../components/admin/PaymentReconciliationQueue";

export const prerender = false;
---

<AdminLayout title="Rekonsiliasi pembayaran AutoLaris" activeMenu="payments">
  <div class="mx-auto max-w-7xl space-y-5">
    <AdminPageHeader
      eyebrow="Payment operations"
      title="Rekonsiliasi pembayaran AutoLaris"
      description="Gunakan rekonsiliasi manual bila status otomatis belum berubah. Tandai lunas hanya setelah transaksi terlihat berhasil di dashboard AutoLaris."
      backHref="/admin/payments"
      backLabel="Payment AutoLaris"
    />

    <PaymentReconciliationQueue client:load />
  </div>
</AdminLayout>
