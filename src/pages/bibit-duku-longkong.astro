---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoIpResolvedForm from '../components/forms/GeoIpResolvedForm.astro';
import Icon from '../components/shared/Icon.astro';
import LpMiniFooter from '../components/shared/LpMiniFooter.astro';
import MetaLandingTracker from '../components/tracking/MetaLandingTracker.astro';
import SocialProof from '../components/shared/SocialProof.astro';
import StickyCTA from '../components/shared/StickyCTA.astro';
import { getProductBySlug } from '../data/products';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';

export const prerender = false;

const product = getProductBySlug('bibit-duku-longkong');
if (!product) throw new Error('Product bibit-duku-longkong not found');
const formContext = await resolveFormModeContext(Astro.request);

const canonical = 'https://pesantren.shop/bibit-duku-longkong';
const seoTitle = 'Bibit Duku Longkong Thailand Super Manis Tanpa Biji: Cepat Berbuah Genjah';
const seoDescription =
  'Bibit Duku Longkong Thailand Okulasi Super Manis. Daging bening tebal tanpa biji, pohon genjah cepat berbuah lebat & tahan cuaca. Garansi COD Rp 99rb.';

const sectionTitle = 'text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950';
const body = 'text-[16px] leading-relaxed text-slate-600';

const testimonials = [
  {
    name: 'Pak Haji Rohman',
    location: 'Palembang, Sumatera Selatan',
    avatar: '/images/petani/petani-01.webp',
    problem: 'Pernah tanam duku lokal belasan tahun tak kunjung berbuah dan bijinya besar',
    comment:
      'Dulu tanam duku biasa <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 font-semibold text-slate-950">10 tahun lebih baru belajar buah & bijinya gede banget</strong>. Pas ganti Bibit Duku Longkong okulasi ini <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">tanam 2.5 tahun langsung dompolan lebat manis banget tanpa biji</strong>!',
    highlight: 'Berbuah lebat 2.5 tahun tanpa biji',
  },
  {
    name: 'Bu Hajjah Maryam',
    location: 'Sidoarjo, Jawa Timur',
    avatar: '/images/petani/petani-dewi.webp',
    problem: 'Ragu tanam bibit buah di pot teras karena takut tidak mau berbuah',
    comment:
      'Awalnya ragu tanam di pot teras depan rumah. Ternyata <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">bibitnya sangat genjah & tahan panas</strong>. Sekarang sudah panen duku manis bening renyah. Anak-anak suka sekali!',
    highlight: 'Genjah & cocok di pot teras',
  },
  {
    name: 'Pak Hendra Gunawan',
    location: 'Tangerang, Banten',
    avatar: '/images/petani/petani-07.webp',
    problem: 'Takut bibit tanaman mati di jalan saat pengiriman online',
    comment:
      'Pengiriman COD cepat, bibit duku sampai dalam kondisi sangat segar dengan media tanam lembab. <strong class="box-decoration-clone bg-[#FFEACC] px-1.5 pb-0.5 font-semibold text-slate-950">Akar lebat & sambungan okulasi sangat rapi</strong>. Penjual amanah!',
    highlight: 'Bibit segar & garansi sampai',
  },
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={product.heroImage}
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
  breadcrumbs={[
    { name: 'Beranda', url: '/' },
    { name: 'Bibit Duku Longkong', url: '/bibit-duku-longkong' }
  ]}
  preloadImages={[
    {
      srcset: "/images/duku/duku-hero-400.webp 400w, /images/duku/duku-hero-600.webp 600w",
      sizes: "(max-width: 480px) 100vw, 480px"
    }
  ]}
>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950">
    <MetaLandingTracker slug="bibit-duku-longkong" productId={product.productId} contentName={product.contentName} price={product.price} />

    <!-- 1. URGENCY TOP BAR -->
    <div class="bg-[#EC7211] px-4 py-2.5 text-center">
      <p class="flex items-center justify-center gap-1.5 text-[12px] font-extrabold uppercase tracking-wide text-white">
        <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-white" aria-hidden="true" />
        PROMO BIBIT DUKU LONGKONG OKULASI: DISKON 50% GARANSI HIDUP & COD 99RB!
      </p>
    </div>

    <!-- 2. HERO SECTION & HERO FOTO PRODUK -->
    <section class="bg-white pb-8 text-center">
      <div class="px-5 pt-7">
        <div class="mx-auto mb-3 inline-flex items-center gap-1.5 rounded-full bg-[#FFF5E5] px-3.5 py-1 text-[11.5px] font-extrabold text-[#EC7211] border border-[#FFEACC]">
          <Icon name="lucide:sparkles" class="h-3.5 w-3.5 text-[#EC7211]" />
          VARIETAS DUKU LONGKONG THAILAND UNGGULAN
        </div>
        <h1 class="mx-auto max-w-[440px] text-[clamp(30px,8.5vw,35px)] font-extrabold leading-[1.14] tracking-tight text-slate-950">
          Berbuah Manis Legit <span class="hl-brush">Tanpa Biji & Genjah Lebat!</span>
        </h1>
        <p class="mx-auto mt-4 max-w-[400px] text-[16px] font-semibold leading-relaxed text-slate-700">
          Bibit Duku Longkong Thailand Super Manis. <strong class="font-bold text-slate-950">Daging bening tebal bagai kristal tanpa biji</strong> & <span class="font-bold text-slate-950 underline decoration-[#EC7211]/60 decoration-2 underline-offset-4">pohon sangat genjah, cepat berbuah lebat 2-3 tahun walau ditanam di pot teras rumah!</span>
        </p>
      </div>

      <!-- HERO IMAGE CONTAINER (PRESISI 1:1 FRAME SQUARE) -->
      <div class="mt-6 w-full overflow-hidden border-y border-slate-200 bg-white">
        <img
          src="/images/duku/duku-hero-600.webp"
          srcset="/images/duku/duku-hero-400.webp 400w, /images/duku/duku-hero-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Bibit Duku Longkong Thailand Super Manis Tanpa Biji Berbuah Lebat"
          class="w-full h-auto block object-contain mx-auto"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          width="540"
          height="540"
        />

        <div class="bg-slate-950 px-4 py-2.5 text-center">
          <p class="flex items-center justify-center gap-1.5 text-[12.5px] font-bold text-[#FFD699]">
            <Icon name="lucide:sprout" class="h-4 w-4 text-[#EC7211] shrink-0" aria-hidden="true" />
            <span>Hasil Okulasi Vegetatif • Daging Tebal Bening • Berbuah Genjah 2-3 Tahun!</span>
          </p>
        </div>
      </div>
    </section>

    <!-- 3. HIGHLIGHT SPECS BAR -->
    <section class="border-y border-orange-100 bg-[#FFF5E5]/60 px-5 py-5">
      <div class="grid grid-cols-2 gap-3 text-left">
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-3 shadow-xs">
          <Icon name="lucide:sparkles" class="mt-0.5 h-5 w-5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[11px] font-extrabold tracking-wide uppercase text-slate-400">RASA BUAH</p>
            <p class="text-[13.5px] font-extrabold text-slate-950">Super Manis Legit</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-3 shadow-xs">
          <Icon name="lucide:check-circle" class="mt-0.5 h-5 w-5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[11px] font-extrabold tracking-wide uppercase text-slate-400">BIJI BUAH</p>
            <p class="text-[13.5px] font-extrabold text-slate-950">Minim / Tanpa Biji</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-3 shadow-xs">
          <Icon name="lucide:calendar" class="mt-0.5 h-5 w-5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[11px] font-extrabold tracking-wide uppercase text-slate-400">MASA BERBUAH</p>
            <p class="text-[13.5px] font-extrabold text-slate-950">Genjah 2-3 Tahun</p>
          </div>
        </div>
        <div class="flex items-start gap-2.5 rounded-xl border border-orange-100 bg-white p-3 shadow-xs">
          <Icon name="lucide:truck" class="mt-0.5 h-5 w-5 shrink-0 text-[#EC7211]" />
          <div>
            <p class="text-[11px] font-extrabold tracking-wide uppercase text-slate-400">LAYANAN</p>
            <p class="text-[13.5px] font-extrabold text-slate-950">Garansi & COD</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 4. DETAIL SPESIFIKASI BIBIT & BUAH DUKU LONGKONG -->
    <section class="px-5 py-9 border-b border-slate-100">
      <div class="text-center">
        <span class="text-[11.5px] font-extrabold uppercase tracking-widest text-[#EC7211]">KEUNGGULAN VARIETAS</span>
        <h2 class={sectionTitle + ' mt-1.5'}>Detail Daging Buah & Bibit</h2>
        <p class={body + ' mt-2.5 font-medium'}>
          Kualitas duku kualitas super tanpa biji dengan daging buah bening tebal bagai kristal.
        </p>
      </div>

      <!-- FOTO INFOGRAFIS KEUNGGULAN DUKU -->
      <div class="mt-6 w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm">
        <img
          src="/images/duku/duku-infografis-600.webp"
          srcset="/images/duku/duku-infografis-400.webp 400w, /images/duku/duku-infografis-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Infografis Keunggulan Buah Duku Longkong Thailand Super Manis Tanpa Biji"
          class="w-full h-auto block object-contain max-h-[480px] mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>

      <!-- FOTO DAGING BUAH BENING TEBAL -->
      <div class="mt-4 w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm">
        <img
          src="/images/duku/duku-daging-600.webp"
          srcset="/images/duku/duku-daging-400.webp 400w, /images/duku/duku-daging-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Detail Daging Buah Duku Longkong Tebal Bening Tanpa Biji"
          class="w-full h-auto block object-contain max-h-[420px] mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>

      <div class="mt-5 rounded-2xl border border-slate-200 bg-slate-50 p-5 shadow-xs">
        <ul class="space-y-3.5 text-[14.5px] text-slate-800">
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
            <span class="text-slate-500 font-medium">Varietas Tanaman</span>
            <span class="font-bold text-slate-950">Duku Longkong Thailand Super</span>
          </li>
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
            <span class="text-slate-500 font-medium">Sistem Perbanyakan</span>
            <span class="font-bold text-slate-950">Okulasi Sambung Vegetatif Unggul</span>
          </li>
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
            <span class="text-slate-500 font-medium">Tinggi Bibit Dikirim</span>
            <span class="font-bold text-slate-950">50 - 70 cm (Siap Tanam)</span>
          </li>
          <li class="flex items-center justify-between border-b border-slate-200/80 pb-2.5">
            <span class="text-slate-500 font-medium">Estimasi Berbuah</span>
            <span class="font-bold text-slate-950">2 - 3 Tahun Sejak Tanam</span>
          </li>
          <li class="flex items-center justify-between">
            <span class="text-slate-500 font-medium">Kebutuhan Lahan</span>
            <span class="font-bold text-slate-950">Tabulampot Pot Teras / Pekarangan</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- 5. ALASAN MEMILIH DUKU LONGKONG (OVERCLAIM SECTION) -->
    <section class="px-5 py-9 border-b border-slate-100 bg-slate-50/50">
      <div class="text-center">
        <span class="text-[11.5px] font-extrabold uppercase tracking-widest text-[#EC7211]">KENAPA HARUS TANAM DUKU LONGKONG?</span>
        <h2 class={sectionTitle + ' mt-1.5'}>4 Alasan Pilih Duku Longkong</h2>
        <p class={body + ' mt-2 font-medium'}>Perbandingan keunggulan dibanding duku lokal biasa:</p>
      </div>

      <!-- FOTO POHON BERBUAH LEBAT & DOMPOLAN -->
      <div class="mt-6 grid grid-cols-2 gap-3">
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xs">
          <img
            src="/images/duku/duku-lebat-600.webp"
            srcset="/images/duku/duku-lebat-400.webp 400w, /images/duku/duku-lebat-600.webp 600w"
            sizes="(max-width: 480px) 100vw, 480px"
            alt="Pohon Duku Longkong Berbuah Lebat di Pot"
            class="w-full h-[150px] object-cover"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="540"
            height="540"
          />
          <div class="p-2.5 text-center">
            <p class="text-[12.5px] font-bold text-slate-950">Berbuah Lebat Rimbun</p>
          </div>
        </div>

        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-2xs">
          <img
            src="/images/duku/duku-dompolan-600.webp"
            srcset="/images/duku/duku-dompolan-400.webp 400w, /images/duku/duku-dompolan-600.webp 600w"
            sizes="(max-width: 480px) 100vw, 480px"
            alt="Dompolan Buah Duku Longkong Super Manis"
            class="w-full h-[150px] object-cover"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="540"
            height="540"
          />
          <div class="p-2.5 text-center">
            <p class="text-[12.5px] font-bold text-slate-950">Dompolan Buah Banyak</p>
          </div>
        </div>
      </div>

      <div class="mt-6 space-y-3.5">
        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Daging Bening Tebal & Tanpa Biji Pahit</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Sensasi menikmati duku utuh yang juicy tanpa perlu khawatir menggigit biji pahit yang mengganggu.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Rasa Super Manis Legit (Brix 20+)</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Manis alami tinggi tanpa rasa rasa asam/sepat di lidah walau buah belum terlalu matang.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Pohon Sangat Genjah Berbuah (2-3 Tahun)</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Hasil okulasi batang unggul membuat tanaman cepat belajar berbuah tanpa menunggu belasan tahun.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-3.5 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-xs">
          <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-600 font-bold text-[14px]">
            ✓
          </div>
          <div>
            <h3 class="text-[15.5px] font-bold text-slate-950">Sangat Cocok Untuk Tabulampot & Kebun</h3>
            <p class="mt-1 text-[14px] leading-relaxed text-slate-600">
              Akar tanaman cepat adaptif di pot teras rumah maupun lahan pekarangan minim air.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 6. BIBIT OKULASI SIAP TANAM -->
    <section class="px-5 py-9 border-b border-slate-100">
      <div class="text-center">
        <span class="text-[11.5px] font-extrabold uppercase tracking-widest text-[#EC7211]">GARANSI BIBIT UNGGUL</span>
        <h2 class={sectionTitle + ' mt-1.5'}>Bibit Okulasi Siap Kirim</h2>
        <p class={body + ' mt-2 font-medium'}>Bibit sehat dengan perakaran kuat & batang kokoh siap tanam:</p>
      </div>

      <!-- FOTO BIBIT OKULASI SIAP KIRIM -->
      <div class="mt-6 w-full overflow-hidden rounded-2xl border border-slate-200 bg-slate-50 shadow-sm">
        <img
          src="/images/duku/duku-bibit-okulasi-600.webp"
          srcset="/images/duku/duku-bibit-okulasi-400.webp 400w, /images/duku/duku-bibit-okulasi-600.webp 600w"
          sizes="(max-width: 480px) 100vw, 480px"
          alt="Foto Bibit Duku Longkong Okulasi Unggul Siap Kirim"
          class="w-full h-auto block object-contain max-h-[480px] mx-auto"
          loading="lazy"
          decoding="async"
          fetchpriority="low"
          width="540"
          height="540"
        />
      </div>
    </section>

    <!-- 7. TESTIMONIALS PELANGGAN -->
    <section class="px-5 py-9 border-b border-slate-100 bg-slate-50/50">
      <div class="text-center">
        <span class="text-[11.5px] font-extrabold uppercase tracking-widest text-[#EC7211]">ULASAN PEMBELI</span>
        <h2 class={sectionTitle + ' mt-1.5'}>Testimoni Pembeli Real</h2>
      </div>

      <div class="mt-6 space-y-4">
        {testimonials.map((t) => (
          <div class="rounded-2xl border border-slate-200/80 bg-white p-4.5 shadow-xs">
            <div class="flex items-center gap-3">
              <img src={t.avatar} alt={t.name} class="h-10 w-10 rounded-full object-cover ring-2 ring-orange-100" loading="lazy" decoding="async" width="40" height="40" />
              <div>
                <h3 class="text-[14.5px] font-bold text-slate-950">{t.name}</h3>
                <p class="text-[12px] text-slate-500">{t.location}</p>
              </div>
            </div>
            <div class="mt-3 rounded-xl bg-[#FFF5E5]/70 p-3 text-[13.5px] leading-relaxed text-slate-700">
              <p set:html={t.comment} />
            </div>
            <div class="mt-2.5 flex items-center justify-between text-[11.5px]">
              <span class="font-bold text-[#EC7211]">✓ {t.highlight}</span>
              <span class="font-semibold text-slate-400">Pembeli Terverifikasi</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 8. SOCIAL PROOF DYNAMIC -->
    <SocialProof productSlug="bibit-duku-longkong" />

    <!-- 9. PRICING & HARGA SECTION (CHECKOUT FORM) -->
    <section id="checkout" class="border-t-8 border-slate-100 bg-white py-12">
      <div class="px-5 pb-8 text-center">
        <p class="mx-auto mb-3 inline-flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-[0.14em] text-[#EC7211]">
          <Icon name="lucide:zap" class="h-4 w-4 shrink-0 text-[#EC7211]" aria-hidden="true" />
          Promo Bibit Duku Longkong COD
        </p>
        <h2 class="mx-auto max-w-[340px] text-[clamp(28px,7.2vw,32px)] font-extrabold leading-[1.12] tracking-tight text-slate-950">
          Isi Alamat Pengiriman, <span class="hl-brush">Bayar Saat Sampai</span>
        </h2>
        <p class="mx-auto mt-4 max-w-[320px] text-[15px] leading-relaxed text-slate-600">
          Form otomatis menyesuaikan lokasi Anda. Bibit dikirim aman bergaransi hidup, bayar tunai ke kurir saat barang tiba.
        </p>
      </div>

      <!-- FOTO BANNER GARANSI BIBIT -->
      <div class="mx-auto mb-6 max-w-[440px] px-5">
        <div class="overflow-hidden rounded-2xl border border-slate-200 shadow-sm">
          <img
            src="/images/duku/duku-garansi-600.webp"
            srcset="/images/duku/duku-garansi-400.webp 400w, /images/duku/duku-garansi-600.webp 600w"
            sizes="(max-width: 480px) 100vw, 480px"
            alt="Banner Garansi Bibit Duku Longkong Cepat Berbuah COD"
            class="w-full h-auto block object-contain max-h-[450px] mx-auto"
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            width="540"
            height="540"
          />
        </div>
      </div>

      <div class="mx-auto mb-6 max-w-[380px] px-5 text-center">
        <div class="rounded-2xl border-2 border-[#EC7211] bg-[#FFF5E5]/40 p-4">
          <p class="text-[12px] font-bold text-[#EC7211] uppercase tracking-wider">HARGA PROMO SPESIAL</p>
          <div class="mt-1 flex items-baseline justify-center gap-2">
            <span class="text-[14px] text-slate-400 line-through">Rp 250.000</span>
            <span class="text-[28px] font-black text-slate-950">Rp 99.000</span>
          </div>
          <p class="mt-0.5 text-[12px] font-medium text-slate-600">Beli 1 Pohon Rp 99.000 • 2 Pohon Rp 149.000 • 3 Pohon Rp 199.000</p>
        </div>
      </div>

      <GeoIpResolvedForm mode={formContext.mode} productSlug="bibit-duku-longkong" embedded={true} />
    </section>

    <!-- 10. FOOTER -->
    <LpMiniFooter />

    <!-- 11. STICKY CTA MOBILE -->
    <StickyCTA productSlug="bibit-duku-longkong" />
  </main>
</BaseLayout>

<style>
  .hl-brush {
    -webkit-box-decoration-break: clone;
