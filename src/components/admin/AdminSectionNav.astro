---
type Item = { href: string; label: string; description?: string };
interface Props {
  label: string;
  items: Item[];
}

const { label, items } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<nav class="rounded-xl border border-slate-200 bg-white p-1.5 shadow-sm" aria-label={label}>
  <div class="flex flex-wrap gap-1">
    {items.map((item) => {
      const active = currentPath === item.href;
      return (
        <a
          href={item.href}
          aria-current={active ? 'page' : undefined}
          class={`inline-flex min-h-11 items-center rounded-xl px-4 py-2 text-xs font-black transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600 ${active ? 'bg-slate-950 text-white shadow-sm' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-950'}`}
        >
          {item.label}
        </a>
      );
    })}
  </div>
</nav>
