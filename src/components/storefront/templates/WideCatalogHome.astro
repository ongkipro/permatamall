---
import type { TenantHomeContent } from '../../../lib/tenant-content';

interface ProductCard {
  name: string;
  category: string;
  description: string;
  href: string;
  image: string;
  price: number;
  comparePrice: number;
  variants: Array<{ label: string; price: number }>;
}

interface Props {
  content: TenantHomeContent;
  products: ProductCard[];
  tenantName: string;
  logo: string;
  accent: string;
}

const { content, products, tenantName, logo, accent } = Astro.props;
const featuredProduct = products[0];
const formatPrice = (value: number) => `IDR ${value.toLocaleString('id-ID')}`;
const shortVariantLabel = (label: string) => label.split(' - ').at(-1) || label;
---

<div class="min-h-screen bg-[#f7f8f3] text-slate-950" style={`--tenant-accent:${accent}`}>
  <header class="border-b border-slate-900/10 bg-[#f7f8f3]">
    <div class="mx-auto flex min-h-20 max-w-7xl items-center justify-between gap-6 px-5 py-4 md:px-10">
      <a href="/" class="inline-flex min-h-11 items-center gap-3 rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--tenant-accent)]">
        <span class="text-xl font-black tracking-tight">{tenantName}</span>
      </a>
      <nav aria-label="Navigasi utama" class="flex items-center gap-2 sm:gap-5">
        <a href="#produk" class="inline-flex min-h-11 items-center px-2 text-sm font-bold text-slate-700 hover:text-slate-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--tenant-accent)]">Produk</a>
        <a href="/kontak" class="inline-flex min-h-11 items-center rounded-md px-4 text-sm font-black text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2" style="background:var(--tenant-accent)">Kontak</a>
      </nav>
    </div>
  </header>

  <main id="konten-utama">
    <section class="mx-auto grid max-w-7xl gap-10 px-5 py-12 md:grid-cols-[1.05fr_0.95fr] md:items-center md:px-10 md:py-20">
      <div class="max-w-2xl">
        <p class="text-sm font-black uppercase tracking-[0.16em]" style="color:var(--tenant-accent)">{content.hero.ratingLabel}</p>
        <h1 class="mt-4 text-[clamp(2.5rem,2rem+2.5vw,5rem)] font-black leading-[0.98] tracking-[-0.055em]">
          {content.hero.title}
        </h1>
        <p class="mt-6 max-w-[58ch] text-base leading-7 text-slate-600 md:text-lg">
          {content.hero.description}
        </p>
        <a href="#produk" class="mt-8 inline-flex min-h-12 items-center rounded-md px-5 text-sm font-black text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2" style="background:var(--tenant-accent)">
          Lihat katalog
        </a>
      </div>
      {featuredProduct && (
        <a href={featuredProduct.href} class="group block overflow-hidden rounded-xl border border-slate-900/10 bg-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--tenant-accent)]">
          <img src={featuredProduct.image} alt={`Gambar produk ${featuredProduct.name}`} class="aspect-[4/3] w-full object-contain p-6 transition-transform duration-200 group-hover:scale-[1.02]" />
          <div class="border-t border-slate-900/10 p-5">
            <p class="text-xs font-black uppercase tracking-[0.12em]" style="color:var(--tenant-accent)">{featuredProduct.category}</p>
            <h2 class="mt-2 text-xl font-black">{featuredProduct.name}</h2>
            <p class="mt-2 text-sm leading-6 text-slate-600">{featuredProduct.description}</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {featuredProduct.variants.map((variant) => (
                <span class="rounded-md bg-[#eef0e8] px-2.5 py-1.5 text-xs font-bold text-slate-700">
                  {shortVariantLabel(variant.label)}
                </span>
              ))}
            </div>
            <p class="mt-5 text-lg font-black">Mulai {formatPrice(featuredProduct.price)}</p>
          </div>
        </a>
      )}
    </section>

    <section id="produk" class="border-y border-slate-900/10 bg-[#eef0e8]">
      <div class="mx-auto max-w-7xl px-5 py-12 md:px-10 md:py-16">
        <div class="max-w-xl">
          <h2 class="text-3xl font-black tracking-[-0.035em] md:text-4xl">{content.catalog.title}</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">{content.catalog.description}</p>
        </div>
        <div class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(min(100%,16rem),1fr))] gap-5">
          {products.map((product) => (
            <article class="flex flex-col border-t-2 border-slate-900 bg-[#f7f8f3]">
              <a href={product.href} class="group block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--tenant-accent)]">
                <img src={product.image} alt={`Gambar produk ${product.name}`} class="aspect-square w-full bg-white object-contain p-5 transition-transform duration-200 group-hover:scale-[1.02]" loading="lazy" />
              </a>
              <div class="flex flex-1 flex-col p-5">
                <p class="text-xs font-black uppercase tracking-[0.12em]" style="color:var(--tenant-accent)">{product.category}</p>
                <h3 class="mt-2 text-lg font-black"><a href={product.href}>{product.name}</a></h3>
                <p class="mt-2 line-clamp-3 text-sm leading-6 text-slate-600">{product.description}</p>
                <p class="mt-4 text-xs font-bold text-slate-500">
                  {product.variants.map((variant) => shortVariantLabel(variant.label)).join(' dan ')}
                </p>
                <div class="mt-auto flex items-end justify-between gap-4 pt-6">
                  <p class="text-lg font-black">Mulai {formatPrice(product.price)}</p>
                  <a href={product.href} class="inline-flex min-h-11 items-center text-sm font-black underline decoration-2 underline-offset-4 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--tenant-accent)]">Detail</a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-5 py-12 md:px-10 md:py-16">
      <h2 class="text-3xl font-black tracking-[-0.035em]">{content.solutionsHeading.title}</h2>
      <div class="mt-8 grid gap-x-8 border-t border-slate-900/15 md:grid-cols-3">
        {content.solutions.slice(0, 3).map((solution) => (
          <a href={solution.href} class="group border-b border-slate-900/15 py-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--tenant-accent)]">
            <p class="text-xs font-black uppercase tracking-[0.12em]" style="color:var(--tenant-accent)">{solution.crop}</p>
            <h3 class="mt-2 text-xl font-black leading-tight group-hover:underline">{solution.title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{solution.excerpt}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer class="border-t border-slate-900/10 px-5 py-8 text-center text-sm text-slate-600">
    <nav aria-label="Informasi toko" class="mb-4 flex flex-wrap justify-center gap-x-5 gap-y-3 text-xs font-bold">
      <a href="/kebijakan-privasi" class="underline-offset-4 hover:underline">Kebijakan Privasi</a>
      <a href="/syarat-ketentuan" class="underline-offset-4 hover:underline">Syarat & Ketentuan</a>
      <a href="/pengiriman" class="underline-offset-4 hover:underline">Pengiriman</a>
      <a href="/kontak" class="underline-offset-4 hover:underline">Kontak</a>
    </nav>
    <p>&copy; {new Date().getFullYear()} {tenantName}. Hak Cipta Dilindungi.</p>
  </footer>
</div>
