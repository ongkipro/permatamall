---
import SiteBrand from './SiteBrand.astro';
import { tenantConfig } from '../../lib/tenant';

const footerLegal = [
  { label: 'Kebijakan Privasi', href: '/kebijakan-privasi' },
  { label: 'Syarat & Ketentuan', href: '/syarat-ketentuan' },
  { label: 'Pengiriman & Retur', href: '/pengiriman' },
  { label: 'Kontak', href: '/kontak' },
];
---

<footer class="relative border-t border-zinc-200 bg-zinc-950 px-5 py-12 text-zinc-400">
  <div class:list={['mx-auto space-y-6 text-center', tenantConfig.storefrontTemplate === 'wide-catalog' ? 'max-w-7xl' : 'max-w-[480px]']}>
    <!-- Brand Logo -->
    <div class="flex justify-center brightness-200 contrast-200">
      <SiteBrand href="/" />
    </div>

    <!-- Tagline -->
    <p class="mx-auto max-w-[420px] text-xs leading-relaxed text-zinc-400 font-normal">
      {tenantConfig.description || 'Pusat belanja koleksi tas wanita & produk pilihan berkualitas tinggi. Pengiriman COD cepat dan garansi originalitas 100%.'}
    </p>

    <!-- Policy Links -->
    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 border-t border-zinc-800/80 pt-6 text-[11px] font-semibold tracking-wider uppercase text-zinc-300">
      {
        footerLegal.map((item) => (
          <a href={item.href} class="transition-colors hover:text-white">
            {item.label}
          </a>
        ))
      }
    </div>

    <!-- Copyright -->
    <p class="text-[11px] text-zinc-500">
      © {new Date().getFullYear()} {tenantConfig.name}. All Rights Reserved.
    </p>
  </div>
</footer>
