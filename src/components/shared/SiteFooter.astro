---
import SiteBrand from './SiteBrand.astro';
import { tenantConfig } from '../../lib/tenant';

const footerLegal = [
  { label: 'Kebijakan Privasi', href: '/kebijakan-privasi' },
  { label: 'Syarat & Ketentuan', href: '/syarat-ketentuan' },
  { label: 'Pengiriman & Retur', href: '/pengiriman' },
  { label: 'Kontak', href: '/kontak' },
];
---

<footer class="relative border-t border-slate-100 bg-white px-5 py-8 text-slate-500">
  <div class:list={['mx-auto space-y-4 text-center', tenantConfig.storefrontTemplate === 'wide-catalog' ? 'max-w-7xl' : 'max-w-[480px]']}>
    <!-- Brand Logo -->
    <div class="flex justify-center">
      <SiteBrand href="/" />
    </div>

    <!-- Tagline -->
    <p class="mx-auto max-w-[340px] text-xs leading-relaxed text-slate-500 font-normal">
      {tenantConfig.description}
    </p>

    <!-- Policy Links -->
    <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2 border-t border-slate-100 pt-4 text-[11px] font-semibold text-slate-600">
      {
        footerLegal.map((item) => (
          <a href={item.href} class="transition-colors hover:text-slate-900">
            {item.label}
          </a>
        ))
      }
    </div>

    <!-- Copyright -->
    <p class="text-[10px] text-slate-400">
      © {new Date().getFullYear()} {tenantConfig.name}. Hak Cipta Dilindungi.
    </p>
  </div>
</footer>
