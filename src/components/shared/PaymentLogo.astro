---
import {
  normalizePaymentBrandCode,
  paymentBrandAsset,
  paymentBrandLabel,
} from '../../lib/payment-brand';

interface Props {
  channel: string;
  class?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
}

const { channel, class: className = '', size = 'md' } = Astro.props;
const code = normalizePaymentBrandCode(channel);
const asset = paymentBrandAsset(code);
const label = paymentBrandLabel(code);
const sizeClass = {
  sm: 'h-5 w-12',
  md: 'h-7 w-16',
  lg: 'h-9 w-20',
  xl: 'h-11 w-24',
}[size];
---

<div class={`inline-flex shrink-0 items-center justify-center ${className}`}>
  {asset ? (
    <img
      src={asset}
      alt={label}
      width="96"
      height="64"
      loading="eager"
      class={`${sizeClass} object-contain`}
    />
  ) : (
    <span class={`${sizeClass} inline-flex items-center justify-center rounded-lg border border-slate-200 bg-white px-2 text-xs font-black uppercase text-slate-700`}>
      {code || 'BAYAR'}
    </span>
  )}
</div>
