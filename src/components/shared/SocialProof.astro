---
import Icon from './Icon.astro';
import { getStorefrontProduct } from '../../lib/catalog';

interface Props {
  /** Stable editorial product key. Name and thumbnail resolve from the operational catalog. */
  productSlug?: string;
  /**
   * Override nama yang tampil. Kosongkan kecuali LP benar-benar menjual
   * varian/paket berbeda. JANGAN dipakai untuk menempelkan nama komoditas
   * (mis. "Saratoga Padi") — itu mengarang SKU yang tidak ada di katalog.
   */
  label?: string;
  /** Override thumbnail. Default: foto produk dari katalog. */
  image?: string;
}

const { productSlug, label, image } = Astro.props;

// Use the same operational product identity as checkout and the public catalog.
const product = productSlug ? await getStorefrontProduct(Astro.locals, productSlug) : null;
if (!product) throw new Error(`SocialProof: produk "${productSlug}" tidak tersedia`);

const productLabel = label ?? product.productName;
const thumb = image ?? product.image;
---

{
  /*
  Toast pemberitahuan pembelian. Sengaja aria-hidden: isinya persuasi marketing,
  bukan informasi fungsional, dan pengumuman berulang akan mengganggu pengguna
  screen reader. Karena aria-hidden, JANGAN menaruh elemen fokusable di dalamnya.
  pointer-events-none dipertahankan PERMANEN supaya toast tidak pernah mencegat
  tap pengguna di area atas layar.
*/
}
<div
  data-social-proof
  aria-hidden="true"
  class="pointer-events-none fixed top-4 left-1/2 z-50 w-[calc(100%-2rem)] max-w-[360px] -translate-x-1/2 -translate-y-16 scale-95 opacity-0"
>
  <div
    class="flex items-center gap-3 rounded-full border border-slate-200/60 bg-white/90 p-2 pr-4 shadow-[0_12px_24px_rgba(0,0,0,0.06),0_4px_12px_rgba(0,0,0,0.03)] backdrop-blur-md"
  >
    <!-- Thumbnail produk (menggantikan ikon generik) -->
    <div
      class="grid h-10 w-10 shrink-0 place-items-center overflow-hidden rounded-full bg-slate-50 ring-1 ring-slate-200/70"
    >
      <img
        src={thumb}
        alt=""
        width="40"
        height="40"
        class="h-full w-full object-contain p-[3px]"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="min-w-0 flex-1 text-left">
      <div class="flex items-center gap-1">
        <span class="truncate text-[12.5px] font-bold text-slate-900" data-buyer-name></span>
        <span class="inline-flex shrink-0 text-[#C5A880]">
          <Icon name="lucide:badge-check" class="h-4 w-4" />
        </span>
        <span class="ml-auto shrink-0 text-[10.5px] font-medium text-slate-500" data-buyer-time></span>
      </div>
      <p class="mt-0.5 truncate text-[11.5px] leading-tight text-slate-600">
        Baru saja memesan <strong class="font-semibold text-[#111111]">{productLabel}</strong><span
          data-buyer-location></span>
      </p>
    </div>
  </div>
</div>

<style>
  [data-social-proof] {
    transition:
      transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.4s ease;
  }

  /* Hormati preferensi sistem: tanpa gerakan melenting, cukup fade. */
  @media (prefers-reduced-motion: reduce) {
    [data-social-proof] {
      transition: opacity 0.2s ease;
    }
  }
</style>

<script>
  const initSocialProof = () => {
    const toast = document.querySelector('[data-social-proof]');
    if (!toast) return;

    const mainElement = document.querySelector('main');
    if (!mainElement) return;

    const hero = mainElement.querySelector('section:first-of-type') || mainElement.firstElementChild;
    const checkout = document.getElementById('checkout');

    const buyers = [
      { name: 'Pak Supardi', location: 'Subang, Jawa Barat', time: 'Baru saja' },
      { name: 'Haji Budi Santoso', location: 'Sragen, Jawa Tengah', time: '2 mnt lalu' },
      { name: 'Ibu Sumarni', location: 'Sidrap, Sulawesi Selatan', time: '1 mnt lalu' },
      { name: 'Pak Joko', location: 'Sleman, DI Yogyakarta', time: '5 mnt lalu' },
      { name: 'Pak Nyoman', location: 'Tabanan, Bali', time: '3 mnt lalu' },
      { name: 'Pak Ahmad', location: 'Deli Serdang, Sumut', time: '4 mnt lalu' },
      { name: 'Pak Ujang', location: 'Cianjur, Jawa Barat', time: '7 mnt lalu' },
      { name: 'Pak Wayan', location: 'Gianyar, Bali', time: 'Baru saja' },
      { name: 'Pak Sutrisno', location: 'Ngawi, Jawa Timur', time: '6 mnt lalu' },
      { name: 'Pak Bambang', location: 'Karanganyar, Jateng', time: '2 mnt lalu' },
      { name: 'Ibu Halimah', location: 'Kampar, Riau', time: '8 mnt lalu' },
      { name: 'Pak Mansur', location: 'Pinrang, Sulsel', time: '3 mnt lalu' },
      { name: 'Pak Dadang', location: 'Garut, Jawa Barat', time: '5 mnt lalu' },
      { name: 'Pak Made', location: 'Badung, Bali', time: '1 mnt lalu' },
      { name: 'Pak Sugeng', location: 'Nganjuk, Jawa Timur', time: '9 mnt lalu' },
      { name: 'Pak Ridwan', location: 'Kutai Kartanegara', time: '4 mnt lalu' },
      { name: 'Pak Slamet', location: 'Banyuwangi, Jatim', time: 'Baru saja' },
      { name: 'Ibu Warsiah', location: 'Indramayu, Jawa Barat', time: '6 mnt lalu' },
      { name: 'Pak Arifin', location: 'Wajo, Sulawesi Selatan', time: '2 mnt lalu' },
      { name: 'Pak Gunawan', location: 'Klaten, Jawa Tengah', time: '5 mnt lalu' },
    ];

    // Fisher-Yates. `sort(() => Math.random() - 0.5)` bukan shuffle seragam:
    // comparator-nya tidak konsisten, sebagian urutan jauh lebih sering muncul.
    const shuffled = [...buyers];
    for (let i = shuffled.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
    }

    let currentIndex = 0;
    let isHeroVisible = true;
    let isCheckoutVisible = false;
    let isFormFocused = false;
    let isToastShowing = false;
    let timerId: ReturnType<typeof setTimeout> | null = null;

    const nameEl = toast.querySelector('[data-buyer-name]');
    const locEl = toast.querySelector('[data-buyer-location]');
    const timeEl = toast.querySelector('[data-buyer-time]');

    const clearTimer = () => {
      if (timerId) clearTimeout(timerId);
      timerId = null;
    };

    // Tab tidak aktif ikut memblokir: percuma menampilkan toast di tab tersembunyi.
    const isBlocked = () => isHeroVisible || isCheckoutVisible || isFormFocused || document.hidden;

    const showToast = () => {
      clearTimer();
      if (isBlocked()) {
        timerId = setTimeout(showToast, 3000);
        return;
      }

      const buyer = shuffled[currentIndex];
      if (nameEl) nameEl.textContent = buyer.name;
      if (locEl) locEl.textContent = ` • ${buyer.location}`;
      if (timeEl) timeEl.textContent = buyer.time;

      toast.classList.remove('opacity-0', '-translate-y-16', 'scale-95');
      toast.classList.add('opacity-100', 'translate-y-0', 'scale-100');
      isToastShowing = true;

      const duration = Math.floor(Math.random() * (15000 - 8000 + 1)) + 8000;
      timerId = setTimeout(() => {
        hideToast();
        const delayNext = Math.floor(Math.random() * (10000 - 5000 + 1)) + 5000;
        currentIndex = (currentIndex + 1) % shuffled.length;
        timerId = setTimeout(showToast, delayNext);
      }, duration);
    };

    const hideToast = () => {
      toast.classList.add('opacity-0', '-translate-y-16', 'scale-95');
      toast.classList.remove('opacity-100', 'translate-y-0', 'scale-100');
      isToastShowing = false;
      clearTimer();
    };

    const handleVisibilityUpdate = () => {
      if (isBlocked()) {
        if (isToastShowing) hideToast();
      } else if (!isToastShowing) {
        showToast();
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.target === hero) isHeroVisible = entry.isIntersecting;
          if (entry.target === checkout) isCheckoutVisible = entry.isIntersecting;
        });
        handleVisibilityUpdate();
      },
      { root: null, threshold: 0.05 },
    );

    if (hero) observer.observe(hero);
    if (checkout) observer.observe(checkout);

    document.addEventListener('visibilitychange', handleVisibilityUpdate);

    if (checkout) {
      const formFields = checkout.querySelectorAll('input, textarea, select');
      formFields.forEach((field) => {
        field.addEventListener('focus', () => {
          isFormFocused = true;
          handleVisibilityUpdate();
        });
        field.addEventListener('blur', () => {
          setTimeout(() => {
            const active = document.activeElement;
            if (!active || !checkout.contains(active)) {
              isFormFocused = false;
              handleVisibilityUpdate();
            }
          }, 100);
        });
      });
    }

    showToast();
  };

  // Ditunda 2 detik setelah load agar tidak mengganggu metrik LCP/INP.
  if (document.readyState === 'complete') {
    setTimeout(initSocialProof, 2000);
  } else {
    window.addEventListener('load', () => setTimeout(initSocialProof, 2000));
  }
</script>
