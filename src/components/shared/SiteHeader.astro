---
import SiteBrand from './SiteBrand.astro';
import { tenantConfig } from '../../lib/tenant';

const isWide = tenantConfig.storefrontTemplate === 'wide-catalog';
---

<div
  class="border-b px-4 py-2 text-center text-xs font-semibold text-white"
  style={`background-color:${tenantConfig.themeColor};border-color:color-mix(in srgb, ${tenantConfig.themeColor}, black 18%)`}
>
  <p class:list={['mx-auto px-1', isWide ? 'max-w-7xl' : 'max-w-[480px]']}>{tenantConfig.tagline}</p>
</div>

<header class="relative border-b border-slate-100 bg-white">
  <div
    class:list={[
      'mx-auto flex h-16 items-center px-5',
      isWide ? 'max-w-7xl justify-between md:px-10' : 'max-w-[480px] justify-center',
    ]}
  >
    <SiteBrand href="/" showTagline={!isWide} />
    {
      isWide && (
        <nav aria-label="Navigasi utama" class="flex items-center gap-2 sm:gap-5">
          <a
            href="/#produk"
            class="hidden min-h-11 items-center px-2 text-sm font-bold text-slate-700 hover:text-slate-950 focus-visible:outline-none focus-visible:ring-2 sm:inline-flex"
            style={`--tw-ring-color:${tenantConfig.themeColor}`}
          >
            Produk
          </a>
          <a
            href="/kontak"
            class="inline-flex min-h-11 items-center rounded-md px-4 text-sm font-black text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2"
            style={`background-color:${tenantConfig.themeColor};--tw-ring-color:${tenantConfig.themeColor}`}
          >
            Kontak
          </a>
        </nav>
      )
    }
  </div>
</header>
