---
interface Props {
  item: {
    title: string;
    excerpt: string;
    image: string;
    href?: string;
    category: string;
    isAvailable?: boolean;
    statusLabel?: string;
  };
  featured?: boolean;
}

const { item, featured = false } = Astro.props;
const isAvailable = item.isAvailable !== false && Boolean(item.href);
const statusLabel = item.statusLabel || (isAvailable ? 'Live' : 'Segera Hadir');
const Wrapper = isAvailable ? 'a' : 'div';
const wrapperProps = isAvailable
  ? { href: item.href, title: `Buka solusi ${item.title}` }
  : { 'aria-label': `${item.title} segera hadir` };
const categoryTone = item.category === 'Jagung' ? '#B45309' : item.category === 'Sawit' ? '#8B1E1E' : '#0F2A5F';
---

<article class="border-b border-[#E5E7EB] last:border-b-0">
  <Wrapper
    {...wrapperProps}
    class:list={[
      'group block py-5 transition-opacity',
      isAvailable ? 'opacity-100' : 'opacity-90',
      featured ? 'pt-0' : '',
    ]}
  >
    <div class="relative aspect-[3/2] overflow-hidden rounded-[14px] bg-slate-100">
      <img
        src={item.image}
        alt={`Visual solusi ${item.title}`}
        width="480"
        height="320"
        class:list={[
          'h-full w-full object-cover transition-transform duration-300',
          isAvailable ? 'group-hover:scale-[1.025]' : 'saturate-[0.9]',
        ]}
        loading={featured ? 'eager' : 'lazy'}
        decoding="async"
      />
      <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-slate-950/70 via-slate-950/18 to-transparent p-3">
        <div class="flex flex-wrap items-center gap-2">
          <span
            class="inline-flex rounded-md bg-white/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] backdrop-blur-sm"
            style={`color: ${categoryTone}`}
          >
            {item.category}
          </span>
          <span
            class:list={[
              'inline-flex rounded-md px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.12em] backdrop-blur-sm',
              isAvailable ? 'bg-[#D9F99D] text-[#1B5E20]' : 'bg-white/88 text-slate-500',
            ]}
          >
            {statusLabel}
          </span>
        </div>
      </div>
    </div>

    <div class="pt-3">
      <h2
        class:list={[
          'font-semibold leading-[1.28] tracking-[-0.02em] text-[#263238]',
          featured ? 'text-[21px]' : 'text-[19px]',
        ]}
      >
        {item.title}
      </h2>
      <p class="mt-2 text-[13px] leading-6 text-[#616161]">{item.excerpt}</p>

      {
        isAvailable ? (
          <p class="mt-2.5 inline-flex items-center gap-1.5 text-[12px] font-semibold text-slate-700 underline decoration-slate-300 underline-offset-4">
            Lihat detail solusi
          </p>
        ) : (
          <p class="mt-2.5 text-[12px] font-bold text-slate-400">Segera hadir</p>
        )
      }
    </div>
  </Wrapper>
</article>
