---
import Icon from './Icon.astro';

interface Props {
  productSlug?: string; label?: string; targetId?: string;
}

const { productSlug, label, targetId = 'order-form' } = Astro.props;

// Determine colors based on product slug
const themeConfig = {
  aussie: {
    bg: 'bg-[#8B1E1E] hover:bg-[#701A1A] active:bg-[#5C1515]',
    shadow: 'shadow-[#8B1E1E]/20',
    icon: 'lucide:arrow-down',
    label: 'Pesan Aussie',
  },
  bensu: {
    bg: 'bg-[#0F2A5F] hover:bg-[#0C224C] active:bg-[#09193A]',
    shadow: 'shadow-[#0F2A5F]/20',
    icon: 'lucide:arrow-down',
    label: 'Pesan Bensu',
  },
  saratoga: {
    bg: 'bg-[#14532D] hover:bg-[#0F3F22] active:bg-[#0B3019]',
    shadow: 'shadow-[#14532D]/20',
    icon: 'lucide:arrow-down',
    label: 'Pesan Saratoga',
  },
  kojien: {
    bg: 'bg-[#0F2A5F] hover:bg-[#0C224C] active:bg-[#09193A]',
    shadow: 'shadow-[#0F2A5F]/20',
    icon: 'lucide:arrow-down',
    label: 'Pesan Kojien',
  },
};

const theme = (productSlug && (themeConfig as any)[productSlug]) || { bg: 'bg-[#14532D]', shadow: 'shadow-[#14532D]/20', icon: 'lucide:arrow-down', label: label || 'Pesan Sekarang' };
---

<div
  data-sticky-cta
  data-target-id={targetId}
  class="fixed bottom-5 left-1/2 z-40 w-[calc(100%-2rem)] max-w-[440px] -translate-x-1/2 translate-y-10 opacity-0 pointer-events-none transition-all duration-500 cubic-bezier(0.16, 1, 0.3, 1)"
>
  <button
    type="button"
    class={`flex w-full items-center justify-center gap-2.5 ${theme.bg} ${theme.shadow} rounded-2xl px-6 py-4 text-white shadow-xl transition duration-200 active:scale-98`}
    aria-label={theme.label}
  >
    <!-- Pulse online dot -->
    <span class="relative flex h-2 w-2 shrink-0">
      <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
      <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span>
    </span>

    <span class="text-[15px] font-bold tracking-wide whitespace-nowrap">{theme.label}</span>

    <Icon name={theme.icon} class="h-5 w-5 text-white shrink-0 animate-bounce-slow" />
  </button>
</div>

<style>
  @keyframes bounce-slow {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-2px);
    }
  }
  .animate-bounce-slow {
    animation: bounce-slow 2s infinite ease-in-out;
  }
</style>

<script>
  const initStickyCta = () => {
    const btn = document.querySelector('[data-sticky-cta]');
    if (!btn) return;

    const mainElement = document.querySelector('main');
    if (!mainElement) return;

    // Use the first section inside main as the hero section
    const hero = mainElement.querySelector('section:first-of-type') || mainElement.firstElementChild;
    const targetId = btn.getAttribute('data-target-id') || 'form-pemesanan';
    const checkout = document.getElementById(targetId) || document.getElementById('form-pemesanan') || document.getElementById('checkout');

    if (!checkout) return;

    let isHeroVisible = true;
    let isCheckoutVisible = false;

    const updateVisibility = () => {
      // Button is visible ONLY when user is NOT looking at the hero section AND NOT looking at the checkout section
      if (!isHeroVisible && !isCheckoutVisible) {
        btn.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-10');
        btn.classList.add('opacity-100', 'translate-y-0');
      } else {
        btn.classList.add('opacity-0', 'pointer-events-none', 'translate-y-10');
        btn.classList.remove('opacity-100', 'translate-y-0');
      }
    };

    // Intersection Observer to track visibility of Hero and Checkout sections
    const observerOptions = {
      root: null, // Viewport
      threshold: 0.05, // Trigger even on minor overlap
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.target === hero) {
          isHeroVisible = entry.isIntersecting;
        }
        if (entry.target === checkout) {
          isCheckoutVisible = entry.isIntersecting;
        }
      });
      updateVisibility();
    }, observerOptions);

    if (hero) observer.observe(hero);
    observer.observe(checkout);

    // Scroll to checkout on click
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      checkout.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  };

  // Delayed execution to maximize PageSpeed scores (Total Blocking Time, LCP, FID)
  if (document.readyState === 'complete') {
    setTimeout(initStickyCta, 1000);
  } else {
    window.addEventListener('load', () => {
      setTimeout(initStickyCta, 1000);
    });
  }
</script>
