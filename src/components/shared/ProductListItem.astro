---
import { cn } from '../../lib/cn';
import { listItemVariants, metaTextVariants, textVariants } from '../../lib/ui-variants';

interface ProductVariant {
  id: string;
  label: string;
  price: number;
  comparePrice?: number;
}

interface Props {
  product: {
    slug: string;
    productName: string;
    heroImage: string;
    tag: string;
    category: string;
    price: number;
    comparePrice: number;
    variants: ProductVariant[];
  };
  formatPrice: (value: number) => string;
}

const { product, formatPrice } = Astro.props;
---

<article class={listItemVariants({ density: 'normal' })}>
  <a href={`/produk/${product.slug}`} class="flex items-center gap-3.5 group">
    <img
      src={product.heroImage}
      alt={`Foto produk ${product.productName}`}
      width="80"
      height="80"
      class="h-20 w-20 shrink-0 rounded-xl bg-slate-50 object-contain transition-transform duration-200 group-hover:scale-105"
      loading="lazy"
      decoding="async"
    />
    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <p class={cn('text-[9px] font-extrabold uppercase tracking-wider text-slate-400', textVariants({ tone: 'muted' }))}>
            {product.category}
          </p>
          <h2 class={cn('mt-0.5 text-sm font-extrabold leading-snug truncate group-hover:text-slate-700 transition-colors text-slate-900', textVariants({ tone: 'heading' }))}>
            {product.productName}
          </h2>
        </div>
        <div class="shrink-0 text-right">
          <p class={cn('text-[10px] line-through text-slate-400', textVariants({ tone: 'muted' }))}>
            {formatPrice(product.comparePrice)}
          </p>
          <p class={cn('text-xs font-extrabold text-slate-900', textVariants({ tone: 'heading' }))}>{formatPrice(product.price)}</p>
        </div>
      </div>
      <div class:list={['mt-1.5', metaTextVariants()]}>
        <span class="text-[11px] text-slate-500">{product.tag}</span>
        <span class="text-slate-300">•</span>
        <span class="text-[11px] text-slate-500">{product.variants.length} varian</span>
      </div>
      <p class={cn('mt-2 text-[11px] font-extrabold text-slate-900 flex items-center gap-1 group-hover:translate-x-0.5 transition-transform', textVariants({ tone: 'brand' }))}>
        <span>Lihat Detail</span>
        <span>→</span>
      </p>
    </div>
  </a>
</article>
