---
interface Variant {
  id: string;
  label: string;
  price: number;
  comparePrice?: number;
}

interface Props {
  product: {
    productName: string;
    heroImage: string;
    tag: string;
    description: string;
    price: number;
    comparePrice: number;
    variants: Variant[];
  };
  formatPrice: (value: number) => string;
}

const { product, formatPrice } = Astro.props;
---

<section class="mx-auto max-w-[480px] pb-8">
  <img src={product.heroImage} alt={`Visual ${product.productName}`} width="480" height="360" fetchpriority="high" loading="eager" decoding="async" class="aspect-[4/3] w-full object-cover" />

  <div class="px-5 py-6">
    <div class="flex items-start justify-between gap-3 border-b border-[#E5E7EB] pb-4">
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-[#2E7D32]">{product.tag}</p>
        <h2 class="mt-1 text-[24px] font-semibold text-[#263238]">{product.productName}</h2>
        <p class="mt-2 text-[14px] leading-7 text-[#4B5563]">{product.description}</p>
      </div>
      <div class="text-right">
        <p class="text-[12px] text-[#616161] line-through">{formatPrice(product.comparePrice)}</p>
        <p class="text-[20px] font-semibold text-[#1B5E20]">{formatPrice(product.price)}</p>
      </div>
    </div>

    <div class="py-5 border-b border-[#E5E7EB]">
      <h3 class="text-[16px] font-semibold text-[#263238]">Varian Tersedia</h3>
      <div class="mt-3 space-y-3">
        {
          product.variants.map((variant) => (
            <div class="flex items-center justify-between gap-3 border-b border-[#EEF2EA] pb-3 last:border-b-0 last:pb-0">
              <div>
                <p class="text-[14px] font-semibold text-[#263238]">{variant.label}</p>
                <p class="mt-1 text-[12px] text-[#616161]">
                  Harga normal {formatPrice(variant.comparePrice ?? variant.price)}
                </p>
              </div>
              <p class="text-[14px] font-semibold text-[#1B5E20]">{formatPrice(variant.price)}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
