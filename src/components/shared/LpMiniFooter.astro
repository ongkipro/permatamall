---
import { tenantConfig } from '../../lib/tenant';

const legalLinks = [
  { label: 'Privasi', href: '/kebijakan-privasi' },
  { label: 'Syarat & Ketentuan', href: '/syarat-ketentuan' },
  { label: 'Cookie & Iklan', href: '/kebijakan-cookie' },
  { label: 'Disclaimer', href: '/disclaimer' },
];
---

<footer class="border-t border-[#EAEDED] bg-[#F7F8F8] px-3 py-6">
  <nav class="flex items-center justify-center gap-x-3" aria-label="Tautan legal">
    {
      legalLinks.map((item) => (
        <a
          href={item.href}
          class="whitespace-nowrap text-[10.5px] text-[#879596] underline-offset-4 transition-colors hover:text-[#545B64] hover:underline"
        >
          {item.label}
        </a>
      ))
    }
  </nav>
  <p class="mt-3.5 text-center text-[10.5px] text-[#B8C1C1]">© 2026 {tenantConfig.name}</p>
</footer>
