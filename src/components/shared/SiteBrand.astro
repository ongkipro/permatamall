---
import { tenantConfig } from '../../lib/tenant';
interface Props {
  href?: string;
  class?: string;
  tone?: 'light' | 'dark' | 'glossy';
  showTagline?: boolean;
}

const { href = '/', class: className = '', tone = 'dark', showTagline = true } = Astro.props;
const [brandLead, ...brandTailParts] = tenantConfig.name.split(/\s+/);
const brandTail = brandTailParts.join(' ');
const isLight = tone === 'light';
const isGlossy = tone === 'glossy';
const brandLeadClass = isLight ? 'text-white' : 'text-slate-900';
const brandTailClass = isLight
  ? 'text-white/92'
  : isGlossy
    ? 'bg-gradient-to-b from-white via-white to-[#F2F5F0] bg-clip-text text-transparent'
    : 'text-slate-900';
const taglineClass = isLight ? 'text-white/72' : 'text-slate-500';
---

<a
  href={href}
  class={`group flex min-h-11 min-w-0 items-center gap-[8px] rounded-md focus-visible:outline-none focus-visible:ring-2 ${className}`}
  aria-label={tenantConfig.name}
  title={`${tenantConfig.name} - ${tenantConfig.tagline}`}
>
  <span class="flex min-w-0 flex-col justify-center">
    <span
      class="min-w-0 whitespace-nowrap text-[20px] font-black leading-none tracking-tight"
      style="font-family: 'Plus Jakarta Sans', Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
    >
      <span class={brandLeadClass}>{brandLead}{brandTail ? ' ' : ''}</span>{brandTail && <span class={brandTailClass}>{brandTail}</span>}
    </span>
    {
      showTagline && (
        <span
          class={`mt-[4px] whitespace-nowrap text-[9px] font-medium leading-none tracking-normal ${taglineClass}`}
          style="font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;"
        >
          {tenantConfig.tagline}
        </span>
      )
    }
  </span>
</a>
