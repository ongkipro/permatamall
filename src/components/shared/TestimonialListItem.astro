---
import { cn } from '../../lib/cn';
import { listItemVariants, textVariants } from '../../lib/ui-variants';
import RatingStars from './RatingStars.astro';

interface Props {
  item: {
    name: string;
    location: string;
    story: string;
    image: string;
    crop: string;
  };
}

const { item } = Astro.props;
---

<article class={listItemVariants({ density: 'comfortable' })}>
  <img src={item.image} alt={`Foto testimoni ${item.name}`} class="aspect-[4/3] w-full object-cover" loading="lazy" />
  <div class="mt-4 flex items-start justify-between gap-3">
    <div>
      <p class={cn('text-[16px] font-bold', textVariants({ tone: 'heading' }))}>{item.name}</p>
      <p class={cn('mt-1 text-[12px]', textVariants({ tone: 'muted' }))}>{item.location}</p>
      <RatingStars class="mt-2" starClass="h-3.5 w-3.5" />
    </div>
    <span
      class={cn(
        'rounded-full bg-[#EDF6EA] px-2.5 py-1 text-[10px] font-semibold uppercase tracking-[0.12em]',
        textVariants({ tone: 'brand' }),
      )}
    >
      {item.crop}
    </span>
  </div>
  <p class={cn('mt-3 rounded-[14px] bg-[#F8FBF6] px-3 py-3 text-[13px] leading-6', textVariants({ tone: 'body' }))}>
    “{item.story}”
  </p>
</article>
