---
import Icon from '../shared/Icon.astro';

interface Proof {
  name: string;
  location: string;
  story: string;
  image: string;
}
interface Heading {
  eyebrow: string;
  title: string;
  description: string;
}


interface Props {
  proofs: Proof[];
  heading: Heading;
}

const { proofs, heading } = Astro.props;
---

{proofs.length > 0 && (
<section id="bukti" class="border-t border-slate-100 bg-white px-5 py-8">
  <div class="mb-4 text-left">
    <span class="text-[10px] font-extrabold uppercase tracking-widest text-emerald-800">
      {heading.eyebrow}
    </span>
    <h2 class="mt-1 text-xl font-extrabold tracking-tight text-slate-900 md:text-2xl">{heading.title}</h2>
    <p class="mt-1 text-xs text-slate-500">{heading.description}</p>
  </div>

  <!-- Frameless Customer Reviews List with Hairline Dividers -->
  <div class="divide-y divide-slate-100">
    {
      proofs.map((proof) => (
        <article class="py-4 first:pt-2 last:pb-0">
          <div class="flex items-start gap-3">
            <div class="relative shrink-0">
              <img
                src={proof.image}
                alt={`Foto testimoni ${proof.name} dari ${proof.location}`}
                title={`Testimoni ${proof.name}`}
                class="size-11 rounded-lg object-cover bg-slate-50"
                loading="lazy"
              />
              <span class="absolute -bottom-1 -right-1 flex size-4 items-center justify-center rounded-full bg-emerald-700 text-white ring-2 ring-white">
                <Icon name="lucide:check" class="size-2.5" />
              </span>
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="text-xs font-bold text-slate-900 truncate">{proof.name}</h3>
                  <p class="text-[10px] text-slate-400">{proof.location}</p>
                </div>
                <div class="flex text-amber-400">
                  {Array.from({ length: 5 }).map(() => (
                    <svg class="size-3 fill-current" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
              </div>

              <p class="mt-1.5 text-xs leading-relaxed text-slate-600">
                "{proof.story}"
              </p>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
)}
