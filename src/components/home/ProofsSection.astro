---
import Icon from '../shared/Icon.astro';

interface Proof {
  name: string;
  location: string;
  story: string;
  image: string;
}
interface Heading {
  eyebrow: string;
  title: string;
  description: string;
}

interface Props {
  proofs: Proof[];
  heading: Heading;
}

const { proofs, heading } = Astro.props;

// Ensure default fallback proofs if empty
const displayProofs = proofs.length > 0 ? proofs : [
  {
    name: "Siti Rahmawati",
    location: "Jakarta Selatan",
    story: "Bagus banget tasnya! Bahannya tebal, warnanya presisi sesuai gambar. Pengiriman COD sangat cepat dan kurir ramah.",
    image: "",
  },
  {
    name: "Diah Permata",
    location: "Surabaya",
    story: "Jahitan super rapi, muat HP, dompet & makeup. Kualitas luxury untuk harga promo segini, worth it banget!",
    image: "",
  },
  {
    name: "Maya Anggraini",
    location: "Bandung",
    story: "Desainnya mewah & elegan. Suka banget kancing emas & resletingnya yang kokoh. Packing aman & rapi.",
    image: "",
  },
];
---

<section id="bukti" class="border-t border-[#E5E5E5] bg-[#F8F7F4] px-5 py-8">
  <div class="mb-5 text-left">
    <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-[#8A704F]">
      {heading.eyebrow}
    </span>
    <h2 class="mt-1 text-xl font-bold tracking-tight text-[#111111]">{heading.title}</h2>
    <p class="mt-1.5 text-xs font-normal leading-relaxed text-[#555555]">{heading.description}</p>
    
    <!-- Rating Aggregate Summary Banner -->
    <div class="mt-3 flex items-center justify-between border-y border-[#E5E5E5] py-2.5">
      <div class="flex items-center gap-1.5 text-[11px] font-bold text-[#111111]">
        <span class="text-[#C5A880]">★ 4.9 / 5.0</span>
        <span class="text-[#555555]">• 248+ Ulasan Terverifikasi</span>
      </div>
      <span class="text-[9px] font-semibold uppercase tracking-widest text-[#8A704F]">100% Real Buyer</span>
    </div>
  </div>

  <!-- Framed Customer Reviews List -->
  <div class="mt-4 flex flex-col gap-3.5">
    {
      displayProofs.map((proof) => (
        <article class="rounded-none border border-[#E5E5E5] bg-white p-4 shadow-2xs">
          <div class="flex items-start gap-3.5">
            <!-- Icon / Initial Avatar Badge (No Photos) -->
            <div class="relative shrink-0">
              <div 
                class="flex h-10 w-10 items-center justify-center border border-[#C5A880]/60 bg-[#111111] text-[13px] font-bold uppercase text-[#C5A880]"
                style="font-family: 'Cinzel', serif;"
              >
                {proof.name.charAt(0)}
              </div>
              <span class="absolute -bottom-1 -right-1 flex h-4 w-4 items-center justify-center border border-white bg-[#C5A880] text-white">
                <Icon name="lucide:check" class="h-2.5 w-2.5 stroke-[3]" />
              </span>
            </div>

            <div class="min-w-0 flex-1">
              <div class="flex items-center justify-between">
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="text-xs font-bold text-[#111111] truncate">{proof.name}</h3>
                    <span class="inline-flex items-center gap-0.5 border border-[#C5A880]/40 bg-[#F8F7F4] px-1.5 py-0.5 text-[8px] font-semibold uppercase tracking-wider text-[#8A704F]">
                      <Icon name="lucide:shield-check" class="h-2.5 w-2.5 text-[#C5A880]" />
                      Verified
                    </span>
                  </div>
                  <p class="mt-0.5 text-[10px] font-medium text-[#77736C]">{proof.location}</p>
                </div>
                <div class="flex text-[#C5A880]">
                  {Array.from({ length: 5 }).map(() => (
                    <svg class="h-3 w-3 fill-current" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                    </svg>
                  ))}
                </div>
              </div>

              <p class="mt-2 text-xs leading-relaxed text-[#555555]">
                "{proof.story}"
              </p>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
