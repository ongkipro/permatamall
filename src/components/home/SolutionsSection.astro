---
import Icon from '../shared/Icon.astro';

interface Solution {
  title: string;
  excerpt: string;
  image: string;
  href?: string;
  crop?: string;
}

interface Heading {
  eyebrow: string;
  title: string;
  description: string;
}

interface Props {
  solutions: Solution[];
  heading: Heading;
}

const { solutions = [], heading } = Astro.props;

// Group items by category tabs
const categories = ['Semua', 'Kenyamanan Tidur', 'Perkakas Dapur & Rumah', 'Perkakas Bengkel & Otomotif', 'Kesehatan & Herbal', 'Tanaman & Buah'];
const initialLimit = 6;
---

<section id="solusi" class="border-t border-zinc-100 bg-white px-5 py-8">
  <div class="mb-4 text-left">
    <span class="text-[10px] font-semibold uppercase tracking-[0.2em] text-[#8A704F]">
      {heading.eyebrow}
    </span>
    <h2 class="mt-1 text-xl font-bold tracking-tight text-[#111111]">{heading.title}</h2>
    <p class="mt-1.5 text-xs font-normal leading-relaxed text-[#555555]">{heading.description}</p>

    <!-- Category Filter Chips -->
    <div class="mt-3.5 flex flex-wrap gap-1.5 scrollbar-none overflow-x-auto pb-1" id="solutions-filter-bar">
      {categories.map((cat, idx) => (
        <button
          type="button"
          data-category={cat}
          class={`solution-filter-btn rounded-none border border-[#E5E5E5] px-3 py-1 text-[10.5px] font-bold transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#111111] ${
              idx === 0
                ? 'bg-[#111111] text-white shadow-xs'
                : 'bg-[#F8F7F4] text-[#555555] hover:bg-[#111111] hover:text-white'
            }`}
        >
          {cat}
        </button>
      ))}
    </div>
  </div>

  <!-- Seamless List with Hairline Dividers -->
  <div id="solutions-list" class="mt-2 flex flex-col gap-3">
    {
      solutions.map((solution, index) => {
        const href = solution.href || '/solusi-terbaru';
        const cropName = solution.crop || 'CMS Landing Page';

        return (
          <a
            href={href}
            data-index={index}
            data-crop={cropName}
            class={`solution-item group block rounded-2xl border border-zinc-200/80 bg-white p-3 shadow-xs transition-all duration-300 hover:border-zinc-300 hover:shadow-md ${
              index >= initialLimit ? 'hidden' : ''
            }`}
            title={`Buka panduan ${solution.title}`}
          >
            <article class="flex gap-4 items-center">
              <div class="relative aspect-[4/3] w-24 shrink-0 overflow-hidden rounded-xl bg-zinc-50 border border-zinc-100">
                <img
                  src={solution.image}
                  alt={`Foto solusi ${solution.title}`}
                  title={solution.title}
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading={index < 3 ? 'eager' : 'lazy'}
                />
              </div>

              <div class="min-w-0 flex-1">
                <span class="inline-block rounded bg-zinc-100 px-2 py-1 text-[9px] font-extrabold uppercase tracking-widest text-[#09090B]">
                  {cropName}
                </span>
                <h3 class="mt-1.5 text-xs font-bold text-[#111111] group-hover:text-[#8A704F] transition-colors leading-snug">
                  {solution.title}
                </h3>
                <p class="mt-1 line-clamp-2 text-[11px] leading-relaxed text-[#555555]">
                  {solution.excerpt}
                </p>
                <div class="mt-1.5 flex items-center gap-1 text-[10px] font-bold text-[#8A704F]">
                  <span>Buka Panduan & Solusi</span>
                  <Icon name="lucide:chevron-right" class="size-3 transition-transform group-hover:translate-x-0.5" />
                </div>
              </div>
            </article>
          </a>
        );
      })
    }
  </div>

  <!-- Load More Button Bar -->
  <div class="mt-6 flex flex-col items-center justify-center gap-2 pt-2">
    <button
      id="load-more-solutions-btn"
      type="button"
      class="group inline-flex items-center gap-2 rounded-xl border border-zinc-200 bg-white px-5 py-2.5 text-[11px] font-extrabold tracking-wide text-[#09090B] shadow-xs transition-all hover:bg-zinc-50 active:scale-[0.98]"
    >
      <span>Muat Lebih Banyak Panduan</span>
      <Icon name="lucide:chevron-down" class="size-3.5 transition-transform group-hover:translate-y-0.5" />
    </button>
    <p id="solutions-counter" class="text-[11px] font-semibold text-slate-400">
      Menampilkan <span id="visible-count">6</span> dari <span id="total-count">{solutions.length}</span> panduan
    </p>
  </div>
</section>

<script>
  (() => {
    const listEl = document.getElementById('solutions-list');
    const loadMoreBtn = document.getElementById('load-more-solutions-btn');
    const visibleCountEl = document.getElementById('visible-count');
    const totalCountEl = document.getElementById('total-count');
    const filterBtns = document.querySelectorAll('.solution-filter-btn');

    if (!listEl || !loadMoreBtn) return;

    const items = Array.from(listEl.querySelectorAll('.solution-item')) as HTMLElement[];
    let currentLimit = 6;
    let activeCategory = 'Semua';

    const getMatchingItems = () => {
      if (activeCategory === 'Semua') return items;
      return items.filter((item) => {
        const crop = item.getAttribute('data-crop') || '';
        if (activeCategory === 'Kenyamanan Tidur' && (crop.includes('Tidur') || crop.includes('Kenyamanan'))) return true;
        if (activeCategory === 'Perkakas Dapur & Rumah' && (crop.includes('Dapur') || crop.includes('Rumah') || crop.includes('Perkakas'))) return true;
        if (activeCategory === 'Perkakas Bengkel & Otomotif' && (crop.includes('Bengkel') || crop.includes('Otomotif'))) return true;
        if (activeCategory === 'Kesehatan & Herbal' && (crop.includes('Herbal') || crop.includes('Kesehatan') || crop.includes('Minuman') || crop.includes('Pemberantas Hama'))) return true;
        if (activeCategory === 'Tanaman & Buah' && (crop.includes('Tanaman') || crop.includes('Buah') || crop.includes('Bunga') || crop.includes('Nutrisi') || crop.includes('Kebun'))) return true;
        return crop.toLowerCase().includes(activeCategory.toLowerCase());
      });
    };

    const updateVisibility = () => {
      const matching = getMatchingItems();
      let shown = 0;

      items.forEach((item) => {
        const isMatch = matching.includes(item);
        if (isMatch && shown < currentLimit) {
          item.classList.remove('hidden');
          shown++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (visibleCountEl) visibleCountEl.textContent = String(shown);
      if (totalCountEl) totalCountEl.textContent = String(matching.length);

      if (shown >= matching.length) {
        loadMoreBtn.classList.add('hidden');
      } else {
        loadMoreBtn.classList.remove('hidden');
      }
    };

    loadMoreBtn.addEventListener('click', () => {
      currentLimit += 6;
      updateVisibility();
    });

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('bg-[#111111]', 'text-white', 'shadow-xs');
          b.classList.add('bg-[#F8F7F4]', 'text-[#555555]', 'hover:bg-[#111111]', 'hover:text-white');
        });
        btn.classList.remove('bg-[#F8F7F4]', 'text-[#555555]', 'hover:bg-[#111111]', 'hover:text-white');
        btn.classList.add('bg-[#111111]', 'text-white', 'shadow-xs');
        activeCategory = btn.getAttribute('data-category') || 'Semua';
        currentLimit = 6;
        updateVisibility();
      });
    });

    updateVisibility();
  })();
</script>
