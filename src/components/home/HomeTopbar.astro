---
import Icon from '../shared/Icon.astro';
import SiteBrand from '../shared/SiteBrand.astro';
import { tenantConfig } from '../../lib/tenant';
---

<!-- Top Announcement Bar (Clean & Authentic) -->
<div class="bg-emerald-900 px-4 py-2 text-center text-xs font-semibold text-white border-b border-emerald-950/20">
  <p class="mx-auto max-w-[480px] px-1 text-emerald-50">{tenantConfig.tagline}</p>
</div>

<header
  class="relative z-40 border-b border-[#E5E7EB]/80 bg-white shadow-sm"
>
  <div
    class="mx-auto flex h-16 max-w-[480px] items-center justify-between bg-gradient-to-b from-white/95 to-white/80 px-5"
  >
    <a
      href="#konten-utama"
      title={`Lewati ke konten utama ${tenantConfig.name}`}
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:rounded-lg focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:font-semibold focus:text-[#1B5E20]"
      >Lewati ke konten utama</a
    >
    <SiteBrand href="#home" />

    <button
      id="menu-toggle"
      type="button"
      class="group inline-flex h-11 w-11 items-center justify-center rounded-full border border-[#E5E7EB] bg-white/80 text-[#1B5E20] transition-all duration-200 hover:border-[#1B5E20]/30 hover:bg-green-50 active:scale-95"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Buka menu"
    >
      <span class="sr-only">Buka menu</span>
      <span class="flex w-5 flex-col items-end gap-1.5">
        <span class="h-0.5 w-5 rounded-full bg-current transition-transform duration-200 group-hover:translate-x-0.5"
        ></span>
        <span class="h-0.5 w-4 rounded-full bg-current transition-all duration-200 group-hover:w-5"></span>
        <span class="h-0.5 w-5 rounded-full bg-current transition-transform duration-200 group-hover:-translate-x-0.5"
        ></span>
      </span>
    </button>
  </div>
</header>

<div
  id="menu-backdrop"
  class="pointer-events-none fixed inset-0 z-40 bg-slate-950/30 opacity-0 transition-opacity duration-200"
>
</div>
<nav
  id="mobile-menu"
  class="fixed right-0 top-0 z-50 flex h-screen w-[84%] max-w-[336px] translate-x-full flex-col border-l border-[#E5E7EB] bg-white transition-transform duration-200 ease-out"
  aria-hidden="true"
>
  <div class="border-b border-[#E5E7EB] px-5 pb-4 pt-5">
    <div class="flex items-start justify-between gap-4">
      <SiteBrand href="#home" />
      <button
        id="menu-close"
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-[#1B5E20]/10 bg-[#1B5E20] text-white transition-all duration-200 hover:bg-green-800 active:scale-95"
        aria-label="Tutup menu"><Icon name="lucide:x" class="h-[18px] w-[18px]" aria-hidden="true" /></button
      >
    </div>
  </div>

  <div class="px-5 py-5">
    <div class="space-y-1">
      <a
        href="#produk"
        title={`Lihat produk utama ${tenantConfig.name}`}
        class="block rounded-lg px-0 py-3 transition-colors hover:text-[#1B5E20]"
      >
        <div class="flex items-start justify-between gap-3 border-b border-[#EEF2EA] pb-3">
          <div class="min-w-0">
            <div class="flex items-center gap-3">
              <Icon name="lucide:package" class="mt-0.5 h-4 w-4 flex-shrink-0 text-[#1B5E20]" aria-hidden="true" />
              <span class="text-[16px] font-semibold leading-5 text-[#263238]">Produk Utama</span>
            </div>
            <p class="mt-1 pl-7 text-[12px] leading-5 text-[#616161]">
              Lihat produk inti yang paling sering dipakai petani.
            </p>
          </div>
          <span class="pt-0.5 text-[#1B5E20]">›</span>
        </div>
      </a>

      <a
        href="#solusi"
        title="Lihat solusi pertanian terbaru"
        class="block rounded-lg px-0 py-3 transition-colors hover:text-[#1B5E20]"
      >
        <div class="flex items-start justify-between gap-3 border-b border-[#EEF2EA] pb-3">
          <div class="min-w-0">
            <div class="flex items-center gap-3">
              <Icon name="lucide:arrow-right" class="mt-0.5 h-4 w-4 flex-shrink-0 text-[#1B5E20]" aria-hidden="true" />
              <span class="text-[16px] font-semibold leading-5 text-[#263238]">Solusi Terbaru</span>
            </div>
            <p class="mt-1 pl-7 text-[12px] leading-5 text-[#616161]">
              Temukan panduan praktis sesuai masalah tanaman di lapangan.
            </p>
          </div>
          <span class="pt-0.5 text-[#1B5E20]">›</span>
        </div>
      </a>

      <a
        href="#bukti"
        title="Lihat bukti lapangan dan testimoni petani"
        class="block rounded-lg px-0 py-3 transition-colors hover:text-[#1B5E20]"
      >
        <div class="flex items-start justify-between gap-3 border-b border-[#EEF2EA] pb-3">
          <div class="min-w-0">
            <div class="flex items-center gap-3">
              <Icon
                name="lucide:message-circle"
                class="mt-0.5 h-4 w-4 flex-shrink-0 text-[#1B5E20]"
                aria-hidden="true"
              />
              <span class="text-[16px] font-semibold leading-5 text-[#263238]">Bukti Lapangan</span>
            </div>
            <p class="mt-1 pl-7 text-[12px] leading-5 text-[#616161]">
              Baca cerita singkat hasil lapangan dari petani lain.
            </p>
          </div>
          <span class="pt-0.5 text-[#1B5E20]">›</span>
        </div>
      </a>

      <a
        href="#artikel"
        title="Lihat artikel edukasi pertanian"
        class="block rounded-lg px-0 py-3 transition-colors hover:text-[#1B5E20]"
      >
        <div class="flex items-start justify-between gap-3 border-b border-[#EEF2EA] pb-3">
          <div class="min-w-0">
            <div class="flex items-center gap-3">
              <Icon name="lucide:file-text" class="mt-0.5 h-4 w-4 flex-shrink-0 text-[#1B5E20]" aria-hidden="true" />
              <span class="text-[16px] font-semibold leading-5 text-[#263238]">Artikel</span>
            </div>
            <p class="mt-1 pl-7 text-[12px] leading-5 text-[#616161]">
              Pelajari langkah awal perawatan dengan bahasa yang mudah dipahami.
            </p>
          </div>
          <span class="pt-0.5 text-[#1B5E20]">›</span>
        </div>
      </a>

      <a
        href="#footer-contact"
        title={`Hubungi kontak resmi ${tenantConfig.name}`}
        class="block rounded-lg px-0 py-3 transition-colors hover:text-[#1B5E20]"
      >
        <div class="flex items-start justify-between gap-3 pb-1">
          <div class="min-w-0">
            <div class="flex items-center gap-3">
              <Icon name="lucide:mail" class="mt-0.5 h-4 w-4 flex-shrink-0 text-[#1B5E20]" aria-hidden="true" />
              <span class="text-[16px] font-semibold leading-5 text-[#263238]">Kontak</span>
            </div>
            <p class="mt-1 pl-7 text-[12px] leading-5 text-[#616161]">
              Hubungi admin resmi melalui WhatsApp atau email yang tersedia.
            </p>
          </div>
          <span class="pt-0.5 text-[#1B5E20]">›</span>
        </div>
      </a>
    </div>
  </div>

  <div class="mt-auto border-t border-[#E5E7EB] px-5 py-4">
    <p class="text-[11px] leading-5 text-[#616161]">
      Gunakan menu ini untuk membuka bagian penting lebih cepat tanpa perlu scroll panjang.
    </p>
  </div>
</nav>
