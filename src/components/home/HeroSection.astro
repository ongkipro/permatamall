---
import Icon from '../shared/Icon.astro';
import { tenantConfig } from '../../lib/tenant';

interface Slide {
  image: string;
  alt: string;
  badge: string;
  text: string;
}

interface Highlight {
  label: string;
  icon: string;
}
interface HeroContent {
  title: string;
  description: string;
  ratingLabel: string;
}

interface Props {
  slides: Slide[];
  highlights: Highlight[];
  content: HeroContent;
}

const { slides, highlights, content } = Astro.props;

const highlightIcons: Record<string, string> = {
  check: 'lucide:circle-check',
  focus: 'lucide:scan-line',
  note: 'lucide:notebook-text',
  time: 'lucide:clock-3',
};
---

<section class="bg-white pb-8 pt-0">
  <div class="relative overflow-hidden border-b border-slate-200 bg-slate-50 shadow-xs">
    <div id="hero-track" class="flex transition-transform duration-700 ease-out will-change-transform">
      {
        slides.map((slide, index) => (
          <article class="relative min-w-full">
            <img
              src={slide.image}
              alt={`${slide.alt} - ${tenantConfig.name}`}
              title={slide.badge}
              width="600"
              height="400"
              class="aspect-[3/2] w-full object-cover object-center"
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding={index === 0 ? 'sync' : 'async'}
              fetchpriority={index === 0 ? 'high' : undefined}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/25 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-5 text-white">
              <span class="inline-flex rounded-full border border-white/25 bg-slate-950/40 px-3 py-1 text-[11px] font-bold backdrop-blur-md tracking-wide">
                {slide.badge}
              </span>
              <p class="mt-2 max-w-[24rem] text-[13px] font-medium leading-5 text-slate-100">
                {slide.text}
              </p>
            </div>
          </article>
        ))
      }
    </div>
    <div id="hero-dots" class="absolute bottom-3 left-1/2 z-10 flex -translate-x-1/2 gap-2">
      {
        slides.map((_, index) => (
          <button
            type="button"
            aria-label={`Tampilkan slide ${index + 1}`}
            class={index === 0
              ? 'h-6 w-8 rounded-full border-[7px] border-transparent bg-white bg-clip-padding transition-all'
              : 'h-6 w-6 rounded-full border-[7px] border-transparent bg-white/55 bg-clip-padding transition-all'}
          />
        ))
      }
    </div>
  </div>

  <div class="px-5 pt-6">
    <span class="inline-flex rounded-full border border-slate-200 bg-slate-100 px-3.5 py-1 text-[11px] font-bold text-slate-900 tracking-wide">
      {content.ratingLabel}
    </span>
    <h1 class="mt-3 text-[26px] font-black leading-[1.2] tracking-tight text-slate-900 sm:text-3xl">
      {content.title}
    </h1>
    <p class="mt-2.5 text-xs font-medium leading-6 text-slate-600 sm:text-sm">
      {content.description}
    </p>
    <ul class="mt-5 grid grid-cols-2 gap-x-3 gap-y-3 text-[12px] font-medium text-slate-700" aria-label={`Keunggulan ${tenantConfig.name}`}>
      {
        highlights.map((item) => (
          <li class="grid grid-cols-[18px_1fr] items-start gap-2 text-left">
            <span class="mt-[2px] flex h-[18px] w-[18px] items-center justify-center rounded-full bg-slate-900 text-white" aria-hidden="true">
              <Icon name={highlightIcons[item.icon] || 'lucide:circle'} class="h-3 w-3" aria-hidden="true" />
            </span>
            <span class="min-w-0 pt-[1px] font-semibold text-slate-800 leading-[1.3]">{item.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
