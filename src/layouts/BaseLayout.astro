---
import type { ComponentProps } from 'astro/types';
import { SEO } from 'astro-seo';
import jakartaRegularUrl from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-400-normal.woff2?url';
import jakartaSemiBoldUrl from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-600-normal.woff2?url';
import jakartaExtraBoldUrl from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-800-normal.woff2?url';
import GoogleAdsBase from '../components/tracking/GoogleAdsBase.astro';
import MetaPageViewTracker from '../components/tracking/MetaPageViewTracker.astro';
import MetaPixelBase from '../components/tracking/MetaPixelBase.astro';
import GtmBase from '../components/tracking/GtmBase.astro';
import MetaDebugTracker from '../components/tracking/MetaDebugTracker.astro';
import JsonLdSchema from '../components/seo/JsonLdSchema.astro';
import SiteFooter from '../components/shared/SiteFooter.astro';
import SiteHeader from '../components/shared/SiteHeader.astro';
import { tenantConfig } from '../lib/tenant';
import { getStoreAdsConfig } from '../lib/store-ads';
import '../styles/global.css';

type JsonLdProps = ComponentProps<typeof JsonLdSchema>;

type PreloadImageItem = string | { srcset: string; imagesizes?: string; sizes?: string };

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonical?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  noindex?: boolean;
  breadcrumbs?: JsonLdProps['breadcrumbs'];
  product?: JsonLdProps['product'];
  faqs?: JsonLdProps['faqs'];
  contentWidth?: 'compact' | 'wide';
  preloadImages?: PreloadImageItem | readonly PreloadImageItem[];
  shell?: string;
}

const {
  title: rawTitle = tenantConfig.defaultTitle,
  description = tenantConfig.description,
  image = tenantConfig.logo,
  canonical: canonicalProp,
  hideHeader = false,
  hideFooter = false,
  noindex = false,
  breadcrumbs,
  product,
  faqs,
  contentWidth = tenantConfig.storefrontTemplate === 'wide-catalog' ? 'wide' : 'compact',
  preloadImages,
} = Astro.props;

// Clean title: remove any "landing page" or "(landing page)" phrasing to focus strictly on product/brand name
const title = (rawTitle || tenantConfig.defaultTitle)
  .replace(/\s*\(?\s*landing\s*page\s*\)?/gi, '')
  .replace(/\s+-\s+-\s+/g, ' - ')
  .trim();

const publicSiteUrl = tenantConfig.siteUrl;
const adsConfig = await getStoreAdsConfig(Astro.locals);
const canonical = canonicalProp ?? new URL(Astro.url.pathname, publicSiteUrl).toString();
const imageUrl = new URL(image, publicSiteUrl).toString();
const preloadImageUrls =
  typeof preloadImages === 'string' || (typeof preloadImages === 'object' && preloadImages !== null && !Array.isArray(preloadImages))
    ? [preloadImages as PreloadImageItem]
    : ((preloadImages as readonly PreloadImageItem[] | undefined) ?? []);
const jakartaFontCss = `
  @font-face {
    font-family: 'Plus Jakarta Sans';
    font-style: normal;
    font-display: optional;
    font-weight: 400;
    src: url('${jakartaRegularUrl}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Plus Jakarta Sans';
    font-style: normal;
    font-display: optional;
    font-weight: 600;
    src: url('${jakartaSemiBoldUrl}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: 'Plus Jakarta Sans';
    font-style: normal;
    font-display: optional;
    font-weight: 800;
    src: url('${jakartaExtraBoldUrl}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
`;
---

<!doctype html>
<html lang={tenantConfig.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <style is:inline set:html={jakartaFontCss} />
    <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
    <link rel="dns-prefetch" href="https://connect.facebook.net" />
    <link
      rel="preload"
      href={jakartaRegularUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={jakartaSemiBoldUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={jakartaExtraBoldUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    {
      preloadImageUrls.map((item) =>
        typeof item === 'string' ? (
          <link rel="preload" as="image" href={item} fetchpriority="high" />
        ) : (
          <link rel="preload" as="image" imagesrcset={item.srcset} imagesizes={item.imagesizes || item.sizes} fetchpriority="high" />
        )
      )
    }
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      noindex={noindex}
      openGraph={{
        basic: {
          title,
          type: 'website',
          image: imageUrl,
          url: canonical,
        },
        optional: {
          description,
          locale: tenantConfig.openGraphLocale,
          siteName: tenantConfig.name,
        },
        image: {
          url: imageUrl,
          alt: title,
        },
      }}
      twitter={{
        card: 'summary_large_image',
        title,
        description,
        image: imageUrl,
        imageAlt: title,
      }}
      extend={{
        meta: [
          { name: 'robots', content: noindex ? 'noindex, nofollow' : 'index, follow' },
          { name: 'theme-color', content: tenantConfig.themeColor },
          { name: 'author', content: tenantConfig.name },
          { name: 'publisher', content: tenantConfig.name },
          { property: 'article:publisher', content: publicSiteUrl },
        ],
        link: [
          { rel: 'icon', href: '/favicon.png', type: 'image/png' },
          { rel: 'apple-touch-icon', href: '/favicon-192.png' },
        ],
      }}
    />
    <JsonLdSchema
      siteUrl={publicSiteUrl}
      organization={{
        name: tenantConfig.name,
        url: publicSiteUrl,
        logo: tenantConfig.logo,
        description: tenantConfig.description,
      }}
      website={{
        name: tenantConfig.name,
        url: publicSiteUrl,
        description: tenantConfig.description,
        inLanguage: tenantConfig.locale,
      }}
      product={product}
      breadcrumbs={breadcrumbs}
      faqs={faqs}
    />
    <style is:global>
      :where(img, video, iframe) {
        max-width: 100%;
      }

      :where(img[width][height], video[width][height], iframe[width][height]) {
        aspect-ratio: attr(width type(<number>)) / attr(height type(<number>));
      }

      :where(img, video) {
        height: auto;
      }
    </style>
    <GtmBase gtmId={adsConfig.googleTagManagerId} />
    <GoogleAdsBase
      googleAdsId={adsConfig.googleAdsConversionId}
      googleAdsLabel={adsConfig.googleAdsConversionLabel}
    />
    <MetaPixelBase pixelId={adsConfig.metaPixelId} />
    <MetaPageViewTracker />
    <MetaDebugTracker />
    <slot name="head" />
  </head>
  <body>
    <div class="flex min-h-screen w-full justify-center">
      <div
        class:list={[
          'min-h-screen w-full bg-white',
          contentWidth === 'compact'
            ? 'max-w-[480px] shadow-[0_0_40px_rgba(15,23,42,0.08)]'
            : 'max-w-none',
        ]}
      >
        {!hideHeader && <SiteHeader />}
        <slot />
        {!hideFooter && <SiteFooter />}
      </div>
    </div>

    <script is:inline>
      const menu = document.getElementById('mobile-menu');
      const backdrop = document.getElementById('menu-backdrop');
      const toggle = document.getElementById('menu-toggle');
      const close = document.getElementById('menu-close');
      const menuLinks = menu?.querySelectorAll('a') ?? [];

      const openMenu = () => {
        menu?.classList.remove('invisible');
        requestAnimationFrame(() => {
          menu?.classList.remove('translate-x-full');
        });
        backdrop?.classList.remove('pointer-events-none', 'opacity-0');
        backdrop?.classList.add('opacity-100');
        toggle?.setAttribute('aria-expanded', 'true');
        menu?.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      };

      const closeMenu = () => {
        menu?.classList.add('translate-x-full');
        backdrop?.classList.add('pointer-events-none', 'opacity-0');
        backdrop?.classList.remove('opacity-100');
        toggle?.setAttribute('aria-expanded', 'false');
        menu?.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        setTimeout(() => {
          if (menu?.classList.contains('translate-x-full')) {
            menu?.classList.add('invisible');
          }
        }, 200);
      };

      toggle?.addEventListener('click', openMenu);
      close?.addEventListener('click', closeMenu);
      backdrop?.addEventListener('click', closeMenu);
      menuLinks.forEach((link) => link.addEventListener('click', closeMenu));
    </script>
  </body>
</html>
